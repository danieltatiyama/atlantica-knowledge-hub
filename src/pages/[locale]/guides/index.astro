---
import GuidesPage from "../../../components/GuidesPage.astro";
import { NEW_GUIDE_LOCALES } from "../../../i18n/locales.mjs";
import type { Lang } from "../../../i18n/ui";
export function getStaticPaths(){
 return NEW_GUIDE_LOCALES.map(lang=>({params:{locale:lang},props:{lang}}));
}
const {lang}=Astro.props as {lang:Lang};
---
