---
/**
 * Local-only draft preview.
 * No static paths are generated by `astro build`, including Cloudflare deployments.
 * Draft content stays excluded from public guide routes and listings.
 */
import GuideArticle from "../../../components/GuideArticle.astro";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import type { Lang } from "../../../i18n/ui";

export async function getStaticPaths() {
  if (!import.meta.env.DEV) return [];

  const drafts = await getCollection(
    "guides",
    ({ data }) =>
      data.draft &&
      data.translationKey === "avalon-overview" &&
      (data.lang === "en" || data.lang === "pt-br")
  );

  return drafts.map((guide) => ({
    params: {
      lang: guide.data.lang,
      slug: guide.id.replace(/^[^/]+\//, ""),
    },
    props: { guide, lang: guide.data.lang },
  }));
}

interface Props {
  guide: CollectionEntry<"guides">;
  lang: Lang;
}
const { guide, lang } = Astro.props;
---
<GuideArticle guide={guide} lang={lang} />
