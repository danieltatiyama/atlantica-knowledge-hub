---
import GuideArticle from "../../../components/GuideArticle.astro";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
export async function getStaticPaths() {
  const guides = await getCollection("guides", ({data}) => data.lang === "fr" && !data.draft);
  return guides.map(guide=>({params:{slug:guide.id.replace(/^[^/]+\//,"")},props:{guide}}));
}
interface Props { guide: CollectionEntry<"guides">; }
const { guide } = Astro.props;
---
<GuideArticle guide={guide} lang="fr" />
