---
import EditorialArticle from "../../../components/EditorialArticle.astro";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
export async function getStaticPaths() {
  const entries = await getCollection("mercenaries", ({ data }) =>
    data.lang === "pt-br" && !data.draft &&
    data.reviewStatus === "approved" && data.evidenceStatus !== "client-config"
  );
  return entries.map((entry) => ({
    params: { slug: entry.id.replace(/^[^/]+\//, "") },
    props: { entry },
  }));
}
interface Props { entry: CollectionEntry<"mercenaries">; }
const { entry } = Astro.props;
---
<EditorialArticle lang="pt-br" entry={entry} />
