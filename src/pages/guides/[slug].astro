
---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";

export async function getStaticPaths() {
  const guides = await getCollection(
    "guides",
    ({ data }) => data.lang === "en" && !data.draft
  );

  return guides.map((guide) => ({
    params: {
      slug: guide.id.replace(/^en\//, ""),
    },
    props: { guide },
  }));
}

interface Props {
  guide: CollectionEntry<"guides">;
}

const { guide } = Astro.props;
const { Content } = await render(guide);

const updatedAt = guide.data.updatedAt.toLocaleDateString(
  "en-US",
  {
    year: "numeric",
    month: "long",
    day: "numeric",
    timeZone: "UTC",
  }
);
---

<BaseLayout
  title={`${guide.data.title} | Atlantica Knowledge Hub`}
  description={guide.data.description}
  lang={guide.data.lang}
>
  <main class="container">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span>/</span>
      <a href="/guides/">Guides</a>
      <span>/</span>
      <span aria-current="page">{guide.data.title}</span>
    </nav>

    <article class="article">
      <header class="article-header">
        <p class="eyebrow">
          {guide.data.category.replaceAll("-", " ")}
        </p>

        <h1>{guide.data.title}</h1>

        <p class="description">
          {guide.data.description}
        </p>

        <p class="updated">
          Last updated: {updatedAt}
        </p>
      </header>

      <div class="article-body">
        <Content />
      </div>

      <a href="/guides/" class="back-link">
        ← Back to guides
      </a>
    </article>
  </main>
</BaseLayout>

<style>
  .container {
    width: min(var(--content-width), 90%);
    margin: 0 auto;
  }

  .breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    padding-top: 30px;
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .breadcrumbs a {
    text-decoration: none;
  }

  .breadcrumbs a:hover {
    color: var(--color-accent);
  }

  .article {
    max-width: 850px;
    margin: 0 auto;
    padding: 50px 0 80px;
  }

  .article-header {
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 28px;
    margin-bottom: 35px;
  }

  .eyebrow {
    color: var(--color-accent);
    text-transform: uppercase;
    font-size: 0.8rem;
    letter-spacing: 2px;
  }

  h1 {
    font-size: clamp(2rem, 5vw, 3.2rem);
    line-height: 1.2;
    margin: 15px 0;
  }

  .description {
    color: var(--color-text-muted);
    font-size: 1.1rem;
  }

  .updated {
    color: var(--color-text-muted);
    font-size: 0.85rem;
  }

  .article-body {
    font-size: 1rem;
    line-height: 1.8;
  }

  :global(.article-body h2) {
    margin-top: 36px;
    margin-bottom: 12px;
    font-size: 1.6rem;
    color: var(--color-text);
  }

  :global(.article-body h3) {
    margin-top: 28px;
    color: var(--color-text);
  }

  :global(.article-body p),
  :global(.article-body li) {
    color: var(--color-text-muted);
  }

  :global(.article-body a) {
    color: var(--color-accent);
  }

  :global(.article-body img) {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
  }

  :global(.article-body code) {
    overflow-wrap: anywhere;
  }

  .back-link {
    display: inline-block;
    margin-top: 50px;
    color: var(--color-accent);
    text-decoration: none;
  }

  .back-link:hover {
    text-decoration: underline;
  }

  @media (max-width: 700px) {
    .article {
      padding: 30px 0 50px;
    }
  }
</style>
