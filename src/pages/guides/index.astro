
---
import BaseLayout from "../../layouts/BaseLayout.astro";

import { getCollection } from "astro:content";

const categories = [
  {
    title: "Nation Dungeons",
    description:
      "Dungeon mechanics, strategies, cooldowns, and rewards.",
  },
  {
    title: "Mercenaries & Builds",
    description:
      "Mercenary information, skills, formations, and builds.",
  },
  {
    title: "Game Systems",
    description:
      "Crafting, equipment, enhancement, and other systems.",
  },
];

const allGuides = await getCollection("guides");
const guides = allGuides
  .filter((guide) => guide.data.lang === "en" && !guide.data.draft)
  .sort(
    (a, b) =>
      b.data.updatedAt.getTime() -
      a.data.updatedAt.getTime()
  );
---

<BaseLayout
  title="Game Guides | Atlantica Knowledge Hub"
  description="Guides and resources for Atlantica Online players."
  lang="en"
>
  <main class="container">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">Guides</span>
    </nav>

    <section class="intro">
      <p class="eyebrow">KNOWLEDGE BASE</p>
      <h1>Game Guides</h1>
      <p class="subtitle">
        Explore guides, strategies, and useful information
        to improve your Atlantica Online experience.
      </p>
    </section>

    <section class="latest-guides" aria-labelledby="latest-guides-title">
        <h2 id="latest-guides-title">Latest Guides</h2>

        <div class="guide-list">
            {guides.map((guide) => (
            <article class="card">
                <p class="eyebrow">
                {guide.data.category.replaceAll("-", " ")}
                </p>

                <h3>
                    <a class="guide-link" href={`/guides/${guide.id.replace(/^en\//, "")}/`}>
                        {guide.data.title}
                    </a>
                </h3>

                <p>{guide.data.description}</p>

                <span>
                Updated: {guide.data.updatedAt.toISOString().slice(0, 10)}
                </span>
            </article>
            ))}
        </div>
    </section>

    <section class="categories" aria-labelledby="categories-title">
      <h2 id="categories-title">Categories</h2>

      <div class="grid">
        {categories.map((category) => (
          <article class="card">
            <h3>{category.title}</h3>
            <p>{category.description}</p>
            <span>Coming soon</span>
          </article>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .container {
    width: min(var(--content-width), 90%);
    margin: 0 auto;
  }

  .breadcrumbs {
    display: flex;
    gap: 12px;
    padding-top: 30px;
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .breadcrumbs a {
    text-decoration: none;
  }

  .breadcrumbs a:hover {
    color: var(--color-accent);
  }

  .intro {
    padding: 70px 0 50px;
    max-width: 750px;
  }

  .eyebrow {
    color: var(--color-accent);
    font-size: 0.8rem;
    letter-spacing: 2px;
  }

  h1 {
    font-size: clamp(2.5rem, 6vw, 4rem);
    line-height: 1.15;
    margin: 15px 0;
  }

  .subtitle,
  .card p {
    color: var(--color-text-muted);
  }

  .categories {
    padding-bottom: 100px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }

  .card {
    padding: 28px;
    border: 1px solid var(--color-card-border);
    border-radius: 12px;
    background: var(--color-surface);
  }

  .card h3 {
    margin-top: 0;
  }

  .card span {
    color: var(--color-accent);
    font-size: 0.85rem;
  }

  @media (max-width: 700px) {
    .grid {
      grid-template-columns: 1fr;
    }

    .intro {
      padding: 50px 0 30px;
    }
  }

    .latest-guides {
    padding-bottom: 40px;
    }

    .guide-list {
    display: grid;
    grid-template-columns: repeat(
        auto-fit,
        minmax(min(100%, 320px), 1fr)
    );
    gap: 20px;
    }

    .latest-guides .eyebrow {
    text-transform: uppercase;
    margin-top: 0;
    }

    .latest-guides .card h3 {
    margin-bottom: 8px;
    }

    .guide-link {
    color: var(--color-text);
    text-decoration: none;
    transition: color 0.2s ease;
    }

    .guide-link:hover,
    .guide-link:focus-visible {
    color: var(--color-accent);
    text-decoration: underline;
    }

</style>
