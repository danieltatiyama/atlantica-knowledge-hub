
---
import BaseLayout from "../layouts/BaseLayout.astro";

const siteName = "Atlantica Knowledge Hub";

const sections = [
  {
    title: "Game Guides",
    description: "Explore game mechanics, strategies, and tutorials.",
  },
  {
    title: "Nation Dungeons",
    description: "Learn about dungeons, cooldowns, and schedules.",
  },
  {
    title: "Tools & Calculators",
    description: "Interactive tools to help you plan your adventures.",
  },
];

---

<BaseLayout title={siteName} lang="en">
  <main class="container">
    <section class="hero">
      <p class="eyebrow">COMMUNITY KNOWLEDGE BASE</p>
      <h1>Explore the world of Atlantica Online</h1>
      <p class="subtitle">
        Guides, resources, and interactive tools built
        for the Atlantica Online community.
      </p>
      <a class="button" href="#topics">Explore Topics</a>
    </section>

    <section id="topics">
      <h2>Discover</h2>
      <div class="grid">
        {sections.map((section) => (
          <article class="card">
            <h3>{section.title}</h3>
            <p>{section.description}</p>
            <span>Coming soon</span>
          </article>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .container {
    width: min(var(--content-width), 90%);
    margin: 0 auto;
  }

  .hero {
    padding: clamp(40px, 5vh, 72px) 0
            clamp(28px, 4vh, 48px);
    max-width: 760px;
  }

  .eyebrow {
    color: var(--color-accent);
    font-size: 0.8rem;
    letter-spacing: 2px;
  }

  h1 {
    font-size: clamp(2.5rem, 6vw, 4.2rem);
    line-height: 1.15;
    margin: 12px 0 18px;
  }

  .subtitle, .card p {
    color: var(--color-text-muted);
  }

  .button {
    display: inline-block;
    margin-top: 14px;
    padding: 12px 24px;
    border-radius: 8px;
    background: #d8b675;
    color: var(--color-on-accent);
    text-decoration: none;
    font-weight: 700;
  }

  #topics {
    padding-bottom: clamp(36px, 4vh, 64px);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }

  .card {
    padding: 28px;
    border: 1px solid var(--color-card-border);
    border-radius: 12px;
    background: var(--color-surface);
  }

  .card h3 {
    margin-top: 0;
  }

  .card span {
    color: #d8b675;
    font-size: 0.85rem;
  }

  footer {
    padding: 25px;
    border-top: 1px solid #253247;
    text-align: center;
    color: #a9b7cb;
  }

@media (max-width: 700px) {
  .grid {
    grid-template-columns: 1fr;
  }

  .hero {
    padding: 44px 0 32px;
  }
}
</style>
