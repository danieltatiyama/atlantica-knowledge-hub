
---
import "@fontsource/marcellus/400.css";

import "@fontsource/source-sans-3/400.css";
import "@fontsource/source-sans-3/600.css";
import "@fontsource/source-sans-3/700.css";

import "../styles/global.css";
import "../styles/themes.css";

import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FloatingWikiNavigator from "../components/FloatingWikiNavigator.astro";

interface Props {
  title: string;
  description?: string;
  lang?: string;
  alternatePaths?: Partial<Record<"en" | "pt-br", string>>;
}


const {
  title,
  description = "A community knowledge hub for Atlantica Online.",
  lang = "en",
  alternatePaths,
} = Astro.props;

const siteUrl = Astro.site;

if (!siteUrl) {
  throw new Error("Configure 'site' in astro.config.mjs");
}

const canonicalUrl = new URL(
  Astro.url.pathname,
  siteUrl
).href;

const alternateLinks = Object.entries(alternatePaths ?? {})
  .filter(([, path]) => Boolean(path))
  .map(([locale, path]) => ({
    hreflang: locale === "pt-br" ? "pt-BR" : locale,
    href: new URL(path, siteUrl).href,
  }));

---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />
    <meta name="description" content={description} />
    <!-- Apply saved appearance before first paint to avoid a theme flash.
         Atlantica remains the default, even when the OS prefers light. -->
    <script is:inline>
      (() => {
        const allowed = new Set([
          "atlantica", "dark", "light", "parchment", "midnight", "contrast"
        ]);
        let theme = "atlantica";
        try {
          const saved = localStorage.getItem("atlantica.theme");
          if (allowed.has(saved)) theme = saved;
        } catch {
          // Storage can be blocked in privacy mode.
        }
        document.documentElement.dataset.theme = theme;
      })();
    </script>
    <title>{title}</title>

    <link rel="canonical" href={canonicalUrl} />

    {alternateLinks.map((alternate) => (
      <link
        rel="alternate"
        hreflang={alternate.hreflang}
        href={alternate.href}
      />
    ))}

    {Astro.url.pathname === "/" && (
      <script is:inline>
        (() => {
          const storageKey = "atlantica.language";

          let savedLanguage = null;

          try {
            savedLanguage = localStorage.getItem(storageKey);
          } catch {
            // Continue using the browser preference.
          }

          // Explicit user preference always wins.
          if (savedLanguage === "en") {
            return;
          }

          if (savedLanguage === "pt-br") {
            window.location.replace(
              "/pt-br/" + window.location.search + window.location.hash
            );
            return;
          }

          // No saved preference: inspect browser languages.
          const browserLanguages =
            navigator.languages?.length
              ? navigator.languages
              : [navigator.language];

          const preferredLanguage = browserLanguages
            .map((language) =>
              language.toLowerCase().split("-")[0]
            )
            .find((language) =>
              language === "en" || language === "pt"
            );

          if (preferredLanguage === "pt") {
            window.location.replace(
              "/pt-br/" + window.location.search + window.location.hash
            );
          }
        })();
      </script>
    )}

  </head>

  <body>
    <Header />

    <slot />

    <FloatingWikiNavigator lang={lang === "pt-br" ? "pt-br" : "en"} />

    <Footer />
  </body>
</html>
