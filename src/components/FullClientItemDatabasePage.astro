      });
      if(entries.length===0)section.append(node("p",pt
        ?"Não encontramos materiais de fabricação estruturados nos arquivos deste item. Isso não significa que ele não possa ser fabricado."
        :"No structured crafting materials were found in this item's files. This does not mean it cannot be crafted.","wiki-empty"));
      if(data.s.some(row=>row[8]==="unsupported"))section.append(node("p",pt
        ?"Existem materiais que o extrator ainda não conseguiu interpretar."
        :"Some original material expressions could not be decoded yet.","wiki-source-warning"));
      parent.append(section);
    }
    // Preserve ALL original metadata, but make it an optional audit section
    // instead of repeating noisy record-by-record mini-cards above the recipe.
    function addDefinitionTable(parent:HTMLElement,data:Detail,id:string){
      const section=node("details",undefined,"wiki-technical");
      section.id="wiki-item-technical";
      section.dataset.wikiNavNative="true";
      const summary=node("summary");
      summary.append(node("span",pt?"Dados originais dos arquivos":"Original client records"),
        node("span",number.format(data.s.length)+(pt?" registros":" records"),"wiki-tech-count"));
      section.append(summary);
      section.append(node("p",pt
        ?"Para conferir a origem dos dados: cada linha corresponde a uma definição ItemType. Os campos Work e Unit são preservados como extraídos; não confirmam requisitos do jogo."
        :"For source verification: each row is an ItemType definition. Work and Unit are unchanged client values, not confirmed gameplay requirements.","wiki-help"));
      const tbl=node("table"),head=node("thead"),headingRow=node("tr");
      for(const label of [pt?"Registro":"Record",pt?"Arquivo":"Source file",
        pt?"Tipo":"Type",pt?"Categoria":"Category",
        pt?"Nível":"Level",pt?"Grade":"Grade","Work","Unit",
        pt?"Materiais":"Material state"])headingRow.append(node("th",label));
      head.append(headingRow);tbl.append(head);
      const body=node("tbody");
      const stateLabel=(v:string)=>v.startsWith("parsed-")
        ?(pt?"Identificados":"Parsed")
        :v==="unsupported"?(pt?"Não decodificados":"Not decoded")
        :(pt?"Não registrados":"Not recorded");
      for(const [recordId,file,role,cat,level,grade,work,unit,state] of data.s){
        const tr=node("tr");
        for(const value of ["#"+recordId,file,role,cat,fmtRaw(level),
          fmtRaw(grade),fmtRaw(work),fmtRaw(unit),stateLabel(state)])
          tr.append(node("td",String(value)));
        body.append(tr);
      }
      tbl.append(body);const scroll=node("div",undefined,"wiki-table-scroll");
      scroll.append(tbl);section.append(scroll);
      if(data.v.length>1){
        const group=node("details",undefined,"wiki-source-groupings");
        group.append(node("summary",pt?"Agrupamentos de registros":"Record groupings"));
        group.append(node("p",pt
          ?"Grupos de arquivos de origem, não variantes jogáveis comprovadas."
          :"Original source groupings, not confirmed playable variants.","wiki-help"));
        const groupingTable=node("table"),gHead=node("thead"),gtr=node("tr");
        for(const heading of [pt?"Grupo":"Group",pt?"Registros incluídos":"Included source rows"])
          gtr.append(node("th",heading));
        gHead.append(gtr);groupingTable.append(gHead);
        const gBody=node("tbody");
        data.v.forEach((records,i)=>{
          const row=node("tr");
          row.append(node("td",String(i+1)),node("td",records.map(n=>"#"+n).join(", ")));
          gBody.append(row);
        });
        groupingTable.append(gBody);
        const gscroll=node("div",undefined,"wiki-table-scroll");
        gscroll.append(groupingTable);group.append(gscroll);section.append(group);
      }
      parent.append(section);
    }
    async function openItem(id:string,navigate:boolean){
      if(!/^\d{1,12}$/.test(id))return;
      const row=namedRows.get(id);
      if(!row){
        detail.hidden=false;details.replaceChildren();
        detailName.textContent=pt?`ID ${id} não encontrado`:`ID ${id} not found`;
        detailNotice.textContent="";detailMeta.textContent="";
        if(navigate)history.pushState({},"","?id="+encodeURIComponent(id));
        return;
      }
      detail.hidden=false;details.replaceChildren();
      detailName.textContent=row[1]??`Item ID ${id}`;
      detailMeta.textContent=`ID ${id} · ${row[2]??"—"} · ${pt?"fontes":"sources"}: ${row[5]}`;
      detailNotice.textContent=row[6]==="named"
        ?(pt?"Esta ficha reúne receitas, atributos e possíveis fontes de obtenção identificadas nos arquivos do jogo. Confira as ressalvas de cada seção.":"This page brings together crafting, stats and possible acquisition sources from the game files. See the notes in each section.")
        :(pt?"Nome retido: identidade divergente ou tradução não resolvida. Nenhuma definição foi atribuída a um nome inventado.":"Name withheld: conflicting identity or unresolved translation. No source record was assigned a guessed name.");
      if(navigate)history.pushState({},"","?id="+encodeURIComponent(id));
      if(equipmentCandidateCategories.has(row[2]??"")&&row[6]==="named"){
        const p=node("p");
        const a=node("a",row[8]===1
          ?(pt?"Abrir ficha revisada do equipamento":"Open reviewed equipment profile")
          :(pt?"Abrir ficha do equipamento extraída do cliente":"Open client-source equipment profile")) as HTMLAnchorElement;
        a.href=prefix+"/items/"+id+"/";p.append(a);details.append(p);}
      if(row[6]!=="named"){
        details.append(node("p",label(row[6]),"subtle"));detail.scrollIntoView({behavior:"smooth",block:"start"});return;
      }
      details.append(node("p",pt?"Carregando os registros de origem…":"Loading original source records…","subtle"));
      try{
        const data=await sourceDetails(id);
        // Do not let an earlier slow request overwrite a more recent selection.
        if(new URL(location.href).searchParams.get("id")!==id)return;
        details.replaceChildren();
        if(equipmentCandidateCategories.has(row[2]??"")&&row[6]==="named"){
          const p=node("p");
          const a=node("a",row[8]===1
            ?(pt?"Abrir ficha revisada do equipamento":"Open reviewed equipment profile")
            :(pt?"Abrir ficha do equipamento extraída do cliente":"Open client-source equipment profile")) as HTMLAnchorElement;
          a.href=prefix+"/items/"+id+"/";p.append(a);details.append(p);}
        addItemOverview(details,row,data);
        addCraftBatchInformation(details,data);
        addCraftRecipeTables(details,data);
        // Reverse links are generated from every one of the 22,702 named-ID
        // source details, not just the originally reviewed 551 profiles.
        void addUsedInTable(details,id);
        void addMonsterSources(details,id);
        // Original raw numeric rows are shown for every named item type.
        // Only equipment-like source categories may use the explicitly
        // unverified historical upgrade projection.
        const rawStats=await optionalNumericStats(id);
        if(new URL(location.href).searchParams.get("id")!==id)return;
        if(rawStats){
          addRawNumericSourceTable(details,rawStats);
          if(equipmentCandidateCategories.has(row[2]??""))
            addHistoricalGradeTable(details,rawStats);
        }else if(equipmentCandidateCategories.has(row[2]??"")&&row[8]!==1){
          details.append(node("p",pt
            ?"Atributos de combate ainda não foram importados para este ID. Não é possível calcular +0 a +10 com segurança sem os valores originais de Items.csv."
            :"Combat attributes for this ID have not yet been imported. +0..+10 cannot be calculated safely without the original Items.csv values.","subtle"));
        }
        addDefinitionTable(details,data,id);
        // A consistent player-first navigation between the main kinds of
        // information, without showing raw source fields up front.
        const jump=node("nav",undefined,"wiki-profile-jumps");
        jump.setAttribute("aria-label",pt?"Navegação do perfil":"Profile navigation");
        const targets=[
          ["wiki-item-about",pt?"Visão geral":"Overview"],
          ["wiki-item-crafting",pt?"Como fabricar":"Crafting"],
          ["wiki-item-used-by",pt?"Usado em receitas":"Used in recipes"],
          ["wiki-item-monsters",pt?"Monstros":"Monsters"],
          ["wiki-item-technical",pt?"Dados originais":"Raw sources"],
        ];
        for(const [target,title] of targets){
          const link=node("a",title) as HTMLAnchorElement;
          link.href="#"+target;
          if(target==="wiki-item-technical")
            link.addEventListener("click",()=>{const d=document.getElementById(target) as HTMLDetailsElement|null;if(d)d.open=true;});
          jump.append(link);
        }
        const codex=node("a",pt?"Abrir no códice de drops":"Open in loot codex") as HTMLAnchorElement;
        codex.href=prefix+"/monsters/?item="+encodeURIComponent(id);
        jump.append(codex);
        details.prepend(jump);
      }catch{
        details.replaceChildren(node("p",pt?"Não foi possível carregar o arquivo deste ID.":"Could not load the client source shard for this ID.","subtle"));
      }
      detail.scrollIntoView({behavior:"smooth",block:"start"});
    }
    close.addEventListener("click",()=>{
      detail.hidden=true;details.replaceChildren();history.pushState({},"",location.pathname);
    });
    window.addEventListener("popstate",()=>{
      const id=new URL(location.href).searchParams.get("id");
      if(id)void openItem(id,false);else detail.hidden=true;
    });
    query.addEventListener("input",applyFilters);
    category.addEventListener("change",applyFilters);
    identity.addEventListener("change",applyFilters);
    sort.addEventListener("change",applyFilters);
    equipmentOnly.addEventListener("change",applyFilters);
    statField.addEventListener("change",applyFilters);
    statMin.addEventListener("input",applyFilters);
    statMax.addEventListener("input",applyFilters);
    exportButton.addEventListener("click",()=>{
      if(!visible.length||statField.value&&!allStatsReady)return;
      const csv=exportFilteredClientCsv(visible,{
        pt,field:statField.value,summaries:indexedStats,
      });
      const blob=new Blob([csv],{type:"text/csv;charset=utf-8"});
      const url=URL.createObjectURL(blob);
      const a=node("a") as HTMLAnchorElement;
      a.href=url;a.download="atlantica-client-items-snapshot-1.csv";
      a.click();
      window.setTimeout(()=>URL.revokeObjectURL(url),2500);
    });
    compareRun.addEventListener("click",()=>{void runComparison();});
    compareClear.addEventListener("click",()=>{
      comparedIds.splice(0);updateComparisonSelection();renderPage();
    });
    updateComparisonSelection();
    prev.addEventListener("click",()=>{if(currentPage>0){currentPage--;renderPage();}});
    next.addEventListener("click",()=>{if((currentPage+1)*perPage<visible.length){currentPage++;renderPage();}});
    (async()=>{
      try{
        manifest=await fetchJSON("/data/client-items/manifest.json") as Manifest;
        if(manifest.snapshotId!==1||manifest.totalIds!==23586||manifest.namedIds!==22702||manifest.indexShards.length!==6)
          throw Error("Manifest incompatible with original Miner snapshot");
        const pieces=await Promise.all(manifest.indexShards.map(file=>
          fetchJSON("/data/client-items/"+file)));
        allRows=pieces.flatMap(data=>{
          if(data.snapshotId!==manifest?.snapshotId||data.schemaVersion!=="1.0"||!Array.isArray(data.rows))
            throw Error("Client index shard mismatch");
          return data.rows as IndexRow[];
        });
        if(allRows.length!==manifest.totalIds)throw Error("Incomplete client item ID coverage");
        const categoryValues=new Set<string>(),seen=new Set<string>();
        for(const row of allRows){
          if(seen.has(row[0])||!/^\d+$/.test(row[0]))throw Error("Duplicate client item identity");
          seen.add(row[0]);namedRows.set(row[0],row);
          if(row[2])categoryValues.add(row[2]);
        }
        for(const cat of [...categoryValues].sort((a,b)=>a.localeCompare(b,"en"))){
          const opt=node("option",cat) as HTMLOptionElement;opt.value=cat;category.append(opt);
        }
        for(const {key} of RAW_STATS_FIELDS){
          const opt=node("option",fieldTitle(key)+" ("+key+")") as HTMLOptionElement;
          opt.value=key;statField.append(opt);
        }
        applyFilters();
        const deepLink=new URL(location.href).searchParams.get("id");
        if(deepLink)void openItem(deepLink,false);
      }catch{
        status.textContent=pt?"Falha ao carregar ou validar o índice completo. Confira os dados publicados.":"Could not load or verify the full client index. Check the published source data.";
      }
    })();
  }
</script>
