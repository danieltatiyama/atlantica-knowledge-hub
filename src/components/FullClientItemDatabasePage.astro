    function toggleComparison(id:string){
      const row=namedRows.get(id);
      if(!row||row[6]!=="named"||
        !equipmentCandidateCategories.has(row[2]??""))return;
      const position=comparedIds.indexOf(id);
      if(position>=0)comparedIds.splice(position,1);
      else if(comparedIds.length<3)comparedIds.push(id);
