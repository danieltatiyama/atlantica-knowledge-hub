      });
      currentPage=0;renderPage();
      exportButton.disabled=visible.length===0;
      status.textContent=itemDbText(lang,"{found} of {total} IDs found. {named} reconciled names.",{found:number.format(visible.length),total:number.format(allRows.length),named:number.format(manifest?.namedIds??0)});
    }
