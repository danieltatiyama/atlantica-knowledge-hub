---
import {itemDbText} from "../i18n/item-db-ui.mjs";
  import {aliasText} from "../i18n/name-alias-ui.mjs";
import {localePrefix,localizedPaths,localeTag,legacyLocale} from "../i18n/locales.mjs";
import type {Lang} from "../i18n/ui";
import BaseLayout from "../layouts/BaseLayout.astro";
interface Props {lang:Lang; profile?:boolean;}
const {lang,profile=false}=Astro.props;
const prefix=localePrefix(lang);
const fallback=legacyLocale(lang)!==lang;
const nf=new Intl.NumberFormat(lang==="en"?"en-US":localeTag(lang));
const title=itemDbText(lang,"Full client item database");
---
<BaseLayout lang={lang} title={title+" | Atlantica Knowledge Hub"}
  description={itemDbText(lang,"Searchable source index of 23,586 original Atlantica Global game-client item IDs.")}
  alternatePaths={localizedPaths(profile?"/items/profile/":"/items/database/")}>
  <main class="container" id="full-client-db" data-lang={lang} data-profile={String(profile)} data-wiki-nav-root="true">
    <nav class="breadcrumb"><a href={prefix+(profile?"/items/database/":"/items/")}>{profile?itemDbText(lang,"Full client item database"):itemDbText(lang,"← Equipment catalog")}</a></nav>
    <section class="search-panel" hidden={profile} aria-label={itemDbText(lang,"Search items")}>
      <h1 class="search-title">{itemDbText(lang,"Find items")}</h1>
      <div class="search-grid">
        <label>{aliasText(lang,"English name, Wiki translation or ID")}
          <input type="search" id="db-query" autocomplete="off" placeholder={itemDbText(lang,"e.g. Spirit Sword, Immortal Bow, 24120")}/>
        </label>
        <label>{itemDbText(lang,"Original source category")}
          <select id="db-category"><option value="">{itemDbText(lang,"All categories")}</option></select>
        </label>
        <label>{itemDbText(lang,"Identity status")}
          <select id="db-identity">
            <option value="">{itemDbText(lang,"All IDs")}</option>
            <option value="named">{itemDbText(lang,"Official name identified")}</option>
            <option value="collision">{itemDbText(lang,"Conflicting names for ID")}</option>
            <option value="unresolved">{itemDbText(lang,"No resolved name")}</option>
          </select>
        </label>
        <label>{itemDbText(lang,"Sort by")}
          <select id="db-sort">
            <option value="id">{itemDbText(lang,"Ascending ID")}</option>
            <option value="name">{itemDbText(lang,"Name A–Z")}</option>
            <option value="level">{itemDbText(lang,"Raw level descending")}</option>
          </select>
        </label>
      </div>
      <label class="equipment-toggle">
        <input type="checkbox" id="db-equipment-only"/>
        <span>{itemDbText(lang,"Show only equipment-like source categories (not confirmed equip/enhancement eligibility)")}</span>
      </label>

      <details class="stats-workbench" data-wiki-nav-native="true" aria-label={itemDbText(lang,"Additional filters")}>
        <summary>{itemDbText(lang,"Additional filters")}</summary>
        <div class="stats-grid">
          <label>{itemDbText(lang,"Numeric field")}
            <select id="db-stat-field">
              <option value="">{itemDbText(lang,"No numeric field filter")}</option>
            </select>
          </label>
          <label>{itemDbText(lang,"Raw minimum")}
            <input id="db-stat-min" type="number" step="any" placeholder={itemDbText(lang,"No minimum")} disabled/>
          </label>
          <label>{itemDbText(lang,"Raw maximum")}
            <input id="db-stat-max" type="number" step="any" placeholder={itemDbText(lang,"No maximum")} disabled/>
          </label>
          <button type="button" id="db-export" disabled>{itemDbText(lang,"Export filtered CSV")}</button>
        </div>
        <p class="subtle" id="db-stat-status" role="status"></p>
      </details>
      {fallback && <p class="subtle">{itemDbText(lang,"CSV export uses the original English or Portuguese column format.")}</p>}

      <div class="table-wrap">
        <table aria-label={itemDbText(lang,"All client item IDs")}>
          <thead><tr><th>ID</th><th>{itemDbText(lang,"Official English name / status")}</th>
            <th>{itemDbText(lang,"Source category")}</th><th>{itemDbText(lang,"Raw level")}</th>
            <th>{itemDbText(lang,"Raw grade")}</th><th>{itemDbText(lang,"Sources")}</th><th>{itemDbText(lang,"Compare")}</th></tr></thead>
          <tbody id="db-results"></tbody>
        </table>
      </div>
      <div class="pagination">
        <button type="button" id="db-prev" disabled>{itemDbText(lang,"Previous")}</button>
        <span id="db-page">—</span>
        <button type="button" id="db-next" disabled>{itemDbText(lang,"Next")}</button>
      </div>
      <section class="compare-workbench" aria-label={itemDbText(lang,"Compare items")}>
        <h2>{itemDbText(lang,"Compare equipment source attributes")}</h2>
        <p class="subtle">{itemDbText(lang,"Select 2–3 equipment-like source IDs. Comparison shows original numeric fields only, preserving missing, conflicting and partial source observations; a numeric difference is not a gameplay ranking.")}</p>
        <div class="compare-controls">
          <div id="db-compare-selected" aria-live="polite"></div>
          <button type="button" id="db-compare-run" disabled>{itemDbText(lang,"Compare selected")}</button>
          <button type="button" id="db-compare-clear" disabled>{itemDbText(lang,"Clear selection")}</button>
        </div>
        <div id="db-compare-result" aria-live="polite"></div>
      </section>
      <noscript>{itemDbText(lang,"Enable JavaScript to search the client index. The original 551 item pages remain available from the equipment catalog.")}</noscript>
    </section>

<details class="catalog-info" hidden={profile} data-wiki-nav-native="true">
      <summary>{itemDbText(lang,"Coverage")}</summary>
    <header hidden={profile}>
      <p class="eyebrow">GLOBAL / NA · MINER SNAPSHOT 1</p>
      <h1>{title}</h1>
      <p class="intro">{itemDbText(lang,"Search an item by name or ID to see its attributes, crafting materials, recipes that use it, and possible acquisition sources.")}</p>
      <details class="reader-guide">
        <summary>{itemDbText(lang,"How to read the item information")}</summary>
        <p>{itemDbText(lang,"Useful player information comes first. Technical definitions are available under Original client records at the bottom of each item page. Open any ingredient to see its own page or find its possible monster drops.")}</p>
        <p>{itemDbText(lang,"Percentages are client-based estimates, not verified probabilities. Missing recipes or drops do not prove they are unavailable in-game.")}</p>
      </details>
    </header>

    <section class="coverage" hidden={profile} aria-label={itemDbText(lang,"Coverage")}>
      <div><strong>{nf.format(23586)}</strong><small>{itemDbText(lang,"Source IDs")}</small></div>
      <div><strong>{nf.format(22702)}</strong><small>{itemDbText(lang,"Named IDs")}</small></div>
      <div><strong>{nf.format(884)}</strong><small>{itemDbText(lang,"Unresolved IDs")}</small></div>
      <div><strong>{nf.format(27281)}</strong><small>{itemDbText(lang,"Source records")}</small></div>
    </section>

    </details>
      <p class="load-status" id="db-status" role="status">{itemDbText(lang,"Loading client index…")}</p>
    <section class="detail" id="db-detail" hidden aria-live="polite">
      <div class="detail-header"><div>
        <p class="eyebrow">{itemDbText(lang,"ITEM INFORMATION")}</p>
        {profile?<h1 id="db-detail-name"></h1>:<h2 id="db-detail-name"></h2>}
        <p id="db-detail-meta"></p>
      </div><button type="button" id="db-detail-close">{itemDbText(lang,"Close")}</button></div>
      <p id="db-detail-notice" class="detail-note"></p>
      <div id="db-detail-content"></div>
    </section>
  </main>
</BaseLayout>
<script>
  import {prependItemIcon} from "../lib/client-item-icons";
  import {scaledDropText} from "../i18n/scaled-drop-ui.mjs";
  import {mainLevelBandRange} from "../data/monster-level-policy.mjs";
  import {wikiNameAlias,matchesWikiNameAlias} from "../data/wiki-name-aliases.mjs";
  import {itemDbText} from "../i18n/item-db-ui.mjs";
  import {aliasText} from "../i18n/name-alias-ui.mjs";
  import {localePrefix,legacyLocale,localeTag,equipmentProfilePath} from "../i18n/locales.mjs";
  import {buildHistoricalClientProjection,labelForClientField} from "../data/client-item-stat-summary.mjs";
  import {summarizeCraftBatch} from "../data/client-craft-batch.mjs";
  import {buildClientRecipeViews} from "../data/client-craft-recipe-views.mjs";
  import {formatCandidateClientRate} from "../data/client-drop-rate-hypothesis.mjs";
  import {formatLevelResolvedPercent,estimatedTwoStagePercent} from "../data/client-monster-drop-resolver.mjs";
  import {RAW_STATS_FIELDS,summarizeRawNumericRows,comparableRawNumber,matchesRawStat,
    compareSourceStats,exportFilteredClientCsv} from "../data/full-client-stats-tools.mjs";
  type IndexRow=[string,string|null,string|null,string|null,string|null,number,"named"|"collision"|"unresolved",number,number];
  type SourceRow=[number,string,string,string,string|number|null,string|number|null,number|null,number|null,string,[string,number][]];
  type Detail={s:SourceRow[];v:number[][]};
  type Manifest={snapshotId:number;totalIds:number;namedIds:number;collisionIds:number;unresolvedIds:number;indexShards:string[];detailBucketWidth:number};
  const root=document.querySelector<HTMLElement>("#full-client-db");
  if(root){
    const lang=root.dataset.lang??"en";
    const profile=root.dataset.profile==="true";
    const legacyId=new URL(location.href).searchParams.get("id");
    if(!profile && legacyId && /^\d{1,12}$/.test(legacyId))location.replace(localePrefix(lang)+"/items/profile/?id="+encodeURIComponent(legacyId)+location.hash);
    const pt=lang==="pt-br",prefix=localePrefix(legacyLocale(lang));
    const $=<T extends HTMLElement>(id:string)=>root.querySelector<T>("#"+id)!;
    const query=$<HTMLInputElement>("db-query"),category=$<HTMLSelectElement>("db-category");
    const identity=$<HTMLSelectElement>("db-identity"),sort=$<HTMLSelectElement>("db-sort");
    const equipmentOnly=$<HTMLInputElement>("db-equipment-only");
    const statField=$<HTMLSelectElement>("db-stat-field");
    const statMin=$<HTMLInputElement>("db-stat-min"),statMax=$<HTMLInputElement>("db-stat-max");
    const statStatus=$<HTMLParagraphElement>("db-stat-status"),exportButton=$<HTMLButtonElement>("db-export");
    const compareSelected=$<HTMLDivElement>("db-compare-selected");
    const compareRun=$<HTMLButtonElement>("db-compare-run"),compareClear=$<HTMLButtonElement>("db-compare-clear");
    const compareResult=$<HTMLDivElement>("db-compare-result");
    const status=$<HTMLParagraphElement>("db-status"),results=$<HTMLTableSectionElement>("db-results");
    const pageLabel=$<HTMLSpanElement>("db-page"),prev=$<HTMLButtonElement>("db-prev"),next=$<HTMLButtonElement>("db-next");
    const detail=$<HTMLElement>("db-detail"),details=$<HTMLElement>("db-detail-content");
    const detailName=$<HTMLElement>("db-detail-name"),detailMeta=$<HTMLElement>("db-detail-meta");
    const detailNotice=$<HTMLElement>("db-detail-notice");
    const close=$<HTMLButtonElement>("db-detail-close");
    const namedRows=new Map<string,IndexRow>();
    const detailCache=new Map<number,Promise<Record<string,Detail>>>();
    const craftCache=new Map<number,Promise<Record<string,[string,string,number,number[]][]>>>();
    let craftManifestPromise:Promise<{files:string[];bucketWidth:number}|null>|null=null;
    const statsCache=new Map<number,Promise<Record<string,[number,Record<string,string>][]>|null>>();
    let statsManifestPromise:Promise<{snapshotId:number;itemIds:number;sourceRows:number;files:string[]}|null>|null=null;
    let lootSourceManifestPromise:Promise<any|null>|null=null;
    const itemMonsterSourcesCache=new Map<number,Promise<any>>();
    let allStatsPromise:Promise<Map<string,ReturnType<typeof summarizeRawNumericRows>>>|null=null;
    let indexedStats=new Map<string,ReturnType<typeof summarizeRawNumericRows>>();
    let allStatsReady=false,filterEpoch=0,compareEpoch=0;
    const comparedIds:string[]=[];
    // Categories are ORIGINAL ItemType source labels, not proof that the
    // item is equipped or currently enhanceable on the server.
    const equipmentCandidateCategories=new Set([
      "Weapon","Defence","Sword","Spear","Axe","Bow","Gun","Cannon",
      "Staff","Guitar","Saw","Whip","Shield","Orb","Armor","Pants",
      "Boots","Helmet","Glove","Ring","Accessories","Neck","EARRING","BRACELET"
    ]);
    let allRows:IndexRow[]=[],visible:IndexRow[]=[],currentPage=0,manifest:Manifest|null=null;
    const perPage=100,number=new Intl.NumberFormat(lang==="en"?"en-US":localeTag(lang));
    const statLabels={ActivePower:itemDbText(lang,"Active Power"),
      BuffUpPercentage:itemDbText(lang,"Buff bonus (%)")} as Record<string,string>;
    const fieldTitle=(key:string)=>statLabels[key]??itemDbText(lang,labelForClientField(key,false));
    const groupNames={attack:itemDbText(lang,"Attack"),defense:itemDbText(lang,"Defense"),
      attributes:itemDbText(lang,"Base attributes"),other:itemDbText(lang,"Other")} as Record<string,string>;
    const label=(key:string)=>({named:itemDbText(lang,"Source name reconciled"),
      collision:itemDbText(lang,"Identity collision"),
      unresolved:itemDbText(lang,"Name unresolved")} as Record<string,string>)[key]??key;
    const node=(tag:string,text?:string,className?:string)=>{
      const el=document.createElement(tag);
      if(text!==undefined)el.textContent=text;
      if(className)el.className=className;
      return el;
    };
    const td=(tr:HTMLTableRowElement,text:string)=>{const cell=node("td",text);tr.append(cell);return cell;};
    const nameFor=(id:string)=>namedRows.get(id)?.[1]??null;
    const fmtRaw=(x:unknown)=>x===null||x===undefined||x===""?"—":String(x);
    const sourceURL=(id:string)=>`/data/client-items/details/${String(Math.floor(Number(id)/1000)).padStart(2,"0")}.json`;
    async function fetchJSON(url:string){
      const response=await fetch(url,{cache:"force-cache"});
      if(!response.ok)throw Error("Client dataset unavailable");
      return response.json();
    }
    async function sourceDetails(id:string):Promise<Detail>{
      if(!manifest)throw Error("Client manifest unavailable");
      const bucket=Math.floor(Number(id)/manifest.detailBucketWidth);
      if(!detailCache.has(bucket)){
        detailCache.set(bucket,fetchJSON(sourceURL(id)).then(data=>{
          if(data.snapshotId!==manifest?.snapshotId||data.bucket!==bucket||!data.items)
            throw Error("Original client shard mismatch");
          return data.items as Record<string,Detail>;
        }));
      }
      const rows=await detailCache.get(bucket)!;
      if(!rows[id])throw Error("No original source data for ID");
      return rows[id];
    }
    async function originalUsedIn(id:string){
      if(!manifest)return [];
      if(!craftManifestPromise){
        craftManifestPromise=fetchJSON("/data/client-items/crafting/manifest.json")
          .then(data=>{
            if(data.schemaVersion!=="1.0"||data.snapshotId!==manifest?.snapshotId||
              data.dataset!=="client-item-crafting-backlinks"||
              data.itemIndexIds!==manifest?.totalIds||
              data.bucketWidth!==manifest?.detailBucketWidth||
              !Array.isArray(data.files))throw Error("Craft backlink snapshot mismatch");
            return data as {files:string[];bucketWidth:number};
          });
      }
      const meta=await craftManifestPromise;
      if(!meta)return [];
      const bucket=Math.floor(Number(id)/meta.bucketWidth);
      const filename="used-by-"+String(bucket).padStart(2,"0")+".json";
      if(!meta.files.includes(filename))return [];
      if(!craftCache.has(bucket)){
        craftCache.set(bucket,fetchJSON("/data/client-items/crafting/"+filename)
          .then(data=>{
            if(data.schemaVersion!=="1.0"||data.snapshotId!==manifest?.snapshotId||
              data.bucket!==bucket||!data.items||
              typeof data.items!=="object"||Array.isArray(data.items))
              throw Error("Craft inverse file mismatch");
            return data.items as Record<string,[string,string,number,number[]][]>;
          }).catch(error=>{craftCache.delete(bucket);throw error;}));
      }
      return (await craftCache.get(bucket)!)?.[id]??[];
    }
    async function addUsedInTable(parent:HTMLElement,id:string){
      const section=node("section",undefined,"used-in-crafting");
      section.hidden=true;
      section.id="wiki-item-used-by";
      section.append(node("h3",itemDbText(lang,"Used in crafting")));
      section.append(node("p",itemDbText(lang,"Reverse references from parsed ItemType*.ndt recipes. Client source records do not confirm availability in the current live game."),"detail-note"));
      const state=node("p",itemDbText(lang,"Checking recipes…"),"subtle");
      section.append(state);parent.append(section);
      try{
        const rows=await originalUsedIn(id);
        if(rows.length===0){
          section.remove();
          return;
        }
        section.hidden=false;
        state.textContent=(itemDbText(lang,"Recipe references: "))+number.format(rows.length);
        const table=node("table") as HTMLTableElement,head=node("thead"),tr=node("tr");
        for(const name of [itemDbText(lang,"Produced item"),
          itemDbText(lang,"Material quantity"),
          itemDbText(lang,"Source definition IDs")])tr.append(node("th",name));
        head.append(tr);table.append(head);const body=node("tbody");
        for(const [productId,name,quantity,recordIds] of rows){
          const tr=node("tr"),cell=node("td");
          cell.append(linkItem(productId,name??nameFor(productId)??("ID "+productId)));
          cell.append(" · #"+productId);tr.append(cell);
          tr.append(node("td",number.format(quantity)));
          tr.append(node("td",recordIds.map(n=>"#"+n).join(", ")));
          body.append(tr);
        }
        table.append(body);const scroller=node("div",undefined,"stat-table-scroll");
        scroller.append(table);section.append(scroller);
      }catch{
        section.hidden=false;
        state.textContent=itemDbText(lang,"Could not load the original source craft references.");
      }
    }
    async function addMonsterSources(parent:HTMLElement,id:string){
      const section=node("section",undefined,"monster-source-links");
      section.hidden=true;
      section.id="wiki-item-monsters";
      section.append(node("h3",itemDbText(lang,"Which monsters may drop this item?")));
      const codex=node("a",itemDbText(lang,"Explore in the monster loot codex")) as HTMLAnchorElement;
      codex.href=localePrefix(lang)+"/monsters/?item="+encodeURIComponent(id);
      const codexLine=node("p");codexLine.append(codex);section.append(codexLine);
      section.append(node("p",itemDbText(lang,"Only level-matched source brackets are shown. Combined percentages are inferred estimates, NOT verified live-server drop odds."),"detail-note"));
      const state=node("p",itemDbText(lang,"Checking monster drops…"),"subtle");
      section.append(state);parent.append(section);
      try{
        if(!lootSourceManifestPromise){
          lootSourceManifestPromise=fetchJSON("/data/client-monster-discovery/manifest.json")
            .catch(()=>null);
        }
        const meta=await lootSourceManifestPromise;
        if(!meta||meta.schemaVersion!=="1.0"||meta.snapshotId!==manifest?.snapshotId||
          meta.dataset!=="level-resolved-client-monster-loot"||
          meta.levelMatchedGroupRows!==26201||
          meta.unmatchedLevelGroupRefs!==176||
          !Array.isArray(meta.files?.itemSources))
          throw Error("Level-resolved client drop manifest mismatch");
        const bucket=Math.floor(Number(id)/1000);
        const filename="item-sources/"+String(bucket).padStart(2,"0")+".json";
        if(!meta.files.itemSources.includes(filename)){
          section.remove();
          return;
        }
        if(!itemMonsterSourcesCache.has(bucket)){
          itemMonsterSourcesCache.set(bucket,fetchJSON("/data/client-monster-discovery/"+filename)
            .then(data=>{
              if(data.schemaVersion!=="1.0"||data.snapshotId!==manifest?.snapshotId||
                data.dataset!=="level-resolved-client-monster-loot"||data.bucket!==bucket)
                throw Error("Level-resolved source shard mismatch");
              return data.items;
            }).catch(error=>{itemMonsterSourcesCache.delete(bucket);throw error;}));
        }
        const entry=(await itemMonsterSourcesCache.get(bucket)!)?.[id];
        if(!entry){
          section.remove();
          return;
        }
        const sources=[
          ...(entry.direct??[]).map((r:any[])=>({row:r,kind:"direct" as const,
            pct:Number(r[3])/100,min:r[5],max:r[6]})),
          ...(entry.group??[]).map((r:any[])=>({row:r,kind:"group" as const,
            pct:estimatedTwoStagePercent(r[5],r[6]),min:r[9],max:r[10]})),
        ].sort((a,b)=>(b.pct??-1)-(a.pct??-1));
        if(!sources.length){section.remove();return;}
        section.hidden=false;
        state.textContent=(itemDbText(lang,"Level-matched possible drop sources: "))+
          number.format(sources.length);
        const body=node("tbody"),head=node("thead"),h=node("tr");
        for(const label of [
          itemDbText(lang,"Creature"),itemDbText(lang,"Estimated rate"),
          itemDbText(lang,"Amount"),itemDbText(lang,"Source")
        ])h.append(node("th",label));
        head.append(h);
        const table=node("table");table.append(head,body);
        const wrapper=node("div",undefined,"stat-table-scroll");wrapper.append(table);
        section.append(wrapper);
        const more=node("button",itemDbText(lang,"Show 100 more")) as HTMLButtonElement;
        more.type="button";more.className="monster-more";
        let cursor=0;
        const nextChunk=()=>{
          for(const source of sources.slice(cursor,cursor+100)){
            const [charId,name]=source.row;
            if(!/^[1-9]\d*$/.test(String(charId)))continue;
            const tr=node("tr"),first=node("td");
            const link=node("a",name??("CharID #"+charId)) as HTMLAnchorElement;
            link.href=localePrefix(lang)+"/monsters/profile/?id="+encodeURIComponent(charId);
            first.append(link);
            if(source.kind==="group"){const range=mainLevelBandRange(charId,source.row[2],source.row[8]);if(range)first.append(node("small",scaledDropText(lang,"level")+" "+range+" · Band "+source.row[8]));}
            tr.append(first);
            tr.append(node("td",formatLevelResolvedPercent(source.pct,lang)));
            tr.append(node("td",String(source.min)+"–"+String(source.max)));
            const cell=node("td"),audit=node("details");
            audit.append(node("summary",itemDbText(lang,"View source")));
            const fields=source.kind==="direct"
              ?[["RawRate",source.row[3]],[itemDbText(lang,"Row"),source.row[2]],
                ["Slot",source.row[4]]]
              :[["GroupID",source.row[2]],["Band",source.row[8]],
                ["RawRate ref",source.row[5]],["RawRate item",source.row[6]],
                [itemDbText(lang,"Ref row"),source.row[3]],
                [itemDbText(lang,"Item row"),source.row[4]],["Slot",source.row[7]]];
            const dl=node("dl");
            for(const [label,value] of fields){
              const div=node("div");div.append(node("dt",String(label)),node("dd",String(value??"—")));
              dl.append(div);
            }
            audit.append(dl);cell.append(audit);tr.append(cell);body.append(tr);
          }
          cursor=Math.min(sources.length,cursor+100);
          more.textContent=(itemDbText(lang,"Show 100 more · "))+
            number.format(cursor)+" / "+number.format(sources.length);
          if(cursor===sources.length)more.remove();
        };
        if(sources.length>100){more.addEventListener("click",nextChunk);section.append(more);}
        nextChunk();
      }catch{
        section.hidden=false;
        state.textContent=itemDbText(lang,"Level-matched monster drops could not be validated.");
      }
    }
        async function numericManifest(){
      if(!statsManifestPromise){
        statsManifestPromise=fetchJSON("/data/client-items/stats/manifest.json")
          .then(data=>{
            if(data.snapshotId!==manifest?.snapshotId||
              data.dataset!=="all-client-item-raw-stats"||
              !Array.isArray(data.files))return null;
            return data as {snapshotId:number;itemIds:number;sourceRows:number;files:string[]};
          }).catch(()=>null);
      }
      return statsManifestPromise;
    }
    async function numericBucket(bucket:number,meta:{files:string[]}){
      const filename=String(bucket).padStart(2,"0")+".json";
      if(!meta.files.includes(filename))return null;
      if(!statsCache.has(bucket)){
        statsCache.set(bucket,fetchJSON("/data/client-items/stats/"+filename)
          .then(data=>{
            if(data.snapshotId!==manifest?.snapshotId||
              data.bucket!==bucket||data.schemaVersion!=="1.0"||
              !data.items||typeof data.items!=="object"||Array.isArray(data.items))
              throw Error("Unrecognized original numeric shard");
            return data.items as Record<string,[number,Record<string,string>][]>;
          }).catch(err=>{statsCache.delete(bucket);throw err;}));
      }
      return statsCache.get(bucket)!;
    }
    async function optionalNumericStats(id:string){
      if(!manifest)return null;
      const meta=await numericManifest();
      if(!meta)return null;
      const bucket=Math.floor(Number(id)/manifest.detailBucketWidth);
      return (await numericBucket(bucket,meta))?.[id]??null;
    }
    async function loadAllRawStats(){
      if(allStatsReady)return indexedStats;
      if(!allStatsPromise){
        allStatsPromise=(async()=>{
          const meta=await numericManifest();
          if(!meta||meta.itemIds!==7560||meta.sourceRows!==9351||meta.files.length!==28)
            throw Error("Numeric source manifest is missing or incompatible");
          // This ~1 MB secondary index loads only after a user explicitly
          // selects a source field. Regular 23,586-ID searches stay light.
          const chunks=await Promise.all(meta.files.map(async filename=>{
            if(!/^[0-2][0-9]\.json$/.test(filename))
              throw Error("Unexpected numeric shard name");
            const bucket=Number(filename.slice(0,2));
            const records=await numericBucket(bucket,meta);
            if(!records)throw Error("Numeric shard unavailable");
            return {bucket,records};
          }));
          const built=new Map<string,ReturnType<typeof summarizeRawNumericRows>>();
          let sourceRows=0;
          for(const {bucket,records} of chunks){
            for(const [id,rawRows] of Object.entries(records)){
              const original=namedRows.get(id);
              if(built.has(id)||!original||original[6]!=="named"||
                Math.floor(Number(id)/1000)!==bucket)
                throw Error("Numeric field source ID does not match client index");
              built.set(id,summarizeRawNumericRows(rawRows));
              sourceRows+=rawRows.length;
            }
          }
          if(built.size!==meta.itemIds||sourceRows!==meta.sourceRows)
            throw Error("Partial or duplicate numeric client data");
          indexedStats=built;
          allStatsReady=true;
          statStatus.textContent="";
          return built;
        })().catch(err=>{
          allStatsPromise=null;
          statStatus.textContent=itemDbText(lang,"Could not validate numeric client shards. Please retry.");
          throw err;
        });
      }
      return allStatsPromise;
    }
