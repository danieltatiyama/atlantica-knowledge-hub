    async function runComparison(){
      if(comparedIds.length<2)return;
      const selected=[...comparedIds],token=++compareEpoch;
      compareRun.disabled=true;
      compareResult.replaceChildren(node("p",itemDbText(lang,"Loading original source records for comparison…"),"subtle"));
      try{
        // Only selected item buckets are requested, never the full 28-shard
        // numeric index. Comparison is available without running filters.
        const source=await Promise.all(selected.map(id=>optionalNumericStats(id)));
        if(token!==compareEpoch)return;
        const summaries=source.map(rows=>rows?summarizeRawNumericRows(rows):null);
        const observed=RAW_STATS_FIELDS.filter(f=>
          summaries.some(summary=>summary?.fields.has(f.key)));
        if(!observed.length){
          compareResult.replaceChildren(node("p",itemDbText(lang,"None of these IDs has published numeric source fields."),"subtle"));
          return;
        }
        const scroller=node("div",undefined,"stat-table-scroll"),table=node("table") as HTMLTableElement;
        table.className="compare-table";
        const head=node("thead"),headers=node("tr");
        headers.append(node("th",itemDbText(lang,"Original field")));
        for(const id of selected){
          headers.append(node("th",(nameFor(id)??("ID "+id))+" · #"+id));
        }
        headers.append(node("th",itemDbText(lang,"Raw spread")));
        head.append(headers);table.append(head);
        const body=node("tbody");
        for(const {key} of observed){
          const stat=compareSourceStats(summaries,key);
          if(!stat)continue;
          const row=node("tr");
          row.append(node("td",fieldTitle(key)+" ("+key+")"));
          for(const item of stat.values){
            const value=item.record;
            const cell=node("td");
            if(!value)cell.textContent="—";
            else{
              cell.textContent=value.values.join(" / ");
              if(value.status!=="consistent"){
                cell.append(node("small",value.status==="conflict"
                  ?(itemDbText(lang," · conflict"))
                  :(" · "+(itemDbText(lang,"partial "))+value.observedIn+"/"+value.sourceCount)));
              }
            }
            row.append(cell);
          }
          row.append(node("td",stat.difference===null?"—":
            number.format(stat.difference)));
          body.append(row);
        }
        table.append(body);scroller.append(table);
        compareResult.replaceChildren(node("p",itemDbText(lang,"Spread = maximum minus minimum raw value, only when all source records agree. This is not a gameplay efficiency ranking."),"subtle"),scroller);
      }catch{
        if(token===compareEpoch)compareResult.replaceChildren(node("p",itemDbText(lang,"Original numeric rows could not be loaded for comparison."),"subtle"));
      }finally{
        if(token===compareEpoch)compareRun.disabled=comparedIds.length<2;
      }
    }
