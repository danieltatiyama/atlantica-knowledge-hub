  async function loadGraph(id:string){
   const names=await getIndex();
   const graph:Record<string,any[]>={};
   const seen=new Set<string>(),stack=[id];
   while(stack.length){
    const current=stack.pop()!;
    if(seen.has(current))continue;
    if(seen.size>=250)throw Error("Recipe graph exceeds 250 IDs");
    seen.add(current);
    const detail=names.has(current)?await getDetails(current):null;
    const variants=detail?buildClientRecipeViews(detail.s):[];
    graph[current]=variants;
    for(const recipe of variants)
     for(const [materialId] of recipe.materials)
      if(!seen.has(materialId))stack.push(materialId);
   }
   return graph;
  }
