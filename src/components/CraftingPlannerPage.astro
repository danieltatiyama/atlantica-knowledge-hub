      }
      select.addEventListener("change",()=>{
       if(select.value!==""){choices[issue.itemId]=Number(select.value);redraw();}
      });
      wrap.append(select);
     }else if(issue.kind==="ingredient-over-limit"){
      wrap.append(el("p",craftingText(lang,"This recipe requires over 10,000 of an ingredient in a single batch. No valid operation exists with the original client amounts.","Esta receita exige mais de 10.000 unidades de um ingrediente em um único batch. Não existe operação válida com as quantidades originais do cliente.")));
     }else if(issue.kind==="missing-batch"||issue.kind==="batch-over-limit"){
      wrap.append(el("p",craftingText(lang,"Batch size missing or above 10,000. Supply units per batch manually (1–10,000).","Tamanho de lote não confirmado ou maior que 10.000. Informe manualmente as unidades por batch (1 a 10.000).")));
      const input=el("input") as HTMLInputElement;
      input.type="number";input.min="1";input.max="10000";input.step="1";input.placeholder="Batch size";
      input.addEventListener("change",()=>{
       if(input.validity.valid&&Number(input.value)>0){
        batchOverrides[issue.itemId]=input.value;redraw();
       }
      });
      wrap.append(input);
     }
     issues.append(wrap);
    }
    result.hidden=false;
   }catch(error){
    status.textContent=(craftingText(lang,"Could not calculate: ","Não foi possível calcular: "))+
      (error instanceof Error?error.message:String(error));
    result.hidden=true;
   }
  }
  let nameCache:Map<string,string>|null=null;
  form.addEventListener("submit",event=>{
   event.preventDefault();
   if(!selectedId||!rootConfig?.ready){
    status.textContent=craftingText(lang,"Select a valid source recipe and batch size.","Selecione uma receita e um batch válido.");
    return;
   }
   if(!isAllowedCraftQuantity(amount.value,rootConfig.batch)){
    amount.value=String(lastValidQuantity);
    status.textContent=craftingText(lang,"Invalid quantity: enter an exact batch multiple up to 10,000.","Quantidade inválida: informe um múltiplo exato do batch até 10.000.");
    return;
   }
   const id=selectedId,epoch=selectionEpoch;
   status.textContent=craftingText(lang,"Loading recipe dependencies…","Carregando receitas e dependências…");
   void (async()=>{
    try{
     nameCache=await getIndex();
     if(epoch!==selectionEpoch)return;
     if(!activeGraph)activeGraph=await loadGraph(id);
     if(epoch!==selectionEpoch)return;
     if(!activeGraph?.[id]?.length)throw Error(craftingText(lang,"Original recipe unavailable.","Receita original indisponível."));
     status.textContent=craftingText(lang,"Source data loaded.","Dados carregados.");
     redraw();
    }catch(error){
     if(epoch!==selectionEpoch)return;
     status.textContent=(craftingText(lang,"Error: ","Falha: "))+
      (error instanceof Error?error.message:String(error));
     result.hidden=true;
    }
   })();
  });
  const requested=new URL(location.href).searchParams.get("id");
  if(requested&&/^[1-9]\d{0,12}$/.test(requested)){
   query.value=requested;
   void (async()=>{
    try{
     const names=await getIndex();
     if(craftableCandidates.has(requested))
      await selectCraftTarget(requested,names.get(requested)??("Item #"+requested));
     else status.textContent=craftingText(lang,"This ItemID has no parsed source recipe.","Este ItemID não possui receita extraída do cliente.");
    }catch{
     status.textContent=craftingText(lang,"Could not load source recipe.","Falha ao carregar a receita.");
    }
   })();
  }

 }
</script>
