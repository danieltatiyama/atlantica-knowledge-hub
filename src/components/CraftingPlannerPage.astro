  function updateCraftTreeVisibility(){
   const rows=plan?.tree as Array<any>|undefined;
   if(!rows)return;
   const ancestors:Array<{depth:number;path:string}>=[];
   for(let i=0;i<rows.length;i++){
    const row=rows[i];
    while(ancestors.length&&ancestors[ancestors.length-1].depth>=row.depth)ancestors.pop();
    const tr=treeRows.children[i] as HTMLTableRowElement|undefined;
    if(!tr)continue;
    tr.hidden=ancestors.some(parent=>collapsedTreePaths.has(parent.path));
    const toggle=tr.querySelector<HTMLButtonElement>(".craft-tree-toggle");
    if(toggle){
     const open=!collapsedTreePaths.has(row.path);
     toggle.textContent=open?"▾":"▸";
     toggle.setAttribute("aria-expanded",String(open));
    }
    if(rows[i+1]?.depth>row.depth)ancestors.push({depth:row.depth,path:row.path});
   }
  }
