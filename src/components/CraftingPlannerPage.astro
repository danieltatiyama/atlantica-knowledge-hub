---
import BaseLayout from "../layouts/BaseLayout.astro";
interface Props {lang:"en"|"pt-br";}
const {lang}=Astro.props;
const pt=lang==="pt-br",prefix=pt?"/pt-br":"";
---
<BaseLayout lang={lang} title={(pt?"Calculadora de fabricação":"Crafting calculator")+" | Atlantica Knowledge Hub"}
 alternatePaths={{en:"/tools/crafting/","pt-br":"/pt-br/tools/crafting/"}}>
 <main id="wiki-craft-planner" class="craft-planner" data-lang={lang}>
  <nav><a href={prefix+"/tools/"}>{pt?"← Ferramentas":"← Tools"}</a></nav>
  <p class="eyebrow">ATLANTICA GLOBAL / NA · ITEMTYPE SOURCE</p>
  <h1>{pt?"Calculadora de fabricação":"Crafting calculator"}</h1>
  <p>{pt
    ?"Calcule materiais de fabricação e dependências em múltiplos níveis usando receitas extraídas do cliente. Para equipamentos, usamos a regra confirmada: batch de 1, máximo de 20 por operação. Para outros itens, utilizamos o campo Unit do cliente ou um valor informado manualmente."
    :"Plan ingredient requirements across multiple recipe levels using extracted client recipes. Equipment uses the confirmed gameplay rule: batch size 1, maximum 20 per operation. Other items use original client Unit values or explicit manual inputs."}</p>
  <form id="craft-plan-form" class="craft-form">
   <div class="field"><label for="craft-search">{pt?"Nome do item ou ItemID":"Item name or ItemID"}</label>
    <input id="craft-search" type="search" autocomplete="off" required placeholder={pt?"Buscar itens com receita no cliente":"Search items with client recipes"} aria-controls="craft-suggestions" aria-autocomplete="list"/>
    <ul id="craft-suggestions" aria-label={pt?"Sugestões de itens":"Item suggestions"}></ul>
   </div>
   <div class="field"><label for="craft-quantity">{pt?"Quantidade desejada":"Desired output"}</label>
    <input id="craft-quantity" type="number" min="1" max="10000" value="1" step="1" required disabled/>
   </div>
   <button id="craft-submit" type="submit" disabled>{pt?"Calcular materiais":"Calculate materials"}</button>
   <div id="craft-quantity-controls" class="craft-quantity-controls" hidden>
    <div id="craft-root-variant-group" class="craft-root-setting" hidden>
     <label for="craft-root-variant">{pt?"Versão da receita":"Recipe variant"}</label>
     <select id="craft-root-variant"><option value="">{pt?"Escolha uma receita":"Choose a recipe"}</option></select>
    </div>
    <div id="craft-root-batch-group" class="craft-root-setting" hidden>
     <label for="craft-root-batch">{pt?"Unidades por batch não identificadas: informe o mínimo":"Batch size not in source: enter the minimum"}</label>
     <input id="craft-root-batch" type="number" min="1" max="10000" step="1" placeholder="1–10000"/>
    </div>
    <div id="craft-slider-group" hidden>
     <div class="craft-range-heading">
      <label for="craft-quantity-slider">{pt?"Quantidade de fabricação":"Craft quantity"}</label>
      <output id="craft-quantity-output" for="craft-quantity-slider craft-quantity">—</output>
     </div>
     <input id="craft-quantity-slider" type="range" min="1" max="10000" value="1" step="1" disabled/>
     <div class="craft-range-ends"><span id="craft-range-min">1</span><span id="craft-range-max">10.000</span></div>
    </div>
    <p id="craft-batch-hint" class="craft-muted" role="status" aria-live="polite"></p>
   </div>
  </form>
  <p id="craft-status" role="status" aria-live="polite">
   {pt?"Somente itens com receitas presentes no cliente aparecem na busca. Isso não comprova disponibilidade no servidor.":"Search shows items with recipes in the client files. This does not verify live-server availability."}
  </p>
  <section id="craft-result" hidden>
   <h2>{pt?"Plano de produção":"Production plan"}</h2>
   <p id="craft-result-note"></p>
   <div id="craft-overview" class="craft-overview" aria-live="polite">
    <div><span>{pt?"Quantidade planejada":"Planned output"}</span><strong id="craft-summary-output">—</strong></div>
    <div><span>{pt?"Batches totais":"Total batches"}</span><strong id="craft-summary-batches">—</strong></div>
    <div><span>{pt?"Operações totais":"Total operations"}</span><strong id="craft-summary-operations">—</strong></div>
    <div><span>{pt?"Materiais para comprar":"Shopping list items"}</span><strong id="craft-summary-materials">—</strong></div>
   </div>
   <section class="craft-tree-panel">
    <div class="craft-section-heading">
     <h3>{pt?"Árvore de receitas":"Crafting tree"}</h3>
     <div class="craft-tree-tools">
      <button type="button" id="craft-export-tree" class="craft-export-button">{pt?"Exportar planilha (.xlsx)":"Export spreadsheet (.xlsx)"}</button>
      <button type="button" id="craft-tree-expand">{pt?"Expandir tudo":"Expand all"}</button>
      <button type="button" id="craft-tree-collapse">{pt?"Recolher tudo":"Collapse all"}</button>
     </div>
    </div>
    <p class="craft-muted">{pt
     ?"Cores diferenciam os níveis. Necessário = consumo na receita; a fabricar = produção arredondada para batches inteiros. A divisão mostra quantas operações e quantas unidades em cada uma. Itens compartilhados não são contados duas vezes."
     :"Colors distinguish levels. Needed is recipe consumption; to produce rounds up to full batches. The split shows how many operations and units per operation. Shared items are counted once."}</p>
    <div id="craft-tree" class="craft-tree" role="region" tabindex="0" aria-label={pt?"Tabela hierárquica de fabricação":"Hierarchical crafting table"}>
     <table class="craft-tree-table">
      <thead><tr>
       <th scope="col">{pt?"Item / Receita":"Item / Recipe"}</th>
       <th scope="col">{pt?"Neste ramo":"Branch need"}</th>
       <th scope="col">{pt?"Total necessário":"Total needed"}</th>
       <th scope="col">{pt?"A fabricar":"To produce"}</th>
       <th scope="col">{pt?"Por batch":"Per batch"}</th>
       <th scope="col">{pt?"Batches":"Batches"}</th>
       <th scope="col">{pt?"Operações":"Operations"}</th>
       <th scope="col">{pt?"Divisão das operações":"Operation breakdown"}</th>
       <th scope="col">{pt?"Divisão do consumo":"Consumption breakdown"}</th>
       <th scope="col">{pt?"Ação":"Action"}</th>
      </tr></thead>
      <tbody id="craft-tree-rows"></tbody>
     </table>
    </div>
   </section>
   <div class="craft-result-grid">
    <section class="craft-table-panel craft-schedule-panel" aria-labelledby="craft-schedule-heading">
     <div class="craft-panel-heading">
      <div class="craft-panel-title">
       <p class="craft-panel-kicker">{pt?"PLANO DE PRODUÇÃO":"PRODUCTION PLAN"}</p>
       <h3 id="craft-schedule-heading">{pt?"Agenda de fabricação":"Craft schedule"}</h3>
       <p>{pt?"Batches completos e quantidade por operação, incluindo produtos intermediários.":"Whole batches and units per operation, including crafted intermediate products."}</p>
      </div>
      <div class="craft-panel-stat">
       <span>{pt?"Operações":"Operations"}</span>
       <strong id="craft-schedule-count">—</strong>
      </div>
     </div>
     <div class="table-scroll craft-data-scroll">
      <table class="craft-data-table craft-schedule-table">
       <thead><tr>
        <th scope="col">{pt?"Produto":"Product"}</th>
        <th scope="col">{pt?"Necessário":"Required"}</th>
        <th scope="col">{pt?"A fabricar":"To craft"}</th>
        <th scope="col">{pt?"Por batch":"Per batch"}</th>
        <th scope="col">{pt?"Batches":"Batches"}</th>
        <th scope="col">{pt?"Operações":"Operations"}</th>
        <th scope="col">{pt?"Limite/op.":"Limit/op."}</th>
        <th scope="col">{pt?"Divisão por operação":"Operation breakdown"}</th>
        <th scope="col">{pt?"Sobra":"Excess"}</th>
       </tr></thead><tbody id="craft-steps"></tbody>
      </table>
     </div>
     <p class="craft-panel-footnote">{pt?"Os limites de produção são aplicados individualmente em cada receita da árvore.":"Each recipe in the tree respects its own per-operation production limit."}</p>
    </section>
    <section class="craft-table-panel craft-shopping-panel" aria-labelledby="craft-shopping-heading">
     <div class="craft-panel-heading">
      <div class="craft-panel-title">
       <p class="craft-panel-kicker">{pt?"MATERIAIS CONSOLIDADOS":"CONSOLIDATED MATERIALS"}</p>
       <h3 id="craft-shopping-heading">{pt?"Lista de compras":"Shopping list"}</h3>
       <p>{pt?"Ingredientes finais somados entre todos os ramos, sem duplicações.":"Final ingredients combined across all branches without double-counting."}</p>
      </div>
      <div class="craft-tree-tools craft-shopping-actions">
       <button type="button" id="craft-copy-shopping">{pt?"Copiar lista":"Copy list"}</button>
       <button type="button" id="craft-export-shopping">{pt?"Exportar CSV":"Export CSV"}</button>
      </div>
     </div>
     <div class="table-scroll craft-data-scroll">
      <table class="craft-data-table craft-shopping-table">
       <thead><tr>
        <th scope="col">{pt?"Material":"Material"}</th>
        <th scope="col">{pt?"Quantidade":"Quantity"}</th>
        <th scope="col">{pt?"Preço unitário":"Unit price"}</th>
        <th scope="col">{pt?"Custo":"Cost"}</th>
       </tr></thead><tbody id="craft-leaves"></tbody>
      </table>
     </div>
     <div class="craft-cost-summary" aria-live="polite">
      <p id="craft-cost-total"></p>
      <span id="craft-price-coverage" class="craft-price-coverage">—</span>
     </div>
    </section>
   </div>
   <section id="craft-surplus-section" class="craft-surplus-section" hidden><h3>{pt?"Excedentes por batch":"Batch leftovers"}</h3><ul id="craft-surplus"></ul></section>
   <div id="craft-issues" aria-live="polite"></div>
  </section>
  <p class="craft-disclaimer">{pt
   ?"Os arquivos ItemType*.ndt podem conter receitas desativadas ou variantes históricas. A calculadora não inventa receitas, tamanhos de batch nem preços de mercado. Equipamentos usam batch 1 e máximo 20 por operação; outros itens usam limite de 10.000. Esses limites são regras informadas pelo jogador, não valores extraídos automaticamente."
   :"ItemType*.ndt files can contain historical or disabled recipes. No missing recipes, batch sizes or market prices are guessed. Equipment uses batch 1 and a maximum of 20 per operation; other items retain the 10,000 limit. These are player-confirmed gameplay rules, not automatically extracted source values."}</p>
 </main>
</BaseLayout>
<script>
 import {buildClientRecipeViews} from "../data/client-craft-recipe-views.mjs";
 import {CRAFT_PLAN_MAX_OUTPUT,isSourceRecipeCandidate,resolveRootCraftBatch,isAllowedCraftQuantity}
   from "../data/client-crafting-quantity.mjs";
 import {planClientCrafting,priceCraftLeaves} from "../data/client-crafting-planner.mjs";
 const root=document.getElementById("wiki-craft-planner");
 if(root){
  const pt=root.dataset.lang==="pt-br",prefix=pt?"/pt-br":"";
  const $=(id:string)=>document.getElementById(id)!;
  const query=$("craft-search") as HTMLInputElement;
  const amount=$("craft-quantity") as HTMLInputElement;
  const slider=$("craft-quantity-slider") as HTMLInputElement;
  const form=$("craft-plan-form") as HTMLFormElement;
  const submit=$("craft-submit") as HTMLButtonElement;
  const controls=$("craft-quantity-controls");
  const sliderGroup=$("craft-slider-group"),batchHint=$("craft-batch-hint");
  const rootVariantGroup=$("craft-root-variant-group"),rootBatchGroup=$("craft-root-batch-group");
  const rootVariant=$("craft-root-variant") as HTMLSelectElement;
  const rootBatch=$("craft-root-batch") as HTMLInputElement;
  const suggestions=$("craft-suggestions"),status=$("craft-status");
  const result=$("craft-result"),note=$("craft-result-note");
  const steps=$("craft-steps"),leaves=$("craft-leaves"),issues=$("craft-issues");
  const cost=$("craft-cost-total");
  const treeContainer=$("craft-tree"),treeRows=$("craft-tree-rows") as HTMLTableSectionElement;
  const surplus=$("craft-surplus"),surplusSection=$("craft-surplus-section");
  const collapsedTreePaths=new Set<string>();
  const itemCategories:Record<string,string>=Object.create(null),buyIds=new Set<string>();
  const nf=new Intl.NumberFormat(pt?"pt-BR":"en-US");
  const fmt=(n:string|number)=>nf.format(BigInt(n));
  const choices:Record<string,number>={},batchOverrides:Record<string,string>={};
  const prices:Record<string,string>={};
  const storedPriceKey="atlantica.crafting.prices.v1";
  try{
   const stored=JSON.parse(localStorage.getItem(storedPriceKey)||"{}");
   if(stored&&typeof stored==="object"&&!Array.isArray(stored)){
    for(const [id,value] of Object.entries(stored))
     if(/^[1-9]\d{0,12}$/.test(id)&&/^\d{1,20}$/.test(String(value)))
      prices[id]=String(value);
   }
  }catch{ /* Local price persistence is optional. */ }
  const detailCache=new Map<number,Promise<any>>();
  let indexPromise:Promise<Map<string,string>>|null=null;
  const craftableCandidates=new Map<string,string>();
  let selectedId="",activeGraph:Record<string,any[]>|null=null;
  let rootRecipes:any[]=[],rootConfig:any=null,selectionEpoch=0,lastValidQuantity=1;
  let plan:any=null;
  const el=(tag:string,value?:string)=>{
   const n=document.createElement(tag);if(value!==undefined)n.textContent=value;return n;
  };
  const itemLink=(id:string,title:string)=>{
   const a=el("a",title) as HTMLAnchorElement;
   a.href=prefix+"/items/database/?id="+encodeURIComponent(id);return a;
  };
  const fetchJSON=async(path:string)=>{
   const r=await fetch(path,{cache:"force-cache"});
   if(!r.ok)throw Error("Missing original item source");
   return r.json();
  };
  async function getIndex(){
   if(indexPromise)return indexPromise;
   indexPromise=(async()=>{
    const manifest=await fetchJSON("/data/client-items/manifest.json");
    if(manifest.snapshotId!==1||manifest.totalIds!==23586||manifest.namedIds!==22702||
       !Array.isArray(manifest.indexShards)||manifest.indexShards.length!==6)throw Error("Index mismatch");
    const shards=await Promise.all(manifest.indexShards.map((file:string)=>{
     if(!/^index-\d{2}\.json$/.test(file))throw Error("Unsafe item path");
     return fetchJSON("/data/client-items/"+file);
    }));
    const names=new Map<string,string>();
    for(const shard of shards){
     if(shard.snapshotId!==1||!Array.isArray(shard.rows))throw Error("Index shard mismatch");
     for(const row of shard.rows)if(row[6]==="named"){
      names.set(row[0],row[1]);
      if(typeof row[2]==="string")itemCategories[row[0]]=row[2];
      if(isSourceRecipeCandidate(row))craftableCandidates.set(row[0],row[1]);
     }
    }
    if(names.size!==22702||craftableCandidates.size===0)throw Error("Incomplete source name index");
    return names;
   })().catch(error=>{indexPromise=null;throw error;});
   return indexPromise;
  }
  async function getDetails(id:string){
   const bucket=Math.floor(Number(id)/1000);
   if(!Number.isSafeInteger(bucket)||bucket<0||bucket>=30)return null;
   if(!detailCache.has(bucket)){
    const filename=String(bucket).padStart(2,"0")+".json";
    detailCache.set(bucket,fetchJSON("/data/client-items/details/"+filename).then(d=>{
     if(d.snapshotId!==1||d.bucket!==bucket||!d.items)throw Error("Detail shard mismatch");
     return d.items;
    }).catch(e=>{detailCache.delete(bucket);throw e;}));
   }
   return (await detailCache.get(bucket))?.[id]??null;
  }
  let suggestTicket=0;
  function resetTarget(){
   ++selectionEpoch;
   selectedId="";rootRecipes=[];rootConfig=null;activeGraph=null;plan=null;
   controls.hidden=true;sliderGroup.hidden=true;slider.disabled=true;
   amount.disabled=true;submit.disabled=true;result.hidden=true;
  }
  function configureRootBatch(){
   if(!selectedId)return;
   const multiple=rootRecipes.length>1;
   rootVariantGroup.hidden=!multiple;
   const selection=multiple?choices[selectedId]:0;
   rootConfig=resolveRootCraftBatch({
    recipes:rootRecipes,category:itemCategories[selectedId],
    selectedVariant:selection,manualBatch:batchOverrides[selectedId],
   });
   rootBatchGroup.hidden=!["missing-batch","invalid-manual-batch","batch-over-limit"].includes(rootConfig.reason);
   sliderGroup.hidden=!rootConfig.ready;
   amount.disabled=!rootConfig.ready;
   slider.disabled=!rootConfig.ready;
   submit.disabled=!rootConfig.ready;
   if(rootConfig.ready){
    const {min,max,step,batch,source}=rootConfig;
    amount.min=String(min);amount.max=String(max);amount.step=String(step);
    slider.min=String(min);slider.max=String(max);slider.step=String(step);
    const previous=isAllowedCraftQuantity(amount.value,batch)?Number(amount.value):min;
    amount.value=String(previous);
    slider.value=String(previous);
    lastValidQuantity=previous;
    $("craft-range-min").textContent=fmt(min);
    $("craft-range-max").textContent=fmt(max);
    $("craft-quantity-output").textContent=fmt(previous);
    const label=source==="confirmed-equipment-rule"
     ?(pt?"Regra de equipamento confirmada":"Confirmed equipment rule")
     :source==="original-client-unit"?(pt?"Batch extraído do cliente":"Client source batch")
     :(pt?"Batch informado manualmente":"Manually specified batch");
    batchHint.textContent=label+": "+fmt(batch)+
     (pt?" unidades por batch · selecione apenas múltiplos até ":" units/batch · select multiples up to ")+
     fmt(max)+(pt?" (limite do planejamento: 10.000).":" (planning limit: 10,000).");
    status.textContent=pt?"Seleção pronta para calcular.":"Selection ready to calculate.";
   }else{
    $("craft-quantity-output").textContent="—";
    if(rootConfig.reason==="choose-variant"){
     batchHint.textContent=pt?"Selecione a versão da receita antes de informar a quantidade.":"Choose a recipe variant before setting the quantity.";
    }else if(rootConfig.reason==="missing-batch"||rootConfig.reason==="invalid-manual-batch"){
     batchHint.textContent=pt?"O cliente não informa um batch seguro. Informe o mínimo de fabricação para habilitar o slider.":"Client source has no reliable batch size. Enter the minimum crafting quantity to enable the slider.";
    }else{
     batchHint.textContent=pt?"Não existe quantidade válida até 10.000 para esta receita.":"No legal crafting quantity up to 10,000 for this source recipe.";
    }
   }
  }
  rootVariant.addEventListener("change",()=>{
   if(!selectedId)return;
   // A manual batch belongs to a specific recipe variant and must never leak.
   delete batchOverrides[selectedId];rootBatch.value="";
   if(rootVariant.value==="")delete choices[selectedId];
   else choices[selectedId]=Number(rootVariant.value);
   result.hidden=true;configureRootBatch();
  });
  rootBatch.addEventListener("input",()=>{
   if(!selectedId)return;
   const value=rootBatch.value;
   if(/^[1-9]\d{0,4}$/.test(value)&&Number(value)<=CRAFT_PLAN_MAX_OUTPUT)
    batchOverrides[selectedId]=value;
   else delete batchOverrides[selectedId];
   result.hidden=true;configureRootBatch();
  });
  async function selectCraftTarget(id:string,name:string){
   resetTarget();
   const epoch=selectionEpoch;
   ++suggestTicket;
   suggestions.replaceChildren();
   query.value=name+" (#"+id+")";
   status.textContent=pt?"Conferindo receita original…":"Checking the original client recipe…";
   try{
    await getIndex();
    if(epoch!==selectionEpoch)return;
    if(!craftableCandidates.has(id))throw Error(pt
     ?"Este item não possui receita identificada no cliente."
     :"This item has no parsed recipe in the client files.");
    const details=await getDetails(id);
    if(epoch!==selectionEpoch)return;
    const variants=details?buildClientRecipeViews(details.s):[];
    if(variants.length===0)throw Error(pt
     ?"Nenhuma receita válida identificada para este ItemID."
     :"No valid parsed source recipe for this ItemID.");
    selectedId=id;
    rootRecipes=variants;
    rootVariant.replaceChildren();
    const empty=el("option",pt?"Selecione a receita":"Select recipe") as HTMLOptionElement;
    empty.value="";rootVariant.append(empty);
    for(const [i,recipe] of variants.entries()){
     const option=el("option",(pt?"Receita ":"Recipe ")+(i+1)+
      " · #"+recipe.sourceRows.join(", #")) as HTMLOptionElement;
     option.value=String(i);rootVariant.append(option);
    }
    rootVariant.value=variants.length>1&&Number.isInteger(choices[id])?String(choices[id]):"";
    rootBatch.value=batchOverrides[id]??"";
    controls.hidden=false;
    configureRootBatch();
   }catch(error){
    if(epoch!==selectionEpoch)return;
    resetTarget();
    status.textContent=(pt?"Seleção não disponível: ":"Selection unavailable: ")+
     (error instanceof Error?error.message:String(error));
   }
  }
  async function suggest(){
   const ticket=++suggestTicket;
   suggestions.replaceChildren();
   const text=query.value.trim().toLowerCase();
   if(text.length<2)return;
   try{
    await getIndex();
    if(ticket!==suggestTicket)return;
    const matches=[...craftableCandidates].filter(([id,name])=>
     id===text||name.toLowerCase().includes(text)).slice(0,18);
    for(const [id,name] of matches){
     const li=el("li"),button=el("button",name+" (#"+id+")") as HTMLButtonElement;
     button.type="button";
     button.addEventListener("click",()=>{void selectCraftTarget(id,name);});
     li.append(button);suggestions.append(li);
    }
    if(!matches.length){
     const message=el("li",pt?"Nenhum item com receita encontrado.":"No items with parsed recipes found.");
     message.className="craft-empty-suggestion";suggestions.append(message);
    }
   }catch{
    status.textContent=pt?"Falha ao consultar índice de itens.":"Could not load the item index.";
   }
  }
  let debounce:ReturnType<typeof setTimeout>|null=null;
  query.addEventListener("input",()=>{
   resetTarget();
   if(debounce!==null)clearTimeout(debounce);
   debounce=setTimeout(()=>{void suggest();},170);
  });
  query.addEventListener("focus",()=>{if(query.value.trim().length>=2&&!selectedId)void suggest();});
  let redrawFrame=0;
  function previewQuantity(){
   if(!result.hidden&&activeGraph){
    if(redrawFrame)cancelAnimationFrame(redrawFrame);
    redrawFrame=requestAnimationFrame(()=>{redrawFrame=0;redraw();});
   }
  }
  slider.addEventListener("input",()=>{
   if(!rootConfig?.ready)return;
   amount.value=slider.value;
   lastValidQuantity=Number(slider.value);
   $("craft-quantity-output").textContent=fmt(lastValidQuantity);
   previewQuantity();
  });
  amount.addEventListener("input",()=>{
   if(!rootConfig?.ready)return;
   if(isAllowedCraftQuantity(amount.value,rootConfig.batch)){
    lastValidQuantity=Number(amount.value);
    slider.value=amount.value;
    $("craft-quantity-output").textContent=fmt(lastValidQuantity);
    previewQuantity();
   }
  });
  amount.addEventListener("change",()=>{
   if(!rootConfig?.ready)return;
   if(!isAllowedCraftQuantity(amount.value,rootConfig.batch)){
    amount.value=String(lastValidQuantity);
    status.textContent=pt
     ?"Quantidade inválida: use apenas múltiplos completos do batch, dentro do limite permitido."
     :"Invalid quantity: use exact full-batch multiples within the allowed range.";
   }
  });
  async function loadGraph(id:string){
   const names=await getIndex();
   const graph:Record<string,any[]>={};
   const seen=new Set<string>(),stack=[id];
   while(stack.length){
    const current=stack.pop()!;
    if(seen.has(current))continue;
    if(seen.size>=250)throw Error("Recipe graph exceeds 250 IDs");
    seen.add(current);
    const detail=names.has(current)?await getDetails(current):null;
    const variants=detail?buildClientRecipeViews(detail.s):[];
    graph[current]=variants;
    for(const recipe of variants)
     for(const [materialId] of recipe.materials)
      if(!seen.has(materialId))stack.push(materialId);
   }
   return graph;
  }
  function refreshCosts(){
   if(!plan)return;
   const priced=priceCraftLeaves(plan.leaves,prices);
   for(const row of priced.rows){
    const cell=leaves.querySelector<HTMLElement>('[data-cost-for="'+row.itemId+'"]');
    if(cell)cell.textContent=row.total===null?"—":fmt(row.total);
   }
   cost.textContent=(priced.complete
    ?(pt?"Custo total estimado":"Total estimated cost")
    :(pt?"Custo conhecido (parcial)":"Known cost (partial)"))+": "+fmt(priced.knownTotal);
   const coverage=$("craft-price-coverage");
   coverage.textContent=priced.complete
    ?(pt?"Todos os materiais precificados":"All materials priced")
    :fmt(priced.unpricedItems)+(pt?" sem preço":" unpriced");
   coverage.dataset.complete=String(priced.complete);
  }
  function updateCraftTreeVisibility(){
   const rows=plan?.tree as Array<any>|undefined;
   if(!rows)return;
   const ancestors:Array<{depth:number;path:string}>=[];
   for(let i=0;i<rows.length;i++){
    const row=rows[i];
    while(ancestors.length&&ancestors[ancestors.length-1].depth>=row.depth)ancestors.pop();
    const tr=treeRows.children[i] as HTMLTableRowElement|undefined;
    if(!tr)continue;
    tr.hidden=ancestors.some(parent=>collapsedTreePaths.has(parent.path));
    const toggle=tr.querySelector<HTMLButtonElement>(".craft-tree-toggle");
    if(toggle){
     const open=!collapsedTreePaths.has(row.path);
     toggle.textContent=open?"▾":"▸";
     toggle.setAttribute("aria-expanded",String(open));
    }
    if(rows[i+1]?.depth>row.depth)ancestors.push({depth:row.depth,path:row.path});
   }
  }
  function renderCraftTree(){
   if(!plan)return;
   const tree=plan.tree as Array<any>;
   const title=(id:string)=>nameCache?.get(id)??("Item #"+id);
   for(let i=0;i<tree.length;i++){
    const row=tree[i],hasChildren=tree[i+1]?.depth>row.depth;
    const tr=el("tr") as HTMLTableRowElement;
    tr.className="craft-tree-row craft-tree-depth-"+(row.depth%8);
    tr.dataset.depth=String(row.depth);
    const name=el("th") as HTMLTableCellElement;
    name.scope="row";name.className="craft-tree-name";
    const label=el("div");label.className="craft-tree-label";
    label.style.paddingLeft=String(Math.min(row.depth,14)*17+6)+"px";
    if(hasChildren){
     const toggle=el("button","▾") as HTMLButtonElement;
     toggle.type="button";toggle.className="craft-tree-toggle";
     toggle.setAttribute("aria-label",(pt?"Expandir/recolher ":"Expand/collapse ")+title(row.itemId));
     toggle.addEventListener("click",()=>{
      if(collapsedTreePaths.has(row.path))collapsedTreePaths.delete(row.path);
      else collapsedTreePaths.add(row.path);
      updateCraftTreeVisibility();
     });
     label.append(toggle);
    }else{
     const spacer=el("span");spacer.className="craft-tree-toggle-spacer";label.append(spacer);
    }
    label.append(itemLink(row.itemId,title(row.itemId)));
    if(row.sharedReference){
     const shared=el("small",pt?"Compartilhado":"Shared");
     shared.className="craft-tree-shared";
     shared.title=pt
      ?"Referência adicional ao mesmo ItemID; os totais são calculados apenas uma vez."
      :"Another reference to the same ItemID; total demand is calculated only once.";
     label.append(shared);
    }
    name.append(label);
    tr.append(name,el("td",fmt(row.branchQuantity)),el("td",fmt(row.totalRequired)));
    const produced=el("td",row.output===null?"—":fmt(row.output));
    if(row.excess!==null&&row.excess!=="0"){
     produced.append(el("small",(pt?" +":" +")+fmt(row.excess)+
      (pt?" sobra":" excess")));
    }
    tr.append(produced);
    tr.append(el("td",row.batchSize===null?"—":fmt(row.batchSize)));
    tr.append(el("td",row.totalBatches===null?"—":fmt(row.totalBatches)));
    tr.append(el("td",row.operations===null?"—":fmt(row.operations)));
    const breakdown=el("td");breakdown.className="craft-tree-breakdown";
    if(row.operationGroups?.length){
     breakdown.textContent=row.operationGroups.map((group:any)=>
      fmt(group.operations)+" × "+fmt(group.outputEach)).join(" + ");
     breakdown.title=(pt?"Unidades produzidas por operação; máximo permitido: ":"Output units per operation; maximum allowed: ")+
      fmt(row.maxOutputPerOperation);
    }else breakdown.textContent="—";
    tr.append(breakdown);
    const consumption=el("td");
    consumption.className="craft-tree-consumption";
    if(row.parentItemId!==null){
     consumption.textContent=fmt(row.unitsPerParentBatch)+" × "+
      fmt(row.parentBatches)+" = "+fmt(row.branchQuantity);
     consumption.title=(pt?"Consumido por ":"Consumed by ")+
      title(row.parentItemId)+": "+
      fmt(row.unitsPerParentBatch)+(pt?" por batch × ":" per batch × ")+
      fmt(row.parentBatches)+(pt?" batches da receita pai":" parent recipe batches");
    }else consumption.textContent="—";
    tr.append(consumption);
    const actions=el("td");actions.className="craft-tree-actions";
    if(row.itemId!==selectedId&&activeGraph?.[row.itemId]?.length){
     const purchased=buyIds.has(row.itemId);
     const toggle=el("button",purchased
      ?(pt?"Fabricar":"Craft"):(pt?"Comprar":"Buy")) as HTMLButtonElement;
     toggle.type="button";
     toggle.setAttribute("aria-label",(purchased
      ?(pt?"Fabricar ":"Craft "):(pt?"Comprar ":"Buy "))+title(row.itemId));
     toggle.addEventListener("click",()=>{
      if(purchased)buyIds.delete(row.itemId);else buyIds.add(row.itemId);
      redraw();
     });
     actions.append(toggle);
    }
    if(row.mode==="unresolved"){
     const note=el("small",pt?"Pendente":"Pending");actions.append(note);
    }
    tr.append(actions);
    treeRows.append(tr);
   }
   updateCraftTreeVisibility();
  }
  function renderLeftovers(){
   if(!plan)return;
   const title=(id:string)=>nameCache?.get(id)??("Item #"+id);
   const rows=plan.leftoverRows as Array<{itemId:string;quantity:string}>;
   surplusSection.hidden=rows.length===0;
   for(const row of rows){
    const li=el("li");
    li.append(itemLink(row.itemId,title(row.itemId)),
      el("span",fmt(row.quantity)+" "+(pt?"unidades":"units")));
    surplus.append(li);
   }
  }
  $("craft-tree-expand").addEventListener("click",()=>{
   collapsedTreePaths.clear();updateCraftTreeVisibility();
  });
  $("craft-tree-collapse").addEventListener("click",()=>{
   const rows=plan?.tree as Array<any>|undefined;
   if(!rows)return;
   for(let i=0;i<rows.length;i++)if(rows[i+1]?.depth>rows[i].depth)
    collapsedTreePaths.add(rows[i].path);
   updateCraftTreeVisibility();
  });
  function shoppingRows(){
   if(!plan)return [];
   return priceCraftLeaves(plan.leaves,prices).rows.map(row=>({
    id:row.itemId,name:nameCache?.get(row.itemId)??("Item #"+row.itemId),
    quantity:row.quantity,unitPrice:row.unitPrice??"",cost:row.total??"",
   }));
  }
  $("craft-export-tree").addEventListener("click",()=>{
   if(!plan||!selectedId)return;
   const button=$("craft-export-tree") as HTMLButtonElement;
   button.disabled=true;
   status.textContent=pt?"Preparando planilha Excel…":"Preparing Excel workbook…";
   void (async()=>{
    try{
     const {buildCraftingWorkbook}=await import("../data/client-crafting-xlsx.mjs");
     const names=Object.fromEntries(nameCache?.entries()??[]);
     const bytes=buildCraftingWorkbook({plan,names,prices,locale:pt?"pt":"en"});
     const blob=new Blob([bytes],{
      type:"application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
     });
     const href=URL.createObjectURL(blob);
     const link=el("a") as HTMLAnchorElement;
     link.href=href;
     link.download="atlantica-crafting-tree-"+selectedId+"-"+plan.requested+".xlsx";
     link.click();
     setTimeout(()=>URL.revokeObjectURL(href),2500);
     status.textContent=pt?"Planilha Excel pronta.":"Excel workbook exported.";
    }catch(error){
     status.textContent=(pt?"Falha ao exportar planilha: ":"Workbook export failed: ")+
      (error instanceof Error?error.message:String(error));
    }finally{button.disabled=false;}
   })();
  });
  $("craft-copy-shopping").addEventListener("click",()=>{
   const lines=shoppingRows().map(row=>
    row.name+" (#"+row.id+") · "+row.quantity+
    (row.cost?" · "+(pt?"custo ":"cost ")+row.cost:""));
   if(!lines.length)return;
   void navigator.clipboard.writeText(lines.join("\n")).then(()=>{
    status.textContent=pt?"Lista de compras copiada.":"Shopping list copied.";
   }).catch(()=>{
    status.textContent=pt?"Não foi possível copiar.":"Copy unavailable.";
   });
  });
  $("craft-export-shopping").addEventListener("click",()=>{
   const safe=(value:string)=>'"'+String(value).replace(/^([=+@-])/,"'$1")
    .replace(/"/g,'""')+'"';
   const csv=[["ItemID","Name","Quantity","UnitPrice","TotalCost"],
    ...shoppingRows().map(row=>[row.id,row.name,row.quantity,row.unitPrice,row.cost])]
    .map(row=>row.map(safe).join(",")).join("\r\n");
   const blob=new Blob(["\ufeff"+csv],{type:"text/csv;charset=utf-8"});
   const url=URL.createObjectURL(blob),a=el("a") as HTMLAnchorElement;
   a.href=url;a.download="atlantica-craft-shopping.csv";a.click();
   setTimeout(()=>URL.revokeObjectURL(url),1500);
  });
  function redraw(){
   if(!activeGraph||!selectedId)return;
   try{
    plan=planClientCrafting({itemId:selectedId,quantity:amount.value,
     recipesById:activeGraph,choices,batchOverrides,
     itemCategories,buyIds:[...buyIds],strictTargetBatch:true});
    steps.replaceChildren();leaves.replaceChildren();issues.replaceChildren();
    treeRows.replaceChildren();surplus.replaceChildren();
    const title=(id:string)=>nameCache?.get(id)??("Item #"+id);
    for(const step of plan.steps){
     const tr=el("tr") as HTMLTableRowElement;
     tr.className="craft-data-row"+(step.itemId===selectedId?" is-target":"");
     const name=el("th") as HTMLTableCellElement;
     name.scope="row";name.className="craft-data-product";
     name.append(itemLink(step.itemId,title(step.itemId)));
     if(step.itemId===selectedId){
      const tag=el("small",pt?"Produto final":"Target item");
      tag.className="craft-product-tag";name.append(tag);
     }else if(step.manualBatch){
      const tag=el("small",pt?"Batch manual":"Manual batch");
      tag.className="craft-product-tag";name.append(tag);
     }
     tr.append(name);
     for(const value of [step.requested,step.output,step.batchSize,step.totalBatches,
       step.operations,step.maxPerOperation]){
      const td=el("td",fmt(value));td.className="craft-data-number";tr.append(td);
     }
     const breakdown=el("td");breakdown.className="craft-data-operations";
     for(const [index,group] of step.operationGroups.entries()){
      if(index)breakdown.append(el("span","+"));
      const chip=el("span",fmt(group.operations)+" × "+fmt(group.outputEach));
      chip.className="craft-operation-chip";breakdown.append(chip);
     }
     tr.append(breakdown);
     const excess=el("td",fmt(step.excess));
     excess.className="craft-data-number"+(step.excess!=="0"?" craft-has-excess":"");
     tr.append(excess);steps.append(tr);
    }
    for(const leaf of plan.leaves){
     const tr=el("tr") as HTMLTableRowElement;
     tr.className="craft-data-row";
     const name=el("th") as HTMLTableCellElement;
     name.scope="row";name.className="craft-data-product";
     name.append(itemLink(leaf.itemId,title(leaf.itemId)));
     tr.append(name);
     const quantity=el("td",fmt(leaf.quantity));quantity.className="craft-data-number";
     tr.append(quantity);
     const priceCell=el("td");priceCell.className="craft-price-cell";
     const input=el("input") as HTMLInputElement;
     input.type="number";input.min="0";input.step="1";
     input.inputMode="numeric";input.placeholder=pt?"Informar preço":"Enter price";
     input.className="craft-price-input";input.value=prices[leaf.itemId]??"";
     input.setAttribute("aria-label",(pt?"Preço unitário ":"Unit price ")+title(leaf.itemId));
     input.addEventListener("change",()=>{
      prices[leaf.itemId]=input.value;
      try{localStorage.setItem(storedPriceKey,JSON.stringify(prices));}catch{}
      try{refreshCosts();}catch{status.textContent=pt?"Preço inválido.":"Invalid price.";}
     });
     priceCell.append(input);tr.append(priceCell);
     const totalCell=el("td","—");totalCell.dataset.costFor=leaf.itemId;
     totalCell.className="craft-data-number craft-cost-cell";
     tr.append(totalCell);leaves.append(tr);
    }
    refreshCosts();
    renderCraftTree();
    renderLeftovers();
    $("craft-summary-output").textContent=fmt(plan.rootOutput);
    $("craft-summary-batches").textContent=fmt(plan.totalBatches);
    $("craft-summary-operations").textContent=fmt(plan.totalOperations);
    $("craft-schedule-count").textContent=fmt(plan.totalOperations);
    $("craft-summary-materials").textContent=fmt(plan.leaves.length);
    note.textContent=plan.complete
      ?(pt?"Plano calculado a partir das receitas escolhidas.":"Plan calculated using the selected source recipes.")
      :(pt?"Plano parcial: verifique receitas e batches abaixo.":"Partial plan: review recipe and batch questions below.");
    for(const issue of plan.issues){
     const wrap=el("div"),heading=el("strong",title(issue.itemId)+" (#"+issue.itemId+")");
     wrap.className="craft-issue";wrap.append(heading);
     if(issue.kind==="choose-variant"){
      wrap.append(el("p",pt?"Selecione qual versão da receita utilizar:":"Choose the original recipe variant:"));
      const select=el("select") as HTMLSelectElement;
      const placeholder=el("option",pt?"Selecione uma receita":"Select a recipe") as HTMLOptionElement;
      placeholder.value="";select.append(placeholder);
      for(const [i,v] of activeGraph[issue.itemId].entries()){
       const option=el("option",(pt?"Receita ":"Recipe ")+(i+1)+" · #"+v.sourceRows.join(", #")) as HTMLOptionElement;
       option.value=String(i);select.append(option);
      }
      select.addEventListener("change",()=>{
       if(select.value!==""){choices[issue.itemId]=Number(select.value);redraw();}
      });
      wrap.append(select);
     }else if(issue.kind==="missing-batch"||issue.kind==="batch-over-limit"){
      wrap.append(el("p",pt
       ?"Tamanho de lote não confirmado ou maior que 10.000. Informe manualmente as unidades por batch (1 a 10.000)."
       :"Batch size missing or above 10,000. Supply units per batch manually (1–10,000)."));
      const input=el("input") as HTMLInputElement;
      input.type="number";input.min="1";input.max="10000";input.step="1";input.placeholder="Batch size";
      input.addEventListener("change",()=>{
       if(input.validity.valid&&Number(input.value)>0){
        batchOverrides[issue.itemId]=input.value;redraw();
       }
      });
      wrap.append(input);
     }
     issues.append(wrap);
    }
    result.hidden=false;
   }catch(error){
    status.textContent=(pt?"Não foi possível calcular: ":"Could not calculate: ")+
      (error instanceof Error?error.message:String(error));
    result.hidden=true;
   }
  }
  let nameCache:Map<string,string>|null=null;
  form.addEventListener("submit",event=>{
   event.preventDefault();
   if(!selectedId||!rootConfig?.ready){
    status.textContent=pt?"Selecione uma receita e um batch válido.":"Select a valid source recipe and batch size.";
    return;
   }
   if(!isAllowedCraftQuantity(amount.value,rootConfig.batch)){
    amount.value=String(lastValidQuantity);
    status.textContent=pt
     ?"Quantidade inválida: informe um múltiplo exato do batch até 10.000."
     :"Invalid quantity: enter an exact batch multiple up to 10,000.";
    return;
   }
   const id=selectedId,epoch=selectionEpoch;
   status.textContent=pt?"Carregando receitas e dependências…":"Loading recipe dependencies…";
   void (async()=>{
    try{
     nameCache=await getIndex();
     if(epoch!==selectionEpoch)return;
     if(!activeGraph)activeGraph=await loadGraph(id);
     if(epoch!==selectionEpoch)return;
     if(!activeGraph?.[id]?.length)throw Error(pt
      ?"Receita original indisponível."
      :"Original recipe unavailable.");
     status.textContent=pt?"Dados carregados.":"Source data loaded.";
     redraw();
    }catch(error){
     if(epoch!==selectionEpoch)return;
     status.textContent=(pt?"Falha: ":"Error: ")+
      (error instanceof Error?error.message:String(error));
     result.hidden=true;
    }
   })();
  });
  const requested=new URL(location.href).searchParams.get("id");
  if(requested&&/^[1-9]\d{0,12}$/.test(requested)){
   query.value=requested;
   void (async()=>{
    try{
     const names=await getIndex();
     if(craftableCandidates.has(requested))
      await selectCraftTarget(requested,names.get(requested)??("Item #"+requested));
     else status.textContent=pt
      ?"Este ItemID não possui receita extraída do cliente."
      :"This ItemID has no parsed source recipe.";
    }catch{
     status.textContent=pt?"Falha ao carregar a receita.":"Could not load source recipe.";
    }
   })();
  }

 }
</script>
