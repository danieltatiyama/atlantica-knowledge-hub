---
import BaseLayout from "../layouts/BaseLayout.astro";
import {craftingText} from "../i18n/crafting-ui.mjs";
import {localePrefix,localeTag,localizedPaths} from "../i18n/locales.mjs";
import type {Lang} from "../i18n/ui";
interface Props {lang:Lang;}
const {lang}=Astro.props;
const prefix=localePrefix(lang);
---
<BaseLayout lang={lang} title={(craftingText(lang,"Crafting calculator","Calculadora de fabricação"))+" | Atlantica Knowledge Hub"}
 alternatePaths={localizedPaths("/tools/crafting/")}>
 <main id="wiki-craft-planner" class="craft-planner" data-lang={lang}>
  <nav><a href={prefix+"/tools/"}>{craftingText(lang,"← Tools","← Ferramentas")}</a></nav>
  <p class="eyebrow">ATLANTICA GLOBAL / NA · ITEMTYPE SOURCE</p>
  <h1>{craftingText(lang,"Crafting calculator","Calculadora de fabricação")}</h1>
  <p>{craftingText(lang,"Plan ingredient requirements across multiple recipe levels using extracted client recipes. Equipment uses the confirmed gameplay rule: batch size 1, maximum 20 per operation. Other items use original client Unit values or explicit manual inputs.","Calcule materiais de fabricação e dependências em múltiplos níveis usando receitas extraídas do cliente. Para equipamentos, usamos a regra confirmada: batch de 1, máximo de 20 por operação. Para outros itens, utilizamos o campo Unit do cliente ou um valor informado manualmente.")}</p>
  <form id="craft-plan-form" class="craft-form">
   <div class="field"><label for="craft-search">{craftingText(lang,"Item name or ItemID","Nome do item ou ItemID")}</label>
    <input id="craft-search" type="search" autocomplete="off" required placeholder={craftingText(lang,"Search items with client recipes","Buscar itens com receita no cliente")} aria-controls="craft-suggestions" aria-autocomplete="list"/>
    <ul id="craft-suggestions" aria-label={craftingText(lang,"Item suggestions","Sugestões de itens")}></ul>
   </div>
   <div class="field"><label for="craft-quantity">{craftingText(lang,"Desired output","Quantidade desejada")}</label>
    <input id="craft-quantity" type="number" min="1" max="10000" value="1" step="1" required disabled/>
   </div>
   <button id="craft-submit" type="submit" disabled>{craftingText(lang,"Calculate materials","Calcular materiais")}</button>
   <div id="craft-quantity-controls" class="craft-quantity-controls" hidden>
    <div id="craft-root-variant-group" class="craft-root-setting" hidden>
     <label for="craft-root-variant">{craftingText(lang,"Recipe variant","Versão da receita")}</label>
     <select id="craft-root-variant"><option value="">{craftingText(lang,"Choose a recipe","Escolha uma receita")}</option></select>
    </div>
    <div id="craft-root-batch-group" class="craft-root-setting" hidden>
     <label for="craft-root-batch">{craftingText(lang,"Batch size not in source: enter the minimum","Unidades por batch não identificadas: informe o mínimo")}</label>
     <input id="craft-root-batch" type="number" min="1" max="10000" step="1" placeholder="1–10000"/>
    </div>
    <div id="craft-slider-group" hidden>
     <div class="craft-range-heading">
      <label for="craft-quantity-slider">{craftingText(lang,"Craft quantity","Quantidade de fabricação")}</label>
      <output id="craft-quantity-output" for="craft-quantity-slider craft-quantity">—</output>
     </div>
     <input id="craft-quantity-slider" type="range" min="1" max="10000" value="1" step="1" disabled/>
     <div class="craft-range-ends"><span id="craft-range-min">1</span><span id="craft-range-max">10.000</span></div>
    </div>
    <p id="craft-batch-hint" class="craft-muted" role="status" aria-live="polite"></p>
   </div>
  </form>
  <p id="craft-status" role="status" aria-live="polite">
   {craftingText(lang,"Search shows items with recipes in the client files. This does not verify live-server availability.","Somente itens com receitas presentes no cliente aparecem na busca. Isso não comprova disponibilidade no servidor.")}
  </p>
  <section id="craft-result" hidden>
   <h2>{craftingText(lang,"Production plan","Plano de produção")}</h2>
   <p id="craft-result-note"></p>
   <div id="craft-overview" class="craft-overview" aria-live="polite">
    <div><span>{craftingText(lang,"Planned output","Quantidade planejada")}</span><strong id="craft-summary-output">—</strong></div>
    <div><span>{craftingText(lang,"Total batches","Batches totais")}</span><strong id="craft-summary-batches">—</strong></div>
    <div><span>{craftingText(lang,"Total operations","Operações totais")}</span><strong id="craft-summary-operations">—</strong></div>
    <div><span>{craftingText(lang,"Shopping list items","Materiais para comprar")}</span><strong id="craft-summary-materials">—</strong></div>
   </div>
   <section class="craft-tree-panel">
    <div class="craft-section-heading">
     <h3>{craftingText(lang,"Crafting tree","Árvore de receitas")}</h3>
     <div class="craft-tree-tools">
      <button type="button" id="craft-export-tree" class="craft-export-button">{craftingText(lang,"Export spreadsheet (.xlsx)","Exportar planilha (.xlsx)")}</button>
      <button type="button" id="craft-tree-expand">{craftingText(lang,"Expand all","Expandir tudo")}</button>
      <button type="button" id="craft-tree-collapse">{craftingText(lang,"Collapse all","Recolher tudo")}</button>
     </div>
    </div>
    <p class="craft-muted">{craftingText(lang,"Colors distinguish levels. Operation breakdown shows output per operation; consumption breakdown shows ingredients used by each parent operation. Shared totals are counted once.","Cores diferenciam os níveis. A divisão de operações mostra a produção por operação; a divisão de consumo mostra quanto cada operação da receita pai gasta. Totais compartilhados não são duplicados.")}</p>
    <div id="craft-tree" class="craft-tree" role="region" tabindex="0" aria-label={craftingText(lang,"Crafting table with horizontal scrolling and column snapping","Tabela de fabricação, com rolagem horizontal e encaixe por coluna")}>
     <table class="craft-tree-table">
      <thead><tr>
       <th scope="col">{craftingText(lang,"Item / Recipe","Item / Receita")}</th>
       <th scope="col">{craftingText(lang,"Branch need","Neste ramo")}</th>
       <th scope="col">{craftingText(lang,"Total needed","Total necessário")}</th>
       <th scope="col">{craftingText(lang,"To produce","A fabricar")}</th>
       <th scope="col">{craftingText(lang,"Per batch","Por batch")}</th>
       <th scope="col">{craftingText(lang,"Batches","Batches")}</th>
       <th scope="col">{craftingText(lang,"Operations","Operações")}</th>
       <th scope="col">{craftingText(lang,"Operation breakdown","Divisão das operações")}</th>
       <th scope="col">{craftingText(lang,"Consumption breakdown","Divisão do consumo")}</th>
       <th scope="col">{craftingText(lang,"Action","Ação")}</th>
      </tr></thead>
      <tbody id="craft-tree-rows"></tbody>
     </table>
    </div>
   </section>
   <div class="craft-result-grid">
    <section class="craft-table-panel craft-schedule-panel" aria-labelledby="craft-schedule-heading">
     <div class="craft-panel-heading">
      <div class="craft-panel-title">
       <p class="craft-panel-kicker">{craftingText(lang,"PRODUCTION PLAN","PLANO DE PRODUÇÃO")}</p>
       <h3 id="craft-schedule-heading">{craftingText(lang,"Craft schedule","Agenda de fabricação")}</h3>
       <p>{craftingText(lang,"Whole batches and units per operation, including crafted intermediate products.","Batches completos e quantidade por operação, incluindo produtos intermediários.")}</p>
      </div>
      <div class="craft-panel-stat">
       <span>{craftingText(lang,"Operations","Operações")}</span>
       <strong id="craft-schedule-count">—</strong>
      </div>
     </div>
     <div class="table-scroll craft-data-scroll">
      <table class="craft-data-table craft-schedule-table">
       <thead><tr>
        <th scope="col">{craftingText(lang,"Product","Produto")}</th>
        <th scope="col">{craftingText(lang,"Required","Necessário")}</th>
        <th scope="col">{craftingText(lang,"To craft","A fabricar")}</th>
        <th scope="col">{craftingText(lang,"Per batch","Por batch")}</th>
        <th scope="col">{craftingText(lang,"Batches","Batches")}</th>
        <th scope="col">{craftingText(lang,"Operations","Operações")}</th>
        <th scope="col">{craftingText(lang,"Limit/op.","Limite/op.")}</th>
        <th scope="col">{craftingText(lang,"Operation breakdown","Divisão por operação")}</th>
        <th scope="col">{craftingText(lang,"Excess","Sobra")}</th>
       </tr></thead><tbody id="craft-steps"></tbody>
      </table>
     </div>
     <p class="craft-panel-footnote">{craftingText(lang,"Each recipe in the tree respects its own per-operation production limit.","Os limites de produção são aplicados individualmente em cada receita da árvore.")}</p>
    </section>
    <section class="craft-table-panel craft-shopping-panel" aria-labelledby="craft-shopping-heading">
     <div class="craft-panel-heading">
      <div class="craft-panel-title">
       <p class="craft-panel-kicker">{craftingText(lang,"CONSOLIDATED MATERIALS","MATERIAIS CONSOLIDADOS")}</p>
       <h3 id="craft-shopping-heading">{craftingText(lang,"Shopping list","Lista de compras")}</h3>
       <p>{craftingText(lang,"Final ingredients combined across all branches without double-counting.","Ingredientes finais somados entre todos os ramos, sem duplicações.")}</p>
      </div>
      <div class="craft-tree-tools craft-shopping-actions">
       <button type="button" id="craft-copy-shopping">{craftingText(lang,"Copy list","Copiar lista")}</button>
       <button type="button" id="craft-export-shopping">{craftingText(lang,"Export CSV","Exportar CSV")}</button>
       <button type="button" id="craft-load-npc-prices">{craftingText(lang,"Show client references","Ver referências do cliente")}</button>
       <button type="button" id="craft-apply-npc-prices" hidden>{craftingText(lang,"Fill only empty prices","Preencher somente preços vazios")}</button>
      </div>
     </div>
     <p id="craft-npc-price-caption" class="craft-npc-price-caption">
      {craftingText(lang,"Client NPC trade table prices: optional references, not verified fixed offers in the live Market. Manual prices take priority.","Preços da tabela NPC do cliente: referências opcionais. Não comprovam oferta fixa no Market atual. Os valores manuais têm prioridade.")}
     </p>
     <div class="table-scroll craft-data-scroll">
      <table class="craft-data-table craft-shopping-table">
       <thead><tr>
        <th scope="col">{craftingText(lang,"Material","Material")}</th>
        <th scope="col">{craftingText(lang,"Quantity","Quantidade")}</th>
        <th scope="col">{craftingText(lang,"Unit price","Preço unitário")}</th>
        <th scope="col">{craftingText(lang,"Cost","Custo")}</th>
       </tr></thead><tbody id="craft-leaves"></tbody>
      </table>
     </div>
     <div class="craft-cost-summary" aria-live="polite">
      <p id="craft-cost-total"></p>
      <span id="craft-price-coverage" class="craft-price-coverage">—</span>
     </div>
    </section>
   </div>
   <section id="craft-completed-section" class="craft-completed-section" hidden aria-labelledby="craft-completed-heading">
    <div class="craft-completed-heading">
     <div>
      <h3 id="craft-completed-heading">{craftingText(lang,"Completed","Concluídos")}</h3>
      <p>{craftingText(lang,"Items marked done, with their dependencies removed from pending work. Shared materials remain wherever other unfinished recipes need them.","Itens marcados como feitos, com suas dependências removidas do trabalho pendente. Materiais compartilhados continuam onde outras receitas precisam deles.")}</p>
     </div>
     <button type="button" id="craft-undo-all">{craftingText(lang,"Undo all","Desfazer todos")}</button>
    </div>
    <ul id="craft-completed-list"></ul>
   </section>
   <section id="craft-surplus-section" class="craft-surplus-section" hidden><h3>{craftingText(lang,"Batch leftovers","Excedentes por batch")}</h3><ul id="craft-surplus"></ul></section>
   <div id="craft-issues" aria-live="polite"></div>
  </section>
  <p class="craft-disclaimer">{craftingText(lang,"ItemType*.ndt may contain historical or disabled recipes. No missing recipes, batches or prices are invented. Equipment: up to 20 output units per operation. Other items: up to 10,000 output units and no more than 10,000 of each ingredient per operation. These are player-reported limits.","Os arquivos ItemType*.ndt podem conter receitas desativadas ou variantes históricas. Não inventamos receitas, batches nem preços. Equipamentos: até 20 unidades por operação. Demais itens: até 10.000 unidades produzidas e no máximo 10.000 de cada ingrediente por operação. Os limites são regras informadas pelo jogador.")}</p>
 </main>
</BaseLayout>
<script>
  import {isWikiSearchQuery} from "../data/wiki-unified-search.mjs";
  import {wikiNameAlias,matchesWikiNameAlias} from "../data/wiki-name-aliases.mjs";
  import {aliasText} from "../i18n/name-alias-ui.mjs";
 import {craftingText} from "../i18n/crafting-ui.mjs";
 import {localePrefix,localeTag} from "../i18n/locales.mjs";
 import {buildClientRecipeViews} from "../data/client-craft-recipe-views.mjs";
 import {CRAFT_PLAN_MAX_OUTPUT,isSourceRecipeCandidate,resolveRootCraftBatch,isAllowedCraftQuantity}
   from "../data/client-crafting-quantity.mjs";
 import {parseClientNPCPriceCatalog,applyMissingClientNPCPrices}
   from "../data/client-npc-price-reference.mjs";
 import {planClientCrafting,priceCraftLeaves} from "../data/client-crafting-planner.mjs";
 const root=document.getElementById("wiki-craft-planner");
 if(root){
  const lang=root.dataset.lang??"en",prefix=localePrefix(lang);
  const $=(id:string)=>document.getElementById(id)!;
  const query=$("craft-search") as HTMLInputElement;
  const amount=$("craft-quantity") as HTMLInputElement;
  const slider=$("craft-quantity-slider") as HTMLInputElement;
  const form=$("craft-plan-form") as HTMLFormElement;
  const submit=$("craft-submit") as HTMLButtonElement;
  const controls=$("craft-quantity-controls");
  const sliderGroup=$("craft-slider-group"),batchHint=$("craft-batch-hint");
  const rootVariantGroup=$("craft-root-variant-group"),rootBatchGroup=$("craft-root-batch-group");
  const rootVariant=$("craft-root-variant") as HTMLSelectElement;
  const rootBatch=$("craft-root-batch") as HTMLInputElement;
  const suggestions=$("craft-suggestions"),status=$("craft-status");
  const result=$("craft-result"),note=$("craft-result-note");
  const steps=$("craft-steps"),leaves=$("craft-leaves"),issues=$("craft-issues");
  const cost=$("craft-cost-total");
  const treeContainer=$("craft-tree"),treeRows=$("craft-tree-rows") as HTMLTableSectionElement;
  const surplus=$("craft-surplus"),surplusSection=$("craft-surplus-section");
  const completedSection=$("craft-completed-section"),completedList=$("craft-completed-list");
  const collapsedTreePaths=new Set<string>();
  // Keep the snap offset aligned with the actual frozen Item / Recipe column.
  // The table can grow wider than its minimum width on large screens.
  if("ResizeObserver" in window){
   const frozenHeader=treeContainer.querySelector<HTMLElement>(
    ".craft-tree-table thead th:first-child"
   );
   if(frozenHeader){
    const observer=new ResizeObserver(entries=>{
     const width=entries[0]?.borderBoxSize?.[0]?.inlineSize??
      frozenHeader.getBoundingClientRect().width;
     if(width>0)treeContainer.style.setProperty("--craft-frozen-width",
      Math.ceil(width)+"px");
    });
    observer.observe(frozenHeader);
   }
  }
  const itemCategories:Record<string,string>=Object.create(null),buyIds=new Set<string>();
  const doneIds=new Set<string>();
  const nf=new Intl.NumberFormat(lang==="en"?"en-US":localeTag(lang));
  const fmt=(n:string|number)=>nf.format(BigInt(n));
  const choices:Record<string,number>={},batchOverrides:Record<string,string>={};
  const prices:Record<string,string>={};
  const priceOrigins:Record<string,string>={};
  const storedPriceKey="atlantica.crafting.prices.v1";
  const priceOriginsKey="atlantica.crafting.priceOrigins.v1";
  let clientNPCPriceMap:Map<string,string>|null=null;
  const savePriceState=()=>{
   try{
    localStorage.setItem(storedPriceKey,JSON.stringify(prices));
    localStorage.setItem(priceOriginsKey,JSON.stringify(priceOrigins));
   }catch{ /* Local storage is optional. */ }
  };
  try{
   const stored=JSON.parse(localStorage.getItem(storedPriceKey)||"{}");
   if(stored&&typeof stored==="object"&&!Array.isArray(stored)){
    for(const [id,value] of Object.entries(stored))
     if(/^[1-9]\d{0,12}$/.test(id)&&/^\d{1,20}$/.test(String(value)))
      prices[id]=String(value);
   }
  }catch{ /* Local price persistence is optional. */ }
  try{
   const savedOrigins=JSON.parse(localStorage.getItem(priceOriginsKey)||"{}");
   if(savedOrigins&&typeof savedOrigins==="object"&&!Array.isArray(savedOrigins)){
    for(const [id,origin] of Object.entries(savedOrigins))
     if(/^[1-9]\d{0,12}$/.test(id)&&origin==="client-npc-catalog"&&prices[id])
      priceOrigins[id]="client-npc-catalog";
   }
  }catch{ /* Origin metadata is optional. */ }
  const detailCache=new Map<number,Promise<any>>();
  let indexPromise:Promise<Map<string,string>>|null=null;
  const craftableCandidates=new Map<string,string>();
  let selectedId="",activeGraph:Record<string,any[]>|null=null;
  let rootRecipes:any[]=[],rootConfig:any=null,selectionEpoch=0,lastValidQuantity=1;
  let plan:any=null;
  const el=(tag:string,value?:string)=>{
   const n=document.createElement(tag);if(value!==undefined)n.textContent=value;return n;
  };
  const itemLink=(id:string,title:string)=>{
   const a=el("a",title) as HTMLAnchorElement;
   a.href=prefix+"/items/database/?id="+encodeURIComponent(id);
   const alias=wikiNameAlias("item",id,title,lang);
   if(alias)a.append(el("small"," · "+aliasText(lang,"Wiki translation (unofficial)")+": "+alias));
   return a;
  };
  const fetchJSON=async(path:string)=>{
   const r=await fetch(path,{cache:"force-cache"});
   if(!r.ok)throw Error("Missing original item source");
   return r.json();
  };
  async function getIndex(){
   if(indexPromise)return indexPromise;
   indexPromise=(async()=>{
    const manifest=await fetchJSON("/data/client-items/manifest.json");
    if(manifest.snapshotId!==1||manifest.totalIds!==23586||manifest.namedIds!==22702||
       !Array.isArray(manifest.indexShards)||manifest.indexShards.length!==6)throw Error("Index mismatch");
    const shards=await Promise.all(manifest.indexShards.map((file:string)=>{
     if(!/^index-\d{2}\.json$/.test(file))throw Error("Unsafe item path");
     return fetchJSON("/data/client-items/"+file);
    }));
    const names=new Map<string,string>();
    for(const shard of shards){
     if(shard.snapshotId!==1||!Array.isArray(shard.rows))throw Error("Index shard mismatch");
     for(const row of shard.rows)if(row[6]==="named"){
      names.set(row[0],row[1]);
      if(typeof row[2]==="string")itemCategories[row[0]]=row[2];
      if(isSourceRecipeCandidate(row))craftableCandidates.set(row[0],row[1]);
     }
    }
    if(names.size!==22702||craftableCandidates.size===0)throw Error("Incomplete source name index");
    return names;
   })().catch(error=>{indexPromise=null;throw error;});
   return indexPromise;
  }
  async function getDetails(id:string){
   const bucket=Math.floor(Number(id)/1000);
   if(!Number.isSafeInteger(bucket)||bucket<0||bucket>=30)return null;
   if(!detailCache.has(bucket)){
    const filename=String(bucket).padStart(2,"0")+".json";
    detailCache.set(bucket,fetchJSON("/data/client-items/details/"+filename).then(d=>{
     if(d.snapshotId!==1||d.bucket!==bucket||!d.items)throw Error("Detail shard mismatch");
     return d.items;
    }).catch(e=>{detailCache.delete(bucket);throw e;}));
   }
   return (await detailCache.get(bucket))?.[id]??null;
  }
  let suggestTicket=0;
  function resetTarget(){
   ++selectionEpoch;
   selectedId="";rootRecipes=[];rootConfig=null;activeGraph=null;plan=null;
   doneIds.clear();buyIds.clear();collapsedTreePaths.clear();
   controls.hidden=true;sliderGroup.hidden=true;slider.disabled=true;
   amount.disabled=true;submit.disabled=true;result.hidden=true;
  }
  function configureRootBatch(){
   if(!selectedId)return;
   const multiple=rootRecipes.length>1;
   rootVariantGroup.hidden=!multiple;
   const selection=multiple?choices[selectedId]:0;
   rootConfig=resolveRootCraftBatch({
    recipes:rootRecipes,category:itemCategories[selectedId],
    selectedVariant:selection,manualBatch:batchOverrides[selectedId],
   });
   rootBatchGroup.hidden=!["missing-batch","invalid-manual-batch","batch-over-limit"].includes(rootConfig.reason);
   sliderGroup.hidden=!rootConfig.ready;
   amount.disabled=!rootConfig.ready;
   slider.disabled=!rootConfig.ready;
   submit.disabled=!rootConfig.ready;
   if(rootConfig.ready){
    const {min,max,step,batch,source}=rootConfig;
    amount.min=String(min);amount.max=String(max);amount.step=String(step);
    slider.min=String(min);slider.max=String(max);slider.step=String(step);
    const previous=isAllowedCraftQuantity(amount.value,batch)?Number(amount.value):min;
    amount.value=String(previous);
    slider.value=String(previous);
    lastValidQuantity=previous;
    $("craft-range-min").textContent=fmt(min);
    $("craft-range-max").textContent=fmt(max);
    $("craft-quantity-output").textContent=fmt(previous);
    const label=source==="confirmed-equipment-rule"
     ?(craftingText(lang,"Confirmed equipment rule","Regra de equipamento confirmada"))
     :source==="original-client-unit"?(craftingText(lang,"Client source batch","Batch extraído do cliente"))
     :(craftingText(lang,"Manually specified batch","Batch informado manualmente"));
    batchHint.textContent=label+": "+fmt(batch)+
     (craftingText(lang," units/batch · select multiples up to "," unidades por batch · selecione apenas múltiplos até "))+
     fmt(max)+(craftingText(lang," (planning limit: 10,000)."," (limite do planejamento: 10.000)."));
    status.textContent=craftingText(lang,"Selection ready to calculate.","Seleção pronta para calcular.");
   }else{
    $("craft-quantity-output").textContent="—";
    if(rootConfig.reason==="choose-variant"){
     batchHint.textContent=craftingText(lang,"Choose a recipe variant before setting the quantity.","Selecione a versão da receita antes de informar a quantidade.");
    }else if(rootConfig.reason==="missing-batch"||rootConfig.reason==="invalid-manual-batch"){
     batchHint.textContent=craftingText(lang,"Client source has no reliable batch size. Enter the minimum crafting quantity to enable the slider.","O cliente não informa um batch seguro. Informe o mínimo de fabricação para habilitar o slider.");
    }else{
     batchHint.textContent=craftingText(lang,"No legal crafting quantity up to 10,000 for this source recipe.","Não existe quantidade válida até 10.000 para esta receita.");
    }
   }
  }
  rootVariant.addEventListener("change",()=>{
   if(!selectedId)return;
   // A manual batch belongs to a specific recipe variant and must never leak.
   delete batchOverrides[selectedId];rootBatch.value="";
   if(rootVariant.value==="")delete choices[selectedId];
   else choices[selectedId]=Number(rootVariant.value);
   result.hidden=true;configureRootBatch();
  });
  rootBatch.addEventListener("input",()=>{
   if(!selectedId)return;
   const value=rootBatch.value;
   if(/^[1-9]\d{0,4}$/.test(value)&&Number(value)<=CRAFT_PLAN_MAX_OUTPUT)
    batchOverrides[selectedId]=value;
   else delete batchOverrides[selectedId];
   result.hidden=true;configureRootBatch();
  });
  async function selectCraftTarget(id:string,name:string){
   resetTarget();
   const epoch=selectionEpoch;
   ++suggestTicket;
   suggestions.replaceChildren();
   query.value=name+" (#"+id+")";
   status.textContent=craftingText(lang,"Checking the original client recipe…","Conferindo receita original…");
   try{
    await getIndex();
    if(epoch!==selectionEpoch)return;
    if(!craftableCandidates.has(id))throw Error(craftingText(lang,"This item has no parsed recipe in the client files.","Este item não possui receita identificada no cliente."));
    const details=await getDetails(id);
    if(epoch!==selectionEpoch)return;
    const variants=details?buildClientRecipeViews(details.s):[];
    if(variants.length===0)throw Error(craftingText(lang,"No valid parsed source recipe for this ItemID.","Nenhuma receita válida identificada para este ItemID."));
    selectedId=id;
    rootRecipes=variants;
    rootVariant.replaceChildren();
    const empty=el("option",craftingText(lang,"Select recipe","Selecione a receita")) as HTMLOptionElement;
    empty.value="";rootVariant.append(empty);
    for(const [i,recipe] of variants.entries()){
     const option=el("option",(craftingText(lang,"Recipe ","Receita "))+(i+1)+
      " · #"+recipe.sourceRows.join(", #")) as HTMLOptionElement;
     option.value=String(i);rootVariant.append(option);
    }
    rootVariant.value=variants.length>1&&Number.isInteger(choices[id])?String(choices[id]):"";
    rootBatch.value=batchOverrides[id]??"";
    controls.hidden=false;
    configureRootBatch();
   }catch(error){
    if(epoch!==selectionEpoch)return;
    resetTarget();
    status.textContent=(craftingText(lang,"Selection unavailable: ","Seleção não disponível: "))+
     (error instanceof Error?error.message:String(error));
   }
  }
  async function suggest(){
   const ticket=++suggestTicket;
   suggestions.replaceChildren();
   const text=query.value.trim().toLowerCase();
   if(!isWikiSearchQuery(text))return;
   try{
    await getIndex();
    if(ticket!==suggestTicket)return;
    const matches=[...craftableCandidates].filter(([id,name])=>
     id===text||name.toLowerCase().includes(text)||matchesWikiNameAlias("item",id,name,lang,text)).slice(0,18);
    for(const [id,name] of matches){
     const li=el("li"),button=el("button",name+" (#"+id+")") as HTMLButtonElement;
     button.type="button";
     const alias=wikiNameAlias("item",id,name,lang);
     if(alias)button.append(el("small"," · "+aliasText(lang,"Wiki translation (unofficial)")+": "+alias));
     button.addEventListener("click",()=>{void selectCraftTarget(id,name);});
     li.append(button);suggestions.append(li);
    }
    if(!matches.length){
     const message=el("li",craftingText(lang,"No items with parsed recipes found.","Nenhum item com receita encontrado."));
     message.className="craft-empty-suggestion";suggestions.append(message);
    }
   }catch{
    status.textContent=craftingText(lang,"Could not load the item index.","Falha ao consultar índice de itens.");
   }
  }
