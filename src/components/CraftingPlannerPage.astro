     consumption.textContent=(row.consumptionGroups??[]).map((group:any)=>
      fmt(group.operations)+" × "+fmt(group.consumedEach)).join(" + ")||"—";
     consumption.title=(craftingText(lang,"Consumption per operation of ","Consumo por operação de "))+
      title(row.parentItemId)+": "+
