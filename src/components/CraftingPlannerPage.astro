   left:0;right:0;max-height:240px;overflow:auto;background:var(--color-surface);
   border:1px solid var(--color-border)}
 #craft-suggestions:empty{display:none}
 #craft-suggestions button{display:block;width:100%;text-align:left;padding:8px;cursor:pointer;
   border:0;background:transparent;color:var(--color-text);font:inherit}
 #craft-suggestions button:is(:hover,:focus-visible){background:var(--color-background)}
 h2,h3{color:var(--color-gold-light)}
 .craft-result-grid{display:grid;gap:24px}
 .table-scroll{overflow:auto;border:1px solid var(--color-border);border-radius:5px}
 table{border-collapse:collapse;width:100%;min-width:580px}
 th,td{padding:9px 12px;border-bottom:1px solid var(--color-border);text-align:left;font-size:.85rem}
 th{background:var(--color-surface);color:var(--color-gold-light)}td a{color:var(--color-accent)}
 td input{max-width:140px;padding:7px}td small{color:var(--color-text-muted)}
 #craft-cost-total{font-weight:600}
 .craft-issue{border-left:3px solid var(--color-bronze);margin:12px 0;padding:12px;
   background:var(--color-surface)}
 .craft-issue p{color:var(--color-text-muted)}
 .craft-issue :is(select,input){width:min(400px,100%)}
 .craft-disclaimer{border-top:1px solid var(--color-border);padding-top:18px;font-size:.84rem}
 @media(max-width:740px){.craft-form{grid-template-columns:minmax(0,1fr)}}
</style>
