    name.scope="row";name.className="craft-tree-name";
    const label=el("div");label.className="craft-tree-label";
    label.style.paddingLeft=String(Math.min(row.depth,14)*17+6)+"px";
    if(hasChildren){
     const toggle=el("button","▾") as HTMLButtonElement;
     toggle.type="button";toggle.className="craft-tree-toggle";
     toggle.setAttribute("aria-label",(craftingText(lang,"Expand/collapse ","Expandir/recolher "))+title(row.itemId));
     toggle.addEventListener("click",()=>{
      if(collapsedTreePaths.has(row.path))collapsedTreePaths.delete(row.path);
