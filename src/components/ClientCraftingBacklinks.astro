---
interface Props {lang:"en"|"pt-br"; itemId:string;}
const {lang,itemId}=Astro.props;
const pt=lang==="pt-br";
const prefix=pt?"/pt-br":"";
---
<section class="craft-backlinks" data-item-id={itemId} data-prefix={prefix} data-lang={lang} aria-label={pt?"Uso do item em fabricação":"Used in crafting"}>
  <h2>{pt?"Usado em fabricação":"Used in crafting"}</h2>
  <p class="craft-caution">{pt
    ?"Relações invertidas dos materiais decodificados em ItemType*.ndt. São definições dos arquivos do cliente, não receitas confirmadas como disponíveis no servidor."
    :"Reverse links from decoded ItemType*.ndt source material lists. These are client file definitions, not recipes confirmed available on the live server."}</p>
  <p class="craft-backlinks-status" role="status">{pt?"Consultando referências de material…":"Checking material references…"}</p>
  <div class="craft-backlinks-table" hidden>
    <div class="craft-scroll"><table>
      <thead><tr><th>{pt?"Item fabricado":"Crafted item"}</th>
        <th>{pt?"Quantidade utilizada":"Quantity used"}</th>
        <th>{pt?"Registro de origem":"Source evidence"}</th></tr></thead>
      <tbody></tbody>
    </table></div>
  </div>
</section>
<script>
  const wrappers=document.querySelectorAll<HTMLElement>(".craft-backlinks");
  for(const section of wrappers){
    const id=section.dataset.itemId??"";
    const pt=section.dataset.lang==="pt-br",prefix=section.dataset.prefix??"";
    const info=section.querySelector<HTMLElement>(".craft-backlinks-status")!;
    const table=section.querySelector<HTMLElement>(".craft-backlinks-table")!;
    const tbody=section.querySelector<HTMLTableSectionElement>("tbody")!;
    async function load(){
      if(!/^[1-9]\d{0,12}$/.test(id))return;
      try{
        const manifestResp=await fetch("/data/client-items/crafting/manifest.json");
        if(!manifestResp.ok)throw Error("Craft manifest missing");
        const meta=await manifestResp.json();
        if(meta.dataset!=="client-item-crafting-backlinks"||meta.snapshotId!==1||
          meta.itemIndexIds!==23586||meta.namedItemIds!==22702||
          !Array.isArray(meta.files))throw Error("Craft manifest mismatch");
        const filename="used-by-"+String(Math.floor(Number(id)/1000)).padStart(2,"0")+".json";
        if(!meta.files.includes(filename)){
          info.textContent=pt
            ?"Nenhuma utilização decodificada para este item neste snapshot."
            :"No decoded usage for this item in the available client snapshot.";
          return;
        }
        const response=await fetch("/data/client-items/crafting/"+filename);
        if(!response.ok)throw Error("Craft source shard missing");
        const data=await response.json();
        if(data.schemaVersion!=="1.0"||data.snapshotId!==1||
          data.bucket!==Math.floor(Number(id)/1000))throw Error("Craft shard mismatch");
        const rows=data.items?.[id]??[];
        if(!Array.isArray(rows)||!rows.length){
          info.textContent=pt
            ?"Nenhuma utilização decodificada para este item neste snapshot."
            :"No decoded usage for this item in the available client snapshot.";
          return;
        }
        for(const row of rows){
          const [productId,name,quantity,records]=row;
          if(!/^[1-9]\d*$/.test(productId)||typeof name!=="string"||
            !Number.isSafeInteger(quantity)||quantity<1||!Array.isArray(records))
            throw Error("Malformed reverse recipe evidence");
          const tr=document.createElement("tr"),link=document.createElement("a");
          link.textContent=name;link.href=prefix+"/items/database/?id="+encodeURIComponent(productId);
          const itemTd=document.createElement("td");itemTd.append(link);
          itemTd.append(document.createTextNode(" (#"+productId+")"));
          const quantityTd=document.createElement("td");
          quantityTd.textContent=new Intl.NumberFormat(pt?"pt-BR":"en-US").format(quantity);
          const sourceTd=document.createElement("td");
          sourceTd.textContent=records.map(n=>"#"+n).join(", ");
          tr.append(itemTd,quantityTd,sourceTd);tbody.append(tr);
        }
        table.hidden=false;
        info.textContent=(pt?"Referências de receitas encontradas: ":"Recipe references found: ")+rows.length;
      }catch{
        info.textContent=pt
          ?"Não foi possível carregar as referências de fabricação."
          :"Could not load the original craft references.";
      }
    }
    void load();
  }
</script>
<style>
  .craft-backlinks{margin:30px 0;border:1px solid var(--color-border);border-radius:5px;padding:16px}
  .craft-backlinks h2{font-size:1.45rem;margin:0 0 8px;color:var(--color-gold-light)}
  .craft-caution,.craft-backlinks-status{color:var(--color-text-muted);font-size:.89rem;line-height:1.6}
  .craft-scroll{overflow-x:auto;border:1px solid var(--color-border);border-radius:4px}
  table{width:100%;border-collapse:collapse;min-width:570px}
  th,td{padding:10px 12px;border-bottom:1px solid var(--color-border);text-align:left}
  th{color:var(--color-gold-light);background:#29271f}
  td a{color:var(--color-accent)}
  .craft-backlinks-table[hidden]{display:none}
</style>
