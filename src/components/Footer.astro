
---
import {sharedText} from "../i18n/shared-ui.mjs";
import {getLangFromUrl} from "../i18n/utils";
const lang=getLangFromUrl(Astro.url);
const currentYear = new Date().getFullYear();
---

<footer>
  <p>
    Atlantica Knowledge Hub — {sharedText(lang,"Community Project")}
  </p>
  <p class="copyright">
    © {currentYear} Atlantica Knowledge Hub.
    {sharedText(lang,"Unofficial community resource.")}
  </p>
</footer>


<style>
  footer {
    padding: 25px;
    border-top: 1px solid var(--color-border);
    text-align: center;
    color: var(--color-text-muted);
  }

  .copyright {
    font-size: 0.8rem;
    opacity: 0.7;
  }
</style>
