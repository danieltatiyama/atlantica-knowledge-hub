---
import BaseLayout from "../layouts/BaseLayout.astro";
import { render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import type { Lang } from "../i18n/ui";
import { useTranslations } from "../i18n/utils";

interface Props {
  guide: CollectionEntry<"guides">;
  lang: Lang;
}

const { guide, lang } = Astro.props;
const t = useTranslations(lang);

const { Content, headings } = await render(guide);

const tableOfContents = headings.filter(
  (heading) => heading.depth === 2 || heading.depth === 3
);

const updatedAt = guide.data.updatedAt.toLocaleDateString(
  lang === "pt-br" ? "pt-BR" : "en-US",
  {
    year: "numeric",
    month: "long",
    day: "numeric",
    timeZone: "UTC",
  }
);

const homeHref = lang === "en" ? "/" : `/${lang}/`;
const guidesHref = lang === "en" ? "/guides/" : `/${lang}/guides/`;

const categoryLabels: Record<string, string> = {
  "nation-dungeons": t("guides.categoryNationDungeons"),
  "mercenaries": t("guides.categoryMercenaries"),
  "game-systems": t("guides.categoryGameSystems"),
};
---


<BaseLayout
  title={`${guide.data.title} | Atlantica Knowledge Hub`}
  description={guide.data.description}
  lang={lang}
>
  <main class="container">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href={homeHref}>{t("nav.home")}</a>
      <span>/</span>
      <a href={guidesHref}>{t("nav.guides")}</a>
      <span>/</span>
      <span aria-current="page">{guide.data.title}</span>
    </nav>

    <article class="article">
      <header class="article-header">
        <p class="eyebrow">
          {categoryLabels[guide.data.category] ?? guide.data.category}
        </p>

        <h1>{guide.data.title}</h1>

        <p class="description">
          {guide.data.description}
        </p>

        <p class="updated">
          {t("article.updated")}: {updatedAt}
        </p>
      </header>

      <div class="article-layout">
        <div class="article-body">
          <Content />
        </div>

        {tableOfContents.length > 0 && (
          <aside class="article-sidebar">
            <nav class="table-of-contents" aria-label={t("article.toc")}>
              <p class="toc-title">{t("article.toc")}</p>

              <ul>
                {tableOfContents.map((heading) => (
                  <li
                    class:list={{
                      "toc-nested": heading.depth === 3,
                    }}
                  >
                    <a href={`#${heading.slug}`}>
                      {heading.text}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          </aside>
        )}
      </div>

      <a href={guidesHref} class="back-link">
        ← {t("guides.back")}
      </a>
    </article>
  </main>
</BaseLayout>

<style>
  .container {
    width: min(var(--content-width), 90%);
    margin: 0 auto;
  }

  .breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    padding-top: 30px;
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .breadcrumbs a {
    text-decoration: none;
  }

  .breadcrumbs a:hover {
    color: var(--color-accent);
  }


  .article {
    max-width: 1100px;
    margin: 0 auto;
    padding: 50px 0 80px;
  }

  .article-header {
    max-width: 800px;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 28px;
    margin-bottom: 35px;
  }

  .eyebrow {
    color: var(--color-accent);
    text-transform: uppercase;
    font-size: 0.8rem;
    letter-spacing: 2px;
  }

  h1 {
    font-size: clamp(2rem, 5vw, 3.2rem);
    line-height: 1.2;
    margin: 15px 0;
  }

  .description {
    color: var(--color-text-muted);
    font-size: 1.1rem;
  }

  .updated {
    color: var(--color-text-muted);
    font-size: 0.85rem;
  }

  :global(.article-body h2) {
    margin-top: 36px;
    margin-bottom: 12px;
    font-size: 1.6rem;
    color: var(--color-text);
  }

  :global(.article-body h3) {
    margin-top: 28px;
    color: var(--color-text);
  }

  :global(.article-body p),
  :global(.article-body li) {
    color: var(--color-text-muted);
  }

  :global(.article-body a) {
    color: var(--color-accent);
  }

  :global(.article-body img) {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
  }

  :global(.article-body code) {
    overflow-wrap: anywhere;
  }

  .back-link {
    display: inline-block;
    margin-top: 50px;
    color: var(--color-accent);
    text-decoration: none;
  }

  .back-link:hover {
    text-decoration: underline;
  }

  @media (max-width: 700px) {
    .article {
      padding: 30px 0 50px;
    }
  }
    
  /* ==========================================
    Atlantica Classic - Article Navigation
    ========================================== */

  .article-layout {
    display: grid;
    grid-template-columns: minmax(0, 800px) minmax(180px, 220px);
    gap: 48px;
    align-items: start;
  }

  .article-body {
    min-width: 0;
    font-size: 1rem;
    line-height: 1.8;
  }
    
  .article-sidebar {
    position: sticky;
    top: 24px;
    align-self: start;
    min-width: 0;

    max-height: calc(100dvh - 48px);
    overflow-y: auto;
  }


  .table-of-contents {
    padding: 20px;
    border: 1px solid var(--color-border);
    border-radius: 5px;

    background: var(--color-surface);
  }

  .toc-title {
    margin: 0 0 16px;

    font-family: var(--font-heading);
    font-size: 1.1rem;
    color: var(--color-gold-light);
  }

  .table-of-contents ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .table-of-contents li {
    margin-bottom: 12px;
  }

  .table-of-contents li:last-child {
    margin-bottom: 0;
  }

  .table-of-contents a {
    display: block;
    color: var(--color-text-muted);
    text-decoration: none;
    font-size: 0.9rem;
    line-height: 1.4;
    overflow-wrap: anywhere;

    transition: color 0.2s ease;
  }

  .table-of-contents a:hover,
  .table-of-contents a:focus-visible {
    color: var(--color-accent);
  }

  .toc-nested {
    padding-left: 16px;
    border-left: 1px solid var(--color-border);
  }

  /* Improve anchor navigation */

  :global(.article-body h2),
  :global(.article-body h3) {
    scroll-margin-top: 24px;
  }

  /* Responsive layout */

  @media (max-width: 850px) {
    .article-layout {
      display: flex;
      flex-direction: column;
      gap: 24px;
    }

    .article-sidebar {
      order: -1;
      width: 100%;
    }

    .table-of-contents {
      position: static;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .table-of-contents a {
      transition: none;
    }
  }

  /* Active Table of Contents Item */

  .table-of-contents a.is-active {
    color: var(--color-gold-light);
    font-weight: 700;
    padding-left: 10px;
    border-left: 2px solid var(--color-accent);
    background: rgba(210, 164, 91, 0.06);
  }

  .table-of-contents a {
    transition:
      color 0.2s ease,
      background-color 0.2s ease;
  }

  @media (prefers-reduced-motion: reduce) {
    .table-of-contents a {
      transition: none;
    }
  }
  
  /* ==========================================
    Atlantica Classic - Markdown Content
    ========================================== */

  /* Tables */
  
  :global(.article-body table) {
    display: table;
    width: 100%;
    min-width: 440px;

    margin: 0;
    border: 1px solid var(--color-border);
    border-radius: 5px;

    border-spacing: 0;
    border-collapse: separate;
  }

  :global(.article-body .table-scroll) {
    width: 100%;
    max-width: 100%;
    margin: 24px 0;
    overflow-x: auto;
    border-radius: 5px;
  }


  :global(.article-body th),
  :global(.article-body td) {
    padding: 12px 16px;
    text-align: left;
    border-right: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    font-size: 0.95rem;
  }

  :global(.article-body th) {
    background: #29271f;
    color: var(--color-gold-light);
    font-weight: 600;
  }

  :global(.article-body td) {
    color: var(--color-text-muted);
  }

  :global(.article-body tr:nth-child(even)) {
    background: rgba(210, 164, 91, 0.04);
  }

  :global(.article-body tr:last-child td) {
    border-bottom: none;
  }

  :global(.article-body th:last-child),
  :global(.article-body td:last-child) {
    border-right: none;
  }

  /* Blockquotes and notes */

  :global(.article-body blockquote) {
    margin: 28px 0;
    padding: 16px 22px;

    border-left: 3px solid var(--color-accent);

    background: rgba(210, 164, 91, 0.07);

    color: var(--color-parchment);
    border-radius: 0 5px 5px 0;
  }

  :global(.article-body blockquote p) {
    margin: 0;
    color: var(--color-parchment);
  }

  :global(.article-body blockquote p + p) {
    margin-top: 12px;
  }

  /* Code blocks */

  :global(.article-body pre) {
    max-width: 100%;
    margin: 24px 0;
    padding: 18px 22px;

    overflow-x: auto;

    border: 1px solid var(--color-border);
    border-radius: 5px;

    font-size: 0.9rem;
    line-height: 1.6;
    box-shadow: inset 0 0 16px rgba(0, 0, 0, 0.2);
  }

  /* Inline code */

  :global(.article-body :not(pre) > code) {
    padding: 2px 6px;
    border: 1px solid var(--color-border);
    border-radius: 3px;

    background: rgba(210, 164, 91, 0.09);
    color: var(--color-gold-light);

    font-size: 0.9em;
    overflow-wrap: anywhere;
  }

  /* Images */

  :global(.article-body img) {
    display: block;
    max-width: 100%;
    height: auto;

    margin: 28px auto;
    border: 1px solid var(--color-border);
    border-radius: 5px;
  }

  /* Dividers */

  :global(.article-body hr) {
    border: 0;
    height: 1px;
    margin: 36px 0;

    background: linear-gradient(
      90deg,
      transparent,
      var(--color-bronze),
      transparent
    );
  }

  /* Lists */

  :global(.article-body ul),
  :global(.article-body ol) {
    padding-left: 26px;
    margin: 18px 0 24px;
  }

  :global(.article-body li) {
    padding-left: 4px;
    margin-bottom: 7px;
  }

  :global(.article-body li::marker) {
    color: var(--color-accent);
  }

</style>

<script>
  const tocLinks = Array.from(
    document.querySelectorAll<HTMLAnchorElement>(
      '.table-of-contents a[href^="#"]'
    )
  );

  const tocEntries = tocLinks.flatMap((link) => {
    const id = decodeURIComponent(link.hash.slice(1));
    const heading = document.getElementById(id);

    return heading ? [{ link, heading }] : [];
  });

  function updateActiveToc() {
    if (tocEntries.length === 0) return;

    const offset = 150;
    let activeId = tocEntries[0].heading.id;

    for (const entry of tocEntries) {
      if (entry.heading.getBoundingClientRect().top <= offset) {
        activeId = entry.heading.id;
      } else {
        break;
      }
    }

    tocEntries.forEach(({ link, heading }) => {
      const active = heading.id === activeId;

      link.classList.toggle("is-active", active);

      if (active) {
        link.setAttribute("aria-current", "location");
      } else {
        link.removeAttribute("aria-current");
      }
    });
  }

  let animationFrame = 0;

  function scheduleUpdate() {
    if (animationFrame) return;

    animationFrame = window.requestAnimationFrame(() => {
      animationFrame = 0;
      updateActiveToc();
    });
  }

  window.addEventListener("scroll", scheduleUpdate, {
    passive: true,
  });

  window.addEventListener("resize", scheduleUpdate);
  window.addEventListener("hashchange", scheduleUpdate);
  window.addEventListener("load", scheduleUpdate);

  scheduleUpdate();
  
  document
    .querySelectorAll<HTMLTableElement>(".article-body table")
    .forEach((table) => {
      if (table.parentElement?.classList.contains("table-scroll")) {
        return;
      }

      const wrapper = document.createElement("div");
      wrapper.className = "table-scroll";

      table.before(wrapper);
      wrapper.appendChild(table);
    });

</script>
