---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import type { Lang } from "../i18n/ui";
import { useTranslations } from "../i18n/utils";
import { GUIDE_SUBCATEGORIES } from "../data/guide-taxonomy";

interface Props {
  guide: CollectionEntry<"guides">;
  lang: Lang;
}

const { guide, lang } = Astro.props;
const t = useTranslations(lang);

const { Content } = await render(guide);

const updatedAt = guide.data.updatedAt.toLocaleDateString(
  lang === "pt-br" ? "pt-BR" : "en-US",
  {
    year: "numeric",
    month: "long",
    day: "numeric",
    timeZone: "UTC",
  }
);

const homeHref = lang === "en" ? "/" : `/${lang}/`;
const guidesHref = lang === "en" ? "/guides/" : `/${lang}/guides/`;
const categoryHref =
  `${guidesHref}?category=${encodeURIComponent(guide.data.category)}`;


const subcategoryInfo = guide.data.subcategory
  ? GUIDE_SUBCATEGORIES[guide.data.subcategory]
  : null;

const subcategoryHref =
  guide.data.subcategory
    ? `${categoryHref}&subcategory=${encodeURIComponent(guide.data.subcategory)}`
    : null;


const categoryLabels: Record<string, string> = {
  "nation-dungeons": t("guides.categoryNationDungeons"),
  "mercenaries": t("guides.categoryMercenaries"),
  "game-systems": t("guides.categoryGameSystems"),
};


const translations = await getCollection(
  "guides",
  ({ data }) =>
    !data.draft &&
    data.translationKey === guide.data.translationKey &&
    (data.lang === "en" || data.lang === "pt-br")
);

const alternatePaths: Partial<Record<Lang, string>> = {};

if (translations.length > 1) {
  for (const translation of translations) {
    const translationLang = translation.data.lang;

    if (
      translationLang !== "en" &&
      translationLang !== "pt-br"
    ) {
      continue;
    }

    const slug = translation.id.replace(/^[^/]+\//, "");

    const prefix =
      translationLang === "en"
        ? ""
        : `/${translationLang}`;

    alternatePaths[translationLang] =
      `${prefix}/guides/${slug}/`;
  }
}


const categoryGuides = await getCollection(
  "guides",
  ({ data }) =>
    !data.draft &&
    data.lang === lang &&
    data.category === guide.data.category
);

// Alphabetical navigation within the same language and category.
const navigableGuides = [...categoryGuides].sort(
  (a, b) =>
    a.data.title.localeCompare(
      b.data.title,
      lang === "pt-br" ? "pt-BR" : "en"
    ) || a.id.localeCompare(b.id)
);

const currentGuideIndex = navigableGuides.findIndex(
  (entry) => entry.id === guide.id
);

const previousGuide =
  currentGuideIndex > 0
    ? navigableGuides[currentGuideIndex - 1]
    : null;

const nextGuide =
  currentGuideIndex >= 0 &&
  currentGuideIndex < navigableGuides.length - 1
    ? navigableGuides[currentGuideIndex + 1]
    : null;

// Related guides remain sorted by most recently updated.
const relatedGuides = categoryGuides
  .filter(
    (entry) =>
      entry.id !== guide.id &&
      entry.id !== previousGuide?.id &&
      entry.id !== nextGuide?.id
  )
  .sort(
    (a, b) =>
      b.data.updatedAt.getTime() -
      a.data.updatedAt.getTime()
  )
  .slice(0, 3);



---
<BaseLayout
  title={`${guide.data.title} | Atlantica Knowledge Hub`}
  description={guide.data.description}
  lang={lang}
  alternatePaths={alternatePaths}
>
  <main class="container" data-wiki-nav-root="true">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href={homeHref}>{t("nav.home")}</a>
      <span>/</span>
      <a href={guidesHref}>{t("nav.guides")}</a>
      <span>/</span>
      <a href={categoryHref}>
        {categoryLabels[guide.data.category] ?? guide.data.category}
      </a>
      <span>/</span>
      {subcategoryInfo && subcategoryHref && (
        <>
          <a href={subcategoryHref}>
            {subcategoryInfo.labels[lang]}
          </a>
          <span>/</span>
        </>
      )}
      <span aria-current="page">{guide.data.title}</span>
    </nav>

    <article class="article">
      <header class="article-header">
        <p class="eyebrow">
          <a href={categoryHref}>
            {categoryLabels[guide.data.category] ?? guide.data.category}
          </a>
        </p>

        {subcategoryInfo && subcategoryHref && (
          <p class="article-subcategory">
            <a href={subcategoryHref}>
              {subcategoryInfo.labels[lang]}
            </a>
          </p>
        )}

        <h1>{guide.data.title}</h1>

        <p class="description">
          {guide.data.description}
        </p>

        <p class="updated">
          {t("article.updated")}: {updatedAt}
        </p>
      </header>

      <div class="article-layout">
        <div class="article-body">
          <Content />
        </div>

        {/* The reusable floating navigator replaces the duplicate article sidebar. */}
      </div>

      {(previousGuide || nextGuide) && (
        <nav
          class="article-navigation"
          aria-label={t("article.navigation")}
        >
          {previousGuide && (
            <a
              class="article-nav-link article-nav-link--previous"
              href={`${guidesHref}${previousGuide.id.replace(/^[^/]+\//, "")}/`}
            >
              <span class="article-nav-label">
                ← {t("article.previousGuide")}
              </span>
              <strong>{previousGuide.data.title}</strong>
            </a>
          )}

          {nextGuide && (
            <a
              class="article-nav-link article-nav-link--next"
              href={`${guidesHref}${nextGuide.id.replace(/^[^/]+\//, "")}/`}
            >
              <span class="article-nav-label">
                {t("article.nextGuide")} →
              </span>
              <strong>{nextGuide.data.title}</strong>
            </a>
          )}
        </nav>
      )}


      {relatedGuides.length > 0 && (
        <section
          class="related-guides"
          aria-labelledby="related-guides-title"
        >
          <h2 id="related-guides-title">
            {t("article.relatedGuides")}
          </h2>

          <div class="related-guides-grid">
            {relatedGuides.map((related) => {
              const slug = related.id.replace(/^[^/]+\//, "");
              const href = `${lang === "en" ? "" : `/${lang}`}/guides/${slug}/`;

              return (
                <article class="related-guide">
                  <p class="related-guide-category">
                    {categoryLabels[related.data.category]}
                  </p>

                  <h3>
                    <a href={href}>
                      {related.data.title}
                    </a>
                  </h3>

                  <p class="related-guide-description">
                    {related.data.description}
                  </p>
                </article>
              );
            })}
          </div>
        </section>
      )}

      <a href={guidesHref} class="back-link">
        ← {t("guides.back")}
      </a>
    </article>
  </main>
</BaseLayout>

<style>
  .container {
    width: min(var(--content-width), 90%);
    margin: 0 auto;
  }

  .breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    padding-top: 30px;
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .breadcrumbs a {
    text-decoration: none;
  }

  .breadcrumbs a:hover {
    color: var(--color-accent);
  }


  .article {
    width: 100%;
    max-width: var(--content-width);
    margin: 0 auto;
    padding: 50px 0 80px;
  }

  .article-header {
    max-width: 960px;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 28px;
    margin-bottom: 35px;
  }

  .eyebrow {
    color: var(--color-accent);
    text-transform: uppercase;
    font-size: 0.8rem;
    letter-spacing: 2px;
  }

  h1 {
    font-size: clamp(2rem, 5vw, 3.2rem);
    line-height: 1.2;
    margin: 15px 0;
  }

  .description {
    color: var(--color-text-muted);
    font-size: 1.1rem;
  }

  .updated {
    color: var(--color-text-muted);
    font-size: 0.85rem;
  }

  :global(.article-body h2) {
    margin-top: 36px;
    margin-bottom: 12px;
    font-size: 1.6rem;
    color: var(--color-text);
  }

  :global(.article-body h3) {
    margin-top: 28px;
    color: var(--color-text);
  }

  :global(.article-body p),
  :global(.article-body li) {
    color: var(--color-text-muted);
  }

  :global(.article-body a) {
    color: var(--color-accent);
  }

  :global(.article-body img) {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
  }

  :global(.article-body code) {
    overflow-wrap: anywhere;
  }

  .back-link {
    display: inline-block;
    margin-top: 50px;
    color: var(--color-accent);
    text-decoration: none;
  }

  .back-link:hover {
    text-decoration: underline;
  }

  @media (max-width: 700px) {
    .article {
      padding: 30px 0 50px;
    }
  }
    
  /* ==========================================
    Atlantica Classic - Article Navigation
    ========================================== */

  .article-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(24px, 3vw, 40px);
    align-items: start;
  }

  .article-body {
    min-width: 0;
    font-size: 1rem;
    line-height: 1.8;
  }
    
  /* Heading navigation is managed by the shared floating wiki index.
     The article itself uses the entire available readable column. */
  :global(.article-body h2),
  :global(.article-body h3){
    scroll-margin-top:24px;
  }

  /* ==========================================
    Atlantica Classic - Markdown Content
    ========================================== */

  /* Tables */
  
  :global(.article-body table) {
    display: table;
    width: 100%;
    min-width: 440px;

    margin: 0;
    border: 1px solid var(--color-border);
    border-radius: 5px;

    border-spacing: 0;
    border-collapse: separate;
  }

  :global(.article-body .table-scroll) {
    width: 100%;
    max-width: 100%;
    margin: 24px 0;
    overflow-x: auto;
    border-radius: 5px;
  }


  :global(.article-body th),
  :global(.article-body td) {
    padding: 12px 16px;
    text-align: left;
    border-right: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    font-size: 0.95rem;
  }

  :global(.article-body th) {
    background: #29271f;
    color: var(--color-gold-light);
    font-weight: 600;
  }

  :global(.article-body td) {
    color: var(--color-text-muted);
  }

  :global(.article-body tr:nth-child(even)) {
    background: rgba(210, 164, 91, 0.04);
  }

  :global(.article-body tr:last-child td) {
    border-bottom: none;
  }

  :global(.article-body th:last-child),
  :global(.article-body td:last-child) {
    border-right: none;
  }

  /* Blockquotes and notes */

  :global(.article-body blockquote) {
    margin: 28px 0;
    padding: 16px 22px;

    border-left: 3px solid var(--color-accent);

    background: rgba(210, 164, 91, 0.07);

    color: var(--color-parchment);
    border-radius: 0 5px 5px 0;
  }

  :global(.article-body blockquote p) {
    margin: 0;
    color: var(--color-parchment);
  }

  :global(.article-body blockquote p + p) {
    margin-top: 12px;
  }

  /* Code blocks */

  :global(.article-body pre) {
    max-width: 100%;
    margin: 24px 0;
    padding: 18px 22px;

    overflow-x: auto;

    border: 1px solid var(--color-border);
    border-radius: 5px;

    font-size: 0.9rem;
    line-height: 1.6;
    box-shadow: inset 0 0 16px rgba(0, 0, 0, 0.2);
  }

  /* Inline code */

  :global(.article-body :not(pre) > code) {
    padding: 2px 6px;
    border: 1px solid var(--color-border);
    border-radius: 3px;

    background: rgba(210, 164, 91, 0.09);
    color: var(--color-gold-light);

    font-size: 0.9em;
    overflow-wrap: anywhere;
  }

  /* Images */

  :global(.article-body img) {
    display: block;
    max-width: 100%;
    height: auto;

    margin: 28px auto;
    border: 1px solid var(--color-border);
    border-radius: 5px;
  }

  /* Dividers */

  :global(.article-body hr) {
    border: 0;
    height: 1px;
    margin: 36px 0;

    background: linear-gradient(
      90deg,
      transparent,
      var(--color-bronze),
      transparent
    );
  }

  /* Lists */

  :global(.article-body ul),
  :global(.article-body ol) {
    padding-left: 26px;
    margin: 18px 0 24px;
  }

  :global(.article-body li) {
    padding-left: 4px;
    margin-bottom: 7px;
  }

  :global(.article-body li::marker) {
    color: var(--color-accent);
  }

  /* Article image sizing */

  :global(.article-body img.article-image--small) {
    width: 240px;
  }

  :global(.article-body img.article-image--medium) {
    width: 420px;
  }

  :global(.article-body img.article-image--large) {
    width: 680px;
  }

  :global(.article-body img.article-image--full) {
    width: 100%;
  }

  /* Article image alignment */

  :global(.article-body img.article-image--left) {
    margin-left: 0;
    margin-right: auto;
  }

  :global(.article-body img.article-image--center) {
    margin-left: auto;
    margin-right: auto;
  }

  :global(.article-body img.article-image--right) {
    margin-left: auto;
    margin-right: 0;
  }
  
  /* Responsive embedded videos */

  :global(.article-body .article-video) {
    width: 100%;
    max-width: 800px;
    aspect-ratio: 16 / 9;
    margin: 32px auto;

    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    background: #141820;
  }

  :global(.article-body .article-video iframe) {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  /* Embedded video sizing */

  :global(.article-body .article-video.article-video--small) {
    max-width: 320px;
  }

  :global(.article-body .article-video.article-video--medium) {
    max-width: 480px;
  }

  :global(.article-body .article-video.article-video--large) {
    max-width: 680px;
  }

  :global(.article-body .article-video.article-video--full) {
    max-width: 100%;
  }

  /* Embedded video alignment */

  :global(.article-body .article-video.article-video--left) {
    margin-left: 0;
    margin-right: auto;
  }

  :global(.article-body .article-video.article-video--center) {
    margin-left: auto;
    margin-right: auto;
  }

  :global(.article-body .article-video.article-video--right) {
    margin-left: auto;
    margin-right: 0;
  }

  /* Image and GIF captions */

  :global(.article-body .article-figure) {
    width: fit-content;
    max-width: 100%;
    margin: 28px auto;
  }

  :global(.article-body .article-figure > img) {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
    margin: 0;
  }

  :global(.article-body .article-figure figcaption) {
    margin-top: 8px;
    color: var(--color-text-muted);
    font-size: 0.85rem;
    line-height: 1.5;
    text-align: center;
    overflow-wrap: anywhere;
  }

  /* Figure sizing */

  :global(.article-body .article-figure--small) {
    width: min(240px, 100%);
  }

  :global(.article-body .article-figure--medium) {
    width: min(420px, 100%);
  }

  :global(.article-body .article-figure--large) {
    width: min(680px, 100%);
  }

  :global(.article-body .article-figure--full) {
    width: 100%;
  }

  /* Figure alignment */

  :global(.article-body .article-figure--left) {
    margin-left: 0;
    margin-right: auto;
  }

  :global(.article-body .article-figure--center) {
    margin-left: auto;
    margin-right: auto;
  }

  :global(.article-body .article-figure--right) {
    margin-left: auto;
    margin-right: 0;
  }
    
  /* Video captions */

  :global(.article-body .article-video-figure) {
    width: min(800px, 100%);
    max-width: 100%;
    margin: 32px auto;
  }

  :global(.article-body .article-video-figure .article-video) {
    width: 100%;
    max-width: 100%;
    margin: 0;
  }

  :global(.article-body .article-video-figure figcaption) {
    margin-top: 8px;
    color: var(--color-text-muted);
    font-size: 0.85rem;
    line-height: 1.5;
    text-align: center;
    overflow-wrap: anywhere;
  }

  /* Captioned video sizes */

  :global(.article-body .article-video-figure--small) {
    width: min(320px, 100%);
  }

  :global(.article-body .article-video-figure--medium) {
    width: min(480px, 100%);
  }

  :global(.article-body .article-video-figure--large) {
    width: min(680px, 100%);
  }

  :global(.article-body .article-video-figure--full) {
    width: 100%;
  }

  /* Captioned video alignment */

  :global(.article-body .article-video-figure--left) {
    margin-left: 0;
    margin-right: auto;
  }

  :global(.article-body .article-video-figure--center) {
    margin-left: auto;
    margin-right: auto;
  }

  :global(.article-body .article-video-figure--right) {
    margin-left: auto;
    margin-right: 0;
  }

  /* Related guides */

  .related-guides {
    margin-top: 56px;
    padding-top: 28px;
    border-top: 1px solid var(--color-border);
  }

  .related-guides > h2 {
    margin: 0 0 20px;
    color: var(--color-gold-light);
    font-size: 1.5rem;
  }

  .related-guides-grid {
    display: grid;
    grid-template-columns:
      repeat(auto-fill, minmax(min(100%, 240px), 1fr));
    gap: 16px;
  }

  .related-guide {
    padding: 22px;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    background: var(--color-surface);
  }

  .related-guide-category {
    margin: 0 0 12px;
    color: var(--color-accent);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .related-guide h3 {
    margin: 0 0 10px;
    font-size: 1.1rem;
    line-height: 1.4;
  }

  .related-guide h3 a {
    color: var(--color-text);
    text-decoration: none;
  }

  .related-guide h3 a:hover,
  .related-guide h3 a:focus-visible {
    color: var(--color-accent);
    text-decoration: underline;
  }

  .related-guide-description {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .eyebrow a {
    color: inherit;
    text-decoration: none;
  }

  .eyebrow a:hover,
  .eyebrow a:focus-visible {
    text-decoration: underline;
  }

  /* Previous and next guide navigation */

  .article-navigation {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    margin-top: 48px;
  }

  .article-nav-link {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
    padding: 20px 24px;

    border: 1px solid var(--color-border);
    border-radius: 6px;
    background: var(--color-surface);
    color: var(--color-text);
    text-decoration: none;

    transition: border-color 0.2s ease;
  }

  .article-nav-link:hover,
  .article-nav-link:focus-visible {
    border-color: var(--color-accent);
  }

  .article-nav-link--next {
    grid-column: 2;
    text-align: right;
  }

  .article-nav-label {
    color: var(--color-accent);
    font-size: 0.8rem;
  }

  .article-nav-link strong {
    font-size: 1rem;
    line-height: 1.4;
    overflow-wrap: anywhere;
  }

  @media (max-width: 600px) {
    .article-navigation {
      grid-template-columns: 1fr;
    }

    .article-nav-link--next {
      grid-column: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .article-nav-link {
      transition: none;
    }
  }

  /* Article subcategory */

  .article-subcategory {
    margin: 6px 0 18px;
    font-size: 0.9rem;
  }

  .article-subcategory a {
    color: var(--color-accent);
    text-decoration: none;
  }

  .article-subcategory a:hover,
  .article-subcategory a:focus-visible {
    text-decoration: underline;
  }

</style>

<script>
  // The site-wide floating navigator owns section navigation.
  document
    .querySelectorAll<HTMLTableElement>(".article-body table")
    .forEach((table) => {
      if (table.parentElement?.classList.contains("table-scroll")) {
        return;
      }

      const wrapper = document.createElement("div");
      wrapper.className = "table-scroll";

      table.before(wrapper);
      wrapper.appendChild(table);
    });

</script>
