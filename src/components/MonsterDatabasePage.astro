---
import BaseLayout from "../layouts/BaseLayout.astro";
import MonsterDropItemSearch from "./MonsterDropItemSearch.astro";
interface Props{lang:"en"|"pt-br";}
const {lang}=Astro.props;
const pt=lang==="pt-br",prefix=pt?"/pt-br":"";
const title=pt?"Criaturas e fontes de drops do cliente":"Client creatures and drop sources";
---
<BaseLayout lang={lang} title={title+" | Atlantica Knowledge Hub"}
  description={pt?"Navegação por registros originais de criaturas, drops diretos e drops por grupos no cliente.":"Source-based creature catalog with original direct and grouped item drop references."}
  alternatePaths={{en:"/monsters/", "pt-br":"/pt-br/monsters/"}}>
  <main class="creature-db" id="creature-db" data-lang={lang} data-wiki-nav-root="true">
    <nav class="breadcrumb"><a href={prefix+"/"}>{pt?"← Início":"← Home"}</a></nav>
    <header class="bestiary-header">
      <div class="bestiary-heading">
        <div class="bestiary-crest" aria-hidden="true"><span>✥</span></div>
        <div>
          <p class="eyebrow">ATLANTICA GLOBAL / NA · {pt?"BESTIÁRIO DO CLIENTE":"CLIENT BESTIARY"}</p>
          <h1>{title}</h1>
          <p class="bestiary-description">{pt
            ?"Explore criaturas, itens e relações de drops identificados na extração original do cliente."
            :"Discover creatures, items and original game-client loot relationships."}</p>
        </div>
      </div>
      <div class="bestiary-stats" aria-label={pt?"Cobertura da base":"Source database coverage"}>
        <div><strong>4.351</strong><span>{pt?"IDs de criaturas/personagens":"Character IDs"}</span></div>
        <div><strong>9.959</strong><span>{pt?"Drops diretos":"Direct source drops"}</span></div>
        <div><strong>822</strong><span>{pt?"Itens com drops por nível":"Items with level-matched drops"}</span></div>
      </div>
      <p class="bestiary-description">{pt
        ?"Nem todo registro representa um monstro enfrentável. As informações foram extraídas dos arquivos do cliente e não comprovam disponibilidade no servidor atual."
        :"Not every client record represents a fightable monster. Client files do not establish current live-server availability."}</p>
      <p class="warning">{pt
        ?"Drops filtrados pela faixa de nível registrada no cliente. Percentuais estimados para drops de grupo combinam as duas taxas brutas, mas NÃO são chances comprovadas no servidor atual."
        :"Possible drops are filtered by the original client level bracket. Estimated grouped rates combine two raw fields, but are NOT verified live-server probabilities."}</p>
    </header>
    <MonsterDropItemSearch lang={lang}/>
    <section class="browse" aria-label={pt?"Pesquisar criaturas":"Search creatures"}>
      <div class="bestiary-section-head">
        <span class="section-ornament" aria-hidden="true">✦</span>
        <div>
          <p class="eyebrow">{pt?"ARQUIVO DE CRIATURAS":"CREATURE ARCHIVE"}</p>
          <h2>{pt?"Consultar pelo monstro":"Browse by creature"}</h2>
        </div>
      </div>
      <div class="filters">
        <label>{pt?"Nome original ou CharID":"Original name or CharID"}
          <input id="creature-query" type="search" autocomplete="off"
            placeholder={pt?"Pesquise por nome ou ID":"Search by name or ID"} disabled/>
        </label>
        <label>{pt?"Tipo original":"Raw entity category"}
          <select id="creature-kind" disabled>
            <option value="">{pt?"Todas as categorias":"All source categories"}</option>
          </select>
        </label>
        <label>{pt?"Nível mínimo do cliente":"Minimum source level"}
          <input id="creature-level" type="number" min="0" step="1"
            placeholder={pt?"Qualquer":"Any"} disabled/>
        </label>
        <label>{pt?"Tipo de referência":"Loot references"}
          <select id="creature-loot-mode" disabled>
            <option value="">{pt?"Todas as criaturas":"All creatures"}</option>
            <option value="with">{pt?"Com possíveis drops":"With possible drops"}</option>
            <option value="none">{pt?"Sem drops identificados":"No matched drops"}</option>
            <option value="unresolved">{pt?"Com registros inconclusivos":"With unresolved records"}</option>
          </select>
        </label>
      </div>
      <p class="subtle" id="creature-status" role="status">{pt
        ?"Verificando se os registros originais de monstros já foram publicados…"
        :"Checking whether the original creature and loot records have been published…"}</p>
      <div class="creature-table-scroll" id="creature-list" hidden>
        <table>
          <thead><tr>
            <th>{pt?"Nome original em inglês":"Original English name"}</th>
            <th>CharID</th>
            <th>{pt?"Tipo do cliente":"Client category"}</th>
            <th>{pt?"Nível bruto":"Raw level"}</th>
            <th>{pt?"Itens possíveis":"Possible item rows"}</th>
          </tr></thead>
          <tbody id="creature-rows"></tbody>
        </table>
      </div>
      <div class="paging" id="creature-paging" hidden>
        <button id="creature-prev" type="button" disabled>{pt?"Anterior":"Previous"}</button>
        <span id="creature-pages"></span>
        <button id="creature-next" type="button" disabled>{pt?"Próxima":"Next"}</button>
      </div>
    </section>
    <section id="creature-detail" class="creature-detail" hidden>
      <div class="detail-header">
        <h2 id="creature-detail-name"></h2>
        <button type="button" id="creature-close">{pt?"Fechar":"Close"}</button>
      </div>
      <p id="creature-detail-meta" class="subtle"></p>
      <div class="creature-facts" aria-label={pt?"Valores originais registrados":"Original recorded source values"}>
        <div><span>CharID</span><strong id="creature-fact-id">—</strong></div>
        <div><span>{pt?"Nível bruto":"Raw level"}</span><strong id="creature-fact-level">—</strong></div>
        <div><span>{pt?"Itens possíveis":"Possible items"}</span><strong id="creature-fact-direct">—</strong></div>
        <div><span>{pt?"Fontes inconclusivas":"Unresolved sources"}</span><strong id="creature-fact-groups">—</strong></div>
      </div>
      <div id="creature-details"></div>
    </section>
  </main>
</BaseLayout>
<script>
  import {formatLevelResolvedPercent,resolveClientCreatureDrops} from "../data/client-monster-drop-resolver.mjs";
  const root=document.querySelector<HTMLElement>("#creature-db");
  if(root){
    const pt=root.dataset.lang==="pt-br",prefix=pt?"/pt-br":"";
    const $=<T extends HTMLElement>(id:string)=>document.getElementById(id) as T;
    const query=$<HTMLInputElement>("creature-query");
    const kind=$<HTMLSelectElement>("creature-kind");
    const level=$<HTMLInputElement>("creature-level");
    const lootMode=$<HTMLSelectElement>("creature-loot-mode");
    const status=$<HTMLElement>("creature-status");
    const list=$<HTMLElement>("creature-list");
    const rowsEl=$<HTMLTableSectionElement>("creature-rows");
    const pageNav=$<HTMLElement>("creature-paging");
    const prev=$<HTMLButtonElement>("creature-prev");
    const next=$<HTMLButtonElement>("creature-next");
    const pages=$<HTMLElement>("creature-pages");
    const detail=$<HTMLElement>("creature-detail");
    const detailName=$<HTMLElement>("creature-detail-name");
    const detailMeta=$<HTMLElement>("creature-detail-meta");
    const factId=$<HTMLElement>("creature-fact-id");
    const factLevel=$<HTMLElement>("creature-fact-level");
    const factDirect=$<HTMLElement>("creature-fact-direct");
    const factGroups=$<HTMLElement>("creature-fact-groups");
    const detailBody=$<HTMLElement>("creature-details");
    const close=$<HTMLButtonElement>("creature-close");
    const nf=new Intl.NumberFormat(pt?"pt-BR":"en-US");
    const raw=(v:unknown)=>v===null||v===undefined?"—":String(v);
    const node=(tag:string,value?:string,cls?:string)=>{
      const n=document.createElement(tag);
      if(value!==undefined)n.textContent=value;
      if(cls)n.className=cls;
      return n;
    };
    const cell=(row:HTMLTableRowElement,text:string)=>{
      const td=node("td",text);row.append(td);return td;
    };
    const itemLink=(id:string,name:string|null)=>{
      const a=node("a",name??("Item #"+id)) as HTMLAnchorElement;
      a.href=prefix+"/items/database/?id="+encodeURIComponent(id);
      return a;
    };
    let manifest:any=null,all:any[]=[],visible:any[]=[],page=0;
    const possibleByCreature=new Map<string,[number,number]>();
    const perPage=100;
    const shardCache=new Map<string,Promise<any>>();
    const loadShard=(filename:string)=>{
      if(!shardCache.has(filename)){
        shardCache.set(filename,fetch("/data/client-monsters/"+filename)
          .then(r=>{if(!r.ok)throw Error("Missing original source shard");return r.json();})
          .then(data=>{
            if(data.schemaVersion!=="1.0"||data.snapshotId!==1)
              throw Error("Source shard snapshot mismatch");
            return data;
          }).catch(err=>{shardCache.delete(filename);throw err;}));
      }
      return shardCache.get(filename)!;
    };
    function findFile(group:string,id:string){
      const filename=group+"/"+String(Math.floor(Number(id)/1000)).padStart(2,"0")+".json";
      return manifest.files[group]?.includes(filename)?filename:null;
    }
    function render(){
      rowsEl.replaceChildren();
      const first=page*perPage;
      for(const [id,name,rawLevel,rawKind] of visible.slice(first,first+perPage)){
        const tr=node("tr") as HTMLTableRowElement;
        const firstCell=cell(tr,""),a=node("a",name??("CharID "+id)) as HTMLAnchorElement;
        a.href="?id="+encodeURIComponent(id);
        a.addEventListener("click",e=>{
          if(e.ctrlKey||e.metaKey||e.shiftKey||e.altKey)return;
          e.preventDefault();void openCreature(id,true);
        });
        firstCell.append(a);
        cell(tr,id);cell(tr,raw(rawKind));cell(tr,raw(rawLevel));
        const possible=possibleByCreature.get(id);
        cell(tr,possible?nf.format(possible[0]):"—");
        rowsEl.append(tr);
      }
      const total=Math.ceil(visible.length/perPage);
      prev.disabled=page<1;next.disabled=page>=total-1;
      pages.textContent=(pt?"Página ":"Page ")+(total?page+1:0)+"/"+total;
      status.textContent=nf.format(visible.length)+" / "+nf.format(all.length)+
        (pt?" registros de criaturas do cliente":" original client creature IDs");
    }
    function applyFilters(){
      const q=query.value.toLocaleLowerCase().trim(),k=kind.value,rawMin=level.value;
      const minimum=rawMin!==""?Number(rawMin):null;
      const links=lootMode.value;
      visible=all.filter(r=>
        (!q||r[0].includes(q)||(r[1]??"").toLocaleLowerCase().includes(q))&&
        (!k||r[3]===k)&&
        (minimum===null||(r[2]!==null&&Number.isFinite(Number(r[2]))&&Number(r[2])>=minimum))&&
        (!links||(links==="with"?(possibleByCreature.get(r[0])?.[0]??0)>0:
          links==="unresolved"?(possibleByCreature.get(r[0])?.[1]??0)>0:
          (possibleByCreature.get(r[0])?.[0]??0)===0)));
      page=0;render();
    }
    function table(columns:string[],records:(string|number|null)[][]){
      const wrap=node("div",undefined,"creature-table-scroll");
      const tbl=node("table"),thead=node("thead"),h=node("tr"),tbody=node("tbody");
      for(const name of columns)h.append(node("th",name));
      thead.append(h);tbl.append(thead);
      for(const cells of records){
        const tr=node("tr");
        for(const value of cells)cell(tr,raw(value));
        tbody.append(tr);
      }
      tbl.append(tbody);wrap.append(tbl);return wrap;
    }
    function appendItemTable(container:HTMLElement,entries:any[]){
      // Show the player what the selected-level source records indicate.
      // Raw GroupID, Band, Slot and original row IDs stay in View source.
      const tableNode=node("table"),head=node("thead"),h=node("tr"),body=node("tbody");
      const headers=[pt?"Item possível":"Possible item",
        pt?"Taxa estimada":"Estimated rate",
        pt?"Quantidade":"Amount",
        pt?"Origem dos dados":"Source evidence"];
      for(const label of headers)h.append(node("th",label));
      head.append(h);tableNode.append(head);
      for(const source of entries){
        const tr=node("tr"),first=node("td");
        first.append(itemLink(source.itemId,source.name));
        first.append(node("small","Item ID "+source.itemId,"client-source-id"));
        tr.append(first);
        const percent=node("td",undefined,"client-rate");
        percent.append(node("strong",formatLevelResolvedPercent(source.estimatedPercent,pt?"pt-br":"en")));
        tr.append(percent);
        tr.append(node("td",raw(source.min)+"–"+raw(source.max),"client-amount"));
        const technical=node("td"),audit=node("details",undefined,"client-record-row");
        audit.append(node("summary",pt?"Ver origem":"View source"));
        const dl=node("dl");
        const fields=source.kind==="direct"
          ?[["RawRate",raw(source.direct[3])],
            [pt?"Registro original":"Source row","#"+raw(source.direct[0])],
            ["Slot",raw(source.direct[4])]]
          :[["GroupID",raw(source.groupId)],
            ["Band",raw(source.selectedBand.band)],
            ["BandKey",raw(source.selectedBand.minimumLevel)],
            ["RawRate "+(pt?"referência":"reference"),raw(source.groupRef[2])],
            ["RawRate "+(pt?"item":"item"),raw(source.groupDrop[4])],
            [pt?"Linha de referência":"Reference row","#"+raw(source.groupRef[0])],
            [pt?"Linha do item":"Item source row","#"+raw(source.groupDrop[0])],
            [pt?"Slot referência":"Reference slot",raw(source.groupRef[3])],
            [pt?"Slot do item":"Item slot",raw(source.groupDrop[5])]];
        for(const [label,value] of fields){
          const box=node("div");box.append(node("dt",label),node("dd",value));
          dl.append(box);
        }
        audit.append(dl);technical.append(audit);tr.append(technical);
        body.append(tr);
      }
      tableNode.append(body);
      const wrap=node("div",undefined,"creature-table-scroll");
      wrap.append(tableNode);container.append(wrap);
    }
    let shownId="";
    async function openCreature(id:string,navigate:boolean){
      if(!/^[1-9]\d{0,12}$/.test(id))return;
      const entity=all.find(r=>r[0]===id);
      if(!entity)return;
      shownId=id;
      detail.hidden=false;
      detailName.textContent=entity[1]??("CharID "+id);
      detailMeta.textContent=(pt?"Tipo registrado":"Recorded source kind")+": "+raw(entity[3])+
        " · "+(pt?"Identidade":"Identity")+": "+entity[4];
      factId.textContent=id;
      factLevel.textContent=raw(entity[2]);
      factDirect.textContent="—";
      factGroups.textContent="—";
      detailBody.replaceChildren(node("p",pt
        ?"Carregando os registros de origem…"
        :"Loading original source records…","subtle"));
      if(navigate)history.pushState({},"","?id="+encodeURIComponent(id));
      try{
        const charFile=findFile("characters",id),lootFile=findFile("loot",id);
        const [character,loot]=await Promise.all([
          charFile?loadShard(charFile):Promise.resolve(null),
          lootFile?loadShard(lootFile):Promise.resolve(null),
        ]);
        if(shownId!==id)return;
        const body=document.createDocumentFragment();
        const intro=node("p",pt
          ?"Definições extraídas do cliente; nem identidade de monstro ativo, nem chance de drop foram verificadas no servidor."
          :"Extracted client source evidence. Active monster identity and item drop chances have not been verified on the server.","subtle");
        body.append(intro);
        const original=character?.items?.[id]?.original??[];
        const miner=character?.items?.[id]?.miner??[];
        const rawLoot=loot?.items?.[id]??{direct:[],groups:[]};
        const groupFiles=manifest.files.groups??[];
        const groupShards=await Promise.all(groupFiles.map(loadShard));
        if(shownId!==id)return;
        const groupData=Object.assign({},...groupShards.map(data=>data.items));
        const selected=resolveClientCreatureDrops(entity,rawLoot,groupData);
        factDirect.textContent=nf.format(selected.rows.length);
        factGroups.textContent=nf.format(selected.unresolved.length);
        const directSection=node("section",undefined,"community-drop-section");
        directSection.append(node("h3",
          (pt?"Itens que podem aparecer":"Possible monster drops")+
          " ("+nf.format(selected.rows.length)+")"));
        directSection.append(node("p",pt
          ?"Esta lista usa a faixa aplicável ao nível registrado da criatura. A combinação das taxas é uma estimativa identificada a partir do cliente, não uma chance confirmada no servidor."
          :"This list uses the source bracket matching this creature's recorded level. Combined rates are game-client estimates, not verified live-server drop odds.","subtle"));
        if(selected.rows.length)appendItemTable(directSection,selected.rows);
        else directSection.append(node("p",pt
          ?"Nenhum item pôde ser resolvido com os níveis e faixas deste snapshot. Isso não comprova ausência de drops no jogo."
          :"No item was resolved from this snapshot's levels and brackets. That does not establish the creature has no in-game drops.","subtle"));
        body.append(directSection);
        if(selected.unresolved.length){
          const uncertain=node("p",pt
            ?"Algumas referências não possuem faixa compatível com o nível registrado e foram omitidas da lista principal. Consulte Dados originais para investigá-las."
            :"Some source references have no matching level bracket and were excluded from the main item list. Review Original client records for details.","wiki-source-warning");
          body.append(uncertain);
        }
        // Original Miner rows remain fully auditable but no longer interrupt
        // the player-first path from creature name to possible loot.
        const audit=node("details",undefined,"community-creature-audit");
        audit.dataset.wikiNavNative="true";
        audit.append(node("summary",(pt?"Registros originais do cliente":"Original client records")+
          " ("+nf.format(original.length+miner.length)+")"));
        audit.append(node("p",pt
          ?"Estes registros servem para conferir as fontes. Campos internos e números de linha não são requisitos do jogador."
          :"These rows are for checking the source. Internal values and row numbers are not player requirements.","subtle"));
        if(original.length){
          audit.append(node("h4",pt?"Definições da criatura":"Creature source definitions"));
          audit.append(table([
            pt?"Registro":"Source row",pt?"Nome em inglês":"English name",
            pt?"Nível registrado":"Recorded level",pt?"Tipo":"Source type"
          ],original));
        }else audit.append(node("p",pt
          ?"Não há registros Characters.csv para este ID."
          :"No Characters.csv rows were published for this ID.","subtle"));
        if(rawLoot.groups?.length){
          const groupAudit=node("details",undefined,"source-band-details");
          groupAudit.append(node("summary",pt
            ?"Referências técnicas de grupos e faixas":"Technical source groups and level brackets"));
          groupAudit.append(node("p",pt
            ?"A wiki usa o maior BandKey menor ou igual ao nível registrado. Essa regra reproduz os seis drops do Huge Crocodile em capturas do jogo, mas pode não cobrir todas as regras do servidor."
            :"The wiki selects the greatest BandKey not above the recorded creature level. This matches the six Huge Crocodile drops in game screenshots, but might not cover every server rule.","subtle"));
          const technicalRows=rawLoot.groups.map(ref=>{
            const group=groupData[ref[1]];
            const selectedBand=group?.bands?.filter(b=>Number(b[2])<=Number(entity[2]))
              .sort((a,b)=>Number(b[2])-Number(a[2]))[0]??null;
            return ["#"+ref[0],ref[1],ref[2],
              selectedBand?selectedBand[1]:"—",
              selectedBand?selectedBand[2]:"—",
              selectedBand?selectedBand[3]:"—",
              selectedBand?selectedBand[4]:"—"];
          });
          groupAudit.append(table([
            pt?"Linha":"Row","GroupID","RawRate",
            "Band","BandKey","EntryCount","RawSum"
          ],technicalRows));
          audit.append(groupAudit);
        }
        if(miner.length){
          const extra=node("details",undefined,"source-band-details");
          extra.append(node("summary",pt?"Outros metadados do Miner":"Additional Miner fields"));
          extra.append(table([
            pt?"Linha":"Row",pt?"Código":"Code",pt?"Nome":"Name",
            pt?"Arquivo":"File",pt?"Nível":"Level",pt?"Grade":"Grade"
          ],miner));
          audit.append(extra);
        }
        body.append(audit);
        if(shownId!==id)return;
        detailBody.replaceChildren(body);
        detail.scrollIntoView({behavior:"smooth",block:"start"});
      }catch{
        if(shownId===id)detailBody.replaceChildren(node("p",pt
          ?"Não foi possível validar os registros de origem para esta criatura."
          :"Original creature records could not be loaded or validated.","subtle"));
      }
    }
    close.addEventListener("click",()=>{
      shownId="";detail.hidden=true;history.pushState({}, "",location.pathname);
    });
    window.addEventListener("popstate",()=>{
      const id=new URL(location.href).searchParams.get("id");
      if(id)void openCreature(id,false);
      else{shownId="";detail.hidden=true;}
    });
    prev.addEventListener("click",()=>{if(page>0){page--;render();}});
    next.addEventListener("click",()=>{if((page+1)*perPage<visible.length){page++;render();}});
    query.addEventListener("input",applyFilters);
    kind.addEventListener("change",applyFilters);
    level.addEventListener("input",applyFilters);
    lootMode.addEventListener("change",applyFilters);
    void (async()=>{
      try{
        const response=await fetch("/data/client-monsters/manifest.json");
        if(!response.ok){
          status.textContent=pt
            ?"Importação original pendente. As páginas e os links estão preparados; aguardamos o pacote revisado de Characters.csv e drops."
            :"Original data import pending. Catalog pages and item links are ready for the reviewed character/drop package.";
          return;
        }
        manifest=await response.json();
        if(manifest.schemaVersion!=="1.0"||manifest.snapshotId!==1||
          manifest.dataset!=="all-client-monster-loot-original"||
          !Array.isArray(manifest.files?.index))
          throw Error("Unapproved creature manifest");
        const shards=await Promise.all(manifest.files.index.map(loadShard));
        all=shards.flatMap(shard=>shard.rows);
        if(all.length!==manifest.catalogMonsterIds||
          new Set(all.map(r=>r[0])).size!==all.length)
          throw Error("Incomplete source creature catalog");
        const countResp=await fetch("/data/client-monster-discovery/creature-counts.json");
        if(!countResp.ok)throw Error("Level-matched creature index missing");
        const matchCounts=await countResp.json();
        if(matchCounts.schemaVersion!=="1.0"||matchCounts.snapshotId!==1||
          matchCounts.dataset!=="level-resolved-creature-drop-counts"||
          matchCounts.count!==4351||matchCounts.matchedDropRows!==33864||
          matchCounts.unresolvedRefs!==197||!Array.isArray(matchCounts.rows)||
          matchCounts.rows.length!==4351)
          throw Error("Level-resolved creature counts failed validation");
        possibleByCreature.clear();
        for(const row of matchCounts.rows)possibleByCreature.set(row[0],[row[1],row[2]]);
        if(possibleByCreature.size!==all.length)
          throw Error("Unreconciled level-matched creature counts");
        const categories=[...new Set(all.map(r=>r[3]).filter(Boolean))].sort();
        for(const category of categories){
          const option=node("option",category) as HTMLOptionElement;
          option.value=category;kind.append(option);
        }
        query.disabled=false;kind.disabled=false;level.disabled=false;
        lootMode.disabled=false;
        visible=all;list.hidden=false;pageNav.hidden=false;render();
        const selected=new URL(location.href).searchParams.get("id");
        if(selected)void openCreature(selected,false);
      }catch{
        status.textContent=pt
          ?"Os arquivos de criaturas não passaram pela verificação de estrutura."
          :"Original creature sources were missing or failed structural validation.";
      }
    })();
  }
</script>
<style is:global>
  #creature-db{
    --bestiary-metal:#93805d;
    --bestiary-gold:#ecd19a;
    --bestiary-paper:#d5d6d9;
    /* 2540x1440 @125%: use wider desktop canvas without shrinking fonts */
    width:min(1600px,calc(100% - 36px));
    margin:0 auto;
    padding:12px 0 65px;
  }
  #creature-db .breadcrumb{margin:3px 0 11px}
  #creature-db .breadcrumb a{color:var(--color-accent);font-size:.86rem}
  #creature-db a{color:#e5c586}
  #creature-db a:focus-visible,#creature-db button:focus-visible,
  #creature-db input:focus-visible,#creature-db select:focus-visible{
    outline:2px solid #e4b964;outline-offset:2px;
  }
  #creature-db .bestiary-header{
    position:relative;
    overflow:hidden;
