---
import {wikiNameAlias,foldNameAlias} from "../data/wiki-name-aliases.mjs";
import {aliasText} from "../i18n/name-alias-ui.mjs";
import {equipmentText} from "../i18n/equipment-ui.mjs";
import {localePrefix,localeTag,legacyLocale,localizedPaths} from "../i18n/locales.mjs";
import type {Lang} from "../i18n/ui";
import BaseLayout from "../layouts/BaseLayout.astro";
import ClientCraftingBacklinks from "./ClientCraftingBacklinks.astro";
import MonsterItemSources from "./MonsterItemSources.astro";
import AtlanticaItemInfoPanel from "./AtlanticaItemInfoPanel.astro";
import {summarizeCraftBatch} from "../data/client-craft-batch.mjs";
import {
  getClientEquipmentSourceProfile,getOriginalClientItemIdentity,
  getSourceItemLink,
} from "../data/full-client-equipment-source.mjs";
import {RAW_STATS_FIELDS} from "../data/full-client-stats-tools.mjs";
import {labelForClientField} from "../data/client-item-stat-summary.mjs";

interface Props {lang:Lang; itemId:string;}
const {lang,itemId}=Astro.props;
const prefix=localePrefix(lang);
const profile=getClientEquipmentSourceProfile(itemId);
if(!profile)throw Error("Missing original source equipment ID");
const {item,detail,rawStats,summary}=profile;
if(item.reviewed)throw Error("Reviewed equipment must keep its existing manually curated profile");
const fmt=new Intl.NumberFormat(lang==="en"?"en-US":localeTag(lang));
const materialStates=["parsed-client-material","parsed-client-recipe"];
const groupLabels={
  attack:equipmentText(lang,"Attack","Ataque"),
  defense:equipmentText(lang,"Defense and resistance","Defesa e resistência"),
  attributes:equipmentText(lang,"Primary attributes","Atributos básicos"),
  other:equipmentText(lang,"Other source attributes","Outros atributos"),
};
const groups=["attack","defense","attributes","other"]
  .map(group=>({name:groupLabels[group],
    fields:RAW_STATS_FIELDS.filter(f=>f.group===group&&summary?.fields.has(f.key))
      .map(f=>({key:f.key,
        label:equipmentText(lang,labelForClientField(f.key,false),labelForClientField(f.key,true)),obs:summary.fields.get(f.key)}))
  })).filter(g=>g.fields.length);
const recipesMap=new Map();
for(const def of detail.s){
  const [rowId,file,role,category,level,grade,work,unit,state,ingredients]=def;
  if(!materialStates.includes(state)||!ingredients.length)continue;
  const materialPairs=[...ingredients].sort((a,b)=>Number(a[0])-Number(b[0]));
  const signature=JSON.stringify(materialPairs);
  if(!recipesMap.has(signature)){
    recipesMap.set(signature,{materials:materialPairs.map(([id,qty])=>({
      id,qty,name:getOriginalClientItemIdentity(id)?.nameEn??null,
      url:getSourceItemLink(id,localePrefix(legacyLocale(lang))),
    })),definitions:[]});
  }
  recipesMap.get(signature).definitions.push({rowId,file,role,category,work,unit});
}
const recipes=[...recipesMap.values()];
const materialsUnavailable=detail.s.some(s=>s[8]==="unsupported");
const noRecipeSource=detail.s.some(s=>s[8]==="none");
const sourceCount=detail.s.length;
const longSourceRows=(rawStats??[]).map(([sourceRow,values])=>({sourceRow,values:Object.entries(values)}));
const craftBatch=summarizeCraftBatch(detail.s);
const usableBatch=craftBatch.batchSize!==null&&craftBatch.maxBatchesPerOperation>0;
---
<BaseLayout lang={lang} title={item.nameEn+" | Atlantica Knowledge Hub"}
  description={(equipmentText(lang,"Equipment-like source item from the client files: ","Equipamento de categoria semelhante extraído dos arquivos do cliente: "))+item.nameEn}
  alternatePaths={{en:"/items/"+item.id+"/", "pt-br":"/pt-br/items/"+item.id+"/"}}>
  <main class="equipment-source-page" data-wiki-nav-root="true">
    <nav class="breadcrumbs"><a href={prefix+"/items/"}>{equipmentText(lang,"← Equipment catalog","← Catálogo de equipamentos")}</a></nav>
    <header>
      <p class="eyebrow">ATLANTICA GLOBAL / NA · CLIENT SNAPSHOT 1</p>
      <h1>{item.nameEn}</h1>
      {wikiNameAlias("item",item.id,item.nameEn,lang)&&<p>{aliasText(lang,"Wiki translation (unofficial)")}: {wikiNameAlias("item",item.id,item.nameEn,lang)}</p>
      <p class="identity">
        <span>ID <code>{item.id}</code></span>
        <span>{item.sourceCategory}</span>
        <span>{equipmentText(lang,"Client-source item profile","Ficha baseada nos arquivos do cliente")}</span>
      </p>
      <p class="source-caution">{equipmentText(lang,"This profile is generated from original client definitions and is not one of the 551 manually reviewed equipment profiles. Its source category is equipment-like, but does not confirm that the item can be equipped, obtained or crafted on the current server.","Esta ficha foi gerada a partir de definições do cliente e ainda não passou pela revisão editorial dos 551 equipamentos originais. A categoria indica semelhança com equipamentos, mas não comprova que o item esteja equipável, disponível ou fabricável no servidor atual.")}</p>
      <nav class="quicklinks" aria-label={equipmentText(lang,"Profile sections","Seções da ficha")}>
        <a href="#base-info">{equipmentText(lang,"Overview","Informações")}</a>
        <a href="#stats">{equipmentText(lang,"Stats","Atributos")}</a>
        <a href="#crafting">{equipmentText(lang,"Crafting","Fabricação")}</a>
        <a href="#obtain">{equipmentText(lang,"How to obtain","Obtenção")}</a>
        <a href="#sources">{equipmentText(lang,"Source evidence","Fontes")}</a>
        <a href="#used-in">{equipmentText(lang,"Used in crafting","Usado em receitas")}</a>
      </nav>
    </header>

    <AtlanticaItemInfoPanel lang={lang} itemId={item.id} />
    <section id="base-info">
      <h2>{equipmentText(lang,"Item overview","Informações do item")}</h2>
      <dl class="facts">
        <div><dt>{equipmentText(lang,"Client ID","ID do cliente")}</dt><dd><code>{item.id}</code></dd></div>
        <div><dt>{equipmentText(lang,"Source category","Categoria de origem")}</dt><dd>{item.sourceCategory}</dd></div>
        <div><dt>{equipmentText(lang,"Recorded raw level","Nível bruto registrado")}</dt><dd>{item.rawLevel??"—"}</dd></div>
        <div><dt>{equipmentText(lang,"Recorded source grade","Grade bruta registrada")}</dt><dd>{item.rawGrade??"—"}</dd></div>
        <div><dt>{equipmentText(lang,"Original source definitions","Definições originais")}</dt><dd>{sourceCount}</dd></div>
        <div><dt>{equipmentText(lang,"Numeric source records","Registros de atributos")}</dt><dd>{rawStats?.length??0}</dd></div>
      </dl>
      <p class="subtle">{equipmentText(lang,"Source level and grade are extracted properties, not necessarily character requirements, enhancement rules or availability claims.","Nível e grade são propriedades extraídas, não necessariamente requisitos de personagem, regras de melhoria ou confirmações de obtenção.")}</p>
    </section>

    <section id="stats">
      <h2>{equipmentText(lang,"Original client attributes","Atributos de origem")}</h2>
      {summary&&groups.length?<>
        <p class="subtle">{equipmentText(lang,"Raw numeric Items.csv fields. Zeros, missing values, partial coverage and source disagreements remain distinct. Not necessarily live-server tooltip values.","Valores numéricos brutos de Items.csv; zeros, campos ausentes, cobertura parcial e fontes divergentes são preservados. Não representam necessariamente a ficha exibida no servidor.")}</p>
        <div class="stat-groups">{groups.map(group=><div class="stat-group">
          <h3>{group.name}</h3>
          <dl>{group.fields.map(field=><div>
            <dt>{field.label} <small>{field.key}</small></dt>
            <dd>
              <strong>{field.obs.values.join(" / ")}</strong>
              {field.obs.status!=="consistent"&&<small class={field.obs.status}>
                {field.obs.status==="conflict"?(equipmentText(lang,"Conflict","Divergente")):(equipmentText(lang,"Partial","Parcial"))}
                {" · "+field.obs.observedIn+"/"+field.obs.sourceCount}
              </small>}
            </dd>
          </div>)}</dl>
        </div>)}</div>
        <details class="raw-source"><summary>{equipmentText(lang,"Original raw numeric records and source row IDs","Registros numéricos originais e IDs de origem")}</summary>
          <div class="table-scroll"><table>
            <thead><tr><th>{equipmentText(lang,"Source row","Registro")}</th><th>{equipmentText(lang,"Field","Campo")}</th><th>{equipmentText(lang,"Raw value","Valor")}</th></tr></thead>
            <tbody>{longSourceRows.flatMap(row=>row.values.map(([key,value])=><tr>
              <td>#{row.sourceRow}</td><td>{key}</td><td>{value}</td>
            </tr>))}</tbody>
          </table></div>
        </details>
        <p class="subtle"><a href={prefix+"/items/database/?id="+encodeURIComponent(item.id)}>
          {equipmentText(lang,"Explore historical +0–+10 estimates and complete raw records","Ver modelos históricos +0 a +10 e dados originais no explorador")}
        </a>. {equipmentText(lang,"Any projections are historical models, not proof that this item can be enhanced.","Projeções são modelos antigos e não comprovam que o item aceita encantamento.")}</p>
      </>:<p class="subtle">{equipmentText(lang,"No verified client numeric source rows are published for this ID. Missing source data is not zero.","Nenhum registro numérico seguro foi identificado para este ID na extração publicada. Dados ausentes não são zero.")}</p>}
    </section>

    <section id="crafting">
      <h2>{equipmentText(lang,"Crafting recipe","Receita de fabricação")}</h2>
      <div class="craft-batch">
        <h3>{equipmentText(lang,"Production batch size","Tamanho do batch de produção")}</h3>
        {usableBatch?<p>
          <strong>{fmt.format(craftBatch.batchSize)}</strong>
          {equipmentText(lang,"units per source production unit","unidades por fabricação registrada")}
          <span> · {equipmentText(lang,"Steps of","Incrementos de")} {fmt.format(craftBatch.increment)}</span>
          <span> · {equipmentText(lang,"Operation limit","Limite por operação")} {fmt.format(craftBatch.maxPerOperation)}</span>
          <span> · {equipmentText(lang,"Maximum batches","Máximo de batches")} {fmt.format(craftBatch.maxBatchesPerOperation)}</span>
        </p>:<p class="subtle">{craftBatch.status==="conflict"
          ?(equipmentText(lang,"Source files contain different Unit values; no batch was selected.","Os arquivos apresentam valores de Unit divergentes; não foi selecionado um batch."))
          :(equipmentText(lang,"No production batch quantity is identified in the available client records.","Tamanho do batch ainda não identificado nos arquivos do cliente."))}</p>}
        {craftBatch.status==="partial"&&<small>{equipmentText(lang,"Batch value is present in only some original source records.","Batch informado em apenas parte das definições originais.")}</small>}
        <p class="subtle">{equipmentText(lang,"Unit is a raw ItemType field. The 10,000-output-per-operation limit is a player-reported gameplay rule kept separate from the client-source record. Crafting availability is not confirmed.","Unit é um valor bruto do ItemType. O limite de 10.000 unidades por operação é uma regra de jogo informada pelo jogador, separada dos dados extraídos. A existência da receita não é garantida no servidor atual.")}</p>
      </div>
      <p class="subtle">{equipmentText(lang,"Ingredients and quantities were parsed from ItemType*.ndt source definitions. These are not confirmation of a usable recipe in the live crafting interface. Distinct ingredient lists remain separate.","Ingredientes e quantidades foram decodificados dos registros ItemType*.ndt. Não comprovam que a receita esteja disponível na interface de fabricação atual. Listas distintas são mantidas separadas.")}</p>
      {recipes.length?<>
        {recipes.length>1&&<p class="caution">{equipmentText(lang,"The source files contain differing ingredient lists; all are displayed without claiming a canonical gameplay recipe.","As fontes registram receitas divergentes. Todas são exibidas sem escolher uma como definitiva.")}</p>}
        {recipes.map((recipe,index)=><div class="recipe-block">
          <h3>{equipmentText(lang,"Source recipe","Receita de origem")} {recipes.length>1?index+1:""}</h3>
          <p class="subtle">{equipmentText(lang,"Files and source rows","Arquivos e registros")}: {recipe.definitions.map(d=>d.file+" (#"+d.rowId+")").join(" · ")}</p>
          <div class="table-scroll"><table>
            <thead><tr><th>{equipmentText(lang,"Ingredient","Material")}</th><th>ID</th><th>{equipmentText(lang,"Quantity","Quantidade")}</th></tr></thead>
            <tbody>{recipe.materials.map(m=><tr>
              <td>
                <a href={m.url}>{m.name??(equipmentText(lang,"Unreconciled name","Nome não conciliado"))}</a>
                <small class="ingredient-obtain"><a href={prefix+"/monsters/?item="+encodeURIComponent(m.id)}>{equipmentText(lang,"Find monster sources","Ver fontes de drop")}</a></small>
              </td>
              <td><code>{m.id}</code></td><td>{fmt.format(m.qty)}</td>
            </tr>)}</tbody>
          </table></div>
        </div>)}
      </>:<p class="subtle">{equipmentText(lang,"No structured original ingredient list is available for this item. This does not prove that crafting is impossible.","Nenhuma lista de ingredientes estruturada foi encontrada para este item. Isso não demonstra que ele não possa ser fabricado.")}</p>}
      {materialsUnavailable&&<p class="caution">{equipmentText(lang,"Some source definitions contain unparsed material expressions.","Algumas definições possuem expressões de materiais ainda não decodificadas.")}</p>}
      {noRecipeSource&&recipes.length>0&&<p class="caution">{equipmentText(lang,"Other source definitions have no material list. Missing does not mean an empty recipe.","Outras definições não registram materiais. A ausência não é uma receita vazia.")}</p>}
    </section>

    <section id="obtain">
      <h2>{equipmentText(lang,"How to obtain","Onde conseguir")}</h2>
      <p class="subtle">{equipmentText(lang,"Original client-source monster drops have been imported. Browse direct and grouped references below; these do not establish active drops or probabilities on the current server.","A base de drops extraídos do cliente já foi importada. Consulte as referências por criatura e por grupo abaixo; elas não comprovam drops ativos nem probabilidades no servidor atual.")}</p>
    </section>

    <MonsterItemSources lang={lang} itemId={item.id} />

    <section id="sources">
      <h2>{equipmentText(lang,"Original client file evidence","Proveniência dos arquivos do cliente")}</h2>
      <div class="table-scroll"><table>
        <thead><tr><th>{equipmentText(lang,"Source row","Registro")}</th><th>{equipmentText(lang,"File","Arquivo")}</th><th>{equipmentText(lang,"Role","Tipo")}</th>
          <th>{equipmentText(lang,"Category","Categoria")}</th><th>Work</th><th>Unit</th><th>{equipmentText(lang,"Material parser","Materiais")}</th></tr></thead>
        <tbody>{detail.s.map(source=><tr>
          <td>#{source[0]}</td><td>{source[1]}</td><td>{source[2]}</td>
          <td>{source[3]}</td><td>{source[6]??"—"}</td><td>{source[7]??"—"}</td>
          <td>{source[8]}</td>
        </tr>)}</tbody>
      </table></div>
      {detail.v.length>1&&<p class="subtle">{equipmentText(lang,"Source file record groupings","Agrupamentos de registros nos arquivos")}:
        {detail.v.map((v,i)=><span> {i+1}: {v.map(x=>"#"+x).join(", ")} ·</span>)}
        {equipmentText(lang," These are not verified playable variants."," Não representam variantes equipáveis comprovadas.")}</p>}
    </section>

    <div id="used-in"><ClientCraftingBacklinks lang={lang} itemId={item.id}/></div>
  </main>
</BaseLayout>
<style>
  .equipment-source-page{width:min(var(--content-width),92%);margin:0 auto;padding:20px 0 85px}
  .breadcrumbs a,.equipment-source-page a{color:var(--color-accent)}
  header{padding-bottom:24px;border-bottom:1px solid var(--color-border)}
  h1{font-size:clamp(2rem,4vw,3.1rem);margin:8px 0 15px;overflow-wrap:anywhere}
  .eyebrow{letter-spacing:.1em;color:var(--color-accent);font-size:.76rem}
  .identity{display:flex;gap:10px;align-items:center;flex-wrap:wrap}
  .identity span{border:1px solid var(--color-border);padding:7px 10px;border-radius:4px;font-size:.87rem}
  .source-caution,.caution{border-left:3px solid var(--color-bronze);padding:11px 14px;background:var(--color-surface);
    color:var(--color-text-muted);font-size:.9rem;line-height:1.65}
  .quicklinks{display:flex;gap:9px;flex-wrap:wrap;margin:20px 0 5px}
  .quicklinks a{border:1px solid var(--color-border);padding:7px 11px;border-radius:4px;text-decoration:none}
  section{margin:30px 0}h2{color:var(--color-gold-light);font-size:1.4rem}
  .facts{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,200px),1fr));gap:12px}
  .facts>div{border:1px solid var(--color-border);background:var(--color-surface);padding:12px}
  dt{color:var(--color-text-muted);font-size:.85rem}
  dd{margin:6px 0 0} .subtle{font-size:.88rem;line-height:1.65;color:var(--color-text-muted)}
  .stat-groups{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,240px),1fr));gap:12px}
  .stat-group{background:var(--color-surface);border:1px solid var(--color-border);border-radius:5px}
  .stat-group h3{font-size:1rem;padding:8px 12px;margin:0;border-bottom:1px solid var(--color-border)}
  .stat-group dl{margin:0;padding:8px 13px}.stat-group dl>div{display:flex;justify-content:space-between;
    gap:10px;border-bottom:1px solid var(--color-border);padding:7px 0}
  .stat-group dd{text-align:right;margin:0}.stat-group small{display:block;color:var(--color-text-muted);font-size:.72rem}
  .stat-group .conflict{color:var(--color-gold-light)}
  .raw-source{margin:19px 0}.raw-source summary{cursor:pointer;color:var(--color-accent)}
  .craft-batch{border:1px solid var(--color-border);background:var(--color-surface);
    padding:12px 16px;border-radius:5px;margin:14px 0}
  .craft-batch h3{color:var(--color-gold-light);font-size:1rem;margin:0 0 8px}
  .craft-batch p{display:flex;flex-wrap:wrap;align-items:baseline;gap:8px}
  .craft-batch strong{font-size:1.15rem;color:var(--color-gold-light)}
  .craft-batch small{color:var(--color-text-muted);font-size:.78rem}
  .recipe-block{border:1px solid var(--color-border);border-radius:5px;padding:14px;margin:14px 0}
  .recipe-block h3{margin:0;color:var(--color-gold-light);font-size:1rem}
  .ingredient-obtain{display:block;margin-top:6px;font-size:.76rem}
  .ingredient-obtain a{color:var(--color-text-muted);text-decoration:underline;text-underline-offset:2px}
  .table-scroll{overflow:auto;margin:12px 0;border:1px solid var(--color-border);border-radius:5px}
  table{border-collapse:collapse;width:100%;min-width:690px;font-size:.88rem}
  th,td{padding:9px 12px;border-bottom:1px solid var(--color-border);text-align:left}
  th{background:#29271f;color:var(--color-gold-light)}
  td{color:var(--color-text)}
</style>
