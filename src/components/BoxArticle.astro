---
import BaseLayout from "../layouts/BaseLayout.astro";
import { complementaryText } from "../i18n/complementary-ui.mjs";
import { localePrefix, localeTag, localizedPaths, legacyLocale, equipmentProfilePath } from "../i18n/locales.mjs";
import { render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import { getCapturedEquipmentPool, decodedEnhancementCandidate } from "../data/equipment-box-captured-pools";
import { getEquipmentItemEnglishName } from "../data/equipment-item-names-en";
interface Props { lang: string; box: CollectionEntry<"boxes">; }
const {lang,box}=Astro.props;
const base=localePrefix(lang)+"/items/boxes/";
const {Content}=await render(box);
const d=box.data;
const captured=d.itemUniqueId ? getCapturedEquipmentPool(d.itemUniqueId) : undefined;
const previewGrades=captured?.gradeCodes.map(code=>decodedEnhancementCandidate(code));
const hasRates=d.oddsStatus==="regional-published";
const rate=(n:number|undefined)=>n===undefined?"—":n.toLocaleString(localeTag(lang),{maximumFractionDigits:4})+"%";
const source=d.probabilitySourceUrl||d.verificationUrl;
const hasCapturedEvidence=d.contentsEvidence==="server-preview-captured";
const contentsLabel=hasCapturedEvidence
  ? (complementaryText(lang,"Item list received from the game during box opening","Lista recebida do jogo durante a abertura"))
  : (d.contentsEvidence==="family-candidates"
    ? (complementaryText(lang,"Family-matched candidates — drops unverified","Candidatos por família — drops não confirmados"))
    : (complementaryText(lang,"Rewards under review","Recompensas em revisão")));
---
<BaseLayout lang={lang} title={d.title+" | Atlantica Knowledge Hub"} description={d.description} alternatePaths={localizedPaths("/items/boxes/"+box.id.split("/").slice(1).join("/")+"/")}>
  <main class="container">
    <nav class="crumb"><a href={base}>{complementaryText(lang,"← Back to boxes","← Voltar às boxes")}</a></nav>
    <article class="body">
      <header>
        <p class="eyebrow">{complementaryText(lang,"BOX DATABASE","CATÁLOGO DE BOXES")} · {d.region.toUpperCase()}</p>
        <h1>{d.title}</h1><p>{d.description}</p>
        <div class="meta">
          <span>{complementaryText(lang,"Type","Tipo")}: {d.boxType}</span>
          <span>{complementaryText(lang,"Region","Região")}: {d.region.toUpperCase()}</span>
          <span>{complementaryText(lang,"Roll model","Modelo de sorteio")}: {d.rollModel}</span>
        </div>
        {captured && <p class="evidence">
          <strong>{complementaryText(lang,"Likely preview enhancement grades","Graus prováveis na prévia")}:</strong>
          {" "}{previewGrades?.map(grade=>grade===undefined?"?":"+"+grade).join(", ")}
          {" "}({complementaryText(lang,"codes","códigos")} {captured.gradeCodes.join(", ")}).
          {" "}{complementaryText(lang,"Derived from captured messages; not drop-rate information.","Derivado de captura; não representa chances de drop.")}
        </p>}
        <p class="caution">
          {hasRates
            ? (complementaryText(lang,"These published percentages apply to the indicated region; they do not necessarily represent Atlantica Global rates.","As porcentagens são taxas publicadas para a região indicada; não representam necessariamente as chances do Atlantica Global."))
            : (complementaryText(lang,"No outcome percentages are confirmed for this box. Raw client weights are not verified drop rates.","Nenhuma chance de obtenção foi confirmada para esta box. Pesos internos do cliente não são probabilidades verificadas."))}
        </p>
      </header>
      <h2>{complementaryText(lang,"Items associated with the box","Itens associados à box")}</h2>
      <p class="evidence"><strong>{contentsLabel}</strong>{d.contentsNote && <span> — {d.contentsNote}</span>}</p>
      <p class="note">{complementaryText(lang,"A game-transmitted item list does not establish equal drop rates or prove every item is obtainable under all conditions.","A lista exibida pelo jogo não demonstra chances iguais ou garante que cada item seja obtido em qualquer condição.")}</p>
      <div class="table-scroll">
        <table><thead><tr>
          <th>{complementaryText(lang,"Item","Item")}</th><th>ID</th><th>{complementaryText(lang,"Quantity","Quantidade")}</th>
          <th>{complementaryText(lang,"Observed returns","Observações")}</th><th>{complementaryText(lang,"Chance","Chance")}</th>
        </tr></thead>
          <tbody>
            {d.outcomes.map(row=><tr>
              <td>{(row.itemUniqueId && getEquipmentItemEnglishName(row.itemUniqueId)) || row.itemName}</td>
              <td>{row.itemUniqueId ?? "—"}</td>
              <td>{row.quantityVerified ? row.quantity.toLocaleString(localeTag(lang)) : "—"}</td>
              <td>{row.observedCount ? row.observedCount : "—"}</td>
              <td>{hasRates?rate(row.chancePercent):"—"}</td>
            </tr>)}
          </tbody>
        </table>
      </div>
      {d.outcomes.length===0 && <p>{complementaryText(lang,"Reward list not confirmed yet.","Lista de recompensas ainda não confirmada.")}</p>}
      {d.probabilityNotes && <p class="note">{d.probabilityNotes}</p>}
      {source && <p class="source"><a href={source} rel="noopener noreferrer" target="_blank">
        {complementaryText(lang,"Verification source","Fonte para verificação")}</a></p>}
      {lang!==box.data.lang&&<p class="note">{complementaryText(lang,"This article body is shown in English until a reviewed translation is available.")}</p>}
      <div class="content" lang={localeTag(box.data.lang)}><Content /></div>
    </article>
  </main>
</BaseLayout>
<style>
.container{width:min(var(--content-width),92%);margin:0 auto;padding-bottom:75px}
.crumb{padding:26px 0}.crumb a,.source a{color:var(--color-accent);text-decoration:none}
.body{max-width:1140px;margin:0 auto}
header{border-bottom:1px solid var(--color-border);padding:10px 0 28px}
.eyebrow{color:var(--color-accent);font-size:.8rem;letter-spacing:.13em}
h1{font-size:clamp(2rem,4vw,3.3rem);margin:8px 0}
header>p:not(.eyebrow){color:var(--color-text-muted)}
.meta{display:flex;gap:10px;flex-wrap:wrap;margin:15px 0}
.meta span{padding:5px 9px;background:var(--color-surface);border:1px solid var(--color-border);font-size:.85rem}
.caution{border-left:3px solid var(--color-bronze);padding:12px 16px;background:var(--color-surface)}
h2{font-size:1.7rem;margin-top:34px}
.table-scroll{overflow-x:auto;border:1px solid var(--color-border);border-radius:5px}
table{width:100%;border-collapse:collapse;min-width:620px}
th,td{padding:12px 15px;text-align:left;border-bottom:1px solid var(--color-border)}
th{background:#29271f;color:var(--color-gold-light)}
td{color:var(--color-text-muted)}
td:last-child{font-variant-numeric:tabular-nums}
.note,.source{color:var(--color-text-muted);font-size:.9rem}
.evidence{padding:10px 15px;border-left:3px solid var(--color-accent);background:var(--color-surface);color:var(--color-text)}
.content{line-height:1.8;margin-top:38px}
:global(.content a){color:var(--color-accent)}
:global(.content img){max-width:100%;height:auto}
</style>
