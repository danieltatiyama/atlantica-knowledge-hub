---
import {monsterText} from "../i18n/monster-ui.mjs";
import {localePrefix,localeTag,localizedPaths} from "../i18n/locales.mjs";
import type {Lang} from "../i18n/ui";
/** Player-facing source links filtered by each creature's original level Band. */
interface Props {lang:Lang;itemId:string;}
const {lang,itemId}=Astro.props;

---
<section class="monster-item-sources" data-item-id={itemId} data-lang={lang}
  aria-label={monsterText(lang,"source","Monsters that may drop this item")}>
  <h2>{monsterText(lang,"source","Which monsters may drop this item?")}</h2>
  <p class="drop-disclaimer">{monsterText(lang,"source","Only items from the client level bracket matching each creature are shown. Percentages are estimates, NOT verified live-server drop rates.")}</p>
  <p class="monster-item-status" role="status">{monsterText(lang,"source","Loading creature sources…")}</p>
  <div class="monster-item-results" hidden>
    <div class="monster-scroll">
      <table>
        <thead><tr>
          <th>{monsterText(lang,"source","Creature")}</th>
          <th>{monsterText(lang,"source","Estimated rate")}</th>
          <th>{monsterText(lang,"source","Possible amount")}</th>
          <th>{monsterText(lang,"source","Source")}</th>
        </tr></thead>
        <tbody></tbody>
      </table>
    </div>
  </div>
  <p class="monster-catalog-link">
    <a href={localePrefix(lang)+"/monsters/?item="+encodeURIComponent(itemId)}>
      {monsterText(lang,"source","Explore this item in the loot codex")}</a>
    <span aria-hidden="true"> · </span>
    <a href={localePrefix(lang)+"/monsters/"}>{monsterText(lang,"source","Browse creatures")}</a>
  </p>
</section>
<script>
  import {wikiNameAlias,matchesWikiNameAlias} from "../data/wiki-name-aliases.mjs";
  import {aliasText} from "../i18n/name-alias-ui.mjs";
  import {monsterText} from "../i18n/monster-ui.mjs";
  import {localePrefix,localeTag} from "../i18n/locales.mjs";
  import {formatLevelResolvedPercent,estimatedTwoStagePercent} from
    "../data/client-monster-drop-resolver.mjs";
  let manifestPromise:Promise<any>|null=null;
  const getManifest=()=>{
    if(!manifestPromise){
      manifestPromise=fetch("/data/client-monster-discovery/manifest.json")
        .then(response=>response.ok?response.json():null).catch(()=>null);
    }
    return manifestPromise;
  };
  const node=(tag:string,value?:string)=>{
    const n=document.createElement(tag);if(value!==undefined)n.textContent=value;return n;
  };
  const raw=(value:unknown)=>value===null||value===undefined?"—":String(value);
  for(const section of document.querySelectorAll<HTMLElement>(".monster-item-sources")){
    const id=section.dataset.itemId??"",lang=section.dataset.lang??"en",prefix=localePrefix(lang);
    const state=section.querySelector<HTMLElement>(".monster-item-status")!;
    const container=section.querySelector<HTMLElement>(".monster-item-results")!;
    const tbody=container.querySelector("tbody")!;
    void (async()=>{
      if(!/^[1-9]\d{0,12}$/.test(id))return;
      try{
        const meta=await getManifest();
        if(!meta||meta.schemaVersion!=="1.0"||meta.snapshotId!==1||
          meta.dataset!=="level-resolved-client-monster-loot"||
          meta.levelMatchedGroupRows!==23905||
          meta.unmatchedLevelGroupRefs!==197||
          !Array.isArray(meta.files?.itemSources))
          throw Error("Level-resolved client monster source manifest missing or incompatible");
        const bucket=Math.floor(Number(id)/1000);
        const filename="item-sources/"+String(bucket).padStart(2,"0")+".json";
        if(!meta.files.itemSources.includes(filename))return;
        const response=await fetch("/data/client-monster-discovery/"+filename);
        if(!response.ok)throw Error("Level-resolved item source shard missing");
        const shard=await response.json();
        if(shard.schemaVersion!=="1.0"||shard.snapshotId!==1||
          shard.dataset!=="level-resolved-client-monster-loot"||shard.bucket!==bucket)
          throw Error("Level-resolved source shard invalid");
        const entry=shard.items?.[id];
        if(!entry){
          state.textContent=monsterText(lang,"source","No drop matches the recorded level bracket. This does not prove it cannot drop on the server.");
          return;
        }
        const sources=[
          ...(entry.direct??[]).map((r:any[])=>({row:r,kind:"direct" as const,
            pct:Number(r[3])/100,min:r[5],max:r[6]})),
          ...(entry.group??[]).map((r:any[])=>({row:r,kind:"group" as const,
            pct:estimatedTwoStagePercent(r[5],r[6]),min:r[9],max:r[10]})),
        ].sort((a,b)=>(b.pct??-1)-(a.pct??-1)||String(a.row[1]).localeCompare(String(b.row[1])));
        let shown=0;
        const more=node("button") as HTMLButtonElement;
        more.type="button";more.className="monster-more";
        const render=()=>{
          const fragment=document.createDocumentFragment();
          for(const source of sources.slice(shown,shown+75)){
            const [charId,name]=source.row;
            if(!/^[1-9]\d{0,12}$/.test(String(charId)))continue;
            const tr=node("tr"),creatureCell=node("td");
            const link=node("a",name??("CharID #"+charId)) as HTMLAnchorElement;
            link.href=prefix+"/monsters/profile/?id="+encodeURIComponent(charId);
            creatureCell.append(link);
            creatureCell.append(node("small"," #"+charId));
            const alias=wikiNameAlias("monster",charId,name,lang);
            if(alias)creatureCell.append(node("small",aliasText(lang,"Wiki translation (unofficial)")+": "+alias));
            tr.append(creatureCell);
            tr.append(node("td",formatLevelResolvedPercent(source.pct,lang)));
            tr.append(node("td",raw(source.min)+"–"+raw(source.max)));
            const technical=node("td"),details=node("details");
            details.append(node("summary",monsterText(lang,"source","View source")));
            const dl=node("dl");
            const fields=source.kind==="direct"
              ?[["RawRate",source.row[3]],[monsterText(lang,"source","Source row"),source.row[2]],
                ["Slot",source.row[4]]]
              :[["GroupID",source.row[2]],["Band",source.row[8]],
                ["RawRate ref",source.row[5]],["RawRate item",source.row[6]],
                [monsterText(lang,"source","Ref row"),source.row[3]],
                [monsterText(lang,"source","Item row"),source.row[4]],
                ["Slot",source.row[7]]];
            for(const [label,value] of fields){
              const box=node("div");box.append(node("dt",String(label)),node("dd",raw(value)));
              dl.append(box);
            }
            details.append(dl);technical.append(details);tr.append(technical);
            fragment.append(tr);
          }
          tbody.append(fragment);
          shown=Math.min(sources.length,shown+75);
          more.textContent=(monsterText(lang,"source","Show 75 more · "))+
            shown+" / "+sources.length;
          if(shown===sources.length)more.remove();
        };
        if(sources.length>75){
          more.addEventListener("click",render);
          container.append(more);
        }
        render();container.hidden=false;
        state.textContent=(monsterText(lang,"source","Level-matched drop records: "))+
          sources.length;
      }catch{
        state.textContent=monsterText(lang,"source","Level-matched creature sources failed to load or validate.");
      }
    })();
  }
</script>
<style is:global>
  .monster-item-sources{
    margin:25px 0;border:1px solid #847052;border-radius:5px;
    background:linear-gradient(140deg,#171e25,#12161b);
    box-shadow:inset 0 0 0 3px #292820,0 7px 24px #0004;
    padding:17px;color:#e5e7eb;
  }
  .monster-item-sources h2{font-family:Georgia,"Times New Roman",serif;
    font-size:1.42rem;color:#e7cb96;margin:0 0 8px;padding-bottom:10px;
    border-bottom:1px solid #79674885}
  .monster-item-sources .drop-disclaimer,
  .monster-item-sources .monster-item-status{font-size:.85rem;line-height:1.65;color:#c5ccd2}
  .monster-item-sources .monster-scroll{overflow:auto}
  .monster-item-sources table{border-collapse:collapse;width:100%;min-width:560px}
  .monster-item-sources th,.monster-item-sources td{padding:9px 12px;border-bottom:1px solid #574d3f;text-align:left;font-size:.86rem}
  .monster-item-sources th{color:#e5c992;background:#302c22}
  .monster-item-sources tbody tr:nth-child(even){background:#222932}
  .monster-item-sources tbody tr:hover{background:#55452b57}
  .monster-item-sources td a,.monster-item-sources .monster-catalog-link a{color:#e9ce93}
  .monster-item-sources td small{display:block;color:#afb7c4;font-size:.73rem}
  .monster-item-sources td:nth-child(2){font-weight:600;color:#e8d198;font-variant-numeric:tabular-nums}
  .monster-item-sources details summary{color:#e7c78d;cursor:pointer}
  .monster-item-sources details dl{display:grid;grid-template-columns:1fr 1fr;
    gap:8px;background:#13191e;padding:10px;margin:8px 0;border:1px solid #685943}
  .monster-item-sources details dt{font-size:.73rem;color:#b4b9c2}
  .monster-item-sources details dd{margin:3px 0 0;font-size:.83rem;color:#f0dfc0}
  .monster-item-sources .monster-item-results[hidden]{display:none}
  .monster-item-sources .monster-more{border:1px solid #8b7958;border-radius:3px;
    padding:8px 12px;margin:12px 0;background:#28261f;color:#eacb91;cursor:pointer}
  .monster-item-sources .monster-catalog-link{font-size:.85rem;margin-bottom:0}
  .monster-item-sources :is(a,summary,button):focus-visible{outline:2px solid #f0c982;outline-offset:2px}
</style>
