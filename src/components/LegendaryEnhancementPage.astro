---
import BaseLayout from "../layouts/BaseLayout.astro";
import { complementaryText } from "../i18n/complementary-ui.mjs";
import { localePrefix, localeTag, localizedPaths, legacyLocale, equipmentProfilePath } from "../i18n/locales.mjs";
import research from "../data/legendary-enhancement-research.json";
import { getLegendaryResearchRows } from "../data/legendary-enhancement-research.mjs";
import legendaryReference from "../data/legendary-eligibility-reference.json";
import {crossReferenceLegendaryNames,LEGENDARY_REFERENCE_URL}
  from "../data/legendary-eligibility-reference-gate.mjs";
import {EQUIPMENT_ITEM_NAMES_EN} from "../data/equipment-item-names-en";
import clientLegendary from "../data/legendary-client-name-candidates.json";
import {assertLegendaryClientCandidates} from "../data/legendary-client-name-candidates-gate.mjs";

interface Props { lang: string; }
const { lang } = Astro.props;
const prefix=localePrefix(lang);
const title=complementaryText(lang,"Legendary enhancement (L)","Encantamento lendário (L)");
const examples=getLegendaryResearchRows(research);
const clientCandidates=assertLegendaryClientCandidates(clientLegendary,legendaryReference);
const eligibility=crossReferenceLegendaryNames(legendaryReference,EQUIPMENT_ITEM_NAMES_EN)
  .map((item,index)=>({...item,clientSource:clientCandidates[index]}));
const categoryGroups=[...new Set(eligibility.map(item=>item.category))]
  .map(category=>({category,items:eligibility.filter(item=>item.category===category)}));
const matchCounts={
  unique:clientCandidates.filter(item=>item.clientMatchStatus==="one-exact-source-name").length,
  ambiguous:clientCandidates.filter(item=>item.clientMatchStatus==="ambiguous-client-identity").length,
  missing:clientCandidates.filter(item=>item.clientMatchStatus==="not-found-in-miner").length,
};
const format=(n:number)=>new Intl.NumberFormat(localeTag(lang)).format(n);
const stats=[
 {key:"attackMin",pt:"Ataque mínimo",en:"Min. attack"},
 {key:"attackMax",pt:"Ataque máximo",en:"Max. attack"},
 {key:"strength",pt:"Força",en:"Strength"},
 {key:"dexterity",pt:"Destreza",en:"Dexterity"},
 {key:"intelligence",pt:"Inteligência",en:"Intelligence"},
 {key:"vitality",pt:"Vitalidade",en:"Vitality"},
 {key:"defense",pt:"Defesa física",en:"Physical defense"},
] as const;
---
<BaseLayout lang={lang} title={title+" | Atlantica Knowledge Hub"}
 description={complementaryText(lang,"Historical +0 through +10 and Legendary (L) progression, separating documented stats from predictions.","Comparação histórica de upgrades +0 a +10 e L, com previsões claramente separadas de valores documentados.")}
 alternatePaths={localizedPaths("/items/legendary/")}>
 <main class="container">
  <nav class="breadcrumbs"><a href={prefix+"/items/"}>{complementaryText(lang,"← Equipment catalog","← Catálogo de equipamentos")}</a></nav>
  <header>
    <p class="eyebrow">{complementaryText(lang,"EQUIPMENT RESEARCH","PESQUISA DE EQUIPAMENTOS")}</p>
    <h1>{title}</h1>
    <p class="lead">{complementaryText(lang,"L (Legendary, equivalent to +11) exists only for eligible equipment. Compare community-documented figures with the historical model.","A graduação L (Legendary, equivalente a +11) existe somente para equipamentos elegíveis. Compare valores publicados em fontes comunitárias com o modelo histórico.")}</p>
    <p class="source-disclaimer">{complementaryText(lang,"The progression tables below come from historical community sources. Later, separate client name/ID candidates come from Global game files (Miner snapshot 1). A matching item ID is not proof that its current version can be enhanced to L.","As tabelas de progressão abaixo vêm de fontes comunitárias históricas. Já as correspondências de nomes/IDs mais adiante vêm dos arquivos do cliente Global (Miner snapshot 1). Um ID candidato não comprova que a versão atual permite enhancement até L.")}</p>
  </header>
  <section>
    <h2>{complementaryText(lang,"Progression model","Modelo de progressão")}</h2>
    <div class="formula">
      <div><span>{complementaryText(lang,"+10 vs +0","+10 sobre +0")}</span><strong>4,0×</strong></div>
      <div><span>L vs +0</span><strong>4,3×</strong></div>
      <div><span>{complementaryText(lang,"L vs +10","L vs +10")}</span><strong>+7,5%</strong></div>
    </div>
    <p class="note">{complementaryText(lang,"Estimate for attack, Strength, Dexterity, Intelligence, Vitality and physical Defense: floor(base +0 × multiplier). Integer arithmetic avoids floating-point rounding errors. The additional 7.5% compares multipliers before truncation.","Estimativa para ataque, força, destreza, inteligência, vitalidade e defesa física: piso(valor +0 × multiplicador). O modelo usa aritmética inteira para evitar erros de arredondamento. O bônus adicional de 7,5% compara os multiplicadores antes do truncamento.")}</p>
    <p class="note">{complementaryText(lang,"Special bonuses, proc rates, fixed Magic Defense, evasion, durability, Atlas Ore, skills and enhancement success rates are not covered by this formula.","Bônus especiais, chance de ativação, Magic Defense fixa, evasão, durabilidade, Atlas Ore, habilidades e probabilidades de sucesso não obedecem necessariamente a esta fórmula.")}</p>
  </section>
  <section id="legendary-eligibility" class="legendary-reference">
    <h2>{complementaryText(lang,"Initial list of L-eligible equipment","Lista inicial de equipamentos elegíveis a L")}</h2>
    <p class="note">{complementaryText(lang,"47 entries in 12 groups from the historical Fandom list, matched against all 23,586 Miner item IDs (snapshot 1). Shown IDs are exact-English-name source candidates. Actual L eligibility, crafting, event origin and current availability are not established.","47 entradas em 12 categorias da lista histórica do Fandom, cruzadas com todos os 23.586 IDs do Miner (snapshot 1). Os IDs mostrados são candidatos por correspondência exata de nome em inglês. Elegibilidade real a L, fabricação, origem por evento e disponibilidade atual não foram comprovadas.")}</p>
    <p class="sources"><a href={LEGENDARY_REFERENCE_URL} target="_blank" rel="noopener noreferrer">
      {complementaryText(lang,"Source: Legendary Weapons — Atlantica Wiki (Fandom)","Fonte: Legendary Weapons — Atlantica Wiki (Fandom)")}</a></p>
    <p class="note">{complementaryText(lang,"{unique} unique name matches, {ambiguous} names with multiple item IDs and {missing} unmatched. Client level and grade are raw fields, not necessarily the live requirement. Divergent source names remain unresolved.","{unique} correspondências únicas de nome, {ambiguous} nomes com múltiplos IDs e {missing} sem correspondência. Nível e grade do cliente são campos brutos, não necessariamente o requisito exibido no jogo. Nomes divergentes continuam para revisão.",matchCounts)}</p>
    <div class="legendary-groups">
      {categoryGroups.map(group=><details class="legendary-group">
        <summary>{group.category} <span>({group.items.length})</span></summary>
        <div class="table-scroll"><table>
          <thead><tr>
            <th>{complementaryText(lang,"Equipment","Equipamento")}</th>
            <th>{complementaryText(lang,"Listed level","Nível na fonte")}</th>
            <th>{complementaryText(lang,"Candidate client IDs","IDs candidatos do cliente")}</th>
          </tr></thead>
          <tbody>{group.items.map(item=><tr>
            <td>{item.nameEn}</td>
            <td>{item.minimumLevel===null?"—":"Lv. "+item.minimumLevel}</td>
            <td>{item.clientSource.clientCandidates.length
              ? <div class="client-candidates">{item.clientSource.clientCandidates.map(candidate=>
                <div><code>{candidate.itemId}</code> <span class="client-raw">
                  {complementaryText(lang,"Raw Lv","Nível bruto")} {candidate.clientLevelRaw} · {candidate.clientGradeRaw}
                </span></div>)}
                {item.clientSource.clientMatchStatus==="ambiguous-client-identity" &&
                  <small class="unresolved">{complementaryText(lang,"Different IDs — review required","IDs diferentes — requer revisão")}</small>}
                </div>
              : <span class="unresolved">{complementaryText(lang,"No Miner name match","Sem correspondência no Miner")}</span>}</td>
          </tr>)}</tbody>
        </table></div>
      </details>)}
    </div>
  </section>
  <section id="historical-evidence">
    <h2>{complementaryText(lang,"Equipment studied","Equipamentos analisados")}</h2>
    {examples.map(item=><article class="evidence-item">
      <div class="item-heading">
        <div>
          <h3>{item.nameEn}</h3>
          <p>{item.typeEn} · Lv. {item.minimumLevel}</p>
        </div>
        <span class={item.legendaryBasis==="historical-table"?"observed":"pending"}>
          {item.legendaryBasis==="historical-table"
            ?(complementaryText(lang,"L documented","L documentado"))
            :(complementaryText(lang,"L estimated","L estimado"))}
        </span>
      </div>
      <div class="table-scroll"><table>
        <thead><tr><th>{complementaryText(lang,"Stat","Atributo")}</th><th>+0</th><th>+10</th><th>L</th></tr></thead>
        <tbody>{stats.filter(field=>field.key in item.base).map(field=>
          <tr>
            <th scope="row">{complementaryText(lang,field.en,field.pt)}</th>
            <td>{format(item.base[field.key])}</td>
            <td>{format(item.plusTen[field.key])} <small>({complementaryText(lang,"calculated","calculado")})</small></td>
            <td class="legendary-value">{format(item.legendary[field.key])}
              <small>({item.legendaryBasis==="historical-table"
                ? (complementaryText(lang,"historical source","fonte histórica"))
                : (complementaryText(lang,"projection","projeção"))})</small></td>
          </tr>
        )}</tbody>
      </table></div>
      {item.unchangedAtLegendary?.magicDefense !== undefined &&
        <p class="note">{complementaryText(lang,"Fixed Magic Defense","Defesa Mágica fixa")}:
          <strong> {format(item.unchangedAtLegendary.magicDefense)}</strong> —
          {complementaryText(lang," do not apply 4.3×"," não aplicar 4,3×")}</p>}
      <p class="note">{complementaryText(lang,item.noteEn,item.notePt)}</p>
      {item.nameEn === "Dell'arte's Ambition" && <p class="detail-link">
        <a href={prefix+"/items/legendary/dell-artes-ambition/"}>{complementaryText(lang,"View detailed equipped L profile: stats, Star Stones and special effects","Ver ficha detalhada do L equipado: atributos, Star Stones e efeitos")}</a>
      </p>}
      <p class="sources">
        <a href={item.source.url} target="_blank" rel="noopener noreferrer">
          {complementaryText(lang,"Table source","Fonte da tabela")}: {item.source.label}
        </a>
        {item.eligibilitySource && <>
          {" · "}<a href={item.eligibilitySource.url} target="_blank" rel="noopener noreferrer">
            {complementaryText(lang,"Eligibility list","Lista de elegibilidade")}</a>
        </>}
      </p>
    </article>)}
  </section>
  <section id="calculator">
    <h2>{complementaryText(lang,"Historical multiplier calculator","Calculadora do multiplicador histórico")}</h2>
    <p class="note">{complementaryText(lang,"Enter the +0 value of a basic stat. Enable L only after confirming the item is eligible; the calculator cannot check eligibility.","Insira o valor de +0 de um atributo básico. Ative L somente após confirmar que o item é elegível; a calculadora não verifica a elegibilidade.")}</p>
    <form id="legendary-form">
      <div class="form-grid">
        <label>{complementaryText(lang,"Base +0 stat","Valor +0")}
          <input id="legendary-base" name="base" inputmode="numeric" type="number" min="0" max="1000000000000" step="1" value="1350"/>
        </label>
        <label class="checkbox">
          <input id="legendary-eligible" type="checkbox" />
          {complementaryText(lang,"I have confirmed this equipment is L-eligible","Confirmo que este equipamento é elegível a L")}
        </label>
      </div>
      <div class="calc-values" aria-live="polite">
        <div><span>+0</span><strong id="legendary-v0">1.350</strong></div>
        <div><span>+10 · 4,0×</span><strong id="legendary-v10">5.400</strong></div>
        <div><span>L · 4,3×</span><strong id="legendary-vL">—</strong></div>
      </div>
      <p id="legendary-calc-note" class="note">{complementaryText(lang,"L disabled.","L não habilitado.")}</p>
    </form>
  </section>
 </main>
</BaseLayout>
<script>
  import { projectClassicStat } from "../data/equipment-enchant-projection.mjs";
  import { complementaryText } from "../i18n/complementary-ui.mjs";
  import { browserLocale, localeTag } from "../i18n/locales.mjs";
  const base=document.querySelector<HTMLInputElement>("#legendary-base");
  const eligible=document.querySelector<HTMLInputElement>("#legendary-eligible");
  const at0=document.querySelector<HTMLElement>("#legendary-v0");
  const at10=document.querySelector<HTMLElement>("#legendary-v10");
  const atL=document.querySelector<HTMLElement>("#legendary-vL");
  const status=document.querySelector<HTMLElement>("#legendary-calc-note");
  const pageLang=document.documentElement.lang;
  const lang=browserLocale(pageLang)??"en";
  const fmt=new Intl.NumberFormat(localeTag(lang));
  function render(){
    const value=Number(base?.value);
    const valid=base && base.value.trim()!=="" && Number.isSafeInteger(value) &&
      value>=0 && value<=1000000000000;
    if(at0)at0.textContent=valid?fmt.format(value):"—";
    if(at10)at10.textContent=valid?fmt.format(projectClassicStat(value,10)):"—";
    if(atL)atL.textContent=valid && eligible?.checked
      ?fmt.format(projectClassicStat(value,"L")):"—";
    if(status)status.textContent=!valid
      ?(complementaryText(lang,"Enter a valid nonnegative integer.","Informe um número inteiro válido."))
      :eligible?.checked
        ?(complementaryText(lang,"Mathematical estimate, not an in-game reading.","Estimativa matemática, não uma leitura do jogo."))
        :(complementaryText(lang,"L disabled: verify eligibility before calculating.","L não habilitado: confirme a elegibilidade antes de calcular."));
  }
  base?.addEventListener("input",render);
  eligible?.addEventListener("change",render);
  render();
</script>
<style>
  .container{width:min(var(--content-width),92%);max-width:1120px;margin:auto;padding-bottom:80px}
  .breadcrumbs{padding:25px 0}.breadcrumbs a,.sources a{color:var(--color-accent)}
  .eyebrow{color:var(--color-accent);font-size:.8rem;letter-spacing:.13em}
  header{padding:4px 0 25px;border-bottom:1px solid var(--color-border)}
  h1{font-size:clamp(2rem,4vw,3.15rem);margin:12px 0 18px}
  h2{font-size:1.55rem;margin:32px 0 18px;color:var(--color-gold-light)}
  h3{font-size:1.33rem;margin:0;color:var(--color-text)}
  .lead{font-size:1.08rem;line-height:1.65;color:var(--color-text-muted)}
  .source-disclaimer{padding:13px 16px;border-left:3px solid var(--color-bronze);
    background:var(--color-surface);line-height:1.6;color:var(--color-text-muted)}
  .formula,.calc-values{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}
  .formula>div,.calc-values>div{border:1px solid var(--color-border);
    background:var(--color-surface);border-radius:4px;padding:16px}
  .formula span,.calc-values span{display:block;color:var(--color-text-muted);font-size:.86rem}
  .formula strong,.calc-values strong{display:block;font-size:1.7rem;font-variant-numeric:tabular-nums;
    color:var(--color-gold-light);margin-top:5px}
  .note{line-height:1.65;color:var(--color-text-muted)}
  .evidence-item{border:1px solid var(--color-border);border-radius:6px;
    padding:20px;background:var(--color-surface);margin:18px 0}
  .item-heading{display:flex;justify-content:space-between;gap:12px;align-items:flex-start}
  .item-heading p{color:var(--color-text-muted);margin:5px 0 16px}
  .observed,.pending{border:1px solid #8f58b3;color:#e6c7ff;background:#3e284f;
    font-size:.84rem;padding:5px 11px;border-radius:4px}
  .pending{color:var(--color-gold-light);background:#372c1b;border-color:var(--color-bronze)}
  .table-scroll{overflow-x:auto;border:1px solid var(--color-border);border-radius:5px}
  table{width:100%;border-collapse:collapse;min-width:520px;font-variant-numeric:tabular-nums}
  th,td{padding:11px 14px;border-bottom:1px solid var(--color-border);text-align:left}
  th{color:var(--color-gold-light)}td{color:var(--color-text)}
  thead th{background:#29271f}
  td small{display:block;font-size:.75rem;color:var(--color-text-muted)}
  .legendary-value{background:rgba(117,73,159,.13);font-weight:600}
  .detail-link a{display:inline-block;border:1px solid #9261b1;color:#e4b8ff;
    background:rgba(117,73,159,.13);text-decoration:none;padding:9px 14px;border-radius:4px}
  .detail-link a:hover{background:rgba(117,73,159,.24)}
  .legendary-groups{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,360px),1fr));gap:12px;margin:20px 0}
  .legendary-group{border:1px solid var(--color-border);border-radius:5px;background:var(--color-surface);overflow:hidden}
  .legendary-group summary{cursor:pointer;padding:14px 17px;color:var(--color-gold-light);font-weight:600}
  .legendary-group summary span{color:var(--color-text-muted);font-weight:400}
  .legendary-group[open] summary{border-bottom:1px solid var(--color-border)}
  .legendary-group table{min-width:330px}
  .legendary-group th,.legendary-group td{padding:8px 11px;font-size:.87rem}
  .candidate{color:var(--color-gold-light)}
  .unresolved{color:var(--color-text-muted)}
  .client-candidates{display:grid;gap:5px}
  .client-candidates>div{display:flex;flex-wrap:wrap;align-items:baseline;gap:9px}
  .client-candidates code{font-size:.92rem;color:var(--color-gold-light)}
  .client-raw{font-size:.77rem;color:var(--color-text-muted)}
  .sources{font-size:.84rem;line-height:1.6}
  .sources a{text-decoration:underline;text-underline-offset:3px}
  form{border:1px solid var(--color-border);border-radius:5px;padding:18px;background:var(--color-surface)}
  .form-grid{display:flex;align-items:end;gap:24px;flex-wrap:wrap;margin-bottom:20px}
  .form-grid label{display:flex;flex-direction:column;gap:9px;color:var(--color-gold-light)}
  .form-grid label.checkbox{display:flex;flex-direction:row;align-items:center;gap:8px;color:var(--color-text)}
  input[type=number]{font:inherit;color:var(--color-text);background:#181d24;
    border:1px solid var(--color-border);padding:10px;border-radius:4px;max-width:240px}
  input[type=checkbox]{accent-color:#9b66c1;width:18px;height:18px}
  @media(max-width:640px){
    .formula,.calc-values{grid-template-columns:1fr}
    .evidence-item{padding:12px}
    .item-heading{display:block}
    table th,table td{padding:9px}
  }
</style>
