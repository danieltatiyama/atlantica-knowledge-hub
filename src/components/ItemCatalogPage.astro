---
import {catalogText} from "../i18n/catalog-ui.mjs";
import {localePrefix,legacyLocale,localizedPaths,localeTag,equipmentProfilePath} from "../i18n/locales.mjs";
import type {Lang} from "../i18n/ui";
import BaseLayout from "../layouts/BaseLayout.astro";
import {EQUIPMENT_ITEM_CATALOG_BY_ID} from "../data/equipment-item-catalog";
import {FULL_CLIENT_EQUIPMENT_CATALOG,getClientEquipmentSourceProfile}
  from "../data/full-client-equipment-source.mjs";
import {comparableRawNumber} from "../data/full-client-stats-tools.mjs";
import { getCuratedEquipmentMetadata, APPROVED_EQUIPMENT_METADATA_COUNT } from "../data/curated-equipment-metadata";
import {getClientEquipmentFacts} from "../data/client-equipment-facts";
import {getClientItemAttributes} from "../data/client-item-attributes";
import {getClientItemSourceOverview}
  from "../data/equipment-catalog-source-index.mjs";

interface Props { lang: Lang; }
const { lang } = Astro.props;
const prefix=localePrefix(legacyLocale(lang));
const homePrefix=localePrefix(lang);
const fallback=legacyLocale(lang)!==lang;
// All 2,462 named original equipment-like source IDs are indexed. The
// original 551 reviewed articles/box associations are not changed.
const items=FULL_CLIENT_EQUIPMENT_CATALOG.map(source=>{
  const reviewed=EQUIPMENT_ITEM_CATALOG_BY_ID.get(source.id);
  return {...source,boxReferences:reviewed?.boxReferences??[]};
});
const indexedItems=items.map(item=>{
  if(item.reviewed){
    return {...item,sourceIndex:getClientItemSourceOverview(item,
      getClientEquipmentFacts(item.id),getClientItemAttributes(item.id))};
  }
  const profile=getClientEquipmentSourceProfile(item.id);
  const raw=key=>{
    const n=profile?.summary?comparableRawNumber(profile.summary,key):null;
    return n===null?null:String(n);
  };
  return {...item,sourceIndex:{
    category:item.sourceCategory,rawLevel:item.rawLevel,
    minDamage:raw("MinDamage"),maxDamage:raw("MaxDamage"),
    physicalAC:raw("AC"),magicDef:raw("MagicDef"),evasion:raw("EV"),
    movement:raw("MoveSpeed"),
    sourceConflictCount:[...profile?.summary?.fields.values()??[]]
      .filter(f=>f.status==="conflict").length,
  }};
});
const sourceCategories=[...new Set(indexedItems.map(x=>x.sourceIndex.category))]
  .sort((a,b)=>a.localeCompare(b,"en"));
const nf=new Intl.NumberFormat(localeTag(lang));
const fmt=value=>value===null||value===undefined||value==="0"||value===""
  ?"—":/^-?\d+(?:\.\d+)?$/.test(value)?nf.format(Number(value)):value;
const attackRange=stats=>(stats.minDamage===null||stats.maxDamage===null||
  (stats.minDamage==="0"&&stats.maxDamage==="0"))
  ?"—":fmt(stats.minDamage)+"–"+fmt(stats.maxDamage);
const title = catalogText(lang,"Equipment Item Catalog");
const description = catalogText(lang,"Explore 2,462 equipment-like source IDs: 551 reviewed profiles plus 1,911 additional client-source profiles.");
---
<BaseLayout lang={lang} title={title + " | Atlantica Knowledge Hub"} description={description}
  alternatePaths={localizedPaths("/items/")}>
  <main class="container" id="equipment-catalog">
    <nav class="breadcrumb">
      <a href={homePrefix + "/"}>{catalogText(lang,"Home")}</a><span>/</span><span>{title}</span>
    </nav>
    <header class="intro">
      <p class="eyebrow">{catalogText(lang,"ITEM DATABASE")} · GLOBAL / NA CLIENT</p>
      <h1>{title}</h1>
      <p>{description}</p>
      <p class="notice">{catalogText(lang,"This catalog now includes all 2,462 identified equipment-like source IDs. The original 551 profiles retain their reviewed evidence; the other 1,911 are client-source profiles, not live-server availability or equippability claims. Browse all 23,586 original IDs in the complete item database.")}</p>
      {fallback && <p class="notice">{catalogText(lang,"Some linked pages and game names are still in English.")}</p>}
      <p class="related-links">
        <a class="related database-link" href={homePrefix+"/items/database/"}>
          {catalogText(lang,"Browse ALL 23,586 client item IDs")}
        </a>
        <a class="related" href={prefix + "/items/boxes/"}>{catalogText(lang,"Explore Equipment Boxes")}</a>
        <a class="related legendary-link" href={prefix + "/items/legendary/"}>{catalogText(lang,"Research: Legendary enhancement (L)")}</a>
        <a class="related data-download" href="/data/client-equipment-grades.csv" download>
          {catalogText(lang,"Download CSV: 551 items × 11 grades")}
        </a>
      </p>
    </header>
    <section class="catalog" aria-label={title}>
      <div class="filters">
        <div>
          <label for="item-search">{catalogText(lang,"Search name or ID")}</label>
          <input id="item-search" type="search" autocomplete="off"
            placeholder={catalogText(lang,"e.g. Judgment Sword or 47")}/>
        </div>
        <div>
          <label for="item-category">{catalogText(lang,"Client source category")}</label>
          <select id="item-category">
            <option value="">{catalogText(lang,"All categories")}</option>
            {sourceCategories.map(category=><option value={category}>{category}</option>)}
          </select>
        </div>
        <div>
          <label for="item-min-level">{catalogText(lang,"Min. raw level")}</label>
          <input id="item-min-level" type="number" min="0" max="999" step="1"
            placeholder={catalogText(lang,"Any level")}/>
        </div>
        <div>
          <label for="item-evidence">{catalogText(lang,"Profile evidence")}</label>
          <select id="item-evidence">
            <option value="">{catalogText(lang,"All 2,462 source IDs")}</option>
            <option value="reviewed">{catalogText(lang,"551 reviewed profiles")}</option>
            <option value="source">{catalogText(lang,"1,911 client-source profiles")}</option>
          </select>
        </div>
        <div>
          <label for="item-sort">{catalogText(lang,"Sort by")}</label>
          <select id="item-sort">
            <option value="name">{catalogText(lang,"Name A–Z")}</option>
            <option value="level">{catalogText(lang,"Raw level ↑")}</option>
            <option value="attack">{catalogText(lang,"Base attack ↓")}</option>
            <option value="ac">{catalogText(lang,"Base AC ↓")}</option>
          </select>
        </div>
      </div>
      <p class="count" aria-live="polite"><strong id="item-count">{items.length}</strong>
        {catalogText(lang," equipment items found")}</p>
      <div class="table-scroll">
        <table>
          <thead><tr>
            <th>{catalogText(lang,"Official English name")}</th>
            <th>{catalogText(lang,"Item ID")}</th>
            <th>{catalogText(lang,"Client category")}</th>
            <th>{catalogText(lang,"Raw level")}</th>
            <th>{catalogText(lang,"Base attack")}</th>
            <th>{catalogText(lang,"Base AC")}</th>
            <th>{catalogText(lang,"Associated boxes")}</th>
            {APPROVED_EQUIPMENT_METADATA_COUNT > 0 &&
              <th>{catalogText(lang,"Client metadata")}</th>}
          </tr></thead>
          <tbody id="item-table-body">
            {indexedItems.map((item) => (
              <tr data-item-row
                data-search={(item.nameEn+" "+item.id+" "+item.sourceIndex.category).toLocaleLowerCase()}
                data-sort-name={item.nameEn.toLocaleLowerCase()}
                data-category={item.sourceIndex.category}
                data-reviewed={item.reviewed?"reviewed":"source"}
                data-level={item.sourceIndex.rawLevel??""}
                data-attack={item.sourceIndex.maxDamage??""}
                data-ac={item.sourceIndex.physicalAC??""}>
                <td><a href={equipmentProfilePath(lang,item.id,item.reviewed)} lang="en" hreflang={localeTag(lang)}>{item.nameEn}</a>
                  {item.reviewed
                    ? <span class="profile-mark">{catalogText(lang,"Reviewed profile")}</span>
                    : <span class="profile-mark source-only">{catalogText(lang,"Client source")}</span>}</td>
                <td><code>{item.id}</code></td>
                <td>{item.sourceIndex.category}</td>
                <td>{item.sourceIndex.rawLevel??"—"}</td>
                <td>{attackRange(item.sourceIndex)}</td>
                <td>{fmt(item.sourceIndex.physicalAC)}</td>
                <td>{item.boxReferences.length}</td>
                {APPROVED_EQUIPMENT_METADATA_COUNT > 0 &&
                  <td>{getCuratedEquipmentMetadata(item.id)
                    ? (catalogText(lang,"Extracted · Reviewed"))
                    : (catalogText(lang,"Client source only"))}</td>}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p id="item-empty" hidden>{catalogText(lang,"No equipment items match your search.")}</p>
      <p class="footnote">{catalogText(lang,"Category, level, attack and AC here are RAW client-file values, not verified equipment requirements or measured combat stats. Zero or unavailable attack/armor is abbreviated as —. Box associations reflect captured previews, not drop odds or guaranteed rewards.")}</p>
    </section>
  </main>
</BaseLayout>
<script>
  const search=document.querySelector<HTMLInputElement>("#item-search");
  const category=document.querySelector<HTMLSelectElement>("#item-category");
  const minLevel=document.querySelector<HTMLInputElement>("#item-min-level");
  const evidence=document.querySelector<HTMLSelectElement>("#item-evidence");
  const sort=document.querySelector<HTMLSelectElement>("#item-sort");
  const tbody=document.querySelector<HTMLTableSectionElement>("#item-table-body");
  const rows=Array.from(document.querySelectorAll<HTMLTableRowElement>("[data-item-row]"));
  const count=document.querySelector<HTMLElement>("#item-count");
  const empty=document.querySelector<HTMLElement>("#item-empty");
  function filterItems(){
    const query=search?.value.toLocaleLowerCase().trim()??"";
    const selectedCategory=category?.value??"";
    const selectedEvidence=evidence?.value??"";
    const minString=minLevel?.value??"";
    const minimum=minString!==""?Number(minString):null;
    let visible=0;
    for(const row of rows){
      const rawLevel=row.dataset.level??"";
      const match=(row.dataset.search??"").includes(query) &&
        (!selectedCategory||row.dataset.category===selectedCategory) &&
        (!selectedEvidence||row.dataset.reviewed===selectedEvidence) &&
        (minimum===null||(rawLevel!==""&&Number(rawLevel)>=minimum));
      row.hidden=!match;
      if(match)visible++;
    }
    const order=sort?.value??"name";
    const value=(row:HTMLTableRowElement,key:string)=>{
      const source=key==="level"?row.dataset.level:
        key==="attack"?row.dataset.attack:row.dataset.ac;
      return source===""||source===undefined?null:Number(source);
    };
    rows.sort((a,b)=>{
      if(order==="name")return (a.dataset.sortName??"").localeCompare(b.dataset.sortName??"");
      const left=value(a,order),right=value(b,order);
      if(left===null&&right===null)return (a.dataset.sortName??"").localeCompare(b.dataset.sortName??"");
      if(left===null)return 1;
      if(right===null)return -1;
      const delta=order==="level"?left-right:right-left;
      return delta||(a.dataset.sortName??"").localeCompare(b.dataset.sortName??"");
    });
    if(tbody)for(const row of rows)tbody.append(row);
    if(count)count.textContent=String(visible);
    if(empty)empty.hidden=visible>0;
  }
  search?.addEventListener("input",filterItems);
  category?.addEventListener("change",filterItems);
  evidence?.addEventListener("change",filterItems);
  minLevel?.addEventListener("input",filterItems);
  sort?.addEventListener("change",filterItems);
</script>
<style>
  .container{width:min(var(--content-width),92%);margin:0 auto;padding-bottom:80px}
  .breadcrumb{padding:24px 0;color:var(--color-text-muted);font-size:.9rem}
  .breadcrumb a,.related{color:var(--color-accent);text-decoration:none}
  .breadcrumb span{margin:0 9px}
  .intro{border-bottom:1px solid var(--color-border);padding:22px 0 32px}
  .eyebrow{color:var(--color-accent);font-size:.8rem;letter-spacing:.14em}
  h1{font-size:clamp(2rem,4.5vw,3.2rem);margin:12px 0}
  .intro>p:not(.eyebrow){color:var(--color-text-muted);max-width:940px}
  .notice{border-left:3px solid var(--color-bronze);padding:12px 16px;background:var(--color-surface)}
  .related-links{display:flex;flex-wrap:wrap;gap:12px;align-items:center}
  .database-link{border:1px solid var(--color-border);padding:7px 12px;border-radius:4px;font-weight:600}
  .legendary-link{color:#d4adf2;border:1px solid #8255a7;padding:7px 12px;border-radius:4px}
  .legendary-link:hover{background:rgba(117,73,159,.15)}
  .catalog{padding:28px 0}
  .filters{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,180px),1fr));gap:14px;margin-bottom:16px}
  label{display:block;margin-bottom:8px;color:var(--color-gold-light);font-size:.85rem}
  input,select{width:100%;padding:12px;background:var(--color-surface);border:1px solid var(--color-border);
    border-radius:5px;color:var(--color-text);font:inherit}
  select{cursor:pointer}
  input:focus-visible,a:focus-visible{outline:2px solid var(--color-gold-light);outline-offset:3px}
  .count,.footnote{color:var(--color-text-muted);font-size:.92rem}
  .table-scroll{overflow-x:auto;border:1px solid var(--color-border);border-radius:6px}
  table{width:100%;border-collapse:collapse;min-width:850px}
  th,td{padding:12px 17px;text-align:left;border-bottom:1px solid var(--color-border)}
  th{background:#29271f;color:var(--color-gold-light);font-weight:600}
  td{color:var(--color-text-muted)}
  td:first-child{font-weight:600}td:first-child a{color:var(--color-text);text-decoration:none}
  td:first-child a:hover{color:var(--color-accent)}
  .profile-mark.source-only{color:var(--color-text-muted);border-color:var(--color-border)}
  .profile-mark{display:inline-block;font-size:.74rem;letter-spacing:.01em;
    color:var(--color-gold-light);border:1px solid var(--color-card-border);
    border-radius:3px;padding:2px 6px;margin:0 0 0 9px;font-weight:400;
    white-space:nowrap;background:var(--color-surface)}
  tr:hover td{background:var(--color-surface)}
  tr[hidden]{display:none}
  code{font-size:.9em}
</style>
