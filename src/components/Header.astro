---

import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";

const siteName = "Atlantica Knowledge Hub";
const pathname = Astro.url.pathname;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const homeHref = lang === "en" ? "/" : `/${lang}/`;
const guidesHref = lang === "en" ? "/guides/" : `/${lang}/guides/`;
const eventsHref = lang === "en" ? "/events/" : `/${lang}/events/`;
const mercenariesHref = lang === "en" ? "/mercenaries/" : `/${lang}/mercenaries/`;
const itemsHref = lang === "en" ? "/items/" : `/${lang}/items/`;
const allItemsHref = lang === "en" ? "/items/database/" : `/${lang}/items/database/`;
const monstersHref = lang === "en" ? "/monsters/" : `/${lang}/monsters/`;

const navigation = [
  {
    label: t("nav.home"),
    href: homeHref,
    active: pathname === homeHref,
  },
  {
    label: t("nav.guides"),
    href: guidesHref,
    active: pathname.startsWith(guidesHref),
  },
  {
    label: lang === "pt-br" ? "Eventos" : "Events",
    href: eventsHref,
    active: pathname.startsWith(eventsHref),
  },
  {
    label: lang === "pt-br" ? "Mercenários" : "Mercenaries",
    href: mercenariesHref,
    active: pathname.startsWith(mercenariesHref),
  },
  {
    label: lang === "pt-br" ? "Equipamentos" : "Equipment",
    href: itemsHref,
    active: pathname.startsWith(itemsHref) && !pathname.startsWith(allItemsHref),
  },
  {
    label: lang === "pt-br" ? "Todos os itens" : "All Items",
    href: allItemsHref,
    active: pathname.startsWith(allItemsHref),
  },
  {
    label: lang === "pt-br" ? "Monstros" : "Monsters",
    href: monstersHref,
    active: pathname.startsWith(monstersHref),
  },
  {
    label: t("nav.explore"),
    href: `${homeHref}#topics`,
    active: false,
  },
];


type SupportedLang = "en" | "pt-br";

const publishedGuides = await getCollection(
  "guides",
  ({ data }) =>
    !data.draft &&
    (data.lang === "en" || data.lang === "pt-br")
);

function getGuideUrl(guide: CollectionEntry<"guides">): string {
  const prefix = guide.data.lang === "en"
    ? ""
    : `/${guide.data.lang}`;

  const slug = guide.id.replace(/^[^/]+\//, "");

  return `${prefix}/guides/${slug}/`;
}

const normalizedPath = pathname.endsWith("/")
  ? pathname
  : `${pathname}/`;

const currentGuide = publishedGuides.find(
  (guide) => getGuideUrl(guide) === normalizedPath
);

function getLanguageTarget(targetLang: SupportedLang): string {
  const prefix = targetLang === "en"
    ? ""
    : `/${targetLang}`;

  // Article: find the corresponding translation.
  if (currentGuide) {
    const translation = publishedGuides.find(
      (guide) =>
        guide.data.lang === targetLang &&
        guide.data.translationKey ===
          currentGuide.data.translationKey
    );

    return translation
      ? getGuideUrl(translation)
      : `${prefix}/guides/`;
  }

  // Guides listing: preserve the page type.
  if (
    normalizedPath === "/guides/" ||
    normalizedPath === "/pt-br/guides/"
  ) {
    return `${prefix}/guides/`;
  }

  // New curated collections: preserve their listing type when switching languages.
  if (normalizedPath.startsWith("/events/") || normalizedPath.startsWith("/pt-br/events/")) {
    return `${prefix}/events/`;
  }
  if (normalizedPath.startsWith("/mercenaries/") || normalizedPath.startsWith("/pt-br/mercenaries/")) {
    return `${prefix}/mercenaries/`;
  }
  if (normalizedPath.startsWith("/items/") || normalizedPath.startsWith("/pt-br/items/")) {
    return `${prefix}${normalizedPath.replace(/^\/pt-br(?=\/)/, "")}`;
  }
  if (normalizedPath.startsWith("/monsters/") ||
      normalizedPath.startsWith("/pt-br/monsters/")) {
    return `${prefix}/monsters/`;
  }
  // Home or other pages.
  return `${prefix}/`;
}


import {
  getLangFromUrl,
  useTranslations,
} from "../i18n/utils";


---

<header class="site-header">
  <div class="header-content">
    <a class="brand" href={homeHref} aria-label={`${siteName} - Home`}>
        <div class="brand-wordmark" aria-hidden="true">
          <span class="brand-ornament">✦</span>
          <span class="brand-name">
            ATLANTICA
            <span class="brand-name-small"> KNOWLEDGE HUB</span>
          </span>
          <span class="brand-ornament">✦</span>
        </div>
        <span class="brand-subtitle">
            Community Knowledge Hub
        </span>
    </a>


    <nav class="main-nav" aria-label="Main navigation">
      {navigation.map((item) => (
        <a
          href={item.href}
          class:list={[
            "nav-link",
            { active: item.active },
          ]}
          aria-current={item.active ? "page" : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="header-controls" role="group"
      aria-label={lang === "pt-br" ? "Preferências de aparência e idioma" : "Appearance and language preferences"}>
      <div class="theme-switcher header-control-group">
        <label for="site-theme" class="theme-label header-control-label">
          {lang === "pt-br" ? "Tema" : "Theme"}
        </label>
        <select id="site-theme" class="theme-select header-control-select"
          aria-label={lang === "pt-br" ? "Selecionar tema visual" : "Select visual theme"}>
          <option value="atlantica">Atlantica</option>
          <option value="dark">{lang === "pt-br" ? "Escuro" : "Dark"}</option>
          <option value="light">{lang === "pt-br" ? "Claro" : "Light"}</option>
          <option value="parchment">{lang === "pt-br" ? "Pergaminho" : "Parchment"}</option>
          <option value="midnight">{lang === "pt-br" ? "Azul noturno" : "Midnight Blue"}</option>
          <option value="contrast">{lang === "pt-br" ? "Alto contraste" : "High Contrast"}</option>
        </select>
      </div>

      <div class="language-switcher header-control-group">
        <label for="site-language" class="language-label header-control-label">
          {lang === "pt-br" ? "Idioma" : "Language"}
        </label>
        <select id="site-language" class="language-select header-control-select"
          aria-label={lang === "pt-br" ? "Selecionar idioma" : "Select language"}
          data-target-en={getLanguageTarget("en")}
          data-target-pt-br={getLanguageTarget("pt-br")}>
          <option value="en" selected={lang === "en"}>English</option>
          <option value="pt-br" selected={lang === "pt-br"}>Português (Brasil)</option>
        </select>
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: relative;
    background:
      linear-gradient(
        180deg,
        #25272b 0%,
        var(--color-header) 100%
      );
    border-bottom: 1px solid var(--color-border);
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.3);
  }

  .site-header::after {
    content: "";
    position: absolute;
    bottom: -1px;
    left: 0;
    width: 100%;
    height: 2px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      var(--color-bronze) 30%,
      var(--color-gold-light) 50%,
      var(--color-bronze) 70%,
      transparent 100%
    );
    opacity: 0.75;
    pointer-events: none;
  }

  .header-content {
    width: min(1600px, 94%);
    min-height: 96px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(180px, 1fr) auto minmax(316px, 1fr);
    align-items: center;
    column-gap: clamp(12px, 1.5vw, 28px);
  }

  /* Original typography-based branding */

  .brand-wordmark {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--color-gold-light);
  }

  .brand-ornament {
    color: var(--color-bronze);
    font-size: 15px;
  }

  .brand-name {
    display: flex;
    flex-direction: column;
    align-items: center;
    font-family: var(--font-heading);
    font-size: clamp(17px, 2vw, 24px);
    letter-spacing: 0.13em;
    line-height: 1.2;
    text-shadow: 0 2px 12px rgba(210, 164, 91, 0.2);
  }

  .brand-name-small {
    margin-top: 5px;
    color: var(--color-accent);
    font-family: var(--font-primary);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.24em;
  }

  .brand .brand-subtitle {
    display: none;
  }


  /* Brand */

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 13px;
    text-decoration: none;
    min-width: 0;
  }

  .brand-subtitle {
    margin-top: 5px;
    font-size: 10px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.19em;
    color: var(--color-text-muted);
  }

  /* Navigation */

  .main-nav {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .nav-link {
    position: relative;
    padding: 12px 17px;

    color: var(--color-text-muted);
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;

    transition:
      color 0.2s ease,
      background-color 0.2s ease;
  }

  .nav-link::after {
    content: "";
    position: absolute;
    left: 17px;
    right: 17px;
    bottom: 5px;
    height: 1px;

    background: var(--color-accent);
    transform: scaleX(0);
    transition: transform 0.2s ease;
  }

  .nav-link:hover,
  .nav-link:focus-visible,
  .nav-link.active {
    color: var(--color-gold-light);
    background: rgba(210, 164, 91, 0.05);
  }

  .nav-link:hover::after,
  .nav-link:focus-visible::after,
  .nav-link.active::after {
    transform: scaleX(1);
  }

  .brand:focus-visible,
  .nav-link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  /* Wrap only when the three columns no longer fit comfortably. */
  @media (max-width: 1560px) {
    .header-content {
      grid-template-columns: minmax(0, 1fr) auto;
      padding: 12px 0;
      row-gap: 9px;
    }
    .brand { grid-column: 1; grid-row: 1; }
    .header-controls { grid-column: 2; grid-row: 1; }
    .main-nav {
      grid-column: 1 / -1;
      grid-row: 2;
      justify-self: stretch;
      width: 100%;
      justify-content: center;
      flex-wrap: wrap;
    }
    .nav-link { padding: 8px 11px; }
    .nav-link::after { left: 11px; right: 11px; bottom: 2px; }
  }

  @media (max-width: 700px) {
    .header-content {
      grid-template-columns: minmax(0, 1fr);
      justify-items: center;
      gap: 12px;
      padding: 14px 0;
    }
    .brand { grid-column: 1; grid-row: 1; }
    .header-controls {
      grid-column: 1;
      grid-row: 2;
      justify-self: center;
      width: min(100%, 380px);
    }
    .main-nav { grid-column: 1; grid-row: 3; }
    .nav-link { padding: 8px 10px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-link,
    .nav-link::after {
      transition: none;
    }
  }

  .brand {
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 0;
  }

  .brand-subtitle {
    margin-top: -2px;
    color: var(--color-gold-light);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    align-self: center;
  }

  @media (max-width: 700px) {
    .brand {
        align-items: center;
    }
  }
    
  /* Keep the nav centred and the preferences together in one grid area. */
  .main-nav {
    justify-self: center;
    justify-content: center;
    gap: 4px;
    min-width: 0;
  }
  .nav-link { padding: 10px 12px; white-space: nowrap; }

  .header-controls {
    display: grid;
    grid-template-columns: minmax(0, 148px) minmax(0, 170px);
    align-items: end;
    gap: 12px;
    justify-self: end;
    min-width: 0;
  }
  .header-control-group {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    min-width: 0;
    gap: 5px;
  }
  .header-control-label {
    position: static;
    display: block;
    width: auto;
    height: auto;
    padding: 0;
    margin: 0;
    overflow: visible;
    clip: auto;
    white-space: normal;
    border: 0;
    color: var(--color-text-muted);
    font-size: .72rem;
    font-weight: 600;
    line-height: 1.2;
  }
  .header-control-select {
    box-sizing: border-box;
    width: 100%;
    min-width: 0;
    height: 40px;
    margin: 0;
    padding: 0 11px;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    background: var(--color-surface);
    color: var(--color-gold-light);
    font-family: var(--font-primary);
    font-size: .85rem;
    line-height: normal;
    cursor: pointer;
  }
  .header-control-select option {
    color: var(--color-text);
    background: var(--color-surface);
  }
  .header-control-select:hover { border-color: var(--color-accent); }
  .header-control-select:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  @media (max-width: 700px) {
    .header-controls {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 340px) {
    .header-controls {
      grid-template-columns: minmax(0, 1fr);
    }
  }

</style>

<script>
  // One site-wide, bilingual appearance selector.
  // The head bootstrap reads the same key before first paint.
  const themeSelect = document.querySelector<HTMLSelectElement>("#site-theme");
  const themes = new Set([
    "atlantica", "dark", "light", "parchment", "midnight", "contrast"
  ]);
  const savedTheme = document.documentElement.dataset.theme || "atlantica";
  if (themeSelect) {
    themeSelect.value = themes.has(savedTheme) ? savedTheme : "atlantica";
    themeSelect.addEventListener("change", () => {
      const selectedTheme = themeSelect.value;
      if (!themes.has(selectedTheme)) return;
      document.documentElement.dataset.theme = selectedTheme;
      try {
        localStorage.setItem("atlantica.theme", selectedTheme);
      } catch {
        // The selection still works when persistence is unavailable.
      }
    });
    window.addEventListener("storage", (event) => {
      if (event.key !== "atlantica.theme") return;
      const next = themes.has(event.newValue) ? event.newValue : "atlantica";
      document.documentElement.dataset.theme = next;
      themeSelect.value = next;
    });
  }

  const languageSelect =
    document.querySelector<HTMLSelectElement>(
      "#site-language"
    );

  languageSelect?.addEventListener("change", () => {
    const selectedLanguage = languageSelect.value;

    if (
      selectedLanguage !== "en" &&
      selectedLanguage !== "pt-br"
    ) {
      return;
    }

    const destination = selectedLanguage === "en"
      ? languageSelect.dataset.targetEn
      : languageSelect.dataset.targetPtBr;

    if (!destination) {
      return;
    }

    // Persist explicit language preference.
    try {
      localStorage.setItem(
        "atlantica.language",
        selectedLanguage
      );
    } catch {
      // Navigation still works without localStorage.
    }

    const currentPath = window.location.pathname;

    const isHome =
      currentPath === "/" ||
      currentPath === "/pt-br/";

    const isGuideListing =
      currentPath === "/guides/" ||
      currentPath === "/pt-br/guides/";
    const isMonsterCatalog =
      currentPath === "/monsters/" ||
      currentPath === "/pt-br/monsters/";

    // Preserve category filters on listings.
    const query = isGuideListing || isMonsterCatalog
      ? window.location.search
      : "";

    // Preserve anchors on Home.
    const hash = isHome
      ? window.location.hash
      : "";

    window.location.assign(destination + query + hash);
  });
</script>
