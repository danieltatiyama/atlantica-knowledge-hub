---
import {sharedText} from "../i18n/shared-ui.mjs";

import { getCollection } from "astro:content";
import { LOCALE_IDS, LOCALE_NAMES, languageDestination, legacyLocale, localePrefix, catalogPath } from "../i18n/locales.mjs";
import type { Lang } from "../i18n/ui";
import { chromeText } from "../i18n/chrome";
import GlobalSearch from "./GlobalSearch.astro";
import type { CollectionEntry } from "astro:content";

interface Props {alternatePaths?: Partial<Record<Lang,string>>;}
const {alternatePaths}=Astro.props;
const siteName = "Atlantica Knowledge Hub";
const pathname = Astro.url.pathname;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const homeHref = lang === "en" ? "/" : `/${lang}/`;
const guidesHref = lang === "en" ? "/guides/" : `/${lang}/guides/`;
const eventsHref = catalogPath(lang,"/events/");
const mercenariesHref = catalogPath(lang,"/mercenaries/");
const itemsHref = catalogPath(lang,"/items/");
const allItemsHref = catalogPath(lang,"/items/database/");
const monstersHref = catalogPath(lang,"/monsters/");

const navigation = [
  {
    label: t("nav.home"),
    href: homeHref,
    active: pathname === homeHref,
  },
  {
    label: t("nav.guides"),
    href: guidesHref,
    active: pathname.startsWith(guidesHref),
  },
  {
    label: chromeText(lang,"Events",lang === "pt-br" ? "Eventos" : "Events"),
    href: eventsHref,
    active: pathname.startsWith(eventsHref),
  },
  {
    label: chromeText(lang,"Mercenaries",lang === "pt-br" ? "Mercenários" : "Mercenaries"),
    href: mercenariesHref,
    active: pathname.startsWith(mercenariesHref),
  },
  {
    label: chromeText(lang,"Equipment",lang === "pt-br" ? "Equipamentos" : "Equipment"),
    href: itemsHref,
    active: pathname.startsWith(itemsHref) && !pathname.startsWith(allItemsHref),
  },
  {
    label: chromeText(lang,"All Items",lang === "pt-br" ? "Todos os itens" : "All Items"),
    href: allItemsHref,
    active: pathname.startsWith(allItemsHref),
  },
  {
    label: chromeText(lang,"Monsters",lang === "pt-br" ? "Monstros" : "Monsters"),
    href: monstersHref,
    active: pathname.startsWith(monstersHref),
  },
  {
    label: chromeText(lang,"Tools",lang === "pt-br" ? "Ferramentas" : "Tools"),
    href: catalogPath(lang,"/tools/"),
    active: pathname.startsWith(catalogPath(lang,"/tools/")),
  },
  {
    label: t("nav.explore"),
    href: `${homeHref}#topics`,
    active: false,
  },
];


type SupportedLang = Lang;

const publishedGuides = await getCollection(
  "guides",
  ({ data }) =>
    !data.draft
);

function getGuideUrl(guide: CollectionEntry<"guides">): string {
  const prefix = guide.data.lang === "en"
    ? ""
    : `/${guide.data.lang}`;

  const slug = guide.id.replace(/^[^/]+\//, "");

  return `${prefix}/guides/${slug}/`;
}

const normalizedPath = pathname.endsWith("/")
  ? pathname
  : `${pathname}/`;

const currentGuide = publishedGuides.find(
  (guide) => getGuideUrl(guide) === normalizedPath
);

function getLanguageTarget(targetLang: SupportedLang): string {
  const guideAlternates = currentGuide ? Object.fromEntries(publishedGuides.filter(guide=>guide.data.translationKey===currentGuide.data.translationKey).map(guide=>[guide.data.lang,getGuideUrl(guide)])) : undefined;
  return languageDestination({lang:targetLang,path:normalizedPath,guideAlternates,itemAlternates:alternatePaths}) ?? "/";
}


import {
  getLangFromUrl,
  useTranslations,
} from "../i18n/utils";


---

<header class="site-header">
  <div class="header-content">
    <a class="brand" href={homeHref} aria-label={`${siteName} - ${sharedText(lang,"Home")}`}>
        <div class="brand-wordmark" aria-hidden="true">
          <span class="brand-ornament">✦</span>
          <span class="brand-name">
            ATLANTICA
            <span class="brand-name-small"> KNOWLEDGE HUB</span>
          </span>
          <span class="brand-ornament">✦</span>
        </div>
        <span class="brand-subtitle">
            Community Knowledge Hub
        </span>
    </a>


    <nav class="main-nav" aria-label={chromeText(lang,"Main navigation",lang==="pt-br"?"Navegação principal":"Main navigation")}>
      {navigation.map((item) => (
        <a
          href={item.href}
          class:list={[
            "nav-link",
            { active: item.active },
          ]}
          aria-current={item.active ? "page" : undefined}
        >
          {item.label}
        </a>
      ))}
      <button class="wiki-global-trigger" type="button" data-global-search-open
        aria-label={sharedText(lang,"Open global search")}>
        ⌕ {chromeText(lang,"Search",lang === "pt-br" ? "Buscar" : "Search")}
      </button>
    </nav>

    <div class="header-controls" role="group"
      aria-label={chromeText(lang,"Appearance and language preferences",lang === "pt-br" ? "Preferências de aparência e idioma" : "Appearance and language preferences")}>
      <div class="theme-switcher header-control-group">
        <label for="site-theme" class="theme-label header-control-label">
          {chromeText(lang,"Theme",lang === "pt-br" ? "Tema" : "Theme")}
        </label>
        <select id="site-theme" class="theme-select header-control-select"
          aria-label={chromeText(lang,"Select visual theme",lang === "pt-br" ? "Selecionar tema visual" : "Select visual theme")}>
          <option value="atlantica">Atlantica</option>
          <option value="dark">{chromeText(lang,"Dark",lang === "pt-br" ? "Escuro" : "Dark")}</option>
          <option value="light">{chromeText(lang,"Light",lang === "pt-br" ? "Claro" : "Light")}</option>
          <option value="parchment">{chromeText(lang,"Parchment",lang === "pt-br" ? "Pergaminho" : "Parchment")}</option>
          <option value="midnight">{chromeText(lang,"Midnight Blue",lang === "pt-br" ? "Azul noturno" : "Midnight Blue")}</option>
          <option value="contrast">{chromeText(lang,"High Contrast",lang === "pt-br" ? "Alto contraste" : "High Contrast")}</option>
        </select>
      </div>

      <div class="language-switcher header-control-group">
        <label for="site-language" class="language-label header-control-label">
          {chromeText(lang,"Language",lang === "pt-br" ? "Idioma" : "Language")}
        </label>
        <select translate="no" id="site-language" class="language-select header-control-select"
          aria-label={chromeText(lang,"Select language",lang === "pt-br" ? "Selecionar idioma" : "Select language")}
          >
          {LOCALE_IDS.map(locale=><option value={locale} selected={lang===locale} data-target={getLanguageTarget(locale)}>{LOCALE_NAMES[locale]}</option>)}
        </select>
      </div>
    </div>
  </div>
</header>
<GlobalSearch lang={lang} />

<style>
  .site-header {
    position: relative;
    background:
      linear-gradient(
        180deg,
        #25272b 0%,
        var(--color-header) 100%
      );
    border-bottom: 1px solid var(--color-border);
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.3);
  }

  .site-header::after {
    content: "";
    position: absolute;
    bottom: -1px;
    left: 0;
    width: 100%;
    height: 2px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      var(--color-bronze) 30%,
      var(--color-gold-light) 50%,
      var(--color-bronze) 70%,
      transparent 100%
    );
    opacity: 0.75;
    pointer-events: none;
  }

  .header-content {
    width: min(1600px, 94%);
    min-height: 96px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(180px, 1fr) auto minmax(316px, 1fr);
    align-items: center;
    column-gap: clamp(12px, 1.5vw, 28px);
  }

  /* Original typography-based branding */

  .brand-wordmark {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--color-gold-light);
  }

  .brand-ornament {
    color: var(--color-bronze);
    font-size: 15px;
  }

  .brand-name {
    display: flex;
    flex-direction: column;
    align-items: center;
    font-family: var(--font-heading);
    font-size: clamp(17px, 2vw, 24px);
    letter-spacing: 0.13em;
    line-height: 1.2;
    text-shadow: 0 2px 12px rgba(210, 164, 91, 0.2);
  }

  .brand-name-small {
    margin-top: 5px;
    color: var(--color-accent);
    font-family: var(--font-primary);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.24em;
  }

  .brand .brand-subtitle {
    display: none;
  }


  /* Brand */

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 13px;
    text-decoration: none;
    min-width: 0;
  }

  .brand-subtitle {
    margin-top: 5px;
    font-size: 10px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.19em;
    color: var(--color-text-muted);
  }

  /* Navigation */

  .main-nav {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .nav-link {
    position: relative;
    padding: 12px 17px;

    color: var(--color-text-muted);
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;

    transition:
      color 0.2s ease,
      background-color 0.2s ease;
  }

  .nav-link::after {
    content: "";
    position: absolute;
    left: 17px;
    right: 17px;
    bottom: 5px;
    height: 1px;

    background: var(--color-accent);
    transform: scaleX(0);
    transition: transform 0.2s ease;
  }

  .nav-link:hover,
  .nav-link:focus-visible,
  .nav-link.active {
    color: var(--color-gold-light);
    background: rgba(210, 164, 91, 0.05);
  }

  .nav-link:hover::after,
  .nav-link:focus-visible::after,
  .nav-link.active::after {
    transform: scaleX(1);
  }

  .brand:focus-visible,
  .nav-link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  /* Wrap only when the three columns no longer fit comfortably. */
  @media (max-width: 1560px) {
    .header-content {
      grid-template-columns: minmax(0, 1fr) auto;
      padding: 12px 0;
      row-gap: 9px;
    }
    .brand { grid-column: 1; grid-row: 1; }
    .header-controls { grid-column: 2; grid-row: 1; }
    .main-nav {
      grid-column: 1 / -1;
      grid-row: 2;
      justify-self: stretch;
      width: 100%;
      justify-content: center;
      flex-wrap: wrap;
    }
    .nav-link { padding: 8px 11px; }
    .nav-link::after { left: 11px; right: 11px; bottom: 2px; }
  }

  @media (max-width: 700px) {
    .header-content {
      grid-template-columns: minmax(0, 1fr);
      justify-items: center;
      gap: 12px;
      padding: 14px 0;
    }
    .brand { grid-column: 1; grid-row: 1; }
    .header-controls {
      grid-column: 1;
      grid-row: 2;
      justify-self: center;
      width: min(100%, 380px);
    }
    .main-nav { grid-column: 1; grid-row: 3; }
    .nav-link { padding: 8px 10px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-link,
    .nav-link::after {
      transition: none;
    }
  }

  .brand {
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 0;
  }

  .brand-subtitle {
    margin-top: -2px;
    color: var(--color-gold-light);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    align-self: center;
  }

  @media (max-width: 700px) {
    .brand {
        align-items: center;
    }
  }
    
  /* Keep the nav centred and the preferences together in one grid area. */
  .main-nav {
    justify-self: center;
    justify-content: center;
    gap: 4px;
    min-width: 0;
  }
  .nav-link { padding: 10px 12px; white-space: nowrap; }

  .header-controls {
    display: grid;
    grid-template-columns: minmax(0, 148px) minmax(0, 170px);
    align-items: end;
    gap: 12px;
    justify-self: end;
    min-width: 0;
  }
  .header-control-group {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    min-width: 0;
    gap: 5px;
  }
  .header-control-label {
    position: static;
    display: block;
    width: auto;
    height: auto;
    padding: 0;
    margin: 0;
    overflow: visible;
    clip: auto;
    white-space: normal;
    border: 0;
    color: var(--color-text-muted);
    font-size: .72rem;
    font-weight: 600;
    line-height: 1.2;
  }
  .header-control-select {
    box-sizing: border-box;
    width: 100%;
    min-width: 0;
    height: 40px;
    margin: 0;
    padding: 0 11px;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    background: var(--color-surface);
    color: var(--color-gold-light);
    font-family: var(--font-primary);
    font-size: .85rem;
    line-height: normal;
    cursor: pointer;
  }
  .header-control-select option {
    color: var(--color-text);
    background: var(--color-surface);
  }
  .header-control-select:hover { border-color: var(--color-accent); }
  .header-control-select:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  @media (max-width: 700px) {
    .header-controls {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 340px) {
    .header-controls {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  /* Keep responsive rules after the base component rules in the cascade. */
  @media (max-width: 1560px) {
    .main-nav { justify-self: stretch; }
    .nav-link { padding: 8px 11px; }
  }
  @media (max-width: 700px) {
    .nav-link { padding: 8px 10px; }
  }

</style>

<script>
  // One site-wide, bilingual appearance selector.
  // The head bootstrap reads the same key before first paint.
  const themeSelect = document.querySelector<HTMLSelectElement>("#site-theme");
  const themes = new Set([
    "atlantica", "dark", "light", "parchment", "midnight", "contrast"
  ]);
  const savedTheme = document.documentElement.dataset.theme || "atlantica";
  if (themeSelect) {
    themeSelect.value = themes.has(savedTheme) ? savedTheme : "atlantica";
    themeSelect.addEventListener("change", () => {
      const selectedTheme = themeSelect.value;
      if (!themes.has(selectedTheme)) return;
      document.documentElement.dataset.theme = selectedTheme;
      try {
        localStorage.setItem("atlantica.theme", selectedTheme);
      } catch {
        // The selection still works when persistence is unavailable.
      }
    });
    window.addEventListener("storage", (event) => {
      if (event.key !== "atlantica.theme") return;
      const next = themes.has(event.newValue) ? event.newValue : "atlantica";
      document.documentElement.dataset.theme = next;
      themeSelect.value = next;
    });
  }

  const languageSelect =
    document.querySelector<HTMLSelectElement>(
      "#site-language"
    );

  languageSelect?.addEventListener("change", () => {
    const selectedLanguage = languageSelect.value;

    const destination = languageSelect.selectedOptions[0]?.dataset.target;

    if (!destination) {
      return;
    }

    // Persist explicit language preference.
    try {
      localStorage.setItem(
        "atlantica.language",
        selectedLanguage
      );
    } catch {
      // Navigation still works without localStorage.
    }

    const currentPath = window.location.pathname;

    const isHome =
      /^\/(?:pt-br\/|fr\/|de\/|es\/|ko\/|zh-hans\/|ja\/)?$/.test(currentPath);

    const isGuideListing =
      /^(?:\/(?:pt-br|fr|de|es|ko|zh-hans|ja))?\/guides\/$/.test(currentPath);
    const isMonsterCatalog =
      /^(?:\/(?:pt-br|fr|de|es|ko|zh-hans|ja))?\/monsters(?:\/profile)?\/$/.test(currentPath);

    const isItemDatabase = /^(?:\/(?:pt-br|fr|de|es|ko|zh-hans|ja))?\/items\/(?:database|profile)\/$/.test(currentPath);
    const isNationCalendar = /^(?:\/(?:pt-br|fr|de|es|ko|zh-hans|ja))?\/tools\/nation-dungeons\/$/.test(currentPath);
    const isCraftingPlanner = /^(?:\/(?:pt-br|fr|de|es|ko|zh-hans|ja))?\/tools\/crafting\/$/.test(currentPath);
    // Preserve category filters, selected ItemID and shared calendar plan.
    const query = isGuideListing || isMonsterCatalog || isItemDatabase || isNationCalendar || isCraftingPlanner
      ? window.location.search
      : "";

    // Preserve anchors on Home.
    const hash = isHome || isMonsterCatalog || isItemDatabase
      ? window.location.hash
      : "";

    window.location.assign(destination + query + hash);
  });
</script>
