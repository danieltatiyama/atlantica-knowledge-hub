---
import BaseLayout from "../layouts/BaseLayout.astro";
import { complementaryText } from "../i18n/complementary-ui.mjs";
import { localePrefix, localeTag, localizedPaths, legacyLocale, equipmentProfilePath } from "../i18n/locales.mjs";
import facts from "../data/extended-equipment-facts.json";
import { getReviewedExtendedFacts } from "../data/extended-equipment-facts-gate.mjs";
import { EQUIPMENT_ITEM_NAMES_EN } from "../data/equipment-item-names-en";

interface Props { lang: string; slug: string; }
const {lang,slug}=Astro.props;
const prefix=localePrefix(lang);
const all=getReviewedExtendedFacts(facts,EQUIPMENT_ITEM_NAMES_EN);
const item=all.find(entry=>entry.slug===slug);
if(!item)throw new Error("Unreviewed extended equipment slug; cannot render");
const n=(value:number)=>new Intl.NumberFormat(localeTag(lang)).format(value);
const base=item.derived.bareL;
const gems=item.socketedModifiers;
const observed=item.observedTooltip;
const derived=item.derived;
const stats=[
 {label:complementaryText(lang,"Attack","Ataque"),observed:n(observed.attackMin)+" – "+n(observed.attackMax),
   base:n(base.attackMin)+" – "+n(base.attackMax),
   stones:"+"+n(derived.socketAttackTotal.min)+" – +"+n(derived.socketAttackTotal.max)},
 {label:complementaryText(lang,"Strength","Força"),observed:"+"+n(observed.strength)},
 {label:complementaryText(lang,"Intelligence","Inteligência"),observed:"+"+n(observed.intelligence)},
 {label:complementaryText(lang,"Vitality","Vitalidade"),observed:"+"+n(observed.vitality)},
 {label:"Critical",observed:n(observed.critical),stones:"+"+n(gems.count*gems.perStone.criticalRate)},
 {label:"Multi-Hit Rate",observed:n(observed.multiHitRate),stones:"+"+n(gems.count*gems.perStone.multiHitRate)},
 {label:"AP Mod.",observed:n(observed.actionPowerMod),stones:"+"+n(gems.count*gems.perStone.action)},
 {label:"Magic Skill Lv.",observed:"+"+n(observed.magicSkillLevelBonus)},
];
---
<BaseLayout lang={lang} title={item.nameEn+" — L | Atlantica Knowledge Hub"}
 description={complementaryText(lang,"Screenshot-documented Legendary equipment profile separating intrinsic stats from socket modifiers.","Ficha documentada a partir de screenshot de equipamento lendário, separando atributos e bônus de pedras.")}
 alternatePaths={localizedPaths("/items/legendary/"+slug+"/")}>
 <main class="container">
   <nav class="breadcrumb"><a href={prefix+"/items/legendary/"}>{complementaryText(lang,"← Legendary enhancement","← Encantamento L")}</a></nav>
   <article>
    <header>
      <p class="eyebrow">{complementaryText(lang,"ITEM PROFILE • IN-GAME EVIDENCE","FICHA DE EQUIPAMENTO • EVIDÊNCIA DO JOGO")}</p>
      <h1><span class="legend">L</span> {item.nameEn}</h1>
      <p class="lead">{complementaryText(lang,"An in-game Legendary configuration with three Star Stones. The numeric item ID has not yet been reconciled with the public catalog.","Uma configuração lendária observada no jogo, com três Star Stones. O ID numérico do item ainda não foi conciliado com o catálogo público.")}</p>
      <div class="summary">
        <div><span>{complementaryText(lang,"Type","Tipo")}</span><strong>{item.typeEn}</strong></div>
        <div><span>{complementaryText(lang,"Minimum level","Nível mínimo")}</span><strong>Lv. {item.minimumLevel}</strong></div>
        <div><span>{complementaryText(lang,"Grade","Grau")}</span><strong>{item.grade}</strong></div>
      </div>
    </header>

    <nav class="toc">
      <a href="#stats">{complementaryText(lang,"Stats","Atributos")}</a>
      <a href="#sockets">Star Stones</a>
      <a href="#classes">{complementaryText(lang,"Classes","Classes")}</a>
      <a href="#effects">{complementaryText(lang,"Effects","Efeitos")}</a>
      <a href="#crafting">{complementaryText(lang,"Crafting","Fabricação")}</a>
      <a href="#references">{complementaryText(lang,"References","Referências")}</a>
    </nav>

    <section id="stats">
      <h2>{complementaryText(lang,"Stats: observed configuration","Atributos: configuração observada")}</h2>
      <p class="note">{complementaryText(lang,"The final column is the in-game tooltip reading. The bare L value is an estimate from +0 × 4.3; the Star Stone contributions come from the tooltip. These are different evidence types.","A coluna final é a leitura do tooltip do jogo. O valor lendário sem pedras é uma estimativa baseada em +0 × 4,3; as contribuições das pedras vêm do tooltip. Não confundir os três.")}</p>
      <div class="table-scroll"><table>
        <thead><tr>
          <th>{complementaryText(lang,"Stat","Atributo")}</th>
          <th>{complementaryText(lang,"Bare L (model)","L sem pedras (modelo)")}</th>
          <th>{complementaryText(lang,"Stone contributions","Bônus das pedras")}</th>
          <th>{complementaryText(lang,"Equipped L (screenshot)","L equipado (captura)")}</th>
        </tr></thead>
        <tbody>{stats.map(s=><tr>
          <th scope="row">{s.label}</th>
          <td>{s.base??"—"}</td>
          <td>{s.stones??"—"}</td>
          <td class="observed-value">{s.observed}</td>
        </tr>)}</tbody>
      </table></div>
      <p class="footnote">{complementaryText(lang,"Strength, Intelligence and Vitality +1,715 are in the screenshot, but the historic +0 table does not establish the origin of Intelligence. Magic Skill Lv. +48 is likewise a tooltip observation.","Força, Inteligência e Vitalidade +1.715 constam no tooltip, mas não deduzimos automaticamente a origem da Inteligência a partir da tabela comunitária +0. Magic Skill Lv. +48 também é um valor do tooltip.")}</p>
    </section>

    <section id="sockets">
      <h2>{complementaryText(lang,"Equipped Star Stones","Pedras equipadas (Star Stones)")}</h2>
      <p><strong>{gems.count} × {gems.itemName}</strong></p>
      <div class="table-scroll"><table>
        <thead><tr><th>{complementaryText(lang,"Stat","Atributo")}</th>
          <th>{complementaryText(lang,"Per stone","Cada pedra")}</th>
          <th>{complementaryText(lang,"All stones","Três pedras")}</th></tr></thead>
        <tbody>
          <tr><th>Critical Rate</th><td>+{gems.perStone.criticalRate}</td><td>+{gems.count*gems.perStone.criticalRate}</td></tr>
          <tr><th>Multi-Hit Rate</th><td>+{gems.perStone.multiHitRate}</td><td>+{gems.count*gems.perStone.multiHitRate}</td></tr>
          <tr><th>Action</th><td>+{gems.perStone.action}</td><td>+{gems.count*gems.perStone.action}</td></tr>
          <tr><th>{complementaryText(lang,"Attack Enhance","Aumento de ataque")}</th>
            <td>+{gems.perStone.attackEnhancePercent}%<small>
              (+{n(gems.perStone.displayedAttackBonusMin)} – +{n(gems.perStone.displayedAttackBonusMax)})</small></td>
            <td>+{n(derived.socketAttackTotal.min)} – +{n(derived.socketAttackTotal.max)}</td>
          </tr>
        </tbody>
      </table></div>
      <p class="formula">{complementaryText(lang,"Attack reconciliation","Conferência do ataque")}:
        {n(base.attackMin)} + {gems.count} × {n(derived.perStoneAttack.min)} = <strong>{n(observed.attackMin)}</strong>
        {" · "}
        {n(base.attackMax)} + {gems.count} × {n(derived.perStoneAttack.max)} = <strong>{n(observed.attackMax)}</strong>
      </p>
      <p class="footnote">{complementaryText(lang,"The exact match supports this mathematical decomposition, but the unmodified L attack was not observed separately in this screenshot.","A coincidência exata sustenta a decomposição matemática, mas o valor sem pedras não foi medido isoladamente nesta captura.")}</p>
    </section>

    <section id="classes">
      <h2>{complementaryText(lang,"Class restrictions","Classes permitidas")}</h2>
      <p class="note">{complementaryText(lang,"Labels retained as shown in the screenshot, including repeated class labels.","Rótulos preservados conforme a captura, inclusive ocorrências repetidas.")}</p>
      <div class="class-list">{item.eligibleClasses.map(c=><span>{c}</span>)}</div>
    </section>

    <section id="effects">
      <h2>{complementaryText(lang,"Special effects","Efeitos especiais")}</h2>
      {item.specialEffects.map(effect=><div class="effect">
        <strong>{effect.kind==="legendary-debuff"
          ?(complementaryText(lang,"Legendary weapon debuff","Debuff de arma lendária"))
          :(complementaryText(lang,"Conditional class bonus","Bônus condicional de classe"))}</strong>
        <p>{complementaryText(lang,effect.descriptionEn,effect.descriptionPt)}</p>
      </div>)}
      <p class="footnote">{complementaryText(lang,"Special effects were not derived from enchantment scaling or automatically added to raw attack stats.","Efeitos especiais não foram derivados da fórmula de encantamento nem somados automaticamente aos atributos físicos.")}</p>
    </section>

    <section id="crafting">
      <h2>{complementaryText(lang,"Crafting and acquisition","Fabricação e obtenção")}</h2>
      <p class="note">{complementaryText(lang,"Historical community documentation lists this item as not craftable. The screenshot does not establish a recipe, materials, drop location or acquisition chance for the current game.","A documentação comunitária histórica indica que não é fabricável. A captura não informa receita, materiais, local de drop ou chance de obtenção; permanecem não verificados para a versão atual.")}</p>
    </section>

    <section id="references">
      <h2>{complementaryText(lang,"Sources and confidence","Referências e confiança")}</h2>
      <dl class="sources">
        <div><dt>{complementaryText(lang,"Equipment and Star Stone tooltip","Leitura do item e Star Stones")}</dt>
          <dd>{item.evidence.tooltip.label} — <strong>{complementaryText(lang,"observed in-game","observado no jogo")}</strong></dd></div>
        <div><dt>{complementaryText(lang,"Historic +0 stats and modeled L","Atributos +0 e projeção L")}</dt>
          <dd><a href={item.evidence.baseline.url} target="_blank" rel="noopener noreferrer">
            {item.evidence.baseline.label}</a> — {complementaryText(lang,"historical model","modelo histórico")}</dd></div>
        <div><dt>{complementaryText(lang,"Crafting","Fabricação")}</dt>
          <dd><a href={item.evidence.crafting.url} target="_blank" rel="noopener noreferrer">
            {item.evidence.crafting.label}</a> — {complementaryText(lang,"historical","histórico")}</dd></div>
      </dl>
    </section>
   </article>
 </main>
</BaseLayout>
<style>
  .container{width:min(var(--content-width),92%);max-width:1140px;margin:auto;padding:0 0 85px}
  .breadcrumb{padding:24px 0}.breadcrumb a,a{color:var(--color-accent)}
  article>header{border-bottom:1px solid var(--color-border);padding:10px 0 30px}
  .eyebrow{color:var(--color-accent);font-size:.82rem;letter-spacing:.12em}
  h1{font-size:clamp(2rem,4.7vw,3.2rem);margin:12px 0}
  .legend{display:inline-block;padding:1px 14px;background:#51266b;color:#f2d2ff;
    border:1px solid #ba84dc;border-radius:4px}
  .lead,.note,.footnote{color:var(--color-text-muted);line-height:1.7}
  .summary{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin:25px 0 0}
  .summary>div{background:var(--color-surface);border:1px solid var(--color-border);
    padding:14px;border-radius:5px}
  .summary span{display:block;font-size:.85rem;color:var(--color-text-muted)}
  .summary strong{display:block;font-size:1.16rem;margin-top:4px;color:var(--color-gold-light)}
  .toc{display:flex;gap:12px;flex-wrap:wrap;padding:19px 0 0}
  .toc a{text-decoration:none;border:1px solid var(--color-border);
    padding:7px 11px;border-radius:4px;background:var(--color-surface)}
  section{margin-top:38px}
  h2{font-size:1.5rem;color:var(--color-gold-light);margin:0 0 16px}
  .table-scroll{overflow-x:auto;border:1px solid var(--color-border);border-radius:5px}
  table{border-collapse:collapse;min-width:620px;width:100%;font-variant-numeric:tabular-nums}
  th,td{padding:11px 15px;text-align:left;border-bottom:1px solid var(--color-border)}
  th{color:var(--color-gold-light)}thead th{background:#29271f}
  .observed-value{color:#e4b8ff;font-weight:700;background:rgba(117,73,159,.16)}
  td small{display:block;font-size:.85rem;color:var(--color-text-muted)}
  .class-list{display:flex;gap:7px;flex-wrap:wrap}
  .class-list span{border:1px solid var(--color-border);border-radius:3px;
    background:var(--color-surface);padding:5px 10px;font-size:.9rem}
  .effect{background:var(--color-surface);border-left:3px solid #9261b1;
    padding:12px 18px;margin:12px 0}
  .effect p{margin:6px 0}
  .footnote{font-size:.89rem}
  .formula{margin:16px 0;padding:12px;background:var(--color-surface);color:var(--color-gold-light);
    overflow-wrap:anywhere}
  .sources>div{padding:12px 0;border-bottom:1px solid var(--color-border)}
  .sources dt{color:var(--color-text-muted);font-size:.88rem}
  .sources dd{margin:4px 0}
  @media(max-width:650px){.summary{grid-template-columns:1fr}.container{width:94%}}
</style>
