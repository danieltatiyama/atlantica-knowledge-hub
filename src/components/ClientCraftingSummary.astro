---
import {equipmentText} from "../i18n/equipment-ui.mjs";
import {localePrefix,localeTag,legacyLocale,localizedPaths} from "../i18n/locales.mjs";
import type {Lang} from "../i18n/ui";
import type {ClientEquipmentFacts} from "../data/client-equipment-facts";
import {CLIENT_EQUIPMENT_SOURCE_SNAPSHOT} from "../data/client-equipment-facts";
import {summarizeClientCrafting} from "../data/client-equipment-crafting-summary.mjs";
import {summarizeCraftBatch} from "../data/client-craft-batch.mjs";

interface Props {lang:Lang; item?:ClientEquipmentFacts;}
const {lang,item}=Astro.props;
const prefix=localePrefix(lang);
const source=item?summarizeClientCrafting(item):null;
// This component receives verified equipment candidates only; apply the
// player-confirmed 1-per-batch, 20-per-operation rule while preserving raw Unit.
const batch=item?summarizeCraftBatch(item.sourceDefinitions,{equipment:true}):null;
const batchReady=batch?.batchSize!==null&&batch?.maxBatchesPerOperation>0;
const fmt=new Intl.NumberFormat(lang==="en"?"en-US":localeTag(lang));
const isConflict=source?.status==="different-source-materials";
const fmtRaw=value=>value===null?"—":/^[0-9]{1,15}$/.test(value)
  ?fmt.format(Number(value)):value;
---
{item&&source&&<section id="client-crafting" class="client-crafting">
  <div class="header-row">
    <div>
      <p class="eyebrow">{equipmentText(lang,"CLIENT SOURCE FILES","ARQUIVOS DO CLIENTE")}</p>
      <h2>{equipmentText(lang,"Materials and crafting source data","Materiais e dados de fabricação")}</h2>
    </div>
    <small>{equipmentText(lang,"Miner snapshot","Snapshot do Miner")} {CLIENT_EQUIPMENT_SOURCE_SNAPSHOT}</small>
  </div>
  <p class="note">{equipmentText(lang,"Material IDs and quantities come from ItemType*.ndt tables. A material record does not prove the recipe is currently available in the in-game crafting UI or establish where materials can be obtained.","As quantidades e IDs são extraídos das tabelas ItemType*.ndt. O registro de materiais não confirma que a receita esteja disponível na interface de fabricação do jogo atual, nem indica como obter os itens.")}</p>
  <div class="batch-information">
    <h3>{equipmentText(lang,"Production batches","Produção em batches")}</h3>
    {batchReady&&batch?<p>
      <strong>{fmt.format(batch.batchSize)}</strong>
      <span>{equipmentText(lang,"unit per batch (equipment rule)","unidade por batch (regra do equipamento)")}</span>
      <span>{equipmentText(lang,"Steps of","Incrementos de")} {fmt.format(batch.increment)}</span>
      <span>{equipmentText(lang,"Maximum output per operation","Limite por operação")}: {fmt.format(batch.maxPerOperation)}</span>
      <span>{equipmentText(lang,"Up to","Até")} {fmt.format(batch.maxBatchesPerOperation)} batches</span>
    </p>:<p class="note">{batch?.status==="conflict"?
      (equipmentText(lang,"Conflicting original Unit values; no canonical batch.","Unit diverge nos arquivos; batch não consolidado.")) :
      (equipmentText(lang,"No original batch quantity identified.","Tamanho do batch não identificado nas fontes originais."))}</p>}
    {batch?.originalUnitStatus==="partial"&&<p class="note">{equipmentText(lang,"Unit is present in only some original ItemType source rows; the partial coverage is preserved.","Unit consta somente em parte dos registros ItemType; essa diferença permanece identificada.")}</p>}
    <small>{equipmentText(lang,"The player-confirmed equipment rule is 1 unit per batch and at most 20 per operation. The original Unit field remains available in the source section and may be missing. Current-server recipe availability is not verified.","Para equipamentos, a regra confirmada pelo jogador é 1 unidade por batch e máximo de 20 por operação. O campo Unit original permanece exibido na seção técnica e pode estar ausente. A disponibilidade atual da receita não está comprovada.")}</small>
  </div>
  <div class="raw-metadata">
    {[
      {key:"levelRaw",label:equipmentText(lang,"Raw item level","Nível bruto do item")},
      {key:"gradeRaw",label:equipmentText(lang,"Raw client grade","Grade bruta do cliente")},
      {key:"workRaw",label:equipmentText(lang,"Work (raw field)","Work (valor bruto)")},
      {key:"unitRaw",label:equipmentText(lang,"Unit (raw field)","Unit (valor bruto)")},
    ].map(row=><div class="raw-field">
      <span>{row.label}</span>
      <strong>{source.fields[row.key].status==="conflict"
        ?(equipmentText(lang,"Source conflict","Divergência entre arquivos"))
        :fmtRaw(source.fields[row.key].value)}</strong>
      {source.fields[row.key].status==="partial"&&<small>{equipmentText(lang,"Only some sources","Apenas em parte das fontes")}</small>}
    </div>)}
  </div>
  {source.recipes.length>0 ? (
    <>
      {isConflict&&<p class="warning">{equipmentText(lang,"Source files contain different material lists. No preferred recipe was chosen.","As fontes apresentam receitas diferentes. Nenhuma foi escolhida como definitiva.")}</p>}
      {source.status==="partial-source-materials"&&<p class="warning">{equipmentText(lang,"Only some files contain materials; missing lists do not imply zero quantities.","Algumas fontes possuem lista de materiais e outras não. A ausência não significa quantidade zero.")}</p>}
      {source.recipes.map((recipe,index)=><div class="recipe-card">
        {source.recipes.length>1&&<h3>{equipmentText(lang,"Definition","Definição")} {index+1}</h3>}
        <div class="recipe-meta">{equipmentText(lang,"Matching source records","Fontes concordantes")}:
          {" "}{recipe.sourceFiles.map((file,index)=>file+" (#"+recipe.sourceRecordIds[index]+")").join(" · ")}
        </div>
        <div class="table-scroll"><table>
          <thead><tr><th>{equipmentText(lang,"Source material","Material registrado")}</th>
            <th>{equipmentText(lang,"ID","ID")}</th><th>{equipmentText(lang,"Quantity","Quantidade")}</th></tr></thead>
          <tbody>{recipe.materials.map(material=><tr>
            <td>
              <a href={prefix+"/items/database/?id="+encodeURIComponent(material.itemId)}>{material.nameEn??(equipmentText(lang,"Unverified name","Nome não validado"))}</a>
              <small class="recipe-obtain-link"><a href={prefix+"/monsters/?item="+encodeURIComponent(material.itemId)}>{equipmentText(lang,"Find original monster drops","Consultar drops do cliente")}</a></small>
            </td>
            <td><code>{material.itemId}</code></td>
            <td class="quantity">{fmt.format(material.quantity)}</td>
          </tr>)}</tbody>
        </table></div>
      </div>)}
    </>
  ) : <p class="warning">{source.status==="unparsed-source-materials"
    ?(equipmentText(lang,"Some material expressions could not be decoded; no value was estimated.","Existem expressões de materiais que ainda não foram decodificadas; nenhum valor foi estimado."))
    :(equipmentText(lang,"No structured material list was found. This is not proof the item cannot be crafted.","Nenhuma lista estruturada de materiais foi encontrada. Isso não comprova que o item seja impossível de fabricar."))}</p>}
  {source.missingMaterialNames>0&&<p class="warning">{equipmentText(lang,"{count} material references lack a reviewed English name.","{count} referência(s) de material permanecem sem nome inglês validado.",{count:source.missingMaterialNames})}</p>}
  {Object.entries(source.fields).some(([key,value])=>value.status==="conflict")&&<details class="conflicts">
    <summary>{equipmentText(lang,"Inspect conflicting source metadata","Revisar valores divergentes nos metadados")}</summary>
    {Object.entries(source.fields).filter(([key,field])=>field.status==="conflict").map(([key,field])=>
      <p><strong>{key}</strong>: {field.observations.map(o=>`#${o.recordId}: ${o.value}`).join(" · ")}</p>)}
  </details>}
  <p class="note footer">{equipmentText(lang,"Material names were joined by exact item ID to their client official English names, not independently translated. Class restrictions and crafting skills require separate source fields.","Os nomes dos materiais foram associados a seus IDs oficiais em inglês na mesma extração do cliente; não são traduções próprias. Classes permitidas e habilidade de fabricação exigem análise de campos distintos.")}</p>
</section>}
<style>
  .client-crafting{margin:32px 0;padding:18px 20px;border:1px solid var(--color-border);
    border-radius:5px;background:var(--color-surface)}
  .header-row{display:flex;align-items:start;justify-content:space-between;gap:12px;flex-wrap:wrap}
  .eyebrow{margin:0 0 6px;color:var(--color-accent);font-size:.76rem;letter-spacing:.11em}
  h2{margin:0;color:var(--color-gold-light);font-size:1.48rem}
  .header-row small{color:var(--color-text-muted)}
  .note{font-size:.87rem;line-height:1.6;color:var(--color-text-muted)}
  .batch-information{padding:12px 14px;margin:14px 0;
    border:1px solid var(--color-card-border);background:var(--color-background);border-radius:5px}
  .batch-information h3{margin:0 0 10px}
  .batch-information p{display:flex;flex-wrap:wrap;gap:8px 14px;align-items:baseline;margin:8px 0}
  .batch-information strong{font-size:1.25rem;color:var(--color-gold-light)}
  .batch-information small{color:var(--color-text-muted);font-size:.77rem;line-height:1.6}
  .raw-metadata{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,180px),1fr));gap:10px;margin:18px 0}
  .raw-field{padding:11px 12px;border:1px solid var(--color-border);border-radius:4px;
    display:flex;flex-direction:column;gap:4px}
  .raw-field span{font-size:.8rem;color:var(--color-text-muted)}
  .raw-field strong{font-size:1rem;color:var(--color-text)}
  .raw-field small{color:var(--color-gold-light);font-size:.72rem}
  .recipe-card{border:1px solid var(--color-border);border-radius:4px;overflow:hidden;margin:14px 0}
  h3{margin:12px;font-size:1rem;color:var(--color-gold-light)}
  .recipe-meta{padding:10px 12px;font-size:.8rem;line-height:1.5;
    color:var(--color-text-muted);overflow-wrap:anywhere}
  .table-scroll{overflow-x:auto}
  table{width:100%;border-collapse:collapse}
  th,td{padding:9px 12px;text-align:left;border-top:1px solid var(--color-border);
    font-size:.86rem}
  th{font-weight:600;color:var(--color-gold-light)}
  td{color:var(--color-text)}
  td a{color:var(--color-accent);text-decoration:underline;text-underline-offset:2px}
  .recipe-obtain-link{display:block;margin-top:5px;font-size:.73rem}
  .recipe-obtain-link a{color:var(--color-text-muted);text-decoration:underline;text-underline-offset:2px}
  .quantity{text-align:right;font-variant-numeric:tabular-nums}
  .warning{border-left:3px solid var(--color-bronze);padding:10px 12px;
    color:var(--color-text-muted);font-size:.88rem}
  .conflicts{border:1px solid var(--color-border);border-radius:4px}
  .conflicts summary{cursor:pointer;padding:12px}
  .conflicts p{padding:0 12px}
  .footer{margin-top:16px}
  @media(max-width:620px){.client-crafting{padding:13px}}
</style>
