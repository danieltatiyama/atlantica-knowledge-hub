---
import BaseLayout from "../layouts/BaseLayout.astro";
import { complementaryText } from "../i18n/complementary-ui.mjs";
import { localePrefix, localeTag, localizedPaths, legacyLocale, equipmentProfilePath } from "../i18n/locales.mjs";
import { getEquipmentBoxBySlug } from "../data/equipment-box-registry";
import type { EquipmentBoxEntry } from "../data/equipment-box-registry";
import { getCapturedEquipmentPool, decodedEnhancementCandidate } from "../data/equipment-box-captured-pools";
import { getCapturedSelectionPool } from "../data/equipment-box-selection-pools";
import { getEquipmentItemEnglishName } from "../data/equipment-item-names-en";

interface Props { lang: string; entry: EquipmentBoxEntry; }
const {lang,entry}=Astro.props;
const base=localePrefix(lang)+"/items/boxes/";
const parent=entry.baseSlug ? getEquipmentBoxBySlug(entry.baseSlug) : undefined;
const captured=getCapturedEquipmentPool(entry.itemUniqueId);
const selection=getCapturedSelectionPool(entry.itemUniqueId);
const capturedBase=parent ? getCapturedEquipmentPool(parent.itemUniqueId) : undefined;
const missingFromVariant=captured && capturedBase
  ? capturedBase.itemUniqueIds.filter(id=>!captured.itemUniqueIds.includes(id))
  : [];
const grades=captured?.gradeCodes.map(code=>({
  code,enhancement:decodedEnhancementCandidate(code)
})) ?? [];
const description=selection
  ? (complementaryText(lang,"11 selectable equipment IDs recovered from the game-transmitted selection screen.","Lista de 11 opções de seleção identificadas na interface transmitida pelo jogo."))
  : captured
  ? (complementaryText(lang,"Equipment item IDs transmitted during an in-game box opening. Drop probabilities unverified.","Relação de IDs de equipamentos transmitida pelo jogo durante a abertura. Probabilidades não verificadas."))
  : (complementaryText(lang,"Box identified in-game. Item list not yet captured and drop probabilities unknown.","Box identificada no jogo. Lista de resultados ainda não capturada e probabilidades desconhecidas."));
---
<BaseLayout lang={lang} title={entry.name+" | Atlantica Knowledge Hub"} description={description}
  alternatePaths={localizedPaths("/items/boxes/"+entry.slug+"/")}>
  <main class="container">
    <nav class="crumb"><a href={base}>{complementaryText(lang,"← Back to boxes","← Voltar às boxes")}</a></nav>
    <article class="article">
      <header>
        <p class="eyebrow">{complementaryText(lang,"EQUIPMENT BOX CATALOG","CATÁLOGO DE EQUIPMENT BOXES")} · GLOBAL</p>
        <h1>{entry.name}</h1>
        <p class="intro">{description}</p>
        <div class="meta">
          <span>{complementaryText(lang,"Box ID","ID da box")}: {entry.itemUniqueId}</span>
          <span>{complementaryText(lang,"Text ID","ID de texto")}: {entry.nameTextId}</span>
          <span>{entry.group==="variant" ? (complementaryText(lang,"Variant","Variante")) : (complementaryText(lang,"Standard box","Box padrão"))}</span>
          {captured && <span>{captured.itemUniqueIds.length} {complementaryText(lang,"listed equipment items","equipamentos listados")}</span>}
          {selection && <span>{selection.itemUniqueIds.length} {complementaryText(lang,"selection choices identified","opções identificadas")}</span>}
          {entry.interaction==="selection" && <span>{complementaryText(lang,"Equipment selection","Escolha de equipamento")}</span>}
        </div>
      </header>

      {parent && <p class="parent">
        {complementaryText(lang,"Base box","Box-base")}: <a href={base+parent.slug+"/"}>{parent.name}</a>.
      </p>}

      <section>
        <h2>{complementaryText(lang,"Associated equipment","Equipamentos associados")}</h2>
        {entry.setName && <p>
          {complementaryText(lang,"Associated family","Família associada")}: <strong>{entry.setName}</strong>
          {entry.setLevel ? " ("+(complementaryText(lang,"level ","nível "))+entry.setLevel+")" : ""}.
        </p>}

        {selection ? (
          <>
            <p class="notice">{complementaryText(lang,"This box lets players choose equipment. The list was captured in a 0x2139 selection message; it is not a random drop pool.","Esta box permite escolher um equipamento. A lista foi obtida da mensagem 0x2139 durante a abertura; não é um sorteio com chances de drop.")}</p>
            <div class="table-scroll"><table>
              <thead><tr><th>#</th><th>{complementaryText(lang,"Selectable item ID","ID do item selecionável")}</th><th>{complementaryText(lang,"Name","Nome")}</th></tr></thead>
              <tbody>{selection.itemUniqueIds.map((id,i)=><tr>
                <td>{i+1}</td><td><code>{id}</code></td>
                <td>{getEquipmentItemEnglishName(id) ? <a href={equipmentProfilePath(lang,id,true)}>{getEquipmentItemEnglishName(id)}</a> : (complementaryText(lang,"Name pending","Nome pendente"))}</td>
              </tr>)}</tbody>
            </table></div>
            <p class="soft">{complementaryText(lang,"The chosen item and its enhancement grade require separate verification. Player choices have no random drop percentage.","A escolha e o grau do equipamento ainda devem ser validados separadamente. Nenhuma probabilidade se aplica à escolha do jogador.")}</p>
          </>
        ) : captured ? (
          <>
            <p class="notice">{complementaryText(lang,"This list was transmitted by the game during a real opening. It does not establish equal odds, guaranteed outcomes or the absence of additional conditions.","Esta lista foi transmitida pelo jogo durante uma abertura real. Ela não comprova chances iguais, resultados garantidos nem ausência de condições adicionais.")}</p>
            <p>
              <strong>{complementaryText(lang,"Likely listed enhancement grades","Graus prováveis mostrados")}:</strong>
              {" "}{grades.map(g=>g.enhancement===undefined?"?":"+"+g.enhancement).join(", ")}
              <span class="soft"> ({complementaryText(lang,"codes","códigos")}: {captured.gradeCodes.join(", ")})</span>.
            </p>
            <p>
              <strong>{complementaryText(lang,"Observed return","Retorno observado")}:</strong>
              {" "}{complementaryText(lang,"Item ID","ID do item")} <code>{captured.observedItemId}</code>
              {" "}({complementaryText(lang,"likely grade","grau provável")} +{decodedEnhancementCandidate(captured.observedGradeCode)??"?"}).
              {" "}{complementaryText(lang,"One sample, not an odds estimate.","Uma amostra, não uma estimativa de chance.")}
            </p>
            {missingFromVariant.length>0 && <p class="notice">
              {complementaryText(lang,"This variant's preview did not include some IDs present in the base box: ","A prévia desta variante não incluiu alguns IDs presentes na box-base: ")}
              <strong>{missingFromVariant.join(", ")}</strong>.
              {complementaryText(lang," They have not been added by assumption."," Não foram adicionados automaticamente.")}
            </p>}
            {captured.repeatedIdenticalPairs>0 && <p class="notice">
              {complementaryText(lang,"The preview contained repeated identical item+grade pairs. Repetitions are not treated as drop weights.","A prévia continha pares idênticos de item+grau repetidos. As repetições não foram interpretadas como pesos de sorteio.")}
            </p>}
            <div class="table-scroll"><table>
              <thead><tr>
                <th>#</th><th>{complementaryText(lang,"Equipment (Unique ID)","Equipamento (ID Unique)")}</th>
                <th>{complementaryText(lang,"Preview grades","Graus possíveis na prévia")}</th><th>{complementaryText(lang,"Chance","Chance")}</th>
              </tr></thead>
              <tbody>
                {captured.itemUniqueIds.map((id,index)=><tr>
                  <td>{index+1}</td>
                  <td><strong>{getEquipmentItemEnglishName(id) ? <a href={equipmentProfilePath(lang,id,true)}>{getEquipmentItemEnglishName(id)}</a> : (complementaryText(lang,"Name pending","Nome pendente"))}</strong><span class="item-id"> ID {id}</span></td>
                  <td>{grades.map(g=>g.enhancement===undefined?"?":"+"+g.enhancement).join(", ")}</td>
                  <td>—</td>
                </tr>)}
              </tbody>
            </table></div>
            <p class="soft">{captured.itemUniqueIds.length} {complementaryText(lang,"distinct item IDs","IDs distintos")} ·
              {" "}{captured.rawPreviewPositionCount} {complementaryText(lang,"transmitted positions","posições transmitidas")}.
              {complementaryText(lang,"Names taken from the English game-client localization."," Nomes obtidos da localização inglesa do cliente.")}
            </p>
          </>
        ) : (
          <>
            <p class="notice">{pt
              ? (entry.interaction==="selection"?"A box é de seleção, mas ainda não identificamos sua lista de opções na captura.":"Ainda não há uma prévia de abertura capturada para esta box. Não é possível afirmar sua lista completa de resultados.")
              : (entry.interaction==="selection"?"This selection box has no recovered option list yet.":"No opening preview has been captured for this box. Its complete result list has not been verified.")}</p>
            {entry.group==="variant" && entry.enhancementMin!==undefined && entry.enhancementMax!==undefined &&
              <p>{complementaryText(lang,"Player-reported enhancement range","Faixa informada pelo jogador")}:
                <strong> +{entry.enhancementMin} {complementaryText(lang,"to","a")} +{entry.enhancementMax}</strong>.
              </p>}
          </>
        )}
        <p class="soft">{entry.interaction==="selection"
          ? (complementaryText(lang,"Item selection: not a random draw.","Escolha de item: não é sorteio aleatório."))
          : (complementaryText(lang,"Drop rates: unknown.","Probabilidades: desconhecidas."))}</p>
      </section>

      <p class="source-note">{selection
        ? (complementaryText(lang,"Provenance: 0x2139 selection UI captured passively on Nov 22, 2026. English names resolved via Unique ID → NameTextNum → TextMgr_Item_ENG.ntx.","Proveniência: seleção exibida pela mensagem 0x2139 na captura passiva de 22/11/2026. Nomes resolvidos por Unique ID → NameTextNum → TextMgr_Item_ENG.ntx."))
        : captured
        ? (complementaryText(lang,"Provenance: passive capture from Nov 22, 2026; preview 0x2137 and result 0x2138. IDs and codes extracted without session data. Grades interpreted as code minus five; this is not an official protocol specification.","Proveniência: captura passiva de 22/11/2026; prévia 0x2137 e resposta 0x2138. IDs e códigos extraídos sem dados de sessão. Graus interpretados como código menos cinco; esta regra não é uma especificação oficial."))
        : (complementaryText(lang,"Scope checked against player screenshots; reward preview not yet captured.","Escopo conferido com as capturas de tela do jogador; ainda sem prévia de recompensa."))}</p>
    </article>
  </main>
</BaseLayout>
<style>
.container{width:min(var(--content-width),92%);margin:0 auto;padding-bottom:80px}
.crumb{padding:24px 0}.crumb a,.article a{color:var(--color-accent);text-decoration:none}
.article{max-width:1100px;margin:0 auto}.eyebrow{color:var(--color-accent);font-size:.8rem;letter-spacing:.1em}
h1{font-size:clamp(2rem,4vw,3rem);margin:9px 0 16px}
.intro,.source-note,.soft{color:var(--color-text-muted)}
.meta{display:flex;gap:9px;flex-wrap:wrap;margin:20px 0 28px}
.meta span{padding:6px 10px;background:var(--color-surface);border:1px solid var(--color-border);font-size:.85rem}
section{padding:24px 0;border-top:1px solid var(--color-border);line-height:1.8}
h2{font-size:1.6rem}.notice{padding:13px 18px;border-left:3px solid var(--color-bronze);background:var(--color-surface)}
.parent{margin:20px 0}
.source-note{font-size:.86rem;border-top:1px solid var(--color-border);padding-top:18px}
.table-scroll{overflow-x:auto;border:1px solid var(--color-border);border-radius:6px}
table{border-collapse:collapse;width:100%;min-width:630px}
th,td{padding:11px 14px;text-align:left;border-bottom:1px solid var(--color-border)}
th{color:var(--color-gold-light);background:#29271f}
.item-id{font-size:.78rem;color:var(--color-text-muted);margin-left:7px;white-space:nowrap}
code{font-variant-numeric:tabular-nums}
</style>
