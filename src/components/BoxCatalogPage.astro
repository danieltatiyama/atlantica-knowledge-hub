---
import BaseLayout from "../layouts/BaseLayout.astro";
import { complementaryText } from "../i18n/complementary-ui.mjs";
import { localePrefix, localeTag, localizedPaths, legacyLocale, equipmentProfilePath } from "../i18n/locales.mjs";
import { getCollection } from "astro:content";
import { EQUIPMENT_BOXES } from "../data/equipment-box-registry";
import { getCapturedEquipmentPool } from "../data/equipment-box-captured-pools";
import { getCapturedSelectionPool } from "../data/equipment-box-selection-pools";
interface Props { lang: string; }
const { lang } = Astro.props;
const prefix=localePrefix(lang);
const base = prefix + "/items/boxes/";
const editorialEntries = (await getCollection("boxes", ({data}) =>
  !data.draft && data.reviewStatus === "approved" &&
  data.evidenceStatus !== "client-config" && data.lang === legacyLocale(lang)))
  .map((entry)=>({id:entry.id.split("/").slice(1).join("/"),...entry.data,capturedItemCount:entry.data.outcomes.length}));
const editorSlugs = new Set(editorialEntries.map(entry=>entry.id));
const registryEntries = EQUIPMENT_BOXES.filter(box=>!editorSlugs.has(box.slug)).map(box=>({
  id:box.slug,
  title:box.name,
  description:box.group==="variant"
    ? (complementaryText(lang,"Equipment box variant: same base pool; enhancement range reported by the player.","Variante de equipment box: mesmo conjunto da box base; faixa de aprimoramento informada pelo jogador."))
    : (complementaryText(lang,"In-game standard equipment box; item list awaiting verification.","Box padrão identificada no jogo; lista de recompensas aguardando validação.")),
  itemUniqueId:box.itemUniqueId,
  boxType:box.interaction==="selection" ? "selection" as const : "random" as const,
  region:"global" as const,
  oddsStatus:"unknown" as const,
  contentsEvidence:((getCapturedEquipmentPool(box.itemUniqueId) || getCapturedSelectionPool(box.itemUniqueId)) ? "server-preview-captured" : "unknown") as "server-preview-captured" | "unknown",
  catalogGroup:box.group==="variant" ? "equipment-variant" as const : "standard-equipment" as const,
  outcomes:[],
  capturedItemCount:getCapturedEquipmentPool(box.itemUniqueId)?.itemUniqueIds.length ?? getCapturedSelectionPool(box.itemUniqueId)?.itemUniqueIds.length ?? 0,
}));
const entries = [...editorialEntries,...registryEntries]
  .sort((a,b)=>((a.catalogGroup==="equipment-variant")?1:0)-((b.catalogGroup==="equipment-variant")?1:0)
     ||a.title.localeCompare(b.title,localeTag(lang)));
const pageTitle = complementaryText(lang,"Boxes & Rewards","Boxes e Recompensas");
const subtitle = complementaryText(lang,"Explore box contents, possible rewards and region-specific verified probabilities.","Consulte o conteúdo de boxes, formas de obtenção e probabilidades verificadas por região.");
const caution = complementaryText(lang,"Published odds for KR, JP or another region do not automatically apply to Global. Raw client weights are not verified percentages.","Taxas divulgadas para KR, JP ou outra região não são automaticamente válidas para Global. Valores internos do cliente não são porcentagens confirmadas.");
const boxTypes = ["random","selection","fixed","unknown"];
---
<BaseLayout title={pageTitle+" | Atlantica Knowledge Hub"} description={subtitle} lang={lang}
  alternatePaths={localizedPaths("/items/boxes/")}>
<main class="container">
  <nav class="breadcrumb"><a href={prefix+"/"}>{complementaryText(lang,"Home","Início")}</a><span>/</span>
    <span>{complementaryText(lang,"Items","Itens")}</span><span>/</span><span>{pageTitle}</span>
  </nav>
  <header class="intro">
    <p class="eyebrow">{complementaryText(lang,"ITEM DATABASE","CATÁLOGO DE ITENS")}</p>
    <h1>{pageTitle}</h1><p>{subtitle}</p>
    <p class="notice">{caution}</p>
  </header>
  <section class="catalog" aria-label={pageTitle}>
    <div class="filters">
      <label><span>{complementaryText(lang,"Group","Grupo")}</span>
        <select id="boxes-scope"><option value="">{complementaryText(lang,"All","Todos")}</option>
          <option value="standard-equipment">{complementaryText(lang,"Standard boxes","Boxes padrão")}</option>
          <option value="equipment-variant">{complementaryText(lang,"Supreme / Enchanted / Infused","Supreme / Enchanted / Infused")}</option>
        </select>
      </label>
      <label><span>{complementaryText(lang,"Search boxes","Buscar box")}</span>
        <input type="search" id="boxes-search" placeholder={complementaryText(lang,"Box name...","Nome da box...")} autocomplete="off"/>
      </label>
      <label><span>{complementaryText(lang,"Type","Tipo")}</span>
        <select id="boxes-type"><option value="">{complementaryText(lang,"All types","Todos")}</option>
          {boxTypes.map(type=><option value={type}>{type}</option>)}
        </select>
      </label>
      <label><span>{complementaryText(lang,"Region","Região")}</span>
        <select id="boxes-region"><option value="">{complementaryText(lang,"All regions","Todas")}</option>
          {["global","kr","jp","other","unknown"].map(region=><option value={region}>{region.toUpperCase()}</option>)}
        </select>
      </label>
    </div>
    <p class="scope-note">{complementaryText(lang,"Focused on general Equipment Boxes: 26 standard and 7 variants. Melee, Ranged and Magic class-specific boxes are excluded.","Catálogo focado em Equipment Boxes gerais: 26 padrão e 7 variantes. Boxes de classe (Melee, Ranged e Magic) não estão incluídas.")}</p>
    <p class="count" aria-live="polite"><span id="boxes-count">{entries.length}</span>
      {complementaryText(lang," boxes found"," boxes encontradas")}</p>
    <div class="grid">
      {entries.map(box=>(
        <article class="item" data-box data-query={(box.title+" "+box.description+" "+(box.itemUniqueId??"")).toLowerCase()}
          data-type={box.boxType} data-region={box.region} data-scope={box.catalogGroup??"standard-equipment"}>
          <div class="meta"><span>{box.catalogGroup==="equipment-variant" ? (complementaryText(lang,"VARIANT","VARIANTE")) : (complementaryText(lang,"STANDARD","PADRÃO"))}</span><span>{box.region.toUpperCase()}</span></div>
          <h2><a href={base+box.id+"/"}>{box.title}</a></h2>
          <p lang={editorSlugs.has(box.id)?localeTag(legacyLocale(lang)):localeTag(lang)}>{box.description}</p>
          {editorSlugs.has(box.id)&&lang!==legacyLocale(lang)&&<small>{complementaryText(lang,"This article body is shown in English until a reviewed translation is available.")}</small>}
          <span class="sub">{box.contentsEvidence === "server-preview-captured"
            ? (complementaryText(lang,"Game-transmitted item list","Lista capturada durante a abertura"))
            : box.contentsEvidence === "official-published"
              ? (complementaryText(lang,"Official reward list","Lista oficial de recompensas"))
              : (complementaryText(lang,"List not yet captured","Lista ainda não capturada"))} · {box.capturedItemCount} {complementaryText(lang,"items","itens")}</span>
          <p class="rate-note">{box.boxType === "selection"
            ? (complementaryText(lang,"Player choice — not a random draw","Seleção de item — não é sorteio"))
            : box.oddsStatus === "regional-published"
              ? (complementaryText(lang,"Published regional rates","Taxas regionais publicadas"))
              : (complementaryText(lang,"Unknown drop rates","Probabilidades desconhecidas"))}</p>
        </article>
      ))}
    </div>
    <p class="empty" id="boxes-empty" data-none={complementaryText(lang,"No matching boxes.","Nenhuma box corresponde à pesquisa.")}
      data-unpublished={complementaryText(lang,"No boxes approved for publication yet.","Ainda não há boxes aprovadas para publicação.")}
      hidden={entries.length>0}>{complementaryText(lang,"No boxes approved for publication yet.","Ainda não há boxes aprovadas para publicação.")}</p>
  </section>
</main>
</BaseLayout>
<style>
.container{width:min(var(--content-width),92%);margin:0 auto;padding-bottom:80px}
.breadcrumb{padding:24px 0;color:var(--color-text-muted);font-size:.9rem}
.breadcrumb a{color:var(--color-accent);text-decoration:none}
.breadcrumb span{margin:0 8px}
.intro{border-bottom:1px solid var(--color-border);padding:20px 0 30px}
.eyebrow{color:var(--color-accent);font-size:.8rem;letter-spacing:.14em}
h1{font-size:clamp(2rem,5vw,3.4rem);margin:10px 0}
.intro>p{max-width:960px;color:var(--color-text-muted)}
.notice{border-left:3px solid var(--color-bronze);padding-left:14px;font-size:.9rem}
.catalog{padding:28px 0}
.filters{display:grid;grid-template-columns:repeat(3,minmax(130px,1fr)) minmax(190px,2fr);gap:14px}
label{display:grid;gap:6px;font-size:.85rem;color:var(--color-gold-light)}
input,select{width:100%;padding:12px;background:var(--color-surface);border:1px solid var(--color-border);
border-radius:5px;color:var(--color-text);font:inherit}
.count,.scope-note{color:var(--color-text-muted);font-size:.9rem}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,290px),1fr));gap:18px}
.item{border:1px solid var(--color-card-border);border-radius:6px;background:var(--color-surface);padding:22px}
.meta{display:flex;gap:8px;font-size:.7rem;color:var(--color-accent);letter-spacing:.07em}
.meta span{border:1px solid var(--color-border);padding:3px 7px;border-radius:3px}
.item h2{font-size:1.4rem;margin:13px 0 7px}
.item a{text-decoration:none}.item a:hover{color:var(--color-accent)}
.item p{color:var(--color-text-muted);line-height:1.6}
.sub{font-size:.83rem;color:var(--color-gold-light)}
.rate-note{font-size:.79rem!important;margin-top:8px!important}
.empty{padding:30px;border:1px dashed var(--color-border);text-align:center;color:var(--color-text-muted)}
@media(max-width:720px){.filters{grid-template-columns:1fr}}
</style>
<script>
const search=document.querySelector<HTMLInputElement>("#boxes-search");
const type=document.querySelector<HTMLSelectElement>("#boxes-type");
const region=document.querySelector<HTMLSelectElement>("#boxes-region");
const scope=document.querySelector<HTMLSelectElement>("#boxes-scope");
const rows=Array.from(document.querySelectorAll<HTMLElement>("[data-box]"));
const count=document.querySelector<HTMLElement>("#boxes-count");
const empty=document.querySelector<HTMLElement>("#boxes-empty");
function filter(){
  let visible=0;
  const q=(search?.value??"").trim().toLowerCase();
  for(const row of rows){
    const show=(!q||row.dataset.query?.includes(q))&&(!type?.value||type.value===row.dataset.type)
      &&(!region?.value||region.value===row.dataset.region)
      &&(!scope?.value||scope.value===row.dataset.scope);
    row.hidden=!show;if(show)visible++;
  }
  if(count)count.textContent=String(visible);
  if(empty){empty.hidden=visible>0;
    empty.textContent=rows.length?empty.dataset.none??"":empty.dataset.unpublished??"";}
}
search?.addEventListener("input",filter);
type?.addEventListener("change",filter);
region?.addEventListener("change",filter);
scope?.addEventListener("change",filter);
</script>
