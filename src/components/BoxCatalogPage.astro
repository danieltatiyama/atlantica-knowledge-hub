---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
interface Props { lang: "en" | "pt-br"; }
const { lang } = Astro.props;
const pt = lang === "pt-br";
const prefix = pt ? "/pt-br" : "";
const base = prefix + "/items/boxes/";
const entries = (await getCollection("boxes", ({data}) =>
  !data.draft && data.reviewStatus === "approved" &&
  data.evidenceStatus !== "client-config" && data.lang === lang))
  .sort((a,b) => a.data.title.localeCompare(b.data.title,pt?"pt-BR":"en"))
  .map((entry)=>({id:entry.id.replace(/^[^/]+\//,""),...entry.data}));
const pageTitle = pt ? "Boxes e Recompensas" : "Boxes & Rewards";
const subtitle = pt
  ? "Consulte o conteúdo de boxes, formas de obtenção e probabilidades verificadas por região."
  : "Explore box contents, possible rewards and region-specific verified probabilities.";
const caution = pt
  ? "Taxas divulgadas para KR, JP ou outra região não são automaticamente válidas para Global. Valores internos do cliente não são porcentagens confirmadas."
  : "Published odds for KR, JP or another region do not automatically apply to Global. Raw client weights are not verified percentages.";
const boxTypes = ["random","selection","fixed","unknown"];
---
<BaseLayout title={pageTitle+" | Atlantica Knowledge Hub"} description={subtitle} lang={lang}
  alternatePaths={{en:"/items/boxes/","pt-br":"/pt-br/items/boxes/"}}>
<main class="container">
  <nav class="breadcrumb"><a href={prefix+"/"}>{pt?"Início":"Home"}</a><span>/</span>
    <span>{pt?"Itens":"Items"}</span><span>/</span><span>{pageTitle}</span>
  </nav>
  <header class="intro">
    <p class="eyebrow">{pt?"CATÁLOGO DE ITENS":"ITEM DATABASE"}</p>
    <h1>{pageTitle}</h1><p>{subtitle}</p>
    <p class="notice">{caution}</p>
  </header>
  <section class="catalog" aria-label={pageTitle}>
    <div class="filters">
      <label><span>{pt?"Buscar box":"Search boxes"}</span>
        <input type="search" id="boxes-search" placeholder={pt?"Nome da box...":"Box name..."} autocomplete="off"/>
      </label>
      <label><span>{pt?"Tipo":"Type"}</span>
        <select id="boxes-type"><option value="">{pt?"Todos":"All types"}</option>
          {boxTypes.map(type=><option value={type}>{type}</option>)}
        </select>
      </label>
      <label><span>{pt?"Região":"Region"}</span>
        <select id="boxes-region"><option value="">{pt?"Todas":"All regions"}</option>
          {["global","kr","jp","other","unknown"].map(region=><option value={region}>{region.toUpperCase()}</option>)}
        </select>
      </label>
    </div>
    <p class="count" aria-live="polite"><span id="boxes-count">{entries.length}</span>
      {pt?" boxes encontradas":" boxes found"}</p>
    <div class="grid">
      {entries.map(box=>(
        <article class="item" data-box data-query={(box.title+" "+box.description).toLowerCase()}
          data-type={box.boxType} data-region={box.region}>
          <div class="meta"><span>{box.boxType.toUpperCase()}</span><span>{box.region.toUpperCase()}</span></div>
          <h2><a href={base+box.id+"/"}>{box.title}</a></h2>
          <p>{box.description}</p>
          <span class="sub">{box.oddsStatus === "regional-published"
            ? (pt?"Taxas publicadas para a região":"Regional published rates")
            : (pt?"Chance ainda não confirmada":"Chances not yet confirmed")}</span>
        </article>
      ))}
    </div>
    <p class="empty" id="boxes-empty" data-none={pt?"Nenhuma box corresponde à pesquisa.":"No matching boxes."}
      data-unpublished={pt?"Ainda não há boxes aprovadas para publicação.":"No boxes approved for publication yet."}
      hidden={entries.length>0}>{pt?"Ainda não há boxes aprovadas para publicação.":"No boxes approved for publication yet."}</p>
  </section>
</main>
</BaseLayout>
<style>
.container{width:min(var(--content-width),92%);margin:0 auto;padding-bottom:80px}
.breadcrumb{padding:24px 0;color:var(--color-text-muted);font-size:.9rem}
.breadcrumb a{color:var(--color-accent);text-decoration:none}
.breadcrumb span{margin:0 8px}
.intro{border-bottom:1px solid var(--color-border);padding:20px 0 30px}
.eyebrow{color:var(--color-accent);font-size:.8rem;letter-spacing:.14em}
h1{font-size:clamp(2rem,5vw,3.4rem);margin:10px 0}
.intro>p{max-width:960px;color:var(--color-text-muted)}
.notice{border-left:3px solid var(--color-bronze);padding-left:14px;font-size:.9rem}
.catalog{padding:28px 0}
.filters{display:grid;grid-template-columns:minmax(0,2fr) repeat(2,minmax(140px,1fr));gap:14px}
label{display:grid;gap:6px;font-size:.85rem;color:var(--color-gold-light)}
input,select{width:100%;padding:12px;background:var(--color-surface);border:1px solid var(--color-border);
border-radius:5px;color:var(--color-text);font:inherit}
.count{color:var(--color-text-muted);font-size:.9rem}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,290px),1fr));gap:18px}
.item{border:1px solid var(--color-card-border);border-radius:6px;background:var(--color-surface);padding:22px}
.meta{display:flex;gap:8px;font-size:.7rem;color:var(--color-accent);letter-spacing:.07em}
.meta span{border:1px solid var(--color-border);padding:3px 7px;border-radius:3px}
.item h2{font-size:1.4rem;margin:13px 0 7px}
.item a{text-decoration:none}.item a:hover{color:var(--color-accent)}
.item p{color:var(--color-text-muted);line-height:1.6}
.sub{font-size:.83rem;color:var(--color-gold-light)}
.empty{padding:30px;border:1px dashed var(--color-border);text-align:center;color:var(--color-text-muted)}
@media(max-width:720px){.filters{grid-template-columns:1fr}}
</style>
<script>
const search=document.querySelector<HTMLInputElement>("#boxes-search");
const type=document.querySelector<HTMLSelectElement>("#boxes-type");
const region=document.querySelector<HTMLSelectElement>("#boxes-region");
const rows=Array.from(document.querySelectorAll<HTMLElement>("[data-box]"));
const count=document.querySelector<HTMLElement>("#boxes-count");
const empty=document.querySelector<HTMLElement>("#boxes-empty");
function filter(){
  let visible=0;
  const q=(search?.value??"").trim().toLowerCase();
  for(const row of rows){
    const show=(!q||row.dataset.query?.includes(q))&&(!type?.value||type.value===row.dataset.type)
      &&(!region?.value||region.value===row.dataset.region);
    row.hidden=!show;if(show)visible++;
  }
  if(count)count.textContent=String(visible);
  if(empty){empty.hidden=visible>0;
    empty.textContent=rows.length?empty.dataset.none??"":empty.dataset.unpublished??"";}
}
search?.addEventListener("input",filter);
type?.addEventListener("change",filter);
region?.addEventListener("change",filter);
</script>
