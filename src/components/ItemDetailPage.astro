---
import {equipmentText} from "../i18n/equipment-ui.mjs";
import {localePrefix,localeTag,legacyLocale,localizedPaths} from "../i18n/locales.mjs";
import type {Lang} from "../i18n/ui";
import BaseLayout from "../layouts/BaseLayout.astro";
import type { EquipmentItemCatalogEntry } from "../data/equipment-item-catalog";
import { getCuratedEquipmentMetadata, APPROVED_EQUIPMENT_SOURCE_SNAPSHOT } from "../data/curated-equipment-metadata";
import { getReviewedItemProfile } from "../data/reviewed-equipment-profiles";
import ItemKnowledgeSections from "./ItemKnowledgeSections.astro";
import {getClientEquipmentFacts} from "../data/client-equipment-facts";
import ClientEquipmentFactsSection from "./ClientEquipmentFactsSection.astro";
import {getClientItemAttributes} from "../data/client-item-attributes";
import ClientItemAttributesSection from "./ClientItemAttributesSection.astro";
import ClientItemStatSummary from "./ClientItemStatSummary.astro";
import ClientCraftingSummary from "./ClientCraftingSummary.astro";
import AtlanticaItemInfoPanel from "./AtlanticaItemInfoPanel.astro";
import ClientCraftingBacklinks from "./ClientCraftingBacklinks.astro";
import MonsterItemSources from "./MonsterItemSources.astro";
import ClientRawRequirementsSection from "./ClientRawRequirementsSection.astro";

interface Props { lang:Lang; item: EquipmentItemCatalogEntry; }
const { lang, item } = Astro.props;
const prefix=localePrefix(lang);
const base = prefix + "/items/";
const boxRefs = [...item.boxReferences].sort((a,b)=>a.boxName.localeCompare(b.boxName,"en"));
const title = item.nameEn;
const profile = getReviewedItemProfile(item.id);
const sourceFacts = getClientEquipmentFacts(item.id);
const sourceAttributes = getClientItemAttributes(item.id);
const curated = getCuratedEquipmentMetadata(item.id);
const curatedFields = curated?.fields;
const clientFields = curatedFields ? [
  { label: equipmentText(lang,"Client category","Categoria no cliente"), value: curatedFields.clientCategory },
  { label: equipmentText(lang,"Raw client level","Nível bruto do cliente"), value: curatedFields.clientLevelRaw },
  { label: equipmentText(lang,"Raw client grade","Grade bruta do cliente"), value: curatedFields.clientGradeRaw },
].filter((field) => field.value !== undefined) : [];
---
<BaseLayout lang={lang} title={title + " | Atlantica Knowledge Hub"}
  description={(equipmentText(lang,"Equipment item ID and captured box references: ","Informações de equipamento, ID e referências a boxes capturadas: ")) + title}
  alternatePaths={localizedPaths("/items/"+item.id+"/")}>
  <main class="container" data-wiki-nav-root="true">
    <nav class="breadcrumb"><a href={base}>{equipmentText(lang,"← Back to item catalog","← Voltar ao catálogo")}</a></nav>
    <article>
      <header>
        <p class="eyebrow">{equipmentText(lang,"EQUIPMENT ITEM CATALOG","CATÁLOGO DE EQUIPAMENTOS")}</p>
        <h1>{title}</h1>
        <div class="meta">
          <span>{equipmentText(lang,"Item ID (Unique)","ID do item (Unique)")}: <code>{item.id}</code></span>
          <span>{equipmentText(lang,"NA client English name","Nome em inglês do cliente NA")}</span>
        </div>
        <p class="evidence">{equipmentText(lang,"English name reconciled from client equipment definitions and NA localization. This does not establish equipment stats or current item availability.","Nome associado a partir de arquivos de equipamento e localização em inglês do cliente. Ainda não há tradução oficial em português verificada.")}</p>
      </header>
      <AtlanticaItemInfoPanel lang={lang} itemId={item.id} />
      <p class="source-export">
        <a href="/data/client-equipment-grades.csv" download>{equipmentText(lang,"Download CSV: +0 to +10 tables for all 551 equipment items","Exportar CSV: tabelas +0 a +10 dos 551 equipamentos")}</a>
        <small>{equipmentText(lang,"+1..+10 values are historical projections; MagicDef, EV and MoveSpeed stay fixed.","Atributos +1..+10 são projeções históricas; MagicDef, EV e MoveSpeed ficam fixos.")}</small>
      </p>
      <p class="full-db-link">
        <a href={localePrefix(lang)+"/tools/crafting/?id="+item.id}>
          {equipmentText(lang,"Calculate crafting materials for this item","Calcular materiais deste item")}
        </a>
      </p>
      <p class="full-db-link">
        <a href={prefix+"/items/database/?id="+item.id}>
          {equipmentText(lang,"Inspect this ID in the complete original client database","Ver todas as definições deste ID no banco completo do cliente")}
        </a>
      </p>
      <nav class="page-sections" aria-label={equipmentText(lang,"Item sections","Seções do item")}>
        <a href="#item-stats">{equipmentText(lang,"Stats","Atributos")}</a>
        <a href="#item-sources">{equipmentText(lang,"Source","Fontes")}</a>
        <a href="#item-crafting">{equipmentText(lang,"Crafting","Fabricação")}</a>
        <a href="#item-used-in">{equipmentText(lang,"Used in crafting","Usado em receitas")}</a>
        {sourceFacts && <a href="#client-crafting">{equipmentText(lang,"Client materials","Materiais do cliente")}</a>}
        {sourceAttributes && <a href="#client-requirements">{equipmentText(lang,"Raw requirements","Requisitos brutos")}</a>}
        {sourceFacts && <a href="#client-facts">{equipmentText(lang,"Game files","Arquivos do jogo")}</a>}
        {sourceAttributes && <a href="#client-attributes">{equipmentText(lang,"Raw attributes","Atributos brutos")}</a>}
      </nav>
      <ClientItemStatSummary lang={lang} data={sourceAttributes} />
      <ItemKnowledgeSections lang={lang} profile={profile} section="overview" />
      <ItemKnowledgeSections lang={lang} profile={profile} section="stats" />
      <section id="item-sources">
        <h2>{equipmentText(lang,"Source","Fontes de obtenção")}</h2>
        <h3>{equipmentText(lang,"Equipment Box previews","Prévia de Equipment Boxes")}</h3>
        {boxRefs.length ? (
          <>
            <p class="note">{equipmentText(lang,"These boxes transmitted this item ID in their previews captured on November 22, 2026. This does not confirm drop odds, permanent availability or reward quantity.","As boxes abaixo transmitiram este ID em suas listas durante as capturas de 22/11/2026. Isso não confirma probabilidades, disponibilidade permanente nem quantidade recebida.")}</p>
            <div class="table-scroll"><table>
              <thead><tr><th>{equipmentText(lang,"Box","Box")}</th><th>{equipmentText(lang,"Box ID","ID da box")}</th><th>{equipmentText(lang,"Preview","Prévia")}</th></tr></thead>
              <tbody>{boxRefs.map((box) => <tr>
                <td><a href={localePrefix(lang) + "/items/boxes/" + box.boxSlug + "/"}>{box.boxName}</a></td>
                <td><code>{box.boxId}</code></td>
                <td>{box.interaction === "selection"
                  ? (equipmentText(lang,"Player selection","Escolha de item"))
                  : (equipmentText(lang,"Random-box preview","Lista de possíveis resultados"))}</td>
              </tr>)}</tbody>
            </table></div>
          </>
        ) : (
          <p>{equipmentText(lang,"No captured box association for this item.","Nenhuma associação de box capturada para este item.")}</p>
        )}
      </section>
      <MonsterItemSources lang={lang} itemId={item.id} />
      <ItemKnowledgeSections lang={lang} profile={profile} section="crafting" />
      <ClientCraftingSummary lang={lang} item={sourceFacts} />
      <div id="item-used-in"><ClientCraftingBacklinks lang={lang} itemId={item.id} /></div>
      <ClientRawRequirementsSection lang={lang} itemId={item.id} />
      <ClientEquipmentFactsSection lang={lang} item={sourceFacts} />
      <ClientItemAttributesSection lang={lang} data={sourceAttributes} />
      {curated && (
        <section class="curated">
          <h2>{equipmentText(lang,"Reviewed client-extracted metadata","Metadados extraídos e revisados")}</h2>
          <p class="note">{equipmentText(lang,"Client source selected through editorial review. These are extracted raw fields, not independently verified equipment requirements, stats or current availability.","Fonte do cliente selecionada por revisão editorial. Estes campos são valores brutos extraídos, não comprovações de requisitos, atributos ou disponibilidade no jogo.")}</p>
          <div class="table-scroll"><table>
            <thead><tr><th>{equipmentText(lang,"Field","Campo")}</th><th>{equipmentText(lang,"Raw value","Valor bruto")}</th></tr></thead>
            <tbody>{clientFields.map((field) => <tr>
              <td>{field.label}</td><td><code>{field.value}</code></td>
            </tr>)}</tbody>
          </table></div>
          <p class="provenance">{equipmentText(lang,"Evidence","Evidência")}: <strong>{equipmentText(lang,"Extracted","Extraído")}</strong>
            {APPROVED_EQUIPMENT_SOURCE_SNAPSHOT &&
              <> · {equipmentText(lang,"Snapshot","Snapshot")}: <code>{APPROVED_EQUIPMENT_SOURCE_SNAPSHOT}</code></>}
          </p>
        </section>
      )}
      {!profile && !sourceFacts && !sourceAttributes && <p class="pending-note">{equipmentText(lang,"This item has no reviewed gameplay stats yet. Its profile will expand when source-backed information becomes available.","Esta ficha ainda não possui atributos revisados. As informações serão adicionadas conforme forem documentadas com fontes.")}</p>}
    </article>
  </main>
</BaseLayout>
<style>
  .container{width:min(var(--content-width),92%);margin:0 auto;padding-bottom:80px}
  .breadcrumb{padding:26px 0}.breadcrumb a,td a{color:var(--color-accent);text-decoration:none}
  article{max-width:1140px;margin:0 auto}
  .full-db-link a{color:var(--color-accent);font-size:.89rem}
  .source-export{display:flex;flex-wrap:wrap;gap:7px 15px;align-items:baseline;margin:20px 0 10px}
  .source-export a{color:var(--color-accent);font-weight:600}
  .source-export small{color:var(--color-text-muted);line-height:1.5}
  header{padding:12px 0 30px;border-bottom:1px solid var(--color-border)}
  h1{font-size:clamp(2rem,4vw,3.2rem);margin:10px 0 18px}
  .eyebrow{font-size:.8rem;letter-spacing:.14em;color:var(--color-accent)}
  .meta{display:flex;flex-wrap:wrap;gap:10px}
  .meta span{border:1px solid var(--color-border);background:var(--color-surface);padding:8px 12px;font-size:.85rem}
  .evidence{margin-top:22px;border-left:3px solid var(--color-bronze);background:var(--color-surface);padding:14px 17px;color:var(--color-text-muted)}
  h2{font-size:1.55rem;margin-top:34px}
  h3{font-size:1.08rem;color:var(--color-gold-light);margin:12px 0}
  .page-sections{display:flex;flex-wrap:wrap;gap:10px;padding:16px 0 5px}
  .page-sections a{display:inline-block;color:var(--color-gold-light);
    border:1px solid var(--color-border);padding:8px 15px;border-radius:4px;
    text-decoration:none;background:var(--color-surface)}
  .page-sections a:hover,.page-sections a:focus-visible{border-color:var(--color-accent)}
  #item-sources{margin-top:34px}
  .pending-note{color:var(--color-text-muted);border-left:2px solid var(--color-steel);
    padding:12px 16px;margin:26px 0;background:var(--color-surface)}
  .curated{padding:2px 0}
  .provenance{color:var(--color-text-muted);font-size:.9rem;margin-top:16px}
  .provenance code{color:var(--color-gold-light)}
  .note{color:var(--color-text-muted);line-height:1.65}
  .table-scroll{overflow-x:auto;border:1px solid var(--color-border);border-radius:5px}
  table{width:100%;min-width:550px;border-collapse:collapse}
  th,td{padding:12px 16px;border-bottom:1px solid var(--color-border);text-align:left}
  th{background:#29271f;color:var(--color-gold-light)}
  td{color:var(--color-text-muted)}
  a:hover{color:var(--color-gold-light)}
</style>
