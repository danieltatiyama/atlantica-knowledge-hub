---
import {equipmentText} from "../i18n/equipment-ui.mjs";
import {localePrefix,localeTag,legacyLocale,localizedPaths} from "../i18n/locales.mjs";
import type {Lang} from "../i18n/ui";
import type {ClientItemAttributes} from "../data/client-item-attributes";
import {CLIENT_ATTRIBUTE_SOURCE_SNAPSHOT} from "../data/client-item-attributes";
import {summarizeClientRawFields,buildHistoricalClientProjection,labelForClientField}
  from "../data/client-item-stat-summary.mjs";

interface Props {
  lang:Lang;
  data?:ClientItemAttributes;
  showHistoricalProjection?:boolean;
}
const {lang,data,showHistoricalProjection=true}=Astro.props;
const summary=data?summarizeClientRawFields(data):null;
const preview=data&&showHistoricalProjection?buildHistoricalClientProjection(data):null;
const number=new Intl.NumberFormat(lang==="en"?"en-US":localeTag(lang));
const format=value=>typeof value==="number"?number.format(value):value;
const heading={
  attack:equipmentText(lang,"Attack power","Poder de ataque"),
  defense:equipmentText(lang,"Defense and resistance","Defesa e resistência"),
  attributes:equipmentText(lang,"Base attributes","Atributos básicos"),
  other:equipmentText(lang,"Other client bonuses","Outros bônus do cliente"),
};
const progressionFields=preview?.fields??[];
const baselineOnlyFields=preview?.baselineOnlyFields??[];
const fixedFields=preview?.fixedFields??[];
---
{data && summary && <section class="source-summary" aria-label={equipmentText(lang,"Client attribute summary","Resumo dos atributos extraídos")}>
  <div class="summary-heading">
    <div>
      <p class="eyebrow">{equipmentText(lang,"CLIENT SOURCE FILES","ARQUIVOS DO CLIENTE")}</p>
      <h2>{equipmentText(lang,"Equipment base attributes","Atributos básicos do equipamento")}</h2>
    </div>
    <span class="snapshot">{equipmentText(lang,"Snapshot","Snapshot")} {CLIENT_ATTRIBUTE_SOURCE_SNAPSHOT}</span>
  </div>
  <p class="provenance">{equipmentText(lang,"Raw values extracted from Items.csv. A matching source item name and ID confirms provenance, not live-server tooltip stats or enhancement eligibility.","Valores brutos extraídos de Items.csv. Uma correspondência de nome e ID confirma a origem do registro, não o valor exibido pelo servidor ou a possibilidade de aprimoramento.")}</p>
  <div class="stat-groups">
    {summary.visibleGroups.map(group=><div class="stat-group">
      <h3>{heading[group.group]}</h3>
      <dl>
        {group.fields.map(field=><div class="stat-item">
          <dt>{equipmentText(lang,field.en,field.pt)}</dt>
          <dd>{field.status==="conflict"
            ? <span class="different">{equipmentText(lang,"Different values","Divergente")}</span>
            : <strong>{field.value}</strong>}
            {field.status==="partial" &&
              <small>{equipmentText(lang,"In","Em")} {field.observedIn}/{field.sourceCount} {equipmentText(lang,"sources","fontes")}</small>}
          </dd>
        </div>)}
      </dl>
    </div>)}
  </div>
  {summary.visibleGroups.length===0&&<p class="provenance">{equipmentText(lang,"No nonzero values in the reviewed key fields. The raw source table below retains all zeroes and additional fields.","Nenhum valor diferente de zero nos campos básicos revisados. A tabela de origem abaixo preserva todos os zeros e campos adicionais.")}</p>}
  <p class="source-status">{summary.sourceCount} {equipmentText(lang,"original Items.csv source record(s)","registro(s) originais de Items.csv")}
    · {summary.conflictCount===0
      ? (equipmentText(lang,"Shared attributes agree","Atributos em comum sem divergências"))
      : equipmentText(lang,"{count} conflicting field(s)","{count} campo(s) com valores diferentes",{count:summary.conflictCount})}
    {summary.partialCount>0&&<> · {equipmentText(lang,"Some fields exist in only some source records","Alguns campos só existem em parte dos arquivos")}</>}
  </p>
  {summary.conflictCount>0&&<div class="diff-panel">
    <h3>{equipmentText(lang,"Values needing source review","Valores que precisam de revisão")}</h3>
    {summary.fields.filter(field=>field.status==="conflict").map(field=>
      <p><strong>{equipmentText(lang,labelForClientField(field.key,false),labelForClientField(field.key,true))}</strong>: {data.sourceRows
        .filter(row=>field.key in row.fieldsRaw)
        .map(row=>`#${row.sourceRowNumber}: ${row.fieldsRaw[field.key]}`).join(" · ")}</p>)}
  </div>}
  {preview&&preview.rows.length>0&&
    <details class="historical" open>
      <summary>{equipmentText(lang,"Equipment stats +0 to +10 — historical model","Tabela de atributos +0 a +10 — modelo histórico")}</summary>
      <div class="historical-inner">
        <p class="historical-warning">{equipmentText(lang,"HISTORICAL MODEL, NOT CONFIRMED SERVER STATS. +0 uses raw Items.csv values; +1 to +10 apply historical multipliers ONLY to attack, physical armor and primary attributes. Magic Defense (MagicDef), evasion (EV) and movement speed (MoveSpeed) remain FIXED at all grades. L is never inferred. This table does not prove the item can be upgraded.","SIMULAÇÃO HISTÓRICA, NÃO VALORES CONFIRMADOS NO SERVIDOR. +0 utiliza os números brutos de Items.csv; +1 a +10 usam os multiplicadores históricos APENAS em ataque, defesa física e atributos básicos. Defesa mágica (MagicDef), evasão (EV) e velocidade de movimento (MoveSpeed) são mantidas FIXAS em todos os graus. Nenhuma linha L é inferida. Esta tabela não comprova que o item possa ser aprimorado.")}</p>
        {preview.excluded.length>0&&<p class="historical-warning">{equipmentText(lang,"Fields not projected due to a conflict or fractional value (visible in raw records):","Atributos sem projeção por conflito ou valor fracionário (visíveis nos registros brutos):")}
          {" "}{preview.excluded.join(", ")}
        </p>}
        {preview.fixedConflicts.length>0&&<p class="historical-warning">
          {equipmentText(lang,"Conflicting fixed attributes were omitted from the table:","Atributos fixos divergentes foram omitidos da tabela:")}
          {" "}{preview.fixedConflicts.join(", ")}
        </p>}
        <p class="model-footer">{equipmentText(lang,"Columns marked × are historical projections. Columns marked = repeat the exact client source value at all grades; they are never multiplied. Missing or zero values were not invented to fill the table.","Colunas com × = progressão calculada. Colunas com = = mesmo valor bruto do cliente em todos os graus; não são multiplicadas. Um valor 0 ou ausente não foi inventado para preencher colunas.")}</p>
        <div class="table-scroll">
          <table class="progression">
            <thead><tr>
              <th scope="col">{equipmentText(lang,"Grade","Grau")}</th>
              {progressionFields.map(field=><th scope="col">
                {equipmentText(lang,labelForClientField(field,false),labelForClientField(field,true))} <small class="multiplier-mark">×</small>
              </th>)}
              {baselineOnlyFields.map(field=><th scope="col" class="baseline-only-header" title={
                equipmentText(lang,"Original +0 value; no grade projection available","Valor original em +0; sem projeção de grau")
              }>{equipmentText(lang,labelForClientField(field,false),labelForClientField(field,true))} <small>+0</small></th>)}
              {fixedFields.map(field=><th scope="col" class="fixed-header" title={
                equipmentText(lang,"Unchanged raw client source value, never multiplied","Valor bruto fixo do cliente, não multiplicado")
              }>{equipmentText(lang,labelForClientField(field.key,false),labelForClientField(field.key,true))} <small class="fixed-mark">=</small>
                {field.status==="partial"&&<small class="partial-source">{field.observedIn}/{field.sourceCount} {equipmentText(lang,"sources","fontes")}</small>}
              </th>)}
              <th scope="col">{equipmentText(lang,"Basis","Natureza do valor")}</th>
            </tr></thead>
            <tbody>{preview.rows.map(row=><tr class={row.grade===0?"baseline":undefined}>
              <th scope="row">+{row.grade}</th>
              {progressionFields.map(field=><td>{format(row.values[field])}</td>)}
              {baselineOnlyFields.map(field=><td class="baseline-only-value">
                {row.values[field]===undefined?"—":format(row.values[field])}
              </td>)}
              {fixedFields.map(field=><td class="fixed-value">{row.values[field.key]}</td>)}
              <td class={row.status==="historical-estimate"?"estimated":undefined}>
                {row.status==="client-raw-baseline"
                  ?(equipmentText(lang,"Client raw baseline","Extraído do cliente"))
                  :(equipmentText(lang,"Historical estimate","Estimativa histórica"))}
              </td>
            </tr>)}</tbody>
          </table>
        </div>
        <p class="model-footer">{equipmentText(lang,"Multipliers for × columns: 1.0; 1.2; 1.4; 1.6; 1.8; 2.1; 2.4; 2.8; 3.2; 3.6; 4.0. Integer results are rounded down. Magic Defense, evasion and movement speed preserve their original values. Skills, critical and HitRate are not projected. L needs item-specific evidence.","Modelo das colunas ×: 1,0; 1,2; 1,4; 1,6; 1,8; 2,1; 2,4; 2,8; 3,2; 3,6; 4,0. Valores inteiros são arredondados para baixo. Defesa mágica, evasão e velocidade de movimento conservam seus números de origem. Habilidades, crítico e HitRate não foram projetados. L depende de evidência específica.")}</p>
      </div>
    </details>}
  <p class="see-raw">{equipmentText(lang,"See original source rows and every field in","Referências e campos completos na seção")}
    {" "}<a href="#client-attributes">{equipmentText(lang,"Raw extracted attributes","Atributos brutos extraídos")}</a>.</p>
</section>}
<style>
  .source-summary{border:1px solid var(--color-border);background:var(--color-surface);
    border-radius:6px;padding:20px 22px;margin:24px 0 32px}
  .summary-heading{display:flex;justify-content:space-between;align-items:start;gap:18px;flex-wrap:wrap}
  .eyebrow{font-size:.76rem;letter-spacing:.13em;color:var(--color-accent);margin:0 0 5px}
  h2{font-size:1.45rem;margin:0;color:var(--color-gold-light)}
  .snapshot{font-size:.8rem;color:var(--color-text-muted);white-space:nowrap}
  .provenance,.source-status,.see-raw{font-size:.87rem;line-height:1.6;color:var(--color-text-muted)}
  .provenance{margin:10px 0 17px}
  .stat-groups{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,240px),1fr));gap:12px}
  .stat-group{border:1px solid var(--color-border);border-radius:4px;min-width:0}
  .stat-group h3{font-size:.89rem;margin:0;padding:11px 13px;color:var(--color-gold-light);
    border-bottom:1px solid var(--color-border)}
  .stat-group dl{margin:0;padding:4px 12px}
  .stat-item{display:flex;gap:12px;align-items:baseline;justify-content:space-between;
    padding:7px 0;border-bottom:1px solid var(--color-border);font-size:.88rem}
  .stat-item:last-child{border-bottom:0}
  dt{color:var(--color-text-muted)}
  dd{margin:0;text-align:right}
  dd strong{color:var(--color-text);font-weight:600}
  dd small{display:block;color:var(--color-text-muted);font-size:.72rem}
  .different{color:var(--color-gold-light)}
  .source-status{margin:16px 0 2px}
  .diff-panel{border-left:3px solid var(--color-bronze);padding:5px 15px;margin:18px 0}
  .diff-panel h3{font-size:1rem;margin:6px 0}
  .diff-panel p{overflow-wrap:anywhere;font-size:.88rem}
  .historical{margin-top:20px;border:1px solid var(--color-border);border-radius:4px;overflow:hidden}
  .historical>summary{padding:12px 14px;cursor:pointer;font-weight:600;color:var(--color-gold-light)}
  .historical>summary:hover,.historical>summary:focus-visible{background:var(--color-background)}
  .historical-inner{padding:4px 14px 14px;border-top:1px solid var(--color-border)}
  .historical-warning{color:var(--color-text-muted);font-size:.86rem;line-height:1.55}
  .baseline-only-header{background:rgba(133,99,54,.14);min-width:110px}
  .baseline-only-value{background:rgba(133,99,54,.06);color:var(--color-text-muted)}
  .fixed-header{background:rgba(90,104,120,.14);min-width:110px}
  .fixed-header .partial-source{display:block;color:var(--color-text-muted);font-size:.68rem}
  .multiplier-mark,.fixed-mark{font-size:.72rem;opacity:.83}
  .fixed-value{background:rgba(90,104,120,.08);color:var(--color-text);font-variant-numeric:tabular-nums}
  .table-scroll{overflow-x:auto}
  table{border-collapse:collapse;width:100%;white-space:nowrap;font-size:.85rem}
  th,td{padding:8px 12px;border-bottom:1px solid var(--color-border);text-align:right}
  th:first-child{text-align:left}
  thead th{color:var(--color-gold-light);font-weight:600}
  td.estimated{color:var(--color-text-muted)}
  tr.baseline th,tr.baseline td{font-weight:600}
  .model-footer{font-size:.8rem;line-height:1.55;color:var(--color-text-muted)}
  .see-raw{margin:14px 0 0}
  .see-raw a{color:var(--color-accent)}
  @media(max-width:600px){.source-summary{padding:16px 13px}}
</style>
