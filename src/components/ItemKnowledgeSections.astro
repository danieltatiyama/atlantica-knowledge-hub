---
import {equipmentText} from "../i18n/equipment-ui.mjs";
import {localePrefix,localeTag,legacyLocale,localizedPaths} from "../i18n/locales.mjs";
import type {Lang} from "../i18n/ui";
import type { ItemArticleProfile, ItemArticleStatRow } from "../data/reviewed-equipment-profiles";
import { getEnchantStatRows } from "../data/equipment-enchant-projection.mjs";

interface Props {
  lang:Lang;
  section: "overview" | "stats" | "crafting";
  profile?: ItemArticleProfile;
}

const { lang, section, profile } = Astro.props;
const rows = getEnchantStatRows(
  profile?.stats ?? [],
  profile?.enchantmentProjectionModel ?? null,
  profile?.legendaryEligible ? profile.legendaryProjectionModel : null
) as (ItemArticleStatRow & { origin: "observed" | "estimated" })[];
const hasLegendary = rows.some((row) => row.enchantLevel === "L");
const hasEstimatedLegendary = rows.some((row) => row.enchantLevel === "L" && row.origin === "estimated");
const hasMissingNormalGrades = Array.from({ length: 11 }, (_, index) => index)
  .some((grade) => !rows.some((row) => row.enchantLevel === grade));
const hasEstimated = rows.some((row) => row.origin === "estimated");
const baseStatsFromGame = profile?.evidence.stats === "ingame-screenshot";
const baseSourceDescription = baseStatsFromGame
  ? (equipmentText(lang,"Observed in-game","Observado no jogo"))
  : (equipmentText(lang,"Historical community table","Tabela comunitária histórica"));
const number = new Intl.NumberFormat(lang==="en"?"en-US":localeTag(lang));
const format = (value: number | undefined) => value === undefined ? "—" : number.format(value);
const possibleStats: { key: keyof ItemArticleStatRow; en: string; pt: string }[] = [
  { key: "strength", en: "Strength", pt: "Força" },
  { key: "vitality", en: "Vitality", pt: "Vitalidade" },
  { key: "dexterity", en: "Dexterity", pt: "Destreza" },
  { key: "intelligence", en: "Intelligence", pt: "Inteligência" },
  { key: "defense", en: "Defense", pt: "Defesa" },
  { key: "magicDefense", en: "Magic Defense", pt: "Defesa Mágica" },
];
const present = possibleStats.filter(col => rows.some(row => row[col.key] !== undefined));
const hasAttack = rows.some(row => row.attackMin !== undefined && row.attackMax !== undefined);
const crafting = profile?.crafting;
const screenshotLegend = equipmentText(lang,"User-supplied in-game screenshot","Captura de tela fornecida do jogo");
const communityLegend = equipmentText(lang,"Community reference","Referência comunitária");
const sourceLegend = (kind: string) => kind === "ingame-screenshot" ? screenshotLegend : communityLegend;
---
{section === "overview" && profile?.overview && (
  <section class="overview" id="item-overview" aria-label={equipmentText(lang,"Equipment overview","Resumo do equipamento")}>
    <div class="item-artwork" aria-label={equipmentText(lang,"Item artwork not yet available","Ícone do item ainda indisponível")}>
      <span aria-hidden="true">⚔</span>
      <small>{equipmentText(lang,"Artwork pending","Arte pendente")}</small>
    </div>
    <div class="item-overview-details">
      <h2>{equipmentText(lang,"Overview","Informações gerais")}</h2>
      <dl class="overview-key-values">
        <div><dt>{equipmentText(lang,"Type","Tipo")}</dt><dd>{profile.overview.typeEn}</dd></div>
        <div><dt>{equipmentText(lang,"Minimum level","Nível mínimo")}</dt><dd>{profile.overview.minimumLevel}</dd></div>
      </dl>
      {profile.overview.eligibleClasses.length > 0 && (
        <div class="class-restrictions">
          <h3>{equipmentText(lang,"Class restrictions","Classes permitidas")}</h3>
          <p class="subtle">{equipmentText(lang,"Client tooltip labels, retained as shown.","Nomes exibidos no tooltip do cliente, preservados como aparecem.")}</p>
          <div class="classes">{profile.overview.eligibleClasses.map((cls) =>
            <span class="class-chip">{cls}</span>)}</div>
        </div>
      )}
      <p class="source-note">{profile.evidence.overview === "ingame-screenshot"
        ? (equipmentText(lang,"Source: in-game tooltip · +0 equipment","Fonte: tooltip do jogo · Equipamento +0"))
        : (equipmentText(lang,"Source: historical community documentation · Not verified in the current game","Fonte: documentação comunitária histórica · Não verificado no jogo atual"))}</p>
    </div>
  </section>
)}
{section === "stats" && (
  <section id="item-stats">
    <h2>{equipmentText(lang,"Stats","Atributos")}</h2>
    {rows.length > 0 ? (
      <>
        <p class="subtle">{hasEstimated
          ? (baseStatsFromGame
            ? equipmentText(lang,"+0 was observed in-game; other values are predictions derived from historical equipment tables. Every row identifies its origin.","O +0 foi observado no jogo; os demais valores são projeções baseadas em tabelas históricas de equipamentos. Cada linha identifica sua origem.")
            : equipmentText(lang,"+0 was documented in a historic community wiki; other values are predictions from the same model. None have been confirmed in the current client.","O +0 foi documentado em uma wiki comunitária histórica; os demais valores são projeções do mesmo modelo. Nenhum deles foi confirmado no cliente atual."))
          : equipmentText(lang,"Enchantment statistics from reviewed sources.","Valores por nível de encantamento, provenientes de fontes revisadas.")}</p>
        <div class="table-scroll">
          <table class="item-table">
            <thead><tr>
              <th>{equipmentText(lang,"Enchant level","Encantamento")}</th>
              {hasAttack && <th>{equipmentText(lang,"Attack power","Poder de ataque")}</th>}
              {present.map((column) => <th>{equipmentText(lang,column.en,column.pt)}</th>)}
              <th>{equipmentText(lang,"Basis","Origem")}</th>
            </tr></thead>
            <tbody>{rows.map((row) => <tr class={row.enchantLevel === "L" ? "legendary-row" : undefined}>
              <th scope="row">{row.enchantLevel === "L"
                ? <span class="legendary-mark" title={equipmentText(lang,"Legendary Enhancement","Encantamento lendário")}>L</span>
                : "+" + row.enchantLevel}</th>
              {hasAttack && <td>{row.attackMin !== undefined && row.attackMax !== undefined
                ? format(row.attackMin) + " – " + format(row.attackMax) : "—"}</td>}
              {present.map((column) => <td>{row[column.key] === undefined
                ? "—" : "+" + format(row[column.key])}</td>)}
              <td class={row.origin === "estimated" ? "estimated" : "observed"}>
                {row.origin === "observed"
                  ? baseSourceDescription
                  : (equipmentText(lang,"Calculated · historical model","Calculado · modelo histórico"))}
              </td>
            </tr>)}</tbody>
          </table>
        </div>
        {hasEstimated && <p class="model-note">{equipmentText(lang,"Estimate: +1–+10 use historical multipliers with rounding down for attack and basic stats only. These values are not confirmed for the current Atlantica Global. Durability, Atlas costs, fixed Magic Defense, effects and skills are NOT calculated.","Modelo estimado: +1–+10 aplicam multiplicadores históricos com arredondamento para baixo apenas a ataque e atributos básicos. Não são valores confirmados no Atlantica Global atual. Durabilidade, custos de Atlas, Magic Defense fixa, efeitos e habilidades NÃO são calculados.")}</p>}
        {hasEstimatedLegendary && <p class="model-note legendary-info">{equipmentText(lang,"L (Legendary): estimated 4.3× the +0 stat, rounded down. This is 7.5% above +10 before truncation. Only explicitly eligible equipment displays this prediction; special effects may scale differently.","L (lendário): estimativa de 4,3× o atributo +0, com truncamento para baixo. Equivale a 7,5% acima do valor +10 antes do arredondamento. Somente equipamentos comprovadamente elegíveis exibem esta projeção; efeitos especiais podem evoluir de outra forma.")}</p>}
        {profile?.legendaryEligible && !hasLegendary && <p class="source-note">{equipmentText(lang,"This item is documented as L-eligible, but its Legendary values are not yet reviewed.","Este item está documentado como elegível ao L, mas os valores lendários ainda não foram aprovados.")}</p>}
        {hasMissingNormalGrades && <p class="source-note">{equipmentText(lang,"Other enchantment levels still need data; missing values were not invented.","Outros níveis de encantamento ainda aguardam dados; os valores ausentes não foram inventados.")}</p>}
      </>
    ) : <p class="subtle">{equipmentText(lang,"No independently reviewed stats for this item yet.","Nenhum atributo confirmado para este item ainda.")}</p>}
  </section>
)}
{section === "crafting" && (
  <section id="item-crafting">
    <h2>{equipmentText(lang,"Crafting","Fabricação")}</h2>
    {crafting ? (
      <>
        <p class="source-note">{profile.evidence.crafting === "ingame-screenshot"
          ? (equipmentText(lang,"Crafting values observed in the in-game tooltip.","Valores de fabricação observados no tooltip do jogo."))
          : (equipmentText(lang,"Crafting values from historical community documentation; they may have changed.","Valores de fabricação provenientes de fonte comunitária histórica; podem ter mudado."))}</p>
        <div class="craft-info">
          <dl>
            <div><dt>{equipmentText(lang,"Production per batch","Produção por lote")}</dt>
              <dd>{format(crafting.productionPerBatch)}</dd></div>
            <div><dt>{equipmentText(lang,"Required workload","Workload necessário")}</dt>
              <dd>{format(crafting.requiredWorkload)}</dd></div>
            <div><dt>{equipmentText(lang,"Required crafting skill","Skill de fabricação")}</dt>
              <dd>{crafting.requiredSkill.nameEn} · Lv. {crafting.requiredSkill.level}</dd></div>
          </dl>
        </div>
        <h3>{equipmentText(lang,"Materials","Materiais")}</h3>
        {crafting.materials.length ? (
          <>
            <div class="table-scroll"><table class="item-table">
              <thead><tr><th>{equipmentText(lang,"Material","Material")}</th><th>{equipmentText(lang,"Required","Quantidade")}</th></tr></thead>
              <tbody>{crafting.materials.map((material) =>
                <tr><td>{material.nameEn}</td><td>×{format(material.quantity)}</td></tr>)}</tbody>
            </table></div>
            <p class="source-note">{equipmentText(lang,"Materials are supported by a community reference; they were not visible in the supplied tooltip screenshots.","Materiais documentados por referência comunitária; não foram exibidos nas capturas do tooltip.")}</p>
          </>
        ) : <p class="subtle">{equipmentText(lang,"Crafting materials not yet documented.","Materiais ainda não documentados.")}</p>}
      </>
    ) : <p class="subtle">{equipmentText(lang,"Crafting information has not been reviewed for this equipment yet.","Informações de fabricação ainda não verificadas para este equipamento.")}</p>}
    {profile && section === "crafting" && (
      <div class="references">
        <h3>{equipmentText(lang,"References and provenance","Referências e procedência")}</h3>
        <ul>{profile.evidence.references.map(ref => <li>
          <span class="evidence-tag">{sourceLegend(ref.kind)}</span>
          {ref.url ? <a href={ref.url} target="_blank" rel="noopener noreferrer">{ref.label}</a>
            : <span>{ref.label}</span>}
        </li>)}</ul>
        <p class="subtle">{equipmentText(lang,"Sources are tracked by section. Community documentation does not substitute for in-game verification.","A ficha usa evidências separadas por seção. Uma fonte comunitária não substitui a validação no jogo.")}</p>
      </div>
    )}
  </section>
)}
<style>
  section{margin:32px 0 0}
  h2{font-size:1.55rem;line-height:1.3;margin:0 0 16px}
  h3{font-size:1.12rem;margin:24px 0 6px;color:var(--color-gold-light)}
  .subtle{color:var(--color-text-muted);line-height:1.6;margin:6px 0 16px}
  .overview{display:grid;grid-template-columns:176px 1fr;gap:22px;align-items:stretch;
    background:linear-gradient(115deg,rgba(133,99,54,.15),var(--color-surface));
    border:1px solid var(--color-card-border);padding:20px;border-radius:7px}
  .item-artwork{min-height:205px;border:1px solid var(--color-card-border);
    background:radial-gradient(circle at 50% 38%,#364253 0%,#1a2028 56%,#11161c 100%);
    display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;
    border-radius:5px;color:var(--color-gold-light)}
  .item-artwork span{font-size:4.4rem;font-family:Georgia,serif;line-height:1.2}
  .item-artwork small{font-size:.75rem;color:var(--color-text-muted)}
  .overview-key-values,.craft-info dl{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin:0}
  .overview-key-values>div,.craft-info dl>div{background:rgba(0,0,0,.12);
    border:1px solid var(--color-border);padding:11px 14px;border-radius:4px;min-width:0}
  dt{font-size:.82rem;color:var(--color-text-muted)}
  dd{font-size:1.02rem;margin:3px 0 0;font-weight:600;color:var(--color-text)}
  .classes{display:flex;flex-wrap:wrap;gap:7px}
  .class-chip{border:1px solid var(--color-steel);border-radius:3px;
    background:rgba(55,69,88,.3);padding:3px 9px;font-size:.84rem}
  .source-note{font-size:.85rem;color:var(--color-text-muted);margin:14px 0 0}
  .model-note{font-size:.89rem;color:var(--color-gold-light);border-left:3px solid var(--color-bronze);
    padding:11px 13px;margin:16px 0;background:var(--color-surface);line-height:1.6}
  .estimated{color:var(--color-text-muted)!important;font-style:italic;font-size:.84rem;white-space:nowrap}
  .observed{color:var(--color-gold-light)!important;font-weight:600;font-size:.84rem;white-space:nowrap}
  .legendary-row{background:rgba(117,73,159,.13)}
  .legendary-row:hover{background:rgba(117,73,159,.21)!important}
  .legendary-mark{display:inline-block;font-weight:700;color:#e3bcff;border:1px solid #8f58b3;
    border-radius:3px;background:#47285d;padding:2px 11px}
  .legendary-info{border-left-color:#a276bf}
  .table-scroll{overflow-x:auto;border:1px solid var(--color-border);border-radius:5px}
  .item-table{width:100%;min-width:390px;border-collapse:collapse;font-variant-numeric:tabular-nums}
  .item-table th,.item-table td{padding:12px 16px;text-align:left;
    border-bottom:1px solid var(--color-border)}
  .item-table thead th{background:#29271f;color:var(--color-gold-light)}
  .item-table tbody th{color:var(--color-gold-light);font-weight:600}
  .item-table tbody tr:hover{background:var(--color-surface)}
  .item-table tbody td{color:var(--color-text)}
  .craft-info dl{grid-template-columns:repeat(3,minmax(0,1fr))}
  .references{border-top:1px solid var(--color-border);margin-top:30px;padding-top:5px}
  .references ul{margin:10px 0;padding-left:18px}
  .references li{padding:5px 0}
  .references a{color:var(--color-accent);text-decoration:underline;text-underline-offset:3px}
  .evidence-tag{display:inline-block;font-size:.78rem;color:var(--color-gold-light);
    background:var(--color-surface);border:1px solid var(--color-border);
    padding:2px 7px;margin-right:9px;border-radius:3px}
  @media(max-width:700px){
    .overview{grid-template-columns:1fr;padding:12px;gap:12px}
    .item-artwork{min-height:125px}
    .item-artwork span{font-size:3.2rem}
    .overview-key-values,.craft-info dl{grid-template-columns:1fr}
    .item-table th,.item-table td{padding:10px 11px}
  }
</style>
