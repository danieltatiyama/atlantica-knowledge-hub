---
import type { ItemArticleProfile, ItemArticleStatRow } from "../data/reviewed-equipment-profiles";

interface Props {
  lang: "en" | "pt-br";
  section: "overview" | "stats" | "crafting";
  profile?: ItemArticleProfile;
}

const { lang, section, profile } = Astro.props;
const pt = lang === "pt-br";
const rows = [...(profile?.stats ?? [])].sort((a,b) => a.enchantLevel - b.enchantLevel);
const number = new Intl.NumberFormat(pt ? "pt-BR" : "en-US");
const format = (value: number | undefined) => value === undefined ? "—" : number.format(value);
const possibleStats: { key: keyof ItemArticleStatRow; en: string; pt: string }[] = [
  { key: "strength", en: "Strength", pt: "Força" },
  { key: "vitality", en: "Vitality", pt: "Vitalidade" },
  { key: "dexterity", en: "Dexterity", pt: "Destreza" },
  { key: "intelligence", en: "Intelligence", pt: "Inteligência" },
  { key: "defense", en: "Defense", pt: "Defesa" },
  { key: "magicDefense", en: "Magic Defense", pt: "Defesa Mágica" },
];
const present = possibleStats.filter(col => rows.some(row => row[col.key] !== undefined));
const hasAttack = rows.some(row => row.attackMin !== undefined && row.attackMax !== undefined);
const crafting = profile?.crafting;
const screenshotLegend = pt ? "Captura de tela fornecida do jogo" : "User-supplied in-game screenshot";
const communityLegend = pt ? "Referência comunitária" : "Community reference";
const sourceLegend = (kind: string) => kind === "ingame-screenshot" ? screenshotLegend : communityLegend;
---
{section === "overview" && profile?.overview && (
  <section class="overview" id="item-overview" aria-label={pt ? "Resumo do equipamento" : "Equipment overview"}>
    <div class="item-artwork" aria-label={pt ? "Ícone do item ainda indisponível" : "Item artwork not yet available"}>
      <span aria-hidden="true">⚔</span>
      <small>{pt ? "Arte pendente" : "Artwork pending"}</small>
    </div>
    <div class="item-overview-details">
      <h2>{pt ? "Informações gerais" : "Overview"}</h2>
      <dl class="overview-key-values">
        <div><dt>{pt ? "Tipo" : "Type"}</dt><dd>{profile.overview.typeEn}</dd></div>
        <div><dt>{pt ? "Nível mínimo" : "Minimum level"}</dt><dd>{profile.overview.minimumLevel}</dd></div>
      </dl>
      {profile.overview.eligibleClasses.length > 0 && (
        <div class="class-restrictions">
          <h3>{pt ? "Classes permitidas" : "Class restrictions"}</h3>
          <p class="subtle">{pt
            ? "Nomes exibidos no tooltip do cliente, preservados como aparecem."
            : "Client tooltip labels, retained as shown."}</p>
          <div class="classes">{profile.overview.eligibleClasses.map((cls) =>
            <span class="class-chip">{cls}</span>)}</div>
        </div>
      )}
      <p class="source-note">{pt ? "Fonte: tooltip do jogo · Equipamento +0" : "Source: in-game tooltip · +0 equipment"}</p>
    </div>
  </section>
)}
{section === "stats" && (
  <section id="item-stats">
    <h2>{pt ? "Atributos" : "Stats"}</h2>
    {rows.length > 0 ? (
      <>
        <p class="subtle">{pt
          ? "Valores por nível de encantamento. Somente níveis com evidência revisada aparecem na tabela."
          : "Statistics by enchantment level. Only reviewed and source-backed levels appear here."}</p>
        <div class="table-scroll">
          <table class="item-table">
            <thead><tr>
              <th>{pt ? "Encantamento" : "Enchant level"}</th>
              {hasAttack && <th>{pt ? "Poder de ataque" : "Attack power"}</th>}
              {present.map((column) => <th>{pt ? column.pt : column.en}</th>)}
            </tr></thead>
            <tbody>{rows.map((row) => <tr>
              <th scope="row">+{row.enchantLevel}</th>
              {hasAttack && <td>{row.attackMin !== undefined && row.attackMax !== undefined
                ? format(row.attackMin) + " – " + format(row.attackMax) : "—"}</td>}
              {present.map((column) => <td>{row[column.key] === undefined
                ? "—" : "+" + format(row[column.key])}</td>)}
            </tr>)}</tbody>
          </table>
        </div>
        {rows.length < 11 && <p class="source-note">{pt
          ? "Demais níveis de encantamento aguardam confirmação; nenhum valor foi extrapolado."
          : "Other enchantment levels are pending verification; no values have been extrapolated."}</p>}
      </>
    ) : <p class="subtle">{pt
      ? "Nenhum atributo confirmado para este item ainda."
      : "No independently reviewed stats for this item yet."}</p>}
  </section>
)}
{section === "crafting" && (
  <section id="item-crafting">
    <h2>{pt ? "Fabricação" : "Crafting"}</h2>
    {crafting ? (
      <>
        <div class="craft-info">
          <dl>
            <div><dt>{pt ? "Produção por lote" : "Production per batch"}</dt>
              <dd>{format(crafting.productionPerBatch)}</dd></div>
            <div><dt>{pt ? "Workload necessário" : "Required workload"}</dt>
              <dd>{format(crafting.requiredWorkload)}</dd></div>
            <div><dt>{pt ? "Skill de fabricação" : "Required crafting skill"}</dt>
              <dd>{crafting.requiredSkill.nameEn} · Lv. {crafting.requiredSkill.level}</dd></div>
          </dl>
        </div>
        <h3>{pt ? "Materiais" : "Materials"}</h3>
        {crafting.materials.length ? (
          <>
            <div class="table-scroll"><table class="item-table">
              <thead><tr><th>{pt ? "Material" : "Material"}</th><th>{pt ? "Quantidade" : "Required"}</th></tr></thead>
              <tbody>{crafting.materials.map((material) =>
                <tr><td>{material.nameEn}</td><td>×{format(material.quantity)}</td></tr>)}</tbody>
            </table></div>
            <p class="source-note">{pt
              ? "Materiais documentados por referência comunitária; não foram exibidos nas capturas do tooltip."
              : "Materials are supported by a community reference; they were not visible in the supplied tooltip screenshots."}</p>
          </>
        ) : <p class="subtle">{pt
          ? "Materiais ainda não documentados."
          : "Crafting materials not yet documented."}</p>}
      </>
    ) : <p class="subtle">{pt
      ? "Informações de fabricação ainda não verificadas para este equipamento."
      : "Crafting information has not been reviewed for this equipment yet."}</p>}
    {profile && section === "crafting" && (
      <div class="references">
        <h3>{pt ? "Referências e procedência" : "References and provenance"}</h3>
        <ul>{profile.evidence.references.map(ref => <li>
          <span class="evidence-tag">{sourceLegend(ref.kind)}</span>
          {ref.url ? <a href={ref.url} target="_blank" rel="noopener noreferrer">{ref.label}</a>
            : <span>{ref.label}</span>}
        </li>)}</ul>
        <p class="subtle">{pt
          ? "A ficha usa evidências separadas por seção. Uma fonte comunitária não substitui a validação no jogo."
          : "Sources are tracked by section. Community documentation does not substitute for in-game verification."}</p>
      </div>
    )}
  </section>
)}
<style>
  section{margin:32px 0 0}
  h2{font-size:1.55rem;line-height:1.3;margin:0 0 16px}
  h3{font-size:1.12rem;margin:24px 0 6px;color:var(--color-gold-light)}
  .subtle{color:var(--color-text-muted);line-height:1.6;margin:6px 0 16px}
  .overview{display:grid;grid-template-columns:176px 1fr;gap:22px;align-items:stretch;
    background:linear-gradient(115deg,rgba(133,99,54,.15),var(--color-surface));
    border:1px solid var(--color-card-border);padding:20px;border-radius:7px}
  .item-artwork{min-height:205px;border:1px solid var(--color-card-border);
    background:radial-gradient(circle at 50% 38%,#364253 0%,#1a2028 56%,#11161c 100%);
    display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;
    border-radius:5px;color:var(--color-gold-light)}
  .item-artwork span{font-size:4.4rem;font-family:Georgia,serif;line-height:1.2}
  .item-artwork small{font-size:.75rem;color:var(--color-text-muted)}
  .overview-key-values,.craft-info dl{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin:0}
  .overview-key-values>div,.craft-info dl>div{background:rgba(0,0,0,.12);
    border:1px solid var(--color-border);padding:11px 14px;border-radius:4px;min-width:0}
  dt{font-size:.82rem;color:var(--color-text-muted)}
  dd{font-size:1.02rem;margin:3px 0 0;font-weight:600;color:var(--color-text)}
  .classes{display:flex;flex-wrap:wrap;gap:7px}
  .class-chip{border:1px solid var(--color-steel);border-radius:3px;
    background:rgba(55,69,88,.3);padding:3px 9px;font-size:.84rem}
  .source-note{font-size:.85rem;color:var(--color-text-muted);margin:14px 0 0}
  .table-scroll{overflow-x:auto;border:1px solid var(--color-border);border-radius:5px}
  .item-table{width:100%;min-width:390px;border-collapse:collapse;font-variant-numeric:tabular-nums}
  .item-table th,.item-table td{padding:12px 16px;text-align:left;
    border-bottom:1px solid var(--color-border)}
  .item-table thead th{background:#29271f;color:var(--color-gold-light)}
  .item-table tbody th{color:var(--color-gold-light);font-weight:600}
  .item-table tbody tr:hover{background:var(--color-surface)}
  .item-table tbody td{color:var(--color-text)}
  .craft-info dl{grid-template-columns:repeat(3,minmax(0,1fr))}
  .references{border-top:1px solid var(--color-border);margin-top:30px;padding-top:5px}
  .references ul{margin:10px 0;padding-left:18px}
  .references li{padding:5px 0}
  .references a{color:var(--color-accent);text-decoration:underline;text-underline-offset:3px}
  .evidence-tag{display:inline-block;font-size:.78rem;color:var(--color-gold-light);
    background:var(--color-surface);border:1px solid var(--color-border);
    padding:2px 7px;margin-right:9px;border-radius:3px}
  @media(max-width:700px){
    .overview{grid-template-columns:1fr;padding:12px;gap:12px}
    .item-artwork{min-height:125px}
    .item-artwork span{font-size:3.2rem}
    .overview-key-values,.craft-info dl{grid-template-columns:1fr}
    .item-table th,.item-table td{padding:10px 11px}
  }
</style>
