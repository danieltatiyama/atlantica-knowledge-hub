---
import BaseLayout from "../layouts/BaseLayout.astro";
import {toolText} from "../i18n/tools-ui.mjs";
import {localizedPaths,catalogPath} from "../i18n/locales.mjs";
import type {Lang} from "../i18n/ui";
interface Props {lang:Lang;}
const {lang}=Astro.props;
const cards=[
 {name:toolText(lang,"Data quality","Qualidade dos dados"),description:toolText(lang,"Client source coverage and integrity.","Cobertura e consistência dos índices do cliente."),href:catalogPath(lang,"/tools/data-quality/")},
 {name:toolText(lang,"Crafting calculator","Calculadora de crafting"),description:toolText(lang,"Plan materials and dependencies.","Calcule materiais e dependências."),href:catalogPath(lang,"/tools/crafting/")},
 {name:toolText(lang,"Nation Dungeon calendar","Calendário de Nation Dungeons"),description:toolText(lang,"Plan runs and cooldowns.","Planeje runs e cooldowns."),href:catalogPath(lang,"/tools/nation-dungeons/")},
 {name:toolText(lang,"Market price catalog","Catálogo de preços do Market"),description:toolText(lang,"Browse 421 client price references by name, category or ItemID.","Consulte 421 preços de referência por nome, categoria ou ItemID."),href:catalogPath(lang,"/tools/market-prices/")},
];
---
<BaseLayout title={(toolText(lang,"Tools","Ferramentas"))+" | Atlantica Knowledge Hub"}
 lang={lang} alternatePaths={localizedPaths("/tools/")}>
 <main class="tools-index">
  <p class="eyebrow">ATLANTICA GLOBAL / NA</p>
  <h1>{toolText(lang,"Tools & calculators","Ferramentas e calculadoras")}</h1>
  <p>{toolText(lang,"Community tools using Wiki data.","Ferramentas comunitárias baseadas na Wiki.")}</p>
  <div class="tool-grid">{cards.map(card=>card.href
    ? <a href={card.href}><h2>{card.name}</h2><p>{card.description}</p></a>
    : <div class="future-tool"><h2>{card.name}</h2><p>{card.description}</p><small>{toolText(lang,"Coming soon","Em desenvolvimento")}</small></div>
  )}</div>
 </main>
</BaseLayout>
<style>
 .tools-index{width:min(var(--content-width),92%);margin:0 auto;padding:36px 0 90px}
 .eyebrow{font-size:.77rem;letter-spacing:.14em;color:var(--color-accent)}
 h1{font-size:clamp(2rem,4vw,3rem)}.tools-index>p{color:var(--color-text-muted)}
 .tool-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,250px),1fr));gap:15px;margin-top:28px}
 .tool-grid a,.future-tool{display:block;padding:20px;border:1px solid var(--color-border);border-radius:6px;
   background:var(--color-surface);color:var(--color-text);text-decoration:none}
 .tool-grid a:is(:hover,:focus-visible){border-color:var(--color-accent);outline-color:var(--color-accent)}
 .tool-grid h2{margin:0 0 10px;color:var(--color-gold-light);font-size:1.25rem}
 .tool-grid p{color:var(--color-text-muted);margin:0}
 .future-tool{opacity:.65}.future-tool small{color:var(--color-text-muted)}
</style>
