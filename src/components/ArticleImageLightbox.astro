---
interface Props {lang:"en"|"pt-br";}
const {lang}=Astro.props;
const pt=lang==="pt-br";
---
<div id="wiki-image-lightbox" class="wiki-image-lightbox" data-lang={lang}
 role="dialog" aria-modal="true" aria-labelledby="wiki-lightbox-title"
 aria-describedby="wiki-lightbox-hint" hidden>
 <div class="wiki-lightbox-toolbar">
  <div class="wiki-lightbox-meta">
   <strong id="wiki-lightbox-title">{pt?"Visualizador de imagens":"Image viewer"}</strong>
   <span id="wiki-lightbox-position" aria-live="polite"></span>
  </div>
  <div class="wiki-lightbox-controls" role="group"
   aria-label={pt?"Controles da imagem":"Image controls"}>
   <button type="button" id="wiki-lightbox-prev"
    aria-label={pt?"Imagem anterior":"Previous image"} title={pt?"Imagem anterior (←)":"Previous image (←)"}>‹</button>
   <button type="button" id="wiki-lightbox-next"
    aria-label={pt?"Próxima imagem":"Next image"} title={pt?"Próxima imagem (→)":"Next image (→)"}>›</button>
   <span class="wiki-lightbox-divider" aria-hidden="true"></span>
   <button type="button" id="wiki-lightbox-minus"
    aria-label={pt?"Diminuir zoom":"Zoom out"} title={pt?"Diminuir zoom (-)":"Zoom out (-)"}>−</button>
   <span class="wiki-lightbox-zoom" id="wiki-lightbox-zoom" aria-live="polite">100%</span>
   <button type="button" id="wiki-lightbox-plus"
    aria-label={pt?"Aumentar zoom":"Zoom in"} title={pt?"Aumentar zoom (+)":"Zoom in (+)"}>+</button>
   <button type="button" id="wiki-lightbox-fit"
    aria-label={pt?"Ajustar à janela":"Fit to window"} title={pt?"Ajustar à janela (0)":"Fit to window (0)"}>
    {pt?"Ajustar":"Fit"}
   </button>
   <span class="wiki-lightbox-divider" aria-hidden="true"></span>
   <button type="button" id="wiki-lightbox-close" class="wiki-lightbox-close"
    aria-label={pt?"Fechar visualizador de imagens":"Close image viewer"} title={pt?"Fechar (Esc)":"Close (Esc)"}>×</button>
  </div>
 </div>
 <div id="wiki-lightbox-stage" class="wiki-lightbox-stage">
  <div id="wiki-lightbox-canvas" class="wiki-lightbox-canvas">
   <img id="wiki-lightbox-image" alt="" draggable="false"/>
  </div>
 </div>
 <div class="wiki-lightbox-footer">
  <span id="wiki-lightbox-caption"></span>
  <small id="wiki-lightbox-hint">{pt
   ?"←/→: imagens · +/−: zoom · 0: ajustar · Esc: fechar"
   :"←/→: images · +/−: zoom · 0: fit · Esc: close"}</small>
 </div>
</div>
<script>
 import {clampLightboxZoom,cycleLightboxIndex,fitLightboxImage}
  from "../lib/article-image-lightbox.mjs";

 const dialog=document.getElementById("wiki-image-lightbox") as HTMLElement | null;
 if(dialog){
  const pt=dialog.dataset.lang==="pt-br";
  const get=(id:string)=>document.getElementById(id)!;
  const stage=get("wiki-lightbox-stage") as HTMLElement;
  const canvas=get("wiki-lightbox-canvas") as HTMLElement;
  const display=get("wiki-lightbox-image") as HTMLImageElement;
  const caption=get("wiki-lightbox-caption");
  const title=get("wiki-lightbox-title");
  const position=get("wiki-lightbox-position");
  const zoomLabel=get("wiki-lightbox-zoom");
  const previous=get("wiki-lightbox-prev") as HTMLButtonElement;
  const next=get("wiki-lightbox-next") as HTMLButtonElement;
  const minus=get("wiki-lightbox-minus") as HTMLButtonElement;
  const plus=get("wiki-lightbox-plus") as HTMLButtonElement;
  const fit=get("wiki-lightbox-fit") as HTMLButtonElement;
  const closeButton=get("wiki-lightbox-close") as HTMLButtonElement;
  let gallery:HTMLImageElement[]=[];
  let current=0;
  let zoom=1;
  let open=false;
  let lastFocus:HTMLElement|null=null;
  let previousOverflow="";

  // Restrict the viewer to real content images, not icons, logos, galleries
  // with their own interaction or explicitly opted-out images.
  const eligible=(img:HTMLImageElement)=>
   Boolean(img.closest(".article-body"))&&
   Boolean(img.getAttribute("src"))&&
   !img.closest("a,button,[data-wiki-lightbox-ignore]");

  function updateDimensions(){
   if(!open||!display.naturalWidth||!display.naturalHeight)return;
   const size=fitLightboxImage(display.naturalWidth,display.naturalHeight,
    Math.max(stage.clientWidth-16,1),Math.max(stage.clientHeight-16,1),zoom);
   if(!size)return;
   display.style.width=size.width+"px";
   display.style.height=size.height+"px";
   canvas.style.width=Math.max(stage.clientWidth,size.width+16)+"px";
   canvas.style.height=Math.max(stage.clientHeight,size.height+16)+"px";
   // Center the image after each zoom; large images remain pannable by scrolling.
   stage.scrollLeft=Math.max(0,(canvas.scrollWidth-stage.clientWidth)/2);
   stage.scrollTop=Math.max(0,(canvas.scrollHeight-stage.clientHeight)/2);
  }
  function updateControls(){
   zoomLabel.textContent=Math.round(zoom*100)+"%";
   minus.disabled=zoom<=1;
   plus.disabled=zoom>=5;
   previous.disabled=gallery.length<=1;
   next.disabled=gallery.length<=1;
   position.textContent=gallery.length>1?(current+1)+" / "+gallery.length:"";
   display.style.cursor=zoom===1?"zoom-in":"zoom-out";
  }
  function setZoom(nextZoom:number){
   zoom=clampLightboxZoom(nextZoom);
   updateControls();
   updateDimensions();
  }
  function show(index:number){
   current=cycleLightboxIndex(index,0,gallery.length);
   if(current<0)return;
   const source=gallery[current];
   const alt=source.getAttribute("alt")?.trim()||
    (pt?"Imagem do artigo":"Article image");
   const url=source.currentSrc||source.src;
   title.textContent=pt?"Visualizador de imagens":"Image viewer";
   caption.textContent=alt;
   display.alt=alt;
   zoom=1;
   display.style.width="";
   display.style.height="";
   display.src=url;
   updateControls();
   if(display.complete&&display.naturalWidth)updateDimensions();
  }
  function openImage(source:HTMLImageElement){
   gallery=[...source.closest(".article-body")!.querySelectorAll<HTMLImageElement>("img")]
    .filter(eligible);
   const index=gallery.indexOf(source);
   if(index<0)return;
   lastFocus=source;
   previousOverflow=document.body.style.overflow;
   open=true;
   dialog.hidden=false;
   document.body.style.overflow="hidden";
   show(index);
   closeButton.focus({preventScroll:true});
  }
  function close(){
   if(!open)return;
   open=false;
   dialog.hidden=true;
   document.body.style.overflow=previousOverflow;
   display.removeAttribute("src");
   gallery=[];
   lastFocus?.focus({preventScroll:true});
   lastFocus=null;
  }
  display.addEventListener("load",()=>updateDimensions());
  display.addEventListener("error",()=>{
   caption.textContent=pt?"Não foi possível carregar esta imagem.":
    "Could not load this image.";
  });
  const navigate=(delta:number)=>{
   if(gallery.length>1)show(cycleLightboxIndex(current,delta,gallery.length));
  };
  previous.addEventListener("click",()=>navigate(-1));
  next.addEventListener("click",()=>navigate(1));
  minus.addEventListener("click",()=>setZoom(zoom/1.25));
  plus.addEventListener("click",()=>setZoom(zoom*1.25));
  fit.addEventListener("click",()=>setZoom(1));
  closeButton.addEventListener("click",close);
  display.addEventListener("dblclick",()=>setZoom(zoom===1?2:1));
  stage.addEventListener("click",event=>{
   if(event.target===stage||event.target===canvas)close();
  });
  stage.addEventListener("wheel",event=>{
   if(!open||!(event.ctrlKey||event.metaKey))return;
   event.preventDefault();
   setZoom(event.deltaY<0?zoom*1.25:zoom/1.25);
  },{passive:false});

  // Source images remain ordinary, accessible images until JS is ready.
  for(const img of document.querySelectorAll<HTMLImageElement>(".article-body img")){
   if(!eligible(img))continue;
   img.tabIndex=0;
   img.setAttribute("role","button");
   img.setAttribute("aria-label",(pt?"Ampliar imagem":"Expand image")+
    (img.alt?": "+img.alt:""));
   img.dataset.wikiLightboxReady="true";
  }
  document.addEventListener("click",event=>{
   const target=event.target;
   if(!(target instanceof HTMLImageElement)||!eligible(target)||
    !target.dataset.wikiLightboxReady)return;
   event.preventDefault();
   openImage(target);
  });
  document.addEventListener("keydown",event=>{
   if(!open){
    const target=event.target;
    if((event.key==="Enter"||event.key===" ")&&
     target instanceof HTMLImageElement&&eligible(target)&&
     target.dataset.wikiLightboxReady){
     event.preventDefault();
     openImage(target);
    }
    return;
   }
   if(event.key==="Escape"){event.preventDefault();close();return;}
   if(event.key==="ArrowLeft"){event.preventDefault();navigate(-1);return;}
   if(event.key==="ArrowRight"){event.preventDefault();navigate(1);return;}
   if(event.key==="+"||event.key==="="){event.preventDefault();setZoom(zoom*1.25);return;}
   if(event.key==="-"||event.key==="_"){event.preventDefault();setZoom(zoom/1.25);return;}
   if(event.key==="0"){event.preventDefault();setZoom(1);return;}
   if(event.key!=="Tab")return;
   // Keep keyboard focus inside the modal while it is displayed.
   const focusable=[...dialog.querySelectorAll<HTMLButtonElement>("button:not([disabled])")];
   if(!focusable.length)return;
   const first=focusable[0],last=focusable[focusable.length-1];
   if(event.shiftKey&&document.activeElement===first){
    event.preventDefault();last.focus();
   }else if(!event.shiftKey&&document.activeElement===last){
    event.preventDefault();first.focus();
   }else if(!focusable.includes(document.activeElement as HTMLButtonElement)){
    event.preventDefault();first.focus();
   }
  });
  window.addEventListener("resize",()=>updateDimensions());
 }
</script>
<style is:global>
 .article-body img[data-wiki-lightbox-ready]{cursor:zoom-in}
 .article-body img[data-wiki-lightbox-ready]:focus-visible{
  outline:3px solid var(--color-accent);outline-offset:4px
 }
 #wiki-image-lightbox[hidden]{display:none!important}
 #wiki-image-lightbox{
  position:fixed;inset:0;z-index:20000;
  display:grid;grid-template-rows:auto minmax(0,1fr) auto;
  width:100vw;height:100dvh;background:rgba(0,0,0,.95);
  color:#f6f2e9;overscroll-behavior:contain
 }
 .wiki-lightbox-toolbar{
  display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;
  gap:8px 16px;padding:10px clamp(12px,2vw,22px);
  background:var(--color-surface);color:var(--color-text);
  border-bottom:1px solid var(--color-border)
 }
 .wiki-lightbox-meta{display:flex;gap:12px;align-items:center;min-width:0}
 .wiki-lightbox-meta strong{font-size:.96rem}
 #wiki-lightbox-position{font-size:.78rem;color:var(--color-text-muted);white-space:nowrap}
 .wiki-lightbox-controls{display:flex;align-items:center;flex-wrap:wrap;gap:5px}
 .wiki-lightbox-controls button{
  display:inline-flex;align-items:center;justify-content:center;
  min-width:38px;min-height:38px;padding:5px 9px;cursor:pointer;
  border:1px solid var(--color-border);border-radius:5px;
  background:var(--color-background);color:var(--color-text);
  font:inherit;font-size:1.12rem
 }
 .wiki-lightbox-controls button:hover:not(:disabled){border-color:var(--color-accent)}
 .wiki-lightbox-controls button:disabled{opacity:.4;cursor:default}
 .wiki-lightbox-controls button:focus-visible{
  outline:2px solid var(--color-accent);outline-offset:2px
 }
 .wiki-lightbox-controls .wiki-lightbox-close{font-size:1.5rem}
 .wiki-lightbox-divider{width:1px;height:24px;background:var(--color-border);margin:0 5px}
 .wiki-lightbox-zoom{min-width:46px;text-align:center;font-size:.84rem;font-variant-numeric:tabular-nums}
 .wiki-lightbox-stage{min-height:0;min-width:0;overflow:auto;overscroll-behavior:contain}
 .wiki-lightbox-canvas{display:flex;justify-content:center;align-items:center}
 .wiki-lightbox-canvas img{
  display:block;max-width:none!important;max-height:none!important;
  flex-shrink:0;object-fit:fill;user-select:none
 }
 .wiki-lightbox-footer{
  display:flex;justify-content:space-between;align-items:center;gap:8px 22px;
  padding:9px clamp(12px,2vw,22px);background:var(--color-surface);
  color:var(--color-text);border-top:1px solid var(--color-border);
  font-size:.82rem;min-height:40px
 }
 .wiki-lightbox-footer span{overflow-wrap:anywhere}
 .wiki-lightbox-footer small{color:var(--color-text-muted);text-align:right}
 @media(max-width:660px){
  .wiki-lightbox-toolbar{justify-content:center}
  .wiki-lightbox-meta{justify-content:center;width:100%}
  .wiki-lightbox-controls{justify-content:center}
  .wiki-lightbox-controls button{min-width:34px;min-height:36px}
  .wiki-lightbox-divider{margin:0 2px}
  .wiki-lightbox-footer{display:block;text-align:center}
  .wiki-lightbox-footer small{display:block;text-align:center;margin-top:4px}
 }
 @media(prefers-reduced-motion:reduce){
  #wiki-image-lightbox *{scroll-behavior:auto!important}
 }
</style>
