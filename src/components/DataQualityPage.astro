---
import BaseLayout from "../layouts/BaseLayout.astro";
import {marketAuditText} from "../i18n/market-audit-ui.mjs";
import {localePrefix,localeTag,localizedPaths} from "../i18n/locales.mjs";
import type {Lang} from "../i18n/ui";
interface Props {lang:Lang;}
const {lang}=Astro.props;
const prefix=localePrefix(lang);
---
<BaseLayout title={(marketAuditText(lang,"Data quality","Qualidade dos dados"))+" | Atlantica Knowledge Hub"}
 lang={lang} alternatePaths={localizedPaths("/tools/data-quality/")}>
 <main class="quality-page" id="client-source-quality" data-lang={lang}>
  <nav><a href={prefix+"/tools/"}>{marketAuditText(lang,"← Tools","← Ferramentas")}</a></nav>
  <p class="eyebrow">GLOBAL / NA · SNAPSHOT 1</p>
  <h1>{marketAuditText(lang,"Client data quality audit","Auditoria dos dados do cliente")}</h1>
  <p>{marketAuditText(lang,"Integrity checks between loot and crafting source indexes. Internal consistency does not prove current server mechanics or availability.","Verificações de integridade entre índices de drops e fabricação. Consistência dos arquivos não comprova mecânicas ou disponibilidade no servidor.")}</p>
  <p id="source-quality-status" role="status">{marketAuditText(lang,"Loading audit report…","Carregando relatório…")}</p>
  <div id="source-quality-results" hidden>
   <section><h2>{marketAuditText(lang,"Item catalog","Catálogo de itens")}</h2><dl id="quality-items"></dl></section>
   <section><h2>{marketAuditText(lang,"Creatures and loot","Monstros e drops")}</h2><dl id="quality-monsters"></dl></section>
   <section><h2>{marketAuditText(lang,"Crafting","Fabricação")}</h2><dl id="quality-crafting"></dl></section>
   <section><h2>{marketAuditText(lang,"Limitations","Ressalvas")}</h2><ul id="quality-warnings"></ul></section>
  </div>
 </main>
</BaseLayout>
<script>
 import {marketAuditText} from "../i18n/market-audit-ui.mjs";
 import {localeTag} from "../i18n/locales.mjs";
 const root=document.getElementById("client-source-quality");
 if(root){
  const lang=root.dataset.lang??"en",nf=new Intl.NumberFormat(lang==="en"?"en-US":localeTag(lang));
  const status=document.getElementById("source-quality-status")!;
  const sections={
   itemCatalog:[["ids",marketAuditText(lang,"Item IDs","IDs de itens")],["named",marketAuditText(lang,"Named items","Itens nomeados")],["equipmentReviewed",marketAuditText(lang,"Reviewed equipment","Equipamentos revisados")]],
   monsters:[["ids",marketAuditText(lang,"Creature IDs","IDs de criaturas")],["withMatchedDrops",marketAuditText(lang,"Creatures with matched loot","Criaturas com drops")],
    ["withoutMatchedDrops",marketAuditText(lang,"Without resolved loot","Sem drops resolvidos")],["directRows",marketAuditText(lang,"Direct rows","Registros diretos")],
    ["levelMatchedGroupRows",marketAuditText(lang,"Level-matched group rows","Registros compatíveis")],
    ["matchedItemIds",marketAuditText(lang,"Matched loot item IDs","IDs com drops elegíveis")],["unresolvedGroupReferences",marketAuditText(lang,"Unresolved group references","Referências inconclusivas")]],
   crafting:[["recipeProducts",marketAuditText(lang,"Recipe products","Produtos com receitas")],["ingredientObservations",marketAuditText(lang,"Ingredient observations","Ingredientes identificados")],
    ["linkedMaterialIds",marketAuditText(lang,"Linked material IDs","Materiais vinculados")],["unindexedMaterialIds",marketAuditText(lang,"Unindexed material IDs","Materiais sem nome no índice")]],
  };
  const create=(tag:string,value:string)=>{const el=document.createElement(tag);el.textContent=value;return el;};
  void (async()=>{
   try{
    const response=await fetch("/data/audits/source-quality.json");
    if(!response.ok)throw Error("Audit unavailable");
    const data=await response.json();
    if(data.schemaVersion!=="1.0"||data.snapshotId!==1||data.dataset!=="atlantica-client-source-quality"||
      data.status!=="source-consistent"||!data.checks?.forwardReverseMatches||!data.checks?.hugeCrocodileReference)
      throw Error("Invalid audit");
    for(const [name,fields] of Object.entries(sections)){
     const dest=document.getElementById("quality-"+(name==="itemCatalog"?"items":name))!;
     for(const [key,label] of fields){
      const value=data[name]?.[key];
      if(!Number.isSafeInteger(value)||value<0)throw Error("Invalid coverage count");
      const item=create("div","");item.append(create("dt",label),create("dd",nf.format(value)));dest.append(item);
     }
    }
    const warnings=document.getElementById("quality-warnings")!;
    for(const note of data.warnings??[])warnings.append(create("li",marketAuditText(lang,String(note),({
"The 197 unmatched group references remain unresolved and are not inferred.":"As 197 referências de grupo sem correspondência continuam inconclusivas, sem inferência.",
"Unindexed crafting material IDs retain original numeric references; do not guess their identities.":"IDs de materiais não indexados mantêm as referências numéricas originais; suas identidades não são presumidas.",
"Source-consistent means internal indexes agree. It does not prove live-server drop rates, active monsters, or recipe availability.":"Consistência das fontes significa concordância entre índices internos. Não comprova taxas de drops, monstros ativos ou disponibilidade de receitas no servidor."
} as Record<string,string>)[String(note)]??String(note))));
    status.textContent=marketAuditText(lang,"Internal source indexes agree · Snapshot 1","Índices internos consistentes · Snapshot 1");
    document.getElementById("source-quality-results")!.hidden=false;
   }catch{status.textContent=marketAuditText(lang,"Audit report unavailable or incompatible.","Relatório indisponível ou incompatível.");}
  })();
 }
</script>
<style>
 .quality-page{width:min(var(--content-width),92%);margin:0 auto;padding:24px 0 90px}
 nav a{color:var(--color-accent)}h1{font-size:clamp(2rem,4vw,3rem)}
 .eyebrow{color:var(--color-accent);letter-spacing:.12em;font-size:.79rem}
 .quality-page>p{max-width:850px;color:var(--color-text-muted)}
 section{margin:24px 0;padding:20px;border:1px solid var(--color-border);background:var(--color-surface);border-radius:6px}
 section h2{font-size:1.35rem;margin:0 0 15px;color:var(--color-gold-light)}
 dl{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,180px),1fr));gap:10px;margin:0}
 dl>div{padding:13px;background:var(--color-background);border:1px solid var(--color-border);border-radius:4px}
 dt{font-size:.83rem;color:var(--color-text-muted)}dd{margin:7px 0 0;font-size:1.3rem;font-weight:700;font-variant-numeric:tabular-nums}
 li{line-height:1.6;color:var(--color-text-muted);margin:0 0 8px}
</style>
