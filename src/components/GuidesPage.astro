---
import type { Lang } from "../i18n/ui";
import { useTranslations } from "../i18n/utils";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

import { SUBCATEGORY_IDS, GUIDE_SUBCATEGORIES, guideSubcategoryLabel } from "../data/guide-taxonomy";
import { localizedPaths, NEW_GUIDE_LOCALES } from "../i18n/locales.mjs";

const categories = [
  {
    slug: "nation-dungeons",
    title: t("guides.categoryNationDungeons"),
    description: t("guides.nationDungeonsDesc"),
    symbol: "✦",
    theme: "dungeons",
  },
  {
    slug: "mercenaries",
    title: t("guides.categoryMercenaries"),
    description: t("guides.mercenariesDesc"),
    symbol: "⚔",
    theme: "mercenaries",
  },
  {
    slug: "game-systems",
    title: t("guides.categoryGameSystems"),
    description: t("guides.gameSystemsDesc"),
    symbol: "⚙",
    theme: "systems",
  },
];

const allGuides = await getCollection("guides");
const guides = allGuides
  .filter((guide) => guide.data.lang === lang && !guide.data.draft)
  .sort(
    (a, b) =>
      b.data.updatedAt.getTime() -
      a.data.updatedAt.getTime()
  );

const categoryLabels: Record<string, string> = {
  "nation-dungeons": t("guides.categoryNationDungeons"),
  "mercenaries": t("guides.categoryMercenaries"),
  "game-systems": t("guides.categoryGameSystems"),
};

const subcategories = SUBCATEGORY_IDS.map((id) => ({
  id,
  category: GUIDE_SUBCATEGORIES[id].category,
  label: guideSubcategoryLabel(id,lang),
}));
---

<BaseLayout
  title={`${t("guides.title")} | Atlantica Knowledge Hub`}
  description={t("guides.intro")}
  lang={lang}
  alternatePaths={localizedPaths("/guides/")}
>
  <main class="container">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href={lang === "en" ? "/" : `/${lang}/`}>
        {t("nav.home")}
      </a>
      <span>/</span>
      <span>{t("nav.guides")}</span>
    </nav>

    <section class="intro">
      <p class="eyebrow">{t("guides.eyebrow")}</p>
      <h1>{t("guides.title")}</h1>
      <p>{t("guides.intro")}</p>
    </section>

    <section class="latest-guides" aria-labelledby="latest-guides-title">
        <h2 id="latest-guides-title">{t("guides.latest")}</h2>

        <div class="guide-search">
          <label for="guide-search">
            {t("guides.searchLabel")}
          </label>

          <input
            id="guide-search"
            type="search"
            placeholder={t("guides.searchPlaceholder")}
            autocomplete="off"
            aria-controls="guide-list"
          />
        </div>

        <div class="guide-filters" role="group" aria-label={t("guides.filterLabel")}>
          <button class="filter-button is-active" type="button"
            data-guide-filter="all" aria-pressed="true" aria-controls="guide-list">
            {t("guides.all")}
          </button>

          <button class="filter-button" type="button"
            data-guide-filter="nation-dungeons" aria-pressed="false" aria-controls="guide-list">
            {t("guides.categoryNationDungeons")}
          </button>

          <button class="filter-button" type="button"
            data-guide-filter="mercenaries" aria-pressed="false" aria-controls="guide-list">
            {t("guides.filterMercenaries")}
          </button>

          <button class="filter-button" type="button"
            data-guide-filter="game-systems" aria-pressed="false" aria-controls="guide-list">
            {t("guides.categoryGameSystems")}
          </button>
        </div>

        <div class="guide-subcategory"
          id="guide-subcategory-group"
          hidden
        >
          <label for="guide-subcategory">
            {t("guides.subcategory")}
          </label>

          <select
            id="guide-subcategory"
            aria-controls="guide-list"
          >
            <option value="">
              {t("guides.allSubcategories")}
            </option>

            {subcategories.map((subcategory) => (
              <option
                value={subcategory.id}
                data-parent-category={subcategory.category}
              >
                {subcategory.label}
              </option>
            ))}
          </select>
        </div>


        <p id="guide-results-count"
          class="guide-results-count"
          role="status"
          aria-live="polite"
          aria-atomic="true"
          data-one={t("guides.resultsOne")}
          data-many={t("guides.resultsMany")}
        >
          {guides.length} {
            guides.length === 1
              ? t("guides.resultsOne")
              : t("guides.resultsMany")
          }
        </p>

        <div class="guide-list" id="guide-list">
          {guides.map((guide) => (
            <article class="card"
              data-guide-subcategory={guide.data.subcategory ?? ""}
              data-guide-category={guide.data.category}
              data-guide-search={`${guide.data.title} ${guide.data.description}`}>
                <p class="eyebrow">
                {categoryLabels[guide.data.category] ?? guide.data.category}
                </p>

                <h3>
                    <a class="guide-link" href={`${lang === "en" ? "" : `/${lang}`}/guides/${guide.id.replace(/^[^/]+\//, "")}/`}>
                        {guide.data.title}
                    </a>
                </h3>

                <p>{guide.data.description}</p>

                <span>
                  {t("article.updated")}: {guide.data.updatedAt.toISOString().slice(0, 10)}
                </span>
            </article>
          ))}
        </div>

        <p
          id="no-guides"
          class="no-guides"
          role="status"
          hidden={guides.length > 0}
          data-empty-all={t("guides.noArticles")}
          data-empty-filter={t("guides.empty")}
          data-empty-search={t("guides.noSearchResults")}
        >
          {t("guides.noArticles")}
        </p>

      {NEW_GUIDE_LOCALES.includes(lang) && <p><a href="/guides/" lang="en">{t("guides.browseEnglish")} →</a></p>}
    </section>

    <section class="categories" aria-labelledby="categories-title">
      <h2 id="categories-title">{t("guides.categories")}</h2>

      <div class="grid">
        {categories.map((category) => {
          const count = guides.filter(
            (guide) => guide.data.category === category.slug
          ).length;

          const href =
            `${lang === "en" ? "" : `/${lang}`}/guides/?category=${category.slug}`;

          return (
            <a class="card category-card" href={href}>
              <div class={`category-art category-art--${category.theme}`}>
                <div class="category-symbol" aria-hidden="true">
                  {category.symbol}
                </div>
              </div>

              <div class="category-content">
                <h3>{category.title}</h3>
                <p>{category.description}</p>

                <span>
                  {count} {
                    count === 1
                      ? t("guides.categoryCountOne")
                      : t("guides.categoryCountMany")
                  }
                </span>
              </div>
            </a>
          );
        })}
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .container {
    width: min(var(--content-width), 90%);
    margin: 0 auto;
  }

  .breadcrumbs {
    display: flex;
    gap: 12px;
    padding-top: 30px;
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .breadcrumbs a {
    text-decoration: none;
  }

  .breadcrumbs a:hover {
    color: var(--color-accent);
  }

  .intro {
    padding: 70px 0 50px;
    max-width: 750px;
  }

  .eyebrow {
    color: var(--color-accent);
    font-size: 0.8rem;
    letter-spacing: 2px;
  }

  h1 {
    font-size: clamp(2.5rem, 6vw, 4rem);
    line-height: 1.15;
    margin: 15px 0;
  }

  .subtitle,
  .card p {
    color: var(--color-text-muted);
  }

  .categories {
    padding-bottom: 100px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }

  .card {
    padding: 28px;
    border: 1px solid var(--color-card-border);
    border-radius: 12px;
    background: var(--color-surface);
  }

  .card h3 {
    margin-top: 0;
  }

  .card span {
    color: var(--color-accent);
    font-size: 0.85rem;
  }

  @media (max-width: 700px) {
    .grid {
      grid-template-columns: 1fr;
    }

    .intro {
      padding: 50px 0 30px;
    }
  }

    .latest-guides {
    padding-bottom: 40px;
    }

    .guide-list {
    display: grid;
    grid-template-columns: repeat(
        auto-fit,
        minmax(min(100%, 320px), 1fr)
    );
    gap: 20px;
    }

    .latest-guides .eyebrow {
    text-transform: uppercase;
    margin-top: 0;
    }

    .latest-guides .card h3 {
    margin-bottom: 8px;
    }

    .guide-link {
    color: var(--color-text);
    text-decoration: none;
    transition: color 0.2s ease;
    }

    .guide-link:hover,
    .guide-link:focus-visible {
    color: var(--color-accent);
    text-decoration: underline;
    }

  /* Atlantica Classic - Guide Categories */

  .categories .category-card {
    display: flex;
    flex-direction: column;
    padding: 0;
    overflow: hidden;
    border-radius: 6px;
    transition:
      border-color 0.25s ease,
      transform 0.25s ease;
  }

  .category-art {
    position: relative;
    height: 140px;
    background: #171b20;
    overflow: hidden;
  }

  .category-art::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      transparent 55%,
      var(--color-surface) 100%
    );
    pointer-events: none;
  }

  .category-content {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 20px 24px 24px;
  }

  .category-content h3 {
    margin: 0 0 12px;
    color: var(--color-gold-light);
    font-size: 1.25rem;
  }

  .category-content p {
    margin: 0 0 18px;
    line-height: 1.6;
  }

  .category-content span {
    margin-top: auto;
  }

  .categories .category-card:hover {
    border-color: var(--color-accent);
    transform: translateY(-3px);
  }

  @media (prefers-reduced-motion: reduce) {
    .categories .category-card {
      transition: none;
    }

    .categories .category-card:hover {
      transform: none;
    }
  }

  /* Atlantica Classic - Category Filters */

  .guide-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 18px 0 26px;
  }

  .filter-button {
    padding: 9px 16px;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    background: var(--color-surface);
    color: var(--color-text-muted);
    font-family: var(--font-primary);
    font-size: 0.9rem;
    cursor: pointer;
    transition:
      border-color 0.2s ease,
      color 0.2s ease,
      background-color 0.2s ease;
  }

  .filter-button:hover,
  .filter-button:focus-visible {
    color: var(--color-gold-light);
    border-color: var(--color-accent);
  }

  .filter-button.is-active {
    background: rgba(210, 164, 91, 0.12);
    border-color: var(--color-accent);
    color: var(--color-gold-light);
  }

  .filter-button:focus-visible {
    outline: 2px solid var(--color-gold-light);
    outline-offset: 3px;
  }

  .guide-list .card[hidden],
  .no-guides[hidden] {
    display: none;
  }

  .no-guides {
    padding: 30px;
    text-align: center;
    color: var(--color-text-muted);
    border: 1px dashed var(--color-border);
    border-radius: 6px;
  }

  @media (prefers-reduced-motion: reduce) {
    .filter-button {
      transition: none;
    }
  }

  /* Original fantasy category artwork */

  .category-art {
    display: flex;
    align-items: center;
    justify-content: center;
    isolation: isolate;
    background:
      radial-gradient(
        circle at center,
        rgba(210, 164, 91, 0.2),
        transparent 65%
      ),
      linear-gradient(135deg, #24272a, #111418);
  }

  .category-art--mercenaries {
    background:
      radial-gradient(
        circle at center,
        rgba(100, 119, 135, 0.24),
        transparent 65%
      ),
      linear-gradient(135deg, #252b32, #111418);
  }

  .category-art--systems {
    background:
      radial-gradient(
        circle at center,
        rgba(137, 103, 58, 0.25),
        transparent 65%
      ),
      linear-gradient(135deg, #29241c, #111418);
  }

  .category-symbol {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 88px;
    height: 88px;
    border: 1px solid var(--color-bronze);
    border-radius: 50%;
    background: rgba(15, 17, 20, 0.68);
    color: var(--color-gold-light);
    font-size: 42px;
    box-shadow:
      0 0 35px rgba(210, 164, 91, 0.12),
      inset 0 0 15px rgba(210, 164, 91, 0.1);
  }

  /* Guide search */

  .guide-search {
    display: flex;
    flex-direction: column;
    gap: 8px;
    max-width: 520px;
    margin: 20px 0 24px;
  }

  .guide-search label {
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .guide-search input {
    width: 100%;
    min-width: 0;
    padding: 12px 16px;

    border: 1px solid var(--color-border);
    border-radius: 6px;

    background: var(--color-surface);
    color: var(--color-text);

    font: inherit;
    font-size: 1rem;
  }

  .guide-search input::placeholder {
    color: var(--color-text-muted);
  }

  .guide-search input:focus-visible {
    outline: 2px solid var(--color-gold-light);
    outline-offset: 2px;
  }

  /* Search result counter */

  .guide-results-count {
    margin: 0 0 20px;
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .guide-results-count[hidden] {
    display: none;
  }

  /* Mobile search */

  @media (max-width: 600px) {
    .guide-search {
      max-width: 100%;
    }

    .guide-search input {
      font-size: 16px;
    }

    .guide-filters {
      gap: 8px;
    }

    .filter-button {
      padding: 9px 12px;
    }
  }

  /* Clickable category cards */

  .categories .category-card {
    color: inherit;
    text-decoration: none;
  }

  .categories .category-card:focus-visible {
    outline: 2px solid var(--color-gold-light);
    outline-offset: 3px;
  }

  .categories .category-card:hover h3,
  .categories .category-card:focus-visible h3 {
    color: var(--color-accent);
  }

  /* Guide subcategory filter */

  .guide-subcategory {
    display: flex;
    flex-direction: column;
    gap: 8px;
    max-width: 520px;
    margin: 0 0 24px;
  }

  .guide-subcategory[hidden] {
    display: none;
  }

  .guide-subcategory label {
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .guide-subcategory select {
    width: 100%;
    min-width: 0;
    padding: 12px 16px;

    border: 1px solid var(--color-border);
    border-radius: 6px;

    background: var(--color-surface);
    color: var(--color-text);

    font: inherit;
    font-size: 1rem;
  }

  .guide-subcategory select:focus-visible {
    outline: 2px solid var(--color-gold-light);
    outline-offset: 2px;
  }

</style>



<script>
  const buttons = Array.from(
    document.querySelectorAll<HTMLButtonElement>(
      "[data-guide-filter]"
    )
  );

  const cards = Array.from(
    document.querySelectorAll<HTMLElement>(
      "[data-guide-category]"
    )
  );

  const searchInput =
    document.querySelector<HTMLInputElement>("#guide-search");

  const subcategorySelect =
    document.querySelector<HTMLSelectElement>(
      "#guide-subcategory"
    );

  const subcategoryGroup =
    document.querySelector<HTMLElement>(
      "#guide-subcategory-group"
    );

  const emptyMessage =
    document.querySelector<HTMLElement>("#no-guides");

  const resultsCount =
    document.querySelector<HTMLElement>(
      "#guide-results-count"
    );

  let activeCategory = "all";

  function normalizeText(value: string): string {
    return value
      .normalize("NFD")
      .replace(/[\u0300-\u036f]/g, "")
      .toLowerCase()
      .trim();
  }

  function syncSubcategoryOptions() {
    if (!subcategorySelect) return;

    const selectedValue = subcategorySelect.value;
    const options = Array.from(subcategorySelect.options);

    let hasOptions = false;

    options.forEach((option) => {
      if (!option.value) return;

      const allowed =
        option.dataset.parentCategory === activeCategory;

      option.disabled = !allowed;
      option.hidden = !allowed;

      if (allowed) hasOptions = true;
    });

    if (subcategoryGroup) {
      subcategoryGroup.hidden = !hasOptions;
    }

    const selectionIsValid = options.some(
      (option) =>
        option.value === selectedValue &&
        !option.disabled
    );

    if (!selectionIsValid) {
      subcategorySelect.value = "";
    }
  }

  function applyFilters() {
    syncSubcategoryOptions();

    const query = normalizeText(searchInput?.value ?? "");
    const selectedSubcategory =
      subcategorySelect?.value ?? "";

    let visibleCount = 0;

    cards.forEach((card) => {
      const matchesCategory =
        activeCategory === "all" ||
        card.dataset.guideCategory === activeCategory;

      const matchesSubcategory =
        !selectedSubcategory ||
        card.dataset.guideSubcategory === selectedSubcategory;

      const searchText = normalizeText(
        card.dataset.guideSearch ?? ""
      );

      const matchesSearch =
        !query || searchText.includes(query);

      const visible =
        matchesCategory &&
        matchesSubcategory &&
        matchesSearch;

      card.hidden = !visible;

      if (visible) visibleCount++;
    });

    if (resultsCount) {
      resultsCount.hidden = visibleCount === 0;

      const label =
        visibleCount === 1
          ? resultsCount.dataset.one ?? ""
          : resultsCount.dataset.many ?? "";

      resultsCount.textContent = `${visibleCount} ${label}`;
    }

    buttons.forEach((button) => {
      const active =
        button.dataset.guideFilter === activeCategory;

      button.classList.toggle("is-active", active);
      button.setAttribute("aria-pressed", String(active));
    });

    if (emptyMessage) {
      emptyMessage.hidden = visibleCount > 0;

      emptyMessage.textContent =
        cards.length === 0
          ? emptyMessage.dataset.emptyAll ?? ""
          : query
            ? emptyMessage.dataset.emptySearch ?? ""
            : emptyMessage.dataset.emptyFilter ?? "";
    }
  }

  function updateUrl() {
    const url = new URL(window.location.href);
    const query = searchInput?.value.trim() ?? "";
    const subcategory = subcategorySelect?.value ?? "";

    if (activeCategory === "all") {
      url.searchParams.delete("category");
    } else {
      url.searchParams.set("category", activeCategory);
    }

    if (subcategory) {
      url.searchParams.set("subcategory", subcategory);
    } else {
      url.searchParams.delete("subcategory");
    }

    if (query) {
      url.searchParams.set("q", query);
    } else {
      url.searchParams.delete("q");
    }

    window.history.replaceState({}, "", url);
  }

  function restoreFiltersFromUrl() {
    const params = new URLSearchParams(
      window.location.search
    );

    const requestedCategory =
      params.get("category") ?? "all";

    activeCategory = buttons.some(
      (button) =>
        button.dataset.guideFilter === requestedCategory
    )
      ? requestedCategory
      : "all";

    if (searchInput) {
      searchInput.value = params.get("q") ?? "";
    }

    syncSubcategoryOptions();

    const requestedSubcategory =
      params.get("subcategory") ?? "";

    if (subcategorySelect) {
      const validOption = Array.from(
        subcategorySelect.options
      ).find(
        (option) =>
          option.value === requestedSubcategory &&
          !option.disabled
      );

      subcategorySelect.value =
        validOption ? requestedSubcategory : "";
    }

    applyFilters();

    // Remove invalid category/subcategory combinations.
    if (
      requestedSubcategory &&
      subcategorySelect?.value !== requestedSubcategory
    ) {
      updateUrl();
    }
  }

  buttons.forEach((button) => {
    button.addEventListener("click", () => {
      activeCategory =
        button.dataset.guideFilter ?? "all";

      applyFilters();
      updateUrl();
    });
  });

  searchInput?.addEventListener("input", () => {
    applyFilters();
    updateUrl();
  });

  subcategorySelect?.addEventListener("change", () => {
    applyFilters();
    updateUrl();
  });

  window.addEventListener(
    "popstate",
    restoreFiltersFromUrl
  );

  restoreFiltersFromUrl();
</script>
