
---
import type { Lang } from "../i18n/ui";
import { useTranslations } from "../i18n/utils";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const categories = [
  {
    title: t("guides.categoryNationDungeons"),
    description: t("guides.nationDungeonsDesc"),
    image: "/images/atlantica/backgrounds/dungeon-temple.webp",
    imageAlt: "Ancient dungeon environment",
    imageFit: "cover",
  },
  {
    title: t("guides.categoryMercenaries"),
    description: t("guides.mercenariesDesc"),
    image: "/images/atlantica/categories/mercenaries-archer.png",
    imageAlt: "Atlantica Online mercenary artwork",
    imageFit: "cover",
  },
  {
    title: t("guides.categoryGameSystems"),
    description: t("guides.gameSystemsDesc"),
    image: "/images/atlantica/backgrounds/Antilla12.jpg",
    imageAlt: "Atlantica Online artwork",
    imageFit: "contain",
  },
];

const allGuides = await getCollection("guides");
const guides = allGuides
  .filter((guide) => guide.data.lang === lang && !guide.data.draft)
  .sort(
    (a, b) =>
      b.data.updatedAt.getTime() -
      a.data.updatedAt.getTime()
  );
  
const categoryLabels: Record<string, string> = {
  "nation-dungeons": t("guides.categoryNationDungeons"),
  "mercenaries": t("guides.categoryMercenaries"),
  "game-systems": t("guides.categoryGameSystems"),
};

---

<BaseLayout
  title={`${t("guides.title")} | Atlantica Knowledge Hub`}
  description={t("guides.intro")}
  lang={lang}
  alternatePaths={{
    en: "/guides/",
    "pt-br": "/pt-br/guides/",
  }}
>
  <main class="container">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href={lang === "en" ? "/" : `/${lang}/`}>
        {t("nav.home")}
      </a>
      <span>/</span>
      <span>{t("nav.guides")}</span>
    </nav>

    <section class="intro">
      <p class="eyebrow">{t("guides.eyebrow")}</p>
      <h1>{t("guides.title")}</h1>
      <p>{t("guides.intro")}</p>
    </section>

    <section class="latest-guides" aria-labelledby="latest-guides-title">
        <h2 id="latest-guides-title">{t("guides.latest")}</h2>

        <div class="guide-filters" role="group" aria-label={t("guides.filterLabel")}>
          <button class="filter-button is-active" type="button"
            data-guide-filter="all" aria-pressed="true" aria-controls="guide-list">
            {t("guides.all")}
          </button>

          <button class="filter-button" type="button"
            data-guide-filter="nation-dungeons" aria-pressed="false" aria-controls="guide-list">
            {t("guides.categoryNationDungeons")}
          </button>

          <button class="filter-button" type="button"
            data-guide-filter="mercenaries" aria-pressed="false" aria-controls="guide-list">
            {t("guides.filterMercenaries")}
          </button>

          <button class="filter-button" type="button"
            data-guide-filter="game-systems" aria-pressed="false" aria-controls="guide-list">
            {t("guides.categoryGameSystems")}
          </button>
        </div>


        <div class="guide-list" id="guide-list">
          {guides.map((guide) => (
            <article class="card" data-guide-category={guide.data.category}>
                <p class="eyebrow">
                {categoryLabels[guide.data.category] ?? guide.data.category}
                </p>

                <h3>
                    <a class="guide-link" href={`${lang === "en" ? "" : `/${lang}`}/guides/${guide.id.replace(/^[^/]+\//, "")}/`}
>
                        {guide.data.title}
                    </a>
                </h3>

                <p>{guide.data.description}</p>

                <span>
                  {t("article.updated")}: {guide.data.updatedAt.toISOString().slice(0, 10)}
                </span>
            </article>
          ))}
        </div>
        
        <p
          id="no-guides"
          class="no-guides"
          role="status"
          hidden={guides.length > 0}
          data-empty-all={t("guides.noArticles")}
          data-empty-filter={t("guides.empty")}
        >
          {t("guides.noArticles")}
        </p>

    </section>

    <section class="categories" aria-labelledby="categories-title">
      <h2 id="categories-title">{t("guides.categories")}</h2>

      <div class="grid">
        {categories.map((category) => (
          <article class="card category-card">
            <div class="category-art">
              <img
                src={category.image}
                alt={category.imageAlt}
                class:list={{
                  contain: category.imageFit === "contain",
                }}
                loading="lazy"
                decoding="async"
              />
            </div>

            <div class="category-content">
              <h3>{category.title}</h3>
              <p>{category.description}</p>
              <span>{t("shared.comingSoon")}</span>
            </div>
          </article>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .container {
    width: min(var(--content-width), 90%);
    margin: 0 auto;
  }

  .breadcrumbs {
    display: flex;
    gap: 12px;
    padding-top: 30px;
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .breadcrumbs a {
    text-decoration: none;
  }

  .breadcrumbs a:hover {
    color: var(--color-accent);
  }

  .intro {
    padding: 70px 0 50px;
    max-width: 750px;
  }

  .eyebrow {
    color: var(--color-accent);
    font-size: 0.8rem;
    letter-spacing: 2px;
  }

  h1 {
    font-size: clamp(2.5rem, 6vw, 4rem);
    line-height: 1.15;
    margin: 15px 0;
  }

  .subtitle,
  .card p {
    color: var(--color-text-muted);
  }

  .categories {
    padding-bottom: 100px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }

  .card {
    padding: 28px;
    border: 1px solid var(--color-card-border);
    border-radius: 12px;
    background: var(--color-surface);
  }

  .card h3 {
    margin-top: 0;
  }

  .card span {
    color: var(--color-accent);
    font-size: 0.85rem;
  }

  @media (max-width: 700px) {
    .grid {
      grid-template-columns: 1fr;
    }

    .intro {
      padding: 50px 0 30px;
    }
  }

    .latest-guides {
    padding-bottom: 40px;
    }

    .guide-list {
    display: grid;
    grid-template-columns: repeat(
        auto-fit,
        minmax(min(100%, 320px), 1fr)
    );
    gap: 20px;
    }

    .latest-guides .eyebrow {
    text-transform: uppercase;
    margin-top: 0;
    }

    .latest-guides .card h3 {
    margin-bottom: 8px;
    }

    .guide-link {
    color: var(--color-text);
    text-decoration: none;
    transition: color 0.2s ease;
    }

    .guide-link:hover,
    .guide-link:focus-visible {
    color: var(--color-accent);
    text-decoration: underline;
    }
    
  /* Atlantica Classic - Guide Categories */

  .categories .category-card {
    display: flex;
    flex-direction: column;
    padding: 0;
    overflow: hidden;
    border-radius: 6px;
    transition:
      border-color 0.25s ease,
      transform 0.25s ease;
  }

  .category-art {
    position: relative;
    height: 140px;
    background: #171b20;
    overflow: hidden;
  }

  .category-art img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .category-art img.contain {
    object-fit: contain;
    padding: 10px;
  }

  .category-art::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      transparent 55%,
      var(--color-surface) 100%
    );
    pointer-events: none;
  }

  .category-content {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 20px 24px 24px;
  }

  .category-content h3 {
    margin: 0 0 12px;
    color: var(--color-gold-light);
    font-size: 1.25rem;
  }

  .category-content p {
    margin: 0 0 18px;
    line-height: 1.6;
  }

  .category-content span {
    margin-top: auto;
  }

  .categories .category-card:hover {
    border-color: var(--color-accent);
    transform: translateY(-3px);
  }

  @media (prefers-reduced-motion: reduce) {
    .categories .category-card {
      transition: none;
    }

    .categories .category-card:hover {
      transform: none;
    }
  }

  /* Atlantica Classic - Category Filters */

  .guide-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 18px 0 26px;
  }

  .filter-button {
    padding: 9px 16px;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    background: var(--color-surface);
    color: var(--color-text-muted);
    font-family: var(--font-primary);
    font-size: 0.9rem;
    cursor: pointer;
    transition:
      border-color 0.2s ease,
      color 0.2s ease,
      background-color 0.2s ease;
  }

  .filter-button:hover,
  .filter-button:focus-visible {
    color: var(--color-gold-light);
    border-color: var(--color-accent);
  }

  .filter-button.is-active {
    background: rgba(210, 164, 91, 0.12);
    border-color: var(--color-accent);
    color: var(--color-gold-light);
  }

  .filter-button:focus-visible {
    outline: 2px solid var(--color-gold-light);
    outline-offset: 3px;
  }

  .guide-list .card[hidden],
  .no-guides[hidden] {
    display: none;
  }

  .no-guides {
    padding: 30px;
    text-align: center;
    color: var(--color-text-muted);
    border: 1px dashed var(--color-border);
    border-radius: 6px;
  }

  @media (prefers-reduced-motion: reduce) {
    .filter-button {
      transition: none;
    }
  }


</style>

<script>
  const buttons = Array.from(
    document.querySelectorAll<HTMLButtonElement>(
      "[data-guide-filter]"
    )
  );

  const cards = Array.from(
    document.querySelectorAll<HTMLElement>(
      "[data-guide-category]"
    )
  );

  const emptyMessage = document.querySelector<HTMLElement>(
    "#no-guides"
  );

  function applyFilter(category: string) {
    let visibleCount = 0;

    cards.forEach((card) => {
      const visible =
        category === "all" ||
        card.dataset.guideCategory === category;

      card.hidden = !visible;

      if (visible) {
        visibleCount++;
      }
    });

    buttons.forEach((button) => {
      const active = button.dataset.guideFilter === category;

      button.classList.toggle("is-active", active);
      button.setAttribute("aria-pressed", String(active));
    });

    if (emptyMessage) {
      emptyMessage.hidden = visibleCount > 0;

      emptyMessage.textContent =
        cards.length === 0
          ? emptyMessage.dataset.emptyAll ?? ""
          : emptyMessage.dataset.emptyFilter ?? "";
    }

  }

  // Restore the filter when opening a shared URL.
  const requestedCategory =
    new URLSearchParams(window.location.search).get("category") ?? "all";

  const initialCategory = buttons.some(
    (button) => button.dataset.guideFilter === requestedCategory
  ) ? requestedCategory : "all";

  applyFilter(initialCategory);

  buttons.forEach((button) => {
    button.addEventListener("click", () => {
      const category = button.dataset.guideFilter ?? "all";

      applyFilter(category);

      const url = new URL(window.location.href);

      if (category === "all") {
        url.searchParams.delete("category");
      } else {
        url.searchParams.set("category", category);
      }

      window.history.replaceState({}, "", url);
    });
  });
</script>
