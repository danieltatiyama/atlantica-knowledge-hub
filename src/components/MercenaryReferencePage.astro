---
import BaseLayout from "../layouts/BaseLayout.astro";
import { localePrefix, localizedPaths } from "../i18n/locales.mjs";
import { awakeningText } from "../i18n/awakening-ui.mjs";
import { referenceText } from "../i18n/mercenary-reference-ui.mjs";
interface Props {lang:string; section:"database"|"skills"}
const {lang,section}=Astro.props;
const t=referenceText(lang);
const prefix=localePrefix(lang);
const root=prefix+"/mercenaries/";
const title=t[section];
---
<BaseLayout title={title+" | Atlantica Knowledge Hub"} description={t.noFormula} lang={lang} alternatePaths={localizedPaths("/mercenaries/"+section+"/")}>
  <main class="reference" data-reference data-section={section} data-lang={lang} data-labels={JSON.stringify(t)} data-prefix={prefix}>
    <nav><a href={root}>{t.database}</a> / {title}</nav>
    <h1>{title}</h1>
    <p>{t.intro}</p>
    {section==="database" && <p>{t.profileNotice}</p>}
    <p class="notice">{t.noFormula} {t.notVerified}</p>
    <p data-scope aria-live="polite">{t.loading}</p>
    <nav class="tabs">
      <a href={root+"database/"} aria-current={section==="database"?"page":undefined}>{t.database}</a>
      <a href={root+"skills/"} aria-current={section==="skills"?"page":undefined}>{t.skills}</a>
          <a href={prefix+"/tools/awakening/"}>{awakeningText(lang).title}</a>
    </nav>
    <div class="controls" hidden data-controls>
      <label>{t.search}<input type="search" data-search autocomplete="off"/></label>
      <label>{t.select}<select data-primary></select></label>
      {section==="database" ? <>
        <label>{t.compare}<select data-secondary></select></label>
        <label>{t.rank}<select data-profile-filter="Rank"></select></label>
        <label>JobType<select data-profile-filter="jobType"></select></label>
        <label>WpnType<select data-profile-filter="weaponType"></select></label>
        <label>{t.family}<select data-profile-filter="baseGrade"></select></label>
      </> : <>
        <label>{t.bookFilter}<select data-book-filter><option value="">{t.all}</option><option value="yes">{t.hasBooks}</option><option value="no">{t.withoutBooks}</option></select></label>
        <label>{t.grade}<select data-grade></select></label>
      </>}
    </div>
    <p data-count aria-live="polite"></p>
    <section data-result aria-live="polite"></section>
    <noscript>{t.error}</noscript>
  </main>
</BaseLayout>
<style>
.reference{width:min(var(--content-width),94%);margin:auto;padding:26px 0 80px}
.reference h1{font-size:clamp(2rem,4vw,3rem);margin:.7rem 0}
.reference a{color:var(--color-accent)}
.notice{border-left:3px solid var(--color-bronze);padding:12px 16px;color:var(--color-text-muted);background:var(--color-surface)}
.tabs{display:flex;gap:16px;margin:20px 0;flex-wrap:wrap}
.tabs a{padding:10px 14px;border:1px solid var(--color-border);border-radius:5px}
.tabs a[aria-current]{background:var(--color-surface);font-weight:bold}
.controls:not([hidden]){display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,235px),1fr));gap:12px;margin:24px 0}
label{display:grid;gap:6px;color:var(--color-text-muted)}
input,select{font:inherit;min-width:0;width:100%;padding:10px;background:var(--color-surface);color:var(--color-text);border:1px solid var(--color-border);border-radius:5px}
.reference :global(.ref-table-wrap){overflow-x:auto;margin:12px 0 24px}
.reference :global(table){width:100%;border-collapse:collapse;background:var(--color-surface)}
.reference :global(th),.reference :global(td){padding:9px 12px;text-align:left;border-bottom:1px solid var(--color-border);vertical-align:top;overflow-wrap:anywhere}
.reference :global(th){color:var(--color-text-muted);font-weight:600}
.reference :global(.ref-warning){border-left:3px solid var(--color-bronze);padding:8px 12px;font-weight:600}
.reference :global(.ref-source){font-size:.85rem;color:var(--color-text-muted)}
.reference :global(h2){margin:24px 0 8px;font-size:1.4rem}
.reference :global(h3){margin:18px 0 8px;font-size:1.1rem}
.reference :global(.ref-mode-matrix table){min-width:860px;table-layout:fixed;font-variant-numeric:tabular-nums}
.reference :global(.ref-mode-matrix table th:first-child),.reference :global(.ref-mode-matrix table td:first-child){width:28%;position:sticky;left:0;background:var(--color-surface);z-index:1}
.reference :global(.ref-mode-matrix table th:not(:first-child)),.reference :global(.ref-mode-matrix table td:not(:first-child)){text-align:right}
.reference :global(.ref-conflict-cell){display:grid;gap:4px}
.reference :global(.ref-missing){color:var(--color-text-muted)}
.reference :global(.ref-mode-matrix details){margin:12px 0 22px}
.reference :global(.ref-mode-matrix summary){cursor:pointer;color:var(--color-accent)}
.reference :global(.ref-level-controls){display:grid;grid-template-columns:minmax(90px,150px) minmax(0,360px) auto;align-items:end;gap:16px;max-width:680px;margin:12px 0}
.reference :global(.ref-level-control){display:grid;gap:5px;color:var(--color-text-muted)}
.reference :global(.ref-level-range){min-width:0;display:grid;gap:2px;padding-bottom:2px}
.reference :global(.ref-level-range input){width:100%;min-width:0;accent-color:var(--color-accent);cursor:pointer;margin:0;height:25px}
.reference :global(.ref-level-range input:disabled){cursor:default}
.reference :global(.ref-level-range input:focus-visible){outline:2px solid var(--color-accent);outline-offset:3px}
.reference :global(.ref-level-limits){display:flex;justify-content:space-between;font-size:.75rem;line-height:1;color:var(--color-text-muted);font-variant-numeric:tabular-nums}
.reference :global(.ref-level-control input){width:100%;padding:9px;font:inherit;color:var(--color-text);background:var(--color-surface);border:1px solid var(--color-border);border-radius:5px}
.reference :global(.ref-stat-total th),.reference :global(.ref-stat-total td){font-weight:700;color:var(--color-accent);border-bottom:2px solid var(--color-border)}
.reference :global(.ref-stat-group th){width:auto!important;position:static!important;background:var(--color-surface);border-top:2px solid var(--color-border);color:var(--color-text);text-align:left}
.reference :global(.ref-mode-matrix [aria-invalid="true"]){outline:2px solid var(--color-bronze)}
.reference :global(.ref-player-matrix){container:skill-matrix / inline-size;min-width:0}
.reference :global(.ref-player-table-wrap){overflow:auto;max-height:min(72vh,800px);overscroll-behavior-x:contain}
.reference :global(.ref-player-table-wrap table){border-collapse:separate;border-spacing:0}
.reference :global(.ref-player-table-wrap thead th){position:sticky;top:0;z-index:3;background:var(--color-header);border-bottom:2px solid var(--color-border)}
.reference :global(.ref-player-table-wrap thead th:first-child){z-index:4;background:var(--color-header)}
.reference :global(.ref-player-table-wrap tbody + tbody .ref-stat-group th){border-top:8px solid var(--color-background)}
.reference :global(.ref-player-table-wrap .ref-stat-group th){background:var(--color-header);padding-top:8px;padding-bottom:8px}
@container skill-matrix (min-width:860px){
  .reference :global(.ref-player-table-wrap){overflow:visible;max-height:none}
}
@container skill-matrix (min-width:756px){
  .reference :global(.ref-player-table-wrap[data-mode-count="5"]){overflow:visible;max-height:none}
}
@container skill-matrix (min-width:652px){
  .reference :global(.ref-player-table-wrap[data-mode-count="4"]){overflow:visible;max-height:none}
}
@container skill-matrix (min-width:548px){
  .reference :global(.ref-player-table-wrap[data-mode-count="3"]){overflow:visible;max-height:none}
}
@container skill-matrix (min-width:444px){
  .reference :global(.ref-player-table-wrap[data-mode-count="2"]){overflow:visible;max-height:none}
}
@container skill-matrix (min-width:340px){
  .reference :global(.ref-player-table-wrap[data-mode-count="1"]){overflow:visible;max-height:none}
}
@media(max-width:450px){
  .reference :global(.ref-level-controls){grid-template-columns:100px minmax(0,1fr);gap:10px}
  .reference :global(.ref-max-level){grid-column:1 / -1;justify-self:start}
}
.reference :global(.ref-max-level){font:inherit;white-space:nowrap;color:var(--color-accent);background:var(--color-surface);border:1px solid var(--color-border);border-radius:5px;padding:9px 12px;cursor:pointer}
.reference :global(.ref-max-level:disabled){opacity:.5;cursor:default}
.reference :global(.ref-int-controls){display:flex;align-items:end;flex-wrap:wrap;gap:16px;margin:12px 0}
.reference :global(.ref-int-controls .ref-level-control){width:150px}
.reference :global(.ref-cap-summary){margin:0 0 10px}
.reference :global(.ref-player-table-wrap table){min-width:var(--ref-table-min,860px)}
.reference :global(.ref-player-table-wrap table th:first-child){width:max(28%,200px)}
.reference :global(.ref-player-table-wrap tr[hidden]){display:none}
.reference :global(.ref-view-controls){border:1px solid var(--color-border);border-radius:6px;margin:14px 0;padding:12px;min-width:0}
.reference :global(.ref-view-controls legend){font-weight:600;color:var(--color-text);padding:0 6px}
.reference :global(.ref-view-actions),.reference :global(.ref-mode-checks){display:flex;align-items:center;flex-wrap:wrap;gap:8px 16px}
.reference :global(.ref-view-check){display:inline-flex;align-items:center;gap:6px;color:var(--color-text);cursor:pointer}
.reference :global(.ref-view-check input){width:16px;height:16px;margin:0;accent-color:var(--color-accent)}
.reference :global(.ref-view-controls .ref-source){margin:8px 0}
.reference :global(.ref-view-actions button){padding:6px 10px}
.reference :global(.ref-group-toggle){width:100%;display:block;text-align:left;border:0;background:transparent;color:inherit;font:inherit;cursor:pointer;padding:2px 0}
.reference :global(.ref-group-toggle:focus-visible){outline:2px solid var(--color-accent);outline-offset:3px}
</style>
<script>
import { mountReference } from "../scripts/mercenary-reference.mjs";
document.querySelectorAll<HTMLElement>("[data-reference]").forEach(mountReference);
</script>
