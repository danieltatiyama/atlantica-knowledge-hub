    "test:client-attributes": "node --test tests/client-source-attributes.test.mjs",
    "validate:client-attributes": "node scripts/check-client-item-attributes.mjs",
    "test:client-views": "node --test tests/client-item-stat-summary.test.mjs",
    "test:client-crafting": "node --test tests/client-crafting-requirements.test.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.10",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/marcellus": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.1",
    "astro": "^7.4.9"
  },
  "devDependencies": {
    "wrangler": "^4.160.0"
  }
}
