{
  "name": "atlantica-wiki",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "validate:curated": "node scripts/check-curated-equipment.mjs",
    "test:curated": "node --test tests/curated-equipment-gate.test.mjs tests/offline-review-workbench.test.mjs",
    "validate:profiles": "node scripts/check-reviewed-item-profiles.mjs",
    "test:profiles": "node --test tests/reviewed-item-profiles.test.mjs tests/equipment-enchant-projection.test.mjs tests/wikidot-url-pattern.test.mjs",
    "suggest:wikidot": "node scripts/suggest-wikidot-item-pages.mjs",
    "validate:legendary": "node scripts/check-legendary-research.mjs",
    "test:legendary": "node --test tests/legendary-enhancement.test.mjs",
    "test:item-facts": "node --test tests/extended-equipment-facts.test.mjs tests/item-article-review-queue.test.mjs",
    "coverage:items": "node scripts/build-item-article-review-queue.mjs",
    "test:wikidot-review": "node --test tests/historical-item-profile-drafts.test.mjs",
    "audit:wikidot": "python scripts/audit-wikidot-item-pages.py",
    "draft:wikidot": "node scripts/build-historical-item-profile-draft.mjs",
    "test:client-facts": "node --test tests/client-first-equipment.test.mjs tests/legendary-client-reconciliation.test.mjs",
    "validate:client-facts": "node scripts/check-client-equipment-facts.mjs",
    "profile:miner-fields": "python scripts/profile-miner-reference-fields.py",
